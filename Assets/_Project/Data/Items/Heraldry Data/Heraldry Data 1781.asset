  _name: "\u0413\u0435\u0440\u0431 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0438 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438 1781 \u0433."
  _year: 1781
  _description: "   \u0412 1772 \u0433. \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0440\u0430\u0437\u0434\u0435\u043B\u0430 \u0420\u0435\u0447\u0438 \u041F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0439
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A \u0432\u043E\u0448\u0435\u043B \u0432
    \u0441\u043E\u0441\u0442\u0430\u0432 \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u0433\u043E\u0440\u043E\u0434 \u0441\u0442\u0430\u043B \u0446\u0435\u043D\u0442\u0440\u043E\u043C
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438
    \u041F\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438,
    \u0437\u0430\u0442\u0435\u043C \u2013 \u0446\u0435\u043D\u0442\u0440\u043E\u043C
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0443\u0435\u0437\u0434\u0430
    \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438,
    \u0441 1802 \u0433. \u2013 \u0446\u0435\u043D\u0442\u0440\u043E\u043C \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438.   21 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    1781 \u0433. \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u0440\u0438\u0446\u0430
    \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0430 II \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0430
    \u0433\u0435\u0440\u0431\u044B \u0434\u043B\u044F \u0433\u043E\u0440\u043E\u0434\u043E\u0432
    \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0433\u043E \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430,
    \u0432 \u0442.\u0447. \u0434\u043B\u044F \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430.
    \u0413\u0435\u0440\u0431\u044B \u0431\u044B\u043B\u0438 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C\u0438,
    \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E 
    \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435\u043C \u0449\u0438\u0442\u043E\u0432:
    \xAB\u0429\u0438\u0442\u044A \u0440\u0430\u0437\u0440\u0463\u0437\u0430\u043D
    \u043D\u0430 \u0434\u0432\u043E\u0435: \u0432\u044A \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u043E\u043D\u0430\u0433\u043E \u0432\u044A \u0437\u043E\u043B\u043E\u0442\u043E\u043C
    \u043F\u043E\u043B\u0435 \u0420\u043E\u0441\u0441i\u0439\u0441\u043A\u043E\u0439
    \u0418\u043C\u043F\u0435\u0440i\u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
    \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u0433\u043E
    \u0433\u0435\u0440\u0431\u0430 \u0434\u0432\u0443\u0433\u043B\u0430\u0432\u0430\u0433\u043E
    \u043E\u0440\u043B\u0430, \u0430 \u0432\u044A \u043D\u0438\u0436\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0432\u044A \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u043C\u044A
    \u043F\u043E\u043B\u0463 \u0441\u0442\u0430\u0440\u044B\u0439 \u041F\u043E\u043B\u043E\u0446\u043Ai\u0439
    \u0433\u0435\u0440\u0431\u044A; \u043D\u0430 \u043A\u043E\u043D\u0463 \u0432\u043E\u0438\u043D\u044A,
    \u0434\u0435\u0440\u0436\u0430\u0449i\u0439 \u0432\u044A \u043F\u0440\u0430\u0432\u043E\u0439
    \u0440\u0443\u043A\u0463 \u0441\u0430\u0431\u043B\u044E, \u0430 \u043D\u0430
    \u043B\u0463\u0432\u043E\u0439 \u0440\u0443\u043A\u0463 \u043D\u0430\u0434\u0463\u0442\u044B\u0439
    \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0449\u0438\u0442\u044A \u0441 \u0434\u0432\u043E\u0439\u043D\u044B\u043C\u044A
    \u043D\u0430 \u043E\u043D\u043E\u043C\u044A \u043A\u0440\u0435\u0441\u0442\u043E\u043C\u044A\xBB.
    \u0429\u0438\u0442 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0433\u0435\u0440\u0431\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0441\u044F
    \u043E\u0442 \u0433\u0435\u0440\u0431\u043E\u0432 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0433\u043E\u0440\u043E\u0434\u043E\u0432 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C\u0438
    \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438 \u043F\u043E\u043B\u0435\u043C.   "
