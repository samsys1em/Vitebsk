  - _title: "\u0422\u0440\u0430\u043C\u0432\u0430\u0439 \u043D\u0430 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439
      \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0438  \u0437\u0434\u0430\u043D\u0438\u0435
      \u0442\u044E\u0440\u044C\u043C\u044B. 1950-\u0435 \u0433\u0433. \u0424\u043E\u0442\u043E
      \u041A. \u0414\u0443\u0440\u0438\u0445\u0438\u043D\u0430"
