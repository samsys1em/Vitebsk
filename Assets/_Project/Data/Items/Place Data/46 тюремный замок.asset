  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "46 \u0442\u044E\u0440\u0435\u043C\u043D\u044B\u0439 \u0437\u0430\u043C\u043E\u043A"
  m_EditorClassIdentifier: 
  _number: 46
  _name: "\u0442\u044E\u0440\u0435\u043C\u043D\u044B\u0439 \u0437\u0430\u043C\u043E\u043A"
  _description: "\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u0442\u044E\u0440\u0435\u043C\u043D\u044B\u0439
    \u0437\u0430\u043C\u043E\u043A \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u0441 \u043A\u043E\u043D\u0446\u0430 XVIII \u0432\u0435\u043A\u0430. \u0414\u043E
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u044D\u0442\u043E \u0431\u044B\u043B\u0430\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0430\u044F
    \u0442\u044E\u0440\u044C\u043C\u0430. \u0421 1830 \u0433\u043E\u0434\u0430 \u0437\u0430
    \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435\u043C
    \u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435\u043C \u0442\u044E\u0440\u0435\u043C\u043D\u043E\u0433\u043E\r\n\u0437\u0430\u043C\u043A\u0430
    \u0441\u043B\u0435\u0434\u0438\u043B \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u0438\u0442\u0435\u0442
    \u043F\u043E\u043F\u0435\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u043E \u0442\u044E\u0440\u044C\u043C\u0430\u0445.
    \u041E\u043D \u0436\u0435\r\n\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C,
    \u043E\u0434\u0435\u0436\u0434\u043E\u0439, \u0431\u0435\u043B\u044C\u0435\u043C,\r\n\u043E\u0431\u0443\u0432\u044C\u044E,
    \u0440\u0430\u0431\u043E\u0442\u043E\u0439, \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430
    \u0431\u043E\u043B\u044C\u043D\u044B\u0445, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0445
    \u0438\u043C\u0438 \u0434\u0435\u043D\u0435\u0433 \u0438\r\n\u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438
    \u044D\u0442\u0438\u0445 \u0441\u0443\u043C\u043C \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0438\u0445 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F. \u0422\u0430\u043A\u0436\u0435
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442 \u0441\u043B\u0435\u0434\u0438\u043B
    \u0437\u0430\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C
    \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u0445 \u043F\u043E
    \u0438\u0445 \u0440\u043E\u0434\u0443, \u0437\u0432\u0430\u043D\u0438\u044E,
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0443 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0443
    \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0439;\r\n\u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F
    \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043D\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
    \u0442\u044E\u0440\u044C\u043C\u044B.\r\n\u041F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u043F\u0435\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442\u0430 \u043E \u0442\u044E\u0440\u044C\u043C\u0430\u0445
    \u0432\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C \u0442\u044E\u0440\u0435\u043C\u043D\u043E\u043C
    \u0437\u0430\u043C\u043A\u0435 \u0431\u044B\u043B\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043C\u0430\u043B\u043E\u043B\u0435\u0442\u043D\u0438\u0445
    \u0430\u0440\u0435\u0441\u0442\u0430\u043D\u0442\u043E\u0432 \u043D\u0430 37\r\n\u0447\u0435\u043B\u043E\u0432\u0435\u043A.
    \u041E\u043D\u0438 \u0442\u0440\u0443\u0434\u0438\u043B\u0438\u0441\u044C \u043D\u0430
    \u0442\u044E\u0440\u0435\u043C\u043D\u043E\u043C \u043E\u0433\u043E\u0440\u043E\u0434\u0435,
    \u0430 \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043E\u0442
    \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0440\u0435\u043C\u044F \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\r\n\u0442\u044E\u0440\u0435\u043C\u043D\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u043E\u0431\u0443\u0447\u0430\u043B \u0438\u0445
    \u0433\u0440\u0430\u043C\u043E\u0442\u0435 \u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u0430\u043C.\r\n\u041F\u043E\u0441\u043B\u0435
    \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F
    1863-1864 \u0433\u0433. \u0432 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0439 \u0442\u044E\u0440\u044C\u043C\u0435
    \u0432 \u0447\u0438\u0441\u043B\u0435\r\n\u043F\u0440\u043E\u0447\u0438\u0445
    \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u043E\u0432 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
    \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 - \u043C\u0435\u0441\u0442\u043D\u044B\u0435
    \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0438, \u0434\u0432\u043E\u0440\u044F\u043D\u0435,\r\n\u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0432\u0448\u0438\u0435
    \u0437\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u0420\u0435\u0447\u0438 \u041F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0439.
    \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u2013 \u0418\u0432\u0430\u043D
    \u0427\u0435\u0440\u0441\u043A\u0438\u0439,\r\n\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u0433\u0435\u043E\u0433\u0440\u0430\u0444,
    \u0433\u0435\u043E\u043B\u043E\u0433, \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439 \u0421\u0438\u0431\u0438\u0440\u0438,
    \u0443\u0440\u043E\u0436\u0435\u043D\u0435\u0446\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430.\r\n\u041C\u043D\u043E\u0433\u043E
    \u043E\u0441\u0443\u0436\u0434\u0435\u043D\u043D\u044B\u0445 \u043F\u043E \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u043E\u0441\u044C
    \u0432 \u0442\u044E\u0440\u044C\u043C\u0435 \u0432\u043E \u0432\u0440\u0435\u043C\u044F\r\n\u041F\u0435\u0440\u0432\u043E\u0439
    \u0440\u0443\u0441\u0441\u043A\u043E\u0439 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438
    1905-1907 \u0433\u0433., \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432 1917 \u0433.\r\n\u0414\u043E
    1941 \u0433. \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u0442\u044E\u0440\u044C\u043C\u0430
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0432 \u0432\u0435\u0434\u0435\u043D\u0438\u0438
    \u041E\u0442\u0434\u0435\u043B\u0430 \u043C\u0435\u0441\u0442 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u041D\u041A\u0412\u0414.\r\n\u042D\u0442\u043E \u0431\u044B\u043B \u0446\u0435\u043B\u044B\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0439,
    \u0441\u043E\u0441\u0442\u043E\u044F\u0432\u0448\u0438\u0439 \u0438\u0437 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u043A\u043E\u0440\u043F\u0443\u0441\u0430, \u043A\u043E\u0440\u043F\u0443\u0441\u0430
    \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E\r\n\u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0441 \u0431\u0430\u043D\u0435\u0439 \u0438 \u043A\u0443\u0445\u043D\u0435\u0439
    \u043F\u0440\u0438 \u043D\u0435\u043C, \u0442\u044E\u0440\u0435\u043C\u043D\u043E\u0439
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B, \u043A\u043E\u043D\u044E\u0448\u043D\u0438,
    \u043E\u0432\u043E\u0449\u0435\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430,\r\n\u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445,
    \u0441\u043A\u043B\u0430\u0434\u043E\u0432, \u0433\u0430\u0440\u0430\u0436\u0435\u0439,
    \u0447\u0435\u0442\u044B\u0440\u0435\u0445 \u0441\u0442\u043E\u0440\u043E\u0436\u0435\u0432\u044B\u0445
    \u0432\u044B\u0448\u0435\u043A \u0438 \u0434\u0440.\r\n\u0412 \u0433\u043E\u0434\u044B
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0439
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438 \u0442\u044E\u0440\u044C\u043C\u0430
    \u0431\u044B\u043B\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439,
    \u0437\u0434\u0435\u0441\u044C\r\n\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u043E\u0441\u044C
    \u0438 \u043C\u0438\u0440\u043D\u043E\u0435 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435,
    \u0438 \u0442\u0435, \u043A\u0442\u043E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u043B\u0441\u044F
    \u0432 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438\r\n\u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u043C\u0443
    \u0440\u0435\u0436\u0438\u043C\u0443 (\u043F\u043E\u0434\u043F\u043E\u043B\u044C\u0449\u0438\u043A\u0438,
    \u043F\u0430\u0440\u0442\u0438\u0437\u0430\u043D\u0441\u043A\u0438\u0435 \u0441\u0432\u044F\u0437\u043D\u044B\u0435).
    \u0421\u0435\u0439\u0447\u0430\u0441 \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F\r\n\u0421\u0418\u0417\u041E
    \u2116 2"
  _preview: {fileID: 21300000, guid: 300eb7baad09aa14cb10ff7cd21d7e7f, type: 3}
  _images:
  - _title: "\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
