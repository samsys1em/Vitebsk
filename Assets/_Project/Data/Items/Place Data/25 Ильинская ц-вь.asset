  m_Name: "25 \u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0430\u044F \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 25
  _name: "\u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u2013 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0445\u0440\u0430\u043C \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435.
    \u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C\r\n\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    \u043D\u0430 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043E\u0441\u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0443\u043B. \u0420\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0432\u043E\u0437\u043B\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0430\r\n\u0441
    \u0443\u043B. 1-\u0439 \u0416\u043E\u0440\u0435\u0441\u0430.\r\n\u041F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u044D\u0442\u043E\u0433\u043E
    \u0445\u0440\u0430\u043C\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441
    \u0438\u043C\u0435\u043D\u0435\u043C \u043A\u043E\u0440\u043E\u043B\u044F \u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0438\r\n\u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043A\u043D\u044F\u0437\u044F
    \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u041A\u0430\u0437\u0438\u043C\u0438\u0440\u0430
    IV. \u0412 \u0434\u0435\u043D\u044C \u0441\u0432. \u041F\u0440\u043E\u0440\u043E\u043A\u0430
    \u0418\u043B\u044C\u0438 \u0432 1447 \u0433. \u0432\u043E\r\n\u0432\u0440\u0435\u043C\u044F
    \u043A\u0443\u043F\u0430\u043D\u0438\u044F \u0435\u0433\u043E \u0441\u0443\u043F\u0440\u0443\u0433\u0430
    \u0415\u043B\u0435\u043D\u0430 \u0435\u0434\u0432\u0430 \u043D\u0435 \u0443\u0442\u043E\u043D\u0443\u043B\u0430
    \u0438 \u0447\u0443\u0434\u043E\u043C \u0441\u043F\u0430\u0441\u043B\u0430\u0441\u044C.
    \u0412 \u043F\u0430\u043C\u044F\u0442\u044C \u043E\u0431\r\n\u044D\u0442\u043E\u043C
    \u0441\u043E\u0431\u044B\u0442\u0438\u0438\u0438 \u041A\u0430\u0437\u0438\u043C\u0438\u0440
    \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0434\u0438\u043B\u0441\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0430\u0445 \u0417\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0414\u0432\u0438\u043D\u044B,\r\n\u0414\u043D\u0435\u043F\u0440\u0430 \u0438
    \u0421\u043E\u0436\u0430 \u0448\u0435\u0441\u0442\u044C \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0445
    \u0446\u0435\u0440\u043A\u0432\u0435\u0439 \u0432 \u0447\u0435\u0441\u0442\u044C
    \u0418\u043B\u044C\u0438 \u041F\u0440\u043E\u0440\u043E\u043A\u0430.\r\n\u0412\u0440\u0435\u043C\u044F
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0418\u043B\u044C\u0438\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.
    \u041F\u043E\r\n\u043E\u0434\u043D\u0438\u043C \u0434\u0430\u043D\u043D\u044B\u043C,
    \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0432
    1447 \u0433., \u043F\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u2013 \u0432
    1643 \u0433. \u0412 1746 \u0433. \u0445\u0440\u0430\u043C \u0431\u044B\u043B\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u043C\u0438 \u043A\u0443\u043F\u0446\u0430\u043C\u0438
    \u0417\u0430\u043F\u043E\u043B\u044C\u0441\u043A\u0438\u043C\u0438. \u0412 \u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430\r\n\u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0439,
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u0430 \u0446\u0435\u0445\u0443
    \u043A\u043E\u0440\u043C\u0449\u0438\u043A\u043E\u0432. \u0412 1788 \u0433. \u0445\u0440\u0430\u043C
    \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u043D\r\n\u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C,
    \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0432\u043D\u043E\u0432\u044C \u0441\u0442\u0430\u043B
    \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u0438\u043C. \u041E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\r\n\u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0441\u0442\u0430\u043B\u0430 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0439
    \u0432 1839 \u0433.\r\n\u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C XVIII \u2013 \u043D\u0430\u0447\u0430\u043B\u0430
    XX \u0432\u0432. \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u0441\u043E\u0431\u043E\u0439 4-\u0441\u0440\u0443\u0431\u043D\u044B\u0439\r\n\u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u043A\u0440\u0435\u0441\u0442\u043E\u0432\u043E-\u0446\u0435\u043D\u0442\u0440\u0438\u0447\u043D\u043E\u0439
    \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0438 \u043E\u0442\r\n\u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0445
    \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0441\u0440\u0443\u0431\u043D\u044B\u0445
    \u0446\u0435\u0440\u043A\u0432\u0435\u0439 \u043A\u043E\u043D\u0446\u0430 XVII
    \u2013 1-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B XVIII \u0432\u0432.,\r\n\u0438\u043C\u0435\u0432\u0448\u0438\u0445
    \u0444\u043E\u0440\u043C\u0443 \u0440\u0430\u0432\u043D\u043E\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E
    \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043A\u0440\u0435\u0441\u0442\u0430,
    \u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0438\u0439 \u0445\u0440\u0430\u043C
    \u0438\u043C\u0435\u043B\r\n\u043F\u0440\u043E\u0434\u043E\u043B\u0433\u043E\u0432\u0430\u0442\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 (19\u044516 \u043C), \u0447\u0442\u043E \u044F\u0432\u043B\u044F\u043B\u043E\u0441\u044C
    \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435\u043C \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0432\u043B\u0438\u044F\u043D\u0438\u044F.\r\n\u0410\u043B\u0442\u0430\u0440\u0451\u043C
    \u0445\u0440\u0430\u043C \u0431\u044B\u043B \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D
    \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A. \u0420\u044F\u0434\u043E\u043C
    \u0441 \u0446\u0435\u0440\u043A\u043E\u0432\u044C\u044E \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C\r\n\u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0430\u044F
    \u0442\u0440\u0451\u0445\u044A\u044F\u0440\u0443\u0441\u043D\u0430\u044F \u0441\u0440\u0443\u0431\u043E-\u043A\u0430\u0440\u043A\u0430\u0441\u043D\u0430\u044F
    \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044F, \u043D\u0430\u043A\u0440\u044B\u0442\u0430\u044F
    \u043F\u043E\u043A\u0430\u0442\u044B\u043C \u0448\u0430\u0442\u0440\u043E\u043C\r\n\u0441
    \u0433\u043B\u0430\u0432\u043A\u043E\u0439.\r\n\u0412 1865 \u0433. \u0432\u043E\u0437\u043B\u0435
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \xAB\u0442\u0451\u043F\u043B\u0430\u044F\xBB
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432\u044F\u0442\u043E-\r\n\u0418\u043B\u044C\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0438\u0445\u043E\u0434\u0430 \u2013 \u0445\u0440\u0430\u043C \u0432\u043E
    \u0438\u043C\u044F \u041F\u043E\u043A\u0440\u043E\u0432\u0430 \u041F\u0440\u0435\u0441\u0432\u044F\u0442\u043E\u0439
    \u0411\u043E\u0433\u043E\u0440\u043E\u0434\u0438\u0446\u044B.\r\n\u0412 \u0430\u043F\u0440\u0435\u043B\u0435
    1904 \u0433. \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u043C\u043E\u043B\u043D\u0438\u0438
    \u0445\u0440\u0430\u043C \u0441\u0433\u043E\u0440\u0435\u043B, \u043E\u0433\u043E\u043D\u044C
    \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B \u0438 \u043E\u043A\u043E\u043B\u043E
    150\r\n\u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0437\u0434\u0430\u043D\u0438\u0439.
    \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043B\u0435\u0442 \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
    \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\r\n\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0432\u0440\u0430\u0447\u0430,
    \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0430 \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0434\u0435\u044F\u0442\u0435\u043B\u044F \u041F\u0435\u0442\u0440\u0430\r\n\u041C\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u0430
    \u041A\u0440\u0430\u0441\u043E\u0432\u0438\u0446\u043A\u043E\u0433\u043E. \u042D\u0442\u043E
    \u0443\u0436\u0435 \u0431\u044B\u043B \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C, \u0432 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438\r\n\u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0449\u0438\u0439
    \u0441\u0433\u043E\u0440\u0435\u0432\u0448\u0438\u0439 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439.\r\n\u0426\u0435\u0440\u043A\u043E\u0432\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u043A\u0430\u043A
    \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0434\u043E 1931 \u0433\u043E\u0434\u0430.
    \u0411\u044B\u043B\u0430 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0430
    \u0432\r\n\u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u2013 \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B."
