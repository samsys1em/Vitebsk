  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "54 \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
    \u043A\u043E\u043D\u0442\u043E\u0440\u0430"
  m_EditorClassIdentifier: 
  _number: 54
  _name: "\u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
    \u043A\u043E\u043D\u0442\u043E\u0440\u0430"
  _description: "\u0412 1802 \u0433. \u0431\u044B\u043B\u0430 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0430\u044F
    \u043F\u043E\u0447\u0442\u043E\u0432\u0430\u044F \u043A\u043E\u043D\u0442\u043E\u0440\u0430,
    \u0432\r\n1859 \u0433. \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444. \u0412 1885 \u0433. \u043C\u0435\u0441\u0442\u043D\u044B\u0435
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043F\u043E\u0447\u0442\u043E\u0432\u043E\u0439\r\n\u0438
    \u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E
    \u0431\u044B\u043B\u0438 \u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D\u044B,
    \u0432\u043C\u0435\u0441\u0442\u043E \u043D\u0438\u0445 \u0431\u044B\u043B\u0438
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u044B\r\n\u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u044B\u0435
    \u043E\u043A\u0440\u0443\u0433\u0430. \u0421\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E,
    \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\r\n\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u044B\u0435
    \u043A\u043E\u043D\u0442\u043E\u0440\u044B.\r\n\u0421 1880-\u0445 \u0433\u0433.
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
    \u043A\u043E\u043D\u0442\u043E\u0440\u0430 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C
    \u0432 \u0434\u0432\u0443\u0445\r\n\u0437\u0434\u0430\u043D\u0438\u044F\u0445
    \u043D\u0430 \u0443\u043B. \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439
    (\u043D\u044B\u043D\u0435 \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430).
    \u041E\u0434\u043D\u043E \u0438\u0437 \u043D\u0438\u0445, \u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0438
    \u0441\r\n\u0443\u043B. \u0414\u0432\u043E\u0440\u0446\u043E\u0432\u043E\u0439
    (\u043D\u044B\u043D\u0435 \u0443\u043B. \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F,
    13), \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C.\r\n\u0421
    1930 \u0433. \u0432 \u044D\u0442\u0438\u0445 \u0437\u0434\u0430\u043D\u0438\u044F\u0445
    \u043D\u0430\u0440\u044F\u0434\u0443 \u0441 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043F\u043E\u0447\u0442\u043E\u0439
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F\r\n\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C. \u041F\u043E\u0441\u043B\u0435
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u0441 1948 \u043F\u043E 1964\r\n\u0433\u0433.,
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F
    \u0413\u043B\u0430\u0432\u043F\u043E\u0447\u0442\u0430\u043C\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0441\u043F\u0443\u0441\u0442\u044F \u0433\u043E\u0434 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B
    \u043D\u0430\r\n\u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u0439
    \u043F\u0440\u043E\u0441\u043F\u0435\u043A\u0442. \u0410 \u0432 \u0434\u043E\u043C\u0435
    \u043D\u0430 \u0443\u0433\u043B\u0443 \u0443\u043B. \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
    \u0438 \u041B\u0435\u043D\u0438\u043D\u0430 \u0441 1965-\u0433\u043E \u0438\r\n\u043F\u043E
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u043F\u043E\u0447\u0442\u043E\u0432\u043E\u0439 \u0441\u0432\u044F\u0437\u0438
    \u2116 26"
  _preview: {fileID: 21300000, guid: c9582107f962fd945b35bf5761f2b350, type: 3}
  _images:
  - _title: "\u041F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
      \u043A\u043E\u043D\u0442\u043E\u0440\u0430. \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430
      \u043D\u0430\u0447. \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: 1ab71791c69de68488192cfc9f785060, type: 3}
  - _title: "\u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u0430\u044F \u0443\u043B.
      \u0438 \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
      \u043A\u043E\u043D\u0442\u043E\u0440\u0430 (\u0441\u043B\u0435\u0432\u0430).
      1910-\u0435 \u0433\u0433."
    _image: {fileID: 21300000, guid: 5d0f6d218bd2b2b45869b1e9be14b8fd, type: 3}
  - _title: "\u0423\u043B. \u0414\u0432\u043E\u0440\u0446\u043E\u0432\u0430\u044F
      (\u0441\u043E\u0432\u0440. \u0443\u043B. \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F).
      \u0421\u043F\u0440\u0430\u0432\u0430 - \u0437\u0434\u0430\u043D\u0438\u0435
      \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u043E\u0439
      \u043A\u043E\u043D\u0442\u043E\u0440\u044B. \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430
      \u043D\u0430\u0447. \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: c9e06162854c5174ab18c70492155922, type: 3}
  - _title: "\u0423\u043B. \u041B\u0435\u043D\u0438\u043D\u0430 \u0438 \u0437\u0434\u0430\u043D\u0438\u0435
      \u0433\u043B\u0430\u0432\u043F\u043E\u0447\u0442\u0430\u043C\u0442\u0430. 1960-\u0435
      \u0433\u0433. \u0424\u043E\u0442\u043E \u0438\u0437 \u0430\u0440\u0445\u0438\u0432\u0430
      \u041C. \u041A\u0430\u0446\u0435\u0440\u0430"
