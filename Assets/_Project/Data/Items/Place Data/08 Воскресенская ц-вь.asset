  - _title: "\u0420\u0430\u0442\u0443\u0448\u0430 \u0438 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
      \u0446\u0435\u0440\u043A\u043E\u0432\u044C. \u0421\u044A\u0451\u043C\u043A\u0430
      \u0441 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442\u0430. 2003 \u0433."
    _image: {fileID: 21300000, guid: 5d2a15205f26a624289bc1bcadc1ab52, type: 3}
  - _title: "\u0420\u0430\u0442\u0443\u0448\u0430 \u0438 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
      \u0446\u0435\u0440\u043A\u043E\u0432\u044C. \u0421\u044A\u0451\u043C\u043A\u0430
      \u0441 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442\u0430. 2003 \u0433."
