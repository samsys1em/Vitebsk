  - _title: "\u041F\u0443\u0441\u0442\u044B\u0440\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u043E\u0439
      \u0446\u0435\u0440\u043A\u0432\u0438. 1973 \u0433."
    _image: {fileID: 21300000, guid: f564e5d2faa444046b65f699f611a9cc, type: 3}
  - _title: "\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
      \u0446\u0435\u0440\u043A\u043E\u0432\u044C. \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
      2003 \u0433. \u0424\u043E\u0442\u043E \u0410. \u0412\u044B\u0448\u043A\u0438"
