  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "08 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 8
  _name: "\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446-\u0432\u044C"
  _description: "\u0412 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0432 \u0441\u0432\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0431\u044B\u043B\u043E \u0434\u0432\u0435 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0438\u0435
    \u0446\u0435\u0440\u043A\u0432\u0438 \u2013 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F\r\n\u0417\u0430\u0440\u0443\u0447\u0435\u0432\u0441\u043A\u0430\u044F
    (\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0432 \u0440\u0430\u0439\u043E\u043D\u0435
    \u0417\u0430\u0440\u0443\u0447\u0435\u0432\u044C\u0435) \u0438 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    \u0420\u044B\u043D\u043A\u043E\u0432\u0430\u044F\r\n(\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438).
    \u0422\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u043E\u0439\r\n\u0420\u044B\u043D\u043A\u043E\u0432\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u043D\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
    \u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u044D\u0442\u043E
    1-\u044F \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 XVI \u0432. \u041F\u0435\u0440\u0432\u043E\u0435\r\n\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u0445\u0440\u0430\u043C\u0430 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043D\u0430 \u0447\u0435\u0440\u0442\u0435\u0436\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1664 \u0433., \u0433\u0434\u0435 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u043E\r\n\u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435, \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u043F\u043E \u043E\u0441\u0438 \xAB\u0432\u043E\u0441\u0442\u043E\u043A \u2013
    \u0437\u0430\u043F\u0430\u0434\xBB.\r\n\u0412 1772 \u0433. \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438
    \u0431\u044B\u043B\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u043E
    \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\r\n\u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0433\u043E
    \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430.
    \u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0443 \u0441 \u0443\u0441\u043F\u0435\u0445\u043E\u043C
    \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0440\u0435\u0448\u0438\u0442\u044C
    \u0434\u0432\u0435 \u0432\u0430\u0436\u043D\u044B\u0435\r\n\u0437\u0430\u0434\u0430\u0447\u0438:
    \u0432\u043E\u0437\u0432\u0435\u0441\u0442\u0438 \u0437\u0434\u0430\u043D\u0438\u0435
    \u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435
    \u0437\u0435\u043C\u043B\u0438 \u043D\u0430 \u0443\u0433\u043B\u0443 \u0434\u0432\u0443\u0445
    \u0443\u043B\u0438\u0446 \u0438 \u0443\u0434\u0430\u0447\u043D\u043E\r\n\u0432\u043F\u0438\u0441\u0430\u0442\u044C
    \u0435\u0433\u043E \u0432 \u0430\u043D\u0441\u0430\u043C\u0431\u043B\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u0438.\r\n\u0421\u0442\u0440\u043E\u0438\u043B\u0441\u044F
    \u0445\u0440\u0430\u043C \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043A\u0443\u043F\u0446\u0430
    \u041D\u0438\u043A\u043E\u043B\u0430\u044F \u0421\u043C\u044B\u043A\u0430, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043E\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0432
    \u043D\u0430\u0440\u043E\u0434\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
    \u0421\u043C\u044B\u043A\u043E\u0432\u0441\u043A\u043E\u0439. \u0426\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0432 \u0441\u0442\u0438\u043B\u0435\r\n\xAB\u0432\u0438\u043B\u0435\u043D\u0441\u043A\u043E\u0433\u043E\xBB
    \u0431\u0430\u0440\u043E\u043A\u043A\u043E. \u041E\u0431\u0449\u0435\u0439 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
    \u0437\u0434\u0430\u043D\u0438\u044F, \u0443\u0442\u043E\u043D\u0447\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
    \u0444\u043E\u0440\u043C \u0438\r\n\u043B\u0438\u043D\u0438\u0439, \u0431\u043E\u0433\u0430\u0442\u044B\u043C
    \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u043C \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435\u043C
    \u0444\u0430\u0441\u0430\u0434\u043E\u0432 \u043E\u043D\u0430 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435\r\n\u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
    \u043D\u0430 \u0437\u0440\u0438\u0442\u0435\u043B\u044F. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u043B\u0435\u0433\u0435\u043D\u0434\u0435, \u043A\u0440\u0430\u0441\u043E\u0442\u0430
    \u0445\u0440\u0430\u043C\u0430 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430\r\n\u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u044B\u043C
    \u0434\u0430\u0436\u0435 \u041D\u0430\u043F\u043E\u043B\u0435\u043E\u043D\u0430
    \u0411\u043E\u043D\u0430\u043F\u0430\u0440\u0442\u0430. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0435\u0433\u043E \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u044F
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0432\r\n1812 \u0433.,
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u044B \u043D\u0435 \u0441\u0442\u0430\u043B\u0438
    \u0433\u0440\u0430\u0431\u0438\u0442\u044C \u0446\u0435\u0440\u043A\u043E\u0432\u044C,
    \u043B\u0438\u0448\u044C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0438
    \u0432 \u043D\u0435\u0439 \u043B\u0430\u0437\u0430\u0440\u0435\u0442.\r\n\u0412
    1834 \u0433. \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430
    \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C
    \u0438 \u0447\u0435\u0440\u0435\u0437 7 \u043B\u0435\u0442 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0432\r\n\u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
    \u0441 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C\u0438
    \u043A\u0430\u043D\u043E\u043D\u0430\u043C\u0438.\r\n\u0412\u0441\u043A\u043E\u0440\u0435
    \u043F\u043E\u0441\u043B\u0435 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438
    \u0445\u0440\u0430\u043C \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B \u0431\u044B\u0442\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C, \u0432 1920
    \u0438 1926 \u0433\u0433.\r\n\u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u043B\u0438
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u043E\u043C \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B,
    \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u043C \u043E\u0445\u0440\u0430\u043D\u0435.
    \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430\r\n\u044D\u0442\u043E,
    \u0432 1936 \u0433. \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u043F\u043E \u043F\u0440\u0438\u043A\u0430\u0437\u0443
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0432\u043B\u0430\u0441\u0442\u0435\u0439
    \u0431\u044B\u043B\u0430\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0430.\r\n\u0412
    2000 \u0433. \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u0446\u0443
    \u0437\u0434\u0430\u043D\u0438\u044F\r\nXVIII \u0432. \u0412 2009 \u0433. \u0445\u0440\u0430\u043C
    \u0431\u044B\u043B \u043E\u0441\u0432\u044F\u0449\u0435\u043D \u041C\u0438\u0442\u0440\u043E\u043F\u043E\u043B\u0438\u0442\u043E\u043C
    \u041C\u0438\u043D\u0441\u043A\u0438\u043C \u0438 \u0421\u043B\u0443\u0446\u043A\u0438\u043C\r\n\u0424\u0438\u043B\u0430\u0440\u0435\u0442\u043E\u043C,
    \u041F\u0430\u0442\u0440\u0438\u0430\u0440\u0448\u0438\u043C \u042D\u043A\u0437\u0430\u0440\u0445\u043E\u043C
    \u0432\u0441\u0435\u044F \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438."
  _preview: {fileID: 21300000, guid: 445be6d3bf2efdb44ac4f2322b0671cf, type: 3}
  _images:
  - _title: "\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
