  m_Name: "07 \u0440\u0430\u0442\u0443\u0448\u0430"
  m_EditorClassIdentifier: 
  _number: 7
  _name: "\u0420\u0430\u0442\u0443\u0448\u0430"
  _description: "\u0420\u0430\u0442\u0443\u0448\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432\u0438\u0437\u0438\u0442\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u043E\u0439
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430. \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0432\u0440\u0435\u043C\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0432\r\n7
    \u0433\u043E\u0440\u043E\u0434\u0430\u0445 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438
    \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0430\u0442\u0443\u0448\u0443:
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435, \u0427\u0435\u0440\u0438\u043A\u043E\u0432\u0435,
    \u0428\u043A\u043B\u043E\u0432\u0435,\r\n\u0421\u043B\u043E\u043D\u0438\u043C\u0435,
    \u041D\u0435\u0441\u0432\u0438\u0436\u0435, \u041C\u0438\u043D\u0441\u043A\u0435
    \u0438 \u041C\u043E\u0433\u0438\u043B\u0435\u0432\u0435. \u0412\u0441\u0435 \u043E\u043D\u0438
    \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u0441\u0432\u043E\u0435\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043E\u0439,\r\n\u043D\u043E
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0438\u0445 \u043E\u0434\u043D\u043E:
    \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
    \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435\u043C
    \u0433\u043E\u0440\u043E\u0434\u043E\u043C\r\n\u043C\u0430\u0433\u0434\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430, \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044B\u0435
    \u043F\u0443\u043D\u043A\u0442\u044B \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438\r\n\u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0443\u044E,
    \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E, \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C.\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043C\u0430\u0433\u0434\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0435
    \u043F\u0440\u0430\u0432\u043E \u0432 1597 \u0433. \u0416\u0438\u0442\u0435\u043B\u0438
    \u0433\u043E\u0440\u043E\u0434\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u043B\u0438\u0441\u044C
    \u043E\u0442\r\n\u0444\u0435\u043E\u0434\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u043E\u0432\u0438\u043D\u043D\u043E\u0441\u0442\u0435\u0439, \u043E\u0442
    \u0441\u0443\u0434\u0430 \u0438 \u0432\u043B\u0430\u0441\u0442\u0438 \u0432\u043E\u0435\u0432\u043E\u0434,
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445\r\n\u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432. \u0412\u043B\u0430\u0441\u0442\u044C
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u043F\u0435\u0440\u0435\u0448\u043B\u0430
    \u043A \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u0443 \u2013 \u043E\u0440\u0433\u0430\u043D\u0443\r\n\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E
    \u0441\u0430\u043C\u043E\u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
    \u0434\u043B\u044F \u0437\u0430\u0441\u0435\u0434\u0430\u043D\u0438\u0439 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
    \u0440\u0430\u0442\u0443\u0448\u0430.\r\n\u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E,
    \u0433\u043E\u0440\u043E\u0434 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0433\u0435\u0440\u0431, \u043F\u0435\u0447\u0430\u0442\u044C, \u0445\u043E\u0440\u0443\u0433\u0432\u044C.\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F
    \u0440\u0430\u0442\u0443\u0448\u0430 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0412\u0437\u0433\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0437\u0430\u043C\u043A\u0430, \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\r\n\u0433\u043E\u0441\u0442\u0438\u043D\u044B\u043C
    \u0434\u0432\u043E\u0440\u043E\u043C \u043E\u043D\u0438 \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E-\u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
    \u0446\u0435\u043D\u0442\u0440 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430.\r\n\u0412
    \u0440\u0430\u0442\u0443\u0448\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u043B\u0438\u0441\u044C
    \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0441\u0434\u0435\u043B\u043A\u0438,
    \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438\u0441\u044C
    \u0432\u0430\u0436\u043D\u044B\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B.\r\n\u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0440\u0430\u0442\u0443\u0448\u0430 \u0438 \u0432\u0441\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043D\u0430 \u0420\u044B\u043D\u043A\u043E\u0432\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u0431\u044B\u043B\u0438\r\n\u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438.
    \u0417\u0434\u0430\u043D\u0438\u0435 \u0440\u0430\u0442\u0443\u0448\u0438 \u0431\u044B\u043B\u043E
    \u043E\u0434\u043D\u043E\u044D\u0442\u0430\u0436\u043D\u044B\u043C, \u0441 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u043E\u043C
    \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0438\r\n\u043C\u0430\u043B\u043E \u0447\u0435\u043C \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u043E\u0441\u044C
    \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043A.
    \u041E\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B\u043E \u0434\u043E
    1624 \u0433., \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u043E\r\n\u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043D\u043E
    \u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0441\u0443\u0434\u0435\u0431\u043D\u043E\u0439 \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438
    \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E\u043C\r\n\u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0433\u043E
    \u0430\u0440\u0445\u0438\u0435\u043F\u0438\u0441\u043A\u043E\u043F\u0430 \u0418\u043E\u0441\u043E\u0444\u0430\u0442\u0430
    \u041A\u0443\u043D\u0446\u0435\u0432\u0438\u0447\u0430. \u0422\u043E\u0433\u0434\u0430
    \u0436\u0435 \u0433\u043E\u0440\u043E\u0434 \u043B\u0438\u0448\u0438\u043B\u0441\u044F\r\n\u043C\u0430\u0433\u0434\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0437
    20 \u043B\u0435\u0442 \u043E\u043D\u043E \u0431\u044B\u043B\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u043E
    \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0443\u043A\u0430\u0437\u0443\r\n\u043A\u043E\u0440\u043E\u043B\u044F
    \u0412\u043B\u0430\u0434\u0438\u0441\u043B\u0430\u0432\u0430 IV. \u0420\u0430\u0442\u0443\u0448\u0443
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438. \u041F\u0435\u0440\u0432\u043E\u0435
    \u0435\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u043E\r\n\u043D\u0430 \u0427\u0435\u0440\u0442\u0435\u0436\u0435
    1664 \u0433.: \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0435
    \u0432 \u043F\u043B\u0430\u043D\u0435 2-\u044D\u0442\u0430\u0436\u043D\u043E\u0435
    \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0441 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    4-\r\n\u0441\u043A\u0430\u0442\u043D\u043E\u0439 \u043A\u0440\u044B\u0448\u0435\u0439
    \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043B\u043E\u0441\u044C 8-\u0433\u0440\u0430\u043D\u043D\u043E\u0439
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0431\u0430\u0448\u043D\u0435\u0439 \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C
    \u0438\r\n\u0448\u043F\u0438\u043B\u0435\u043C. \u0426\u043E\u043A\u043E\u043B\u044C\u043D\u044B\u0439
    \u0438 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436\u0438 \u0437\u0434\u0430\u043D\u0438\u044F
    \u0431\u044B\u043B\u0438 \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u043C\u0438,
    \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436 \u0438\r\n\u043A\u0440\u044B\u0448\u0430
    \u0441 \u0432\u044B\u0448\u043A\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438.
    \u041A \u0431\u043E\u043A\u043E\u0432\u044B\u043C \u0444\u0430\u0441\u0430\u0434\u0430\u043C
    \u0437\u0434\u0430\u043D\u0438\u044F \u0431\u044B\u043B\u0438 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0435\u043D\u044B\r\n\u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u0433\u043E\u0441\u0442\u0438\u043D\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430.\r\n\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F
    \u0440\u0430\u0442\u0443\u0448\u0430, \u043A\u0430\u043A \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0442
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E
    \u0433\u043E\u0440\u0435\u043B\u0430\r\n(\u0432 1680, 1708, 1733, 1752 \u0433\u0433.).
    \u0412 1775 \u0433. \u0431\u044B\u043B\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u043E
    \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u043E\u0439\r\n\u0420\u0430\u0442\u0443\u0448\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0442\u0430\u043B\u0430 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0446\u0435\u043D\u0442\u0440\u043E\u043C \u043F\u043B\u043E\u0449\u0430\u0434\u0438,
    \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0432 \u0435\u0435 \u043D\u0430 \u0434\u0432\u0435\r\n\u0447\u0430\u0441\u0442\u0438:
    \u043E\u0434\u043D\u0443 \u2013 \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u0444\u0430\u0441\u0430\u0434\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u044F
    \u0434\u043E \u0412\u0438\u0442\u044C\u0431\u044B, \u0434\u0440\u0443\u0433\u0443\u044E
    \u2013 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440 \u043E\u0442 \u043D\u0435\u0435.\r\n\u042D\u0442\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435, \u0432 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u043C
    \u0432\u0438\u0434\u0435, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C
    \u0434\u043E \u043D\u0430\u0448\u0438\u0445 \u0434\u043D\u0435\u0439. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\r\n\u043E\u043D\u043E
    \u0431\u044B\u043B\u043E \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u043C,
    \u0441 4-\u044F\u0440\u0443\u0441\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0435\u0439
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0444\u0430\u0441\u0430\u0434\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F\r\n\u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043B\u0430\u0441\u044C
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0448\u0430\u0442\u0440\u043E\u043C
    \u0441\u043E \u0448\u043F\u0438\u043B\u0435\u043C.\r\n\u0412 \u044D\u0442\u043E\u043C
    \u0436\u0435 1775 \u0433., \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438
    \u0433\u043E\u0434\u0430 \u043F\u043E\u0441\u043B\u0435 \u0432\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\r\n\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438, \u0433\u043E\u0440\u043E\u0434 \u0431\u044B\u043B
    \u043B\u0438\u0448\u0435\u043D \u043C\u0430\u0433\u0434\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430, \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u0442
    \u0431\u044B\u043B\r\n\u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D.
    \u0412 \u0440\u0430\u0442\u0443\u0448\u0435 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0430\u0441\u044C
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F \u0434\u0443\u043C\u0430,
    \u0432 XIX \u0432. \u2013 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F
    \u0443\u043F\u0440\u0430\u0432\u0430,\r\n\u0441\u0443\u0434, \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u0431\u0430\u043D\u043A, \u043F\u043E\u043B\u0438\u0446\u0438\u044F, \u043F\u043E\u0436\u0430\u0440\u043D\u044B\u0439
    \u0434\u0432\u043E\u0440.\r\n\u0417\u0430 \u0432\u0440\u0435\u043C\u044F \u0441\u0432\u043E\u0435\u0433\u043E
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0440\u0430\u0442\u0443\u0448\u0430 \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0430\u0441\u044C.
    \u0412\r\n\u043A\u043E\u043D\u0446\u0435 XVIII \u2013 \u043D\u0430\u0447\u0430\u043B\u0435
    XIX \u0432\u0432. \u043A \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443
    \u0444\u0430\u0441\u0430\u0434\u0443 \u0437\u0434\u0430\u043D\u0438\u044F \u0440\u0430\u0442\u0443\u0448\u0438
    \u0431\u044B\u043B\u0438\r\n\u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0435\u043D\u044B
    2-\u044D\u0442\u0430\u0436\u043D\u044B\u0435 \u043A\u043E\u0440\u043F\u0443\u0441\u0430,
    \u0441\u043E\u0437\u0434\u0430\u0432\u0448\u0438\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0434\u0432\u043E\u0440\u0438\u043A.
    \u041D\u0430\r\n\u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435
    \u0438\u0445 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B.\r\n\u0412 1833 \u0433. \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u044E\u0449\u0438\u0439
    \u0448\u0430\u0442\u0451\u0440 \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u0438
    \u0431\u0430\u0448\u0435\u043D\u043A\u043E\u0439 \u0432 \u0432\u0438\u0434\u0435
    \u0440\u043E\u0442\u043E\u043D\u0434\u044B \u0441\u043E\r\n\u0448\u043F\u0438\u043B\u0435\u043C,
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    1870-\u0445 \u0433\u0433. \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u044F\u0440\u0443\u0441\u0435
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438 \u0447\u0430\u0441\u044B.
    \u0412 XIX\r\n\u0432. \u0431\u0430\u0448\u043D\u044F \u0440\u0430\u0442\u0443\u0448\u0438
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B\u0430 \u0440\u043E\u043B\u044C
    \u043F\u043E\u0436\u0430\u0440\u043D\u043E\u0439 \u043A\u0430\u043B\u0430\u043D\u0447\u0438.
    \u0412 1873\u20131875 \u0433\u0433. \u0431\u044B\u043B\u0430\r\n\u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0430
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u0437\u0434\u0430\u043D\u0438\u044F \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441
    \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C \u043D\u0430
    \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u0434\u0443\u043C\u044B, \u0430 \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439
    \u2013 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u043E\u0433\u043E
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F. \u0412 1911 \u0433.
    \u0431\u044B\u043B\r\n\u043D\u0430\u0434\u0441\u0442\u0440\u043E\u0435\u043D
    \u0442\u0440\u0435\u0442\u0438\u0439 \u044D\u0442\u0430\u0436 (\u043F\u0440\u043E\u0435\u043A\u0442
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430 \u0422. \u041A\u0438\u0431\u0430\u0440\u0434\u0438\u043D\u0430),
    \u043D\u0430\u0440\u0443\u0448\u0438\u0432\u0448\u0438\u0439\r\n\u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u0438
    \u0437\u0434\u0430\u043D\u0438\u044F: \u043E\u043D\u043E \u0441\u0442\u0430\u043B\u043E
    \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0431\u043E\u043B\u0435\u0435
    \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C. \u0422\u043E\u0433\u0434\u0430
    \u0436\u0435 \u043A \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443\r\n\u0432\u0445\u043E\u0434\u0443
    \u0431\u044B\u043B \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0435\u043D \u043F\u043E\u0440\u0442\u0438\u043A,
    \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435
    \u043E\u043A\u043D\u0430 2-\u0433\u043E \u044D\u0442\u0430\u0436\u0430 \u0431\u044B\u043B\u0438
    \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u044B \u043D\u0430\r\n\u043F\u043E\u043B\u0443\u0446\u0438\u0440\u043A\u0443\u043B\u044C\u043D\u044B\u0435.\r\n\u0412
    \u0433\u043E\u0434\u044B \u0412\u041E\u0412 \u0440\u0430\u0442\u0443\u0448\u0430
    \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430, \u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044C
    \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430
    \u0438 \u0432\u0435\u0440\u0445\u043D\u0435\u0439\r\n\u0447\u0430\u0441\u0442\u0438
    \u0431\u0430\u0448\u043D\u0438, \u043D\u043E \u0432\u044B\u0441\u0442\u043E\u044F\u043B\u0430.
    \u0415\u0435 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u043E\u0432\u0430\u043B\u0438,
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438
    \u0432 1944-\u043C, 1970-\u0445,\r\n1980-\u0445, \u043D\u0430\u0447\u0430\u043B\u0435
    2000-\u0445 \u0433\u0433. \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u0432\u0441\u0435\u0445 \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u043E\u043A
    \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C \u0432\r\n\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0447\u0435\u0440\u0442\u044B \u0431\u0430\u0440\u043E\u043A\u043A\u043E (\u043E\u0442\u0434\u0435\u043B\u043A\u0430
    \u0438 \u043E\u0431\u044A\u0435\u043C\r\n\u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u0431\u0430\u0448\u043D\u0438) \u0438 \u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C\u0430
    (\u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043A\u043E\u0440\u043F\u0443\u0441).\r\n\u0412
    1924 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E
    \u043C\u0443\u0437\u0435\u044E. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u043D
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043A\u0430\u043A \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439\r\n\u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439
    \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u0443\u0437\u0435\u0439."
  _preview: {fileID: 21300000, guid: 54c1ddfd86912d548917570bd43c3d5a, type: 3}
  _images:
  - _title: "\u0420\u0430\u0442\u0443\u0448\u0430 \u0438 \u043F\u043B\u043E\u0449\u0430\u0434\u044C
