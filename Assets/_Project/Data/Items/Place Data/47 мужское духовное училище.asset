  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "47 \u043C\u0443\u0436\u0441\u043A\u043E\u0435 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  m_EditorClassIdentifier: 
  _number: 47
  _name: "\u043C\u0443\u0436\u0441\u043A\u043E\u0435 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  _description: "\u041E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445
    \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u0437\u0434\u0430\u043D\u0438\u0439,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0445 \u043D\u0430
    \u0443\u043B. 1-\u0439 \u0412\u0435\u0442\u0440\u044F\u043D\u043E\u0439, \u0431\u044B\u043B\u043E\r\n\u0437\u0434\u0430\u043D\u0438\u0435
    \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0433\u043E
    \u0443\u0447\u0438\u043B\u0438\u0449\u0430 (\u043D\u044B\u043D\u0435 \u0443\u043B.
    \u0427\u0435\u0445\u043E\u0432\u0430, 11/44). \u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0435\r\n\u0443\u0447\u0435\u0431\u043D\u044B\u0435
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C
    \u0434\u043B\u044F \u0434\u0435\u0442\u0435\u0439 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0434\u0443\u0445\u043E\u0432\u0435\u043D\u0441\u0442\u0432\u0430,\r\n\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443
    \u043A\r\n\u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044E
    \u0432 \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0438\u0438.\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435 \u0443\u0447\u0438\u043B\u0438\u0449\u0435
    \u0431\u044B\u043B\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E 30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F
    1810 \u0433\u043E\u0434\u0430 \u043A\u0430\u043A \u0443\u0435\u0437\u0434\u043D\u043E\u0435\r\n\u0443\u0447\u0438\u043B\u0438\u0449\u0435
    \u0432\u043E \u0433\u043B\u0430\u0432\u0435 \u0441 \u0440\u0435\u043A\u0442\u043E\u0440\u043E\u043C.
    \u0421\u043E\u0441\u0442\u043E\u044F\u043B\u043E \u0438\u0437 \u0434\u0432\u0443\u0445
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0439: \u0432\u044B\u0441\u0448\u0435\u0433\u043E
    \u0438 \u043D\u0438\u0437\u0448\u0435\u0433\u043E,\r\n\u0441\u0440\u043E\u043A
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u0434\u0432\u0430 \u0433\u043E\u0434\u0430.
    \u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u0443\u0440\u0441 \u043F\u0440\u043E\u0448\u043B\u043E
    15\r\n\u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432. \u0421 1854 \u0433\u043E\u0434\u0430
    \u0432 \u0443\u0447\u0438\u043B\u0438\u0449\u0435 \u0443\u0436\u0435 \u0431\u044B\u043B
    6-\u043B\u0435\u0442\u043D\u0438\u0439 \u043A\u0443\u0440\u0441 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F.\r\n\u041D\u0430
    \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0432\u0441\u0435\u0439
    \u0441\u0432\u043E\u0435\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435 \u0443\u0447\u0438\u043B\u0438\u0449\u0435\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u043E\u0441\u044C
    \u0432 \u0430\u0440\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0437\u0434\u0430\u043D\u0438\u044F\u0445. \u0421 1892 \u043F\u043E 1918 \u0433\u0433.
    \u043E\u043D\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u043E\r\n\u043A\u0438\u0440\u043F\u0438\u0447\u043D\u043E\u0435
    \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0435 \u043F\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430
    \u0410.\r\n\u041A\u043B\u0435\u043C\u0435\u043D\u0442\u044C\u0435\u0432\u0430
    \u0432 1890-1892 \u0433\u043E\u0434\u0430\u0445 \u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0438
    \u0443\u043B\u0438\u0446 1-\u0439 \u0412\u0435\u0442\u0440\u044F\u043D\u043E\u0439
    \u0438 \u0421\u0443\u0432\u043E\u0440\u043E\u0432\u0441\u043A\u043E\u0439.\r\n\u0412
    \u043D\u0435\u043C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0441\u044C
    4 \u043A\u043B\u0430\u0441\u0441\u0430, \u0443\u0447\u0435\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0435 \u043D\u0430 80-85 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,\r\n\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B
    \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445.
    \u0411\u044B\u043B\u0430 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0441\u043A\u0440\u043E\u043C\u043D\u0430\u044F
    \u0434\u043E\u043C\u043E\u0432\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0421\u0432\u044F\u0442\u0438\u0442\u0435\u043B\u044F\r\n\u0414\u0438\u043C\u0438\u0442\u0440\u0438\u044F
    \u0420\u043E\u0441\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E, \u0438\u043C\u0435\u043B\u0441\u044F
    \u0430\u043A\u0442\u043E\u0432\u044B\u0439 \u0437\u0430\u043B, \u0441\u0442\u043E\u043B\u043E\u0432\u0430\u044F,
    \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F, \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430,
    \u0432\r\n\u043F\u043E\u0434\u0432\u0430\u043B\u044C\u043D\u043E\u043C \u044D\u0442\u0430\u0436\u0435
    \u2013 \u043A\u0443\u0445\u043D\u044F, \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u0434\u043B\u044F \u0441\u043B\u0443\u0436\u0438\u0442\u0435\u043B\u0435\u0439.\r\n\u0421
    \u043D\u0430\u0447\u0430\u043B\u043E\u043C 1-\u0439 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0443\u0447\u0438\u043B\u0438\u0449\u0430
    \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F \u0432\u043E\u0435\u043D\u043D\u044B\u0439\r\n\u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u044C
    (1914 \u2014 1918). \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E,
    \u043A\u0430\u043A \u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E \u0440\u0435\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043E\r\n\u0432
    \u0441\u0432\u044F\u0437\u0438 \u0441 \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438
    1917 \u0433\u043E\u0434\u0430, \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F
    \u0413\u0443\u0431\u0437\u0435\u043C\u043E\u0442\u0434\u0435\u043B, \u0432 1922
    \u0433\u043E\u0434\u0443 \u0441\u044E\u0434\u0430\r\n\u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B
    \u041A\u043E\u043C\u043C\u0443\u043D\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043C.
    \u0424. \u042D\u043D\u0433\u0435\u043B\u044C\u0441\u0430 (\u043E\u043D \u0436\u0435
    \u0440\u0430\u0431\u043E\u0447\u0435-\r\n\u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0441\u043A\u0438\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442), \u0430 \u043F\u043E\u0437\u0434\u043D\u0435\u0435
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0430\u044F \u0441\u043E\u0432\u043F\u0430\u0440\u0442\u0448\u043A\u043E\u043B\u0430.
    \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0432\r\n\u0437\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442,
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439\r\n\u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C, \u043D\u0430 \u0431\u0430\u0437\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432 1924 \u0433\u043E\u0434\u0443
    \u0431\u044B\u043B \u043E\u0442\u043A\u0440\u044B\u0442 \u0411\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u0438\u0439\r\n\u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C (\u0432 1937 \u0433. \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435 \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0435\r\n\u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435).\r\n\u0412 \u0434\u043E\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0431\u044B\u043B \u043D\u0430\u0434\u0441\u0442\u0440\u043E\u0435\u043D
    \u0442\u0440\u0435\u0442\u0438\u0439 \u044D\u0442\u0430\u0436 \u0437\u0434\u0430\u043D\u0438\u044F.
    \u0412 \u043D\u0430\u0447\u0430\u043B\u0435 1950-\u0445 \u0433\u0433. \u0432\r\n\u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0435\u043C
    \u0432 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u044B\u043B\u0438
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u044B\r\n\u0440\u0435\u043C\u043E\u043D\u0442\u043D\u043E-\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0440\u0430\u0431\u043E\u0442\u044B, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
    \u043E\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E\r\n\u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E-\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u0443 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430.\r\n\u041D\u044B\u043D\u0435
    \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 \u0412\u0413\u0423 \u0438\u043C.
    \u041F.\u041C. \u041C\u0430\u0448\u0435\u0440\u043E\u0432\u0430."
  _preview: {fileID: 21300000, guid: 255011c95d002c945b8bfa7b9b2c4cb7, type: 3}
  _images:
  - _title: "\u041C\u0443\u0436\u0441\u043A\u043E\u0435 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435
      \u0443\u0447\u0438\u043B\u0438\u0449\u0435. \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430
      \u043D\u0430\u0447. \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: 1a95232209ac50d4783859f1755ba080, type: 3}
  - _title: "\u041C\u0443\u0436\u0441\u043A\u043E\u0435 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435
      \u0443\u0447\u0438\u043B\u0438\u0449\u0435. \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430
      \u043D\u0430\u0447. \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: 31eb175c7a65aa7498c1cd3bb363d068, type: 3}
