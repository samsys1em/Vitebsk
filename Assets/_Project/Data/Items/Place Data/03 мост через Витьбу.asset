  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "03 \u043C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437 \u0412\u0438\u0442\u044C\u0431\u0443"
  m_EditorClassIdentifier: 
  _number: 3
  _name: "\u043C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437 \u0412\u0438\u0442\u044C\u0431\u0443"
  _description: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u043C\u043E\u0441\u0442, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0432\u0448\u0438\u0439
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E\r\n\u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u0441\u0442\u0430, \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445 XVI \u2013
    XVII \u0432\u0432. \u041E\u043D \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D
    \u043D\u0430\r\n\u0447\u0435\u0440\u0442\u0435\u0436\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1664 \u0433. \u041C\u043E\u0441\u0442 \u0438\u043C\u0435\u043B \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
    \u0417\u0430\u0432\u0438\u0442\u0435\u0431\u043D\u044B\u0439, \u0418\u0435\u0437\u0443\u0438\u0442\u0441\u043A\u0438\u0439,\r\n\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439,
    \u0420\u044B\u043D\u043A\u043E\u0432\u044B\u0439. \u041E\u043D \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u043B
    \u0412\u0437\u0433\u043E\u0440\u0441\u043A\u0438\u0439 \u0438 \u041D\u0438\u0436\u043D\u0438\u0439
    \u0437\u0430\u043C\u043A\u0438 \u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0431\u044B\u043B\r\n\u043F\u043E\u0434\u044A\u0435\u043C\u043D\u044B\u043C:
    \u0443\u0442\u0440\u043E\u043C \u043E\u043F\u0443\u0441\u043A\u0430\u043B\u0441\u044F
    \u0438 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0441\u044F,
    \u043A\u0440\u0435\u043F\u043A\u043E \u0437\u0430\u043F\u0438\u0440\u0430\u043B\u0441\u044F
    \u043D\u0430 \u0432\u0440\u0435\u043C\u044F\r\n\u0432\u043E\u0439\u043D\u044B.
    \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u043C\u043E\u0441\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\r\n\u0441\u043E\u0431\u043E\u0439
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E
    \u0441 \u043E\u043F\u043E\u0440\u0430\u043C\u0438 \u043D\u0430 \u0440\u044F\u0436\u0430\u0445
    (\u0433\u043E\u0440\u043E\u0434\u043D\u044F\u0445) \u0432 \u0440\u0443\u0441\u043B\u0435
    \u0412\u0438\u0442\u044C\u0431\u044B \u0438\r\n\u0441\u0432\u0430\u0439\u043D\u044B\u043C\u0438
    \u043E\u043F\u043E\u0440\u0430\u043C\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0430\u0445.
    \u0414\u043B\u0438\u043D\u0430 \u043C\u043E\u0441\u0442\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u043E\u043A\u043E\u043B\u043E 40 \u043C, \u0448\u0438\u0440\u0438\u043D\u0430
    \u2013 6 \u043C.\r\n\u041D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 \u043A\u043E\u043D\u0446\u0430
    XVIII \u0432. \u043C\u043E\u0441\u0442 \u0441\u0442\u0430\u043B \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F
    \u041A\u0440\u0430\u0441\u043D\u044B\u043C. \u0412 1811\u20131814 \u0433\u0433.
    \u043F\u043E\r\n\u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430 \u041F.\u0418.
    \u0421\u0443\u043C\u0430\u0440\u043E\u043A\u043E\u0432\u0430 \u0432\u043C\u0435\u0441\u0442\u043E
    \u043E\u0431\u0432\u0435\u0442\u0448\u0430\u0432\u0448\u0435\u0433\u043E, \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
    \u0434\u043B\u044F\r\n\u043F\u0440\u043E\u0435\u0437\u0434\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0433\u043E
    \u043C\u043E\u0441\u0442\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043C\u043E\u0441\u0442 \u2013
    \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439
    \u0432\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435. \u041E\u043D \u0438\u043C\u0435\u043B
    \u0442\u0440\u0438 \u0430\u0440\u043A\u0438, \u0434\u043B\u0438\u043D\u0430 \u043C\u043E\u0441\u0442\u0430
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430 \u043E\u043A\u043E\u043B\u043E
    64 \u043C, \u0448\u0438\u0440\u0438\u043D\u0430 12,8 \u043C.\r\n\u0412\u043E
    \u0432\u0440\u0435\u043C\u044F \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0441\u0442\u0430\u0440\u044B\u0439 \u0430\u0440\u043E\u0447\u043D\u044B\u0439
    \u043C\u043E\u0441\u0442 \u0431\u044B\u043B\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D,
    \u043D\u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435 \u0431\u044B\u043B
    \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u043C\u043E\u0441\u0442.
    \u041E\u043D \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\r\n\u0434\u043E
    1958 \u0433., \u043F\u043E\u043A\u0430 \u043D\u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435
    \u043D\u0435 \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D
    \u0436\u0435\u043B\u0435\u0437\u043E\u0431\u0435\u0442\u043E\u043D\u043D\u044B\u0439
    \u043C\u043E\u0441\u0442,\r\n\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0434\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438.
    \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u0438\u0439\xBB
    \u043C\u043E\u0441\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\r\n1973
    \u0433."
  _preview: {fileID: 21300000, guid: 6ec199aca19fdf64eaa288a4857fcf4a, type: 3}
  _images:
  - _title: "\u041C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437 \u0412\u0438\u0442\u044C\u0431\u0443
