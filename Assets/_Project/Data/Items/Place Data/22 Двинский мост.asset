  - _title: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u043C\u043E\u0441\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0440. \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u0443.
      1880-\u0435 - 1890-\u0435 \u0433\u0433. \u0424\u043E\u0442\u043E \u0421. \u042E\u0440\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E"
    _image: {fileID: 21300000, guid: 056f7f1747bbd534e8e2b9c514c8e5c7, type: 3}
