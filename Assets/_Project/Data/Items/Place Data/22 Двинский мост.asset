  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "22 \u0414\u0432\u0438\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u0441\u0442"
  m_EditorClassIdentifier: 
  _number: 22
  _name: "\u0414\u0432\u0438\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u0441\u0442"
  _description: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
    \u043C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437 \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u0443
    (\u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F; \u0441\u0435\u0439\u0447\u0430\u0441
    \u043D\u0430 \u0435\u0433\u043E\r\n\u043C\u0435\u0441\u0442\u0435 \u041A\u0438\u0440\u043E\u0432\u0441\u043A\u0438\u0439
    \u043C\u043E\u0441\u0442, \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0449\u0438\u0439
    \u0443\u043B. \u041A\u0438\u0440\u043E\u0432\u0430 \u0438 \u0417\u0430\u043C\u043A\u043E\u0432\u0443\u044E).\r\n\u0421
    \u0434\u0430\u0432\u043D\u0438\u0445 \u043F\u043E\u0440 \u0437\u0434\u0435\u0441\u044C,
    \u0432\u043E\u0437\u043B\u0435 \u0443\u0441\u0442\u044C\u044F \u0412\u0438\u0442\u044C\u0431\u044B,
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430,
    \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0432\u0448\u0430\u044F\r\n\u0431\u0435\u0440\u0435\u0433\u0430
    \u0440\u0435\u043A\u0438 (\u043C\u0435\u0436\u0434\u0443 \u043D\u044B\u043D\u0435\u0448\u043D\u0438\u043C\u0438
    \u0443\u043B\u0438\u0446\u0430\u043C\u0438 \u0422\u043E\u043B\u0441\u0442\u043E\u0433\u043E
    \u0438 \u042D\u043D\u0433\u0435\u043B\u044C\u0441\u0430). \u0412 XVIII\u2013XIX
    \u0432\u0432.\r\n\u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u0441\u0432\u0430\u0439\u043D\u044B\u0439 \u043C\u043E\u0441\u0442. \u0415\u0433\u043E
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438
    \u043A\u0430\u0436\u0434\u044B\u0439\r\n\u0433\u043E\u0434 \u043F\u043E\u0441\u043B\u0435
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u044F \u043B\u0435\u0434\u043E\u0445\u043E\u0434\u043E\u043C
    \u0438 \u043F\u0430\u0432\u043E\u0434\u043A\u043E\u043C.\r\n\u0412 1867 \u0433.
    \u0431\u044B\u043B \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
    \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043C\u043E\u0441\u0442 \u043D\u0430
    \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043E\u043F\u043E\u0440\u0430\u0445.
    \u041E\u043D\r\n\u0431\u044B\u043B \u043A\u0440\u0430\u0441\u043E\u0439 \u0438
    \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E \u0432\u0438\u0442\u0435\u0431\u043B\u044F\u043D,
    \u044F\u0432\u043B\u044F\u043B\u0441\u044F \u043E\u0434\u043D\u043E\u0439 \u0438\u0437
    \u0441\u0430\u043C\u044B\u0445 \u043B\u044E\u0431\u0438\u043C\u044B\u0445 \xAB\u043C\u043E\u0434\u0435\u043B\u0435\u0439\xBB\r\n\u0434\u043B\u044F
    \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432
    \u0441\u0432\u0435\u0442\u043E\u043F\u0438\u0441\u0438. \u0411\u0435\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0440\u0430\u0437
    \u043E\u043D\u0438\r\n\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u0435\u0433\u043E \u0430\u0436\u0443\u0440\u043D\u044B\u0435 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
    \u0432 \u0440\u0430\u0437\u043D\u044B\u0445 \u0440\u0430\u043A\u0443\u0440\u0441\u0430\u0445
    \u0438 \u0437\u0430\u0442\u0435\u043C\r\n\u0442\u0438\u0440\u0430\u0436\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043A\u0430\u0445 \u0438 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0430\u0445.
    \u041C\u043E\u0441\u0442 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D
    \u043F\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0443\r\n\u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0445
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u0432 \u042D\u043C\u043C\u0438
    \u0438 \u0413\u0440\u0438\u043D\u0430, \u0430 \u0435\u0433\u043E \u0430\u0440\u043E\u0447\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0431\u044B\u043B\u0430 \u043F\u043E\u0445\u043E\u0436\u0430
    \u043D\u0430\r\n\u043F\u0440\u043E\u0435\u043A\u0442 \u043C\u043E\u0441\u0442\u0430,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u0432
    1840 \u0433. \u043D\u0430 \u0421\u0435\u043D-\u0416\u0435\u0440\u043C\u0435\u043D\u0441\u043A\u043E\u0439
    \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439\r\n\u0434\u043E\u0440\u043E\u0433\u0435.
    \u041C\u043E\u0441\u0442 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \u0414\u0432\u0438\u043D\u0441\u043A\u0438\u0439.\r\n\u0412 1898 \u0433. \u043F\u043E
    \u043D\u0435\u043C\u0443 \u0431\u044B\u043B \u043F\u0443\u0449\u0435\u043D \u0442\u0440\u0430\u043C\u0432\u0430\u0439.
    \u0412 \u0438\u044E\u043B\u0435 1941 \u0433. \u043F\u0435\u0440\u0435\u0434 \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0435\u0439\r\n\u0433\u043E\u0440\u043E\u0434\u0430
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u043C\u0438
    \u0437\u0430\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u0430\u043C\u0438 \u043E\u0434\u0438\u043D
    \u043F\u0440\u043E\u043B\u0435\u0442 \u043C\u043E\u0441\u0442\u0430 \u0431\u044B\u043B
    \u0432\u0437\u043E\u0440\u0432\u0430\u043D \u043F\u043E\r\n\u043F\u0440\u0438\u043A\u0430\u0437\u0443
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0445 \u0432\u043B\u0430\u0441\u0442\u0435\u0439.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u043A\u043E\u0440\u0435 \u043D\u0435\u043C\u0446\u044B
    \u0435\u0433\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438,
    \u0432 \u0433\u043E\u0434\u044B\r\n\u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438
    \u043C\u043E\u0441\u0442 \u0431\u044B\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C.
    \u0412 \u0438\u044E\u043D\u0435 1944 \u0433. \u0432 \u0445\u043E\u0434\u0435
    \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\r\n\u043C\u043E\u0441\u0442
    \u0431\u044B\u043B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0432\u043E\u0439\u043D\u044B \u043D\u0430\u0447\u0430\u043B\u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043D\u043E\u0432\u044B\u0439 \u043C\u043E\u0441\u0442 (\u0430\u0432\u0442\u043E\u0440\u044B
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u044B
    \u041E.\r\n\u041B\u0430\u0434\u044B\u0433\u0438\u043D\u0430 \u0438 \u0415. \u0417\u0430\u0441\u043B\u0430\u0432\u0441\u043A\u0438\u0439).
    \u0415\u0433\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u043E\u0441\u044C \u0432
    \u0434\u043E\u043B\u0433\u043E\u0441\u0442\u0440\u043E\u0439, \u0447\u0430\u0441\u0442\u043E\r\n\u0432\u044B\u0441\u043C\u0435\u0438\u0432\u0430\u0435\u043C\u044B\u0439
    \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u0445 \u043C\u0435\u0441\u0442\u043D\u043E\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u043A\u0438. \u0422\u0430\u043A, \u0432
    \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u0442\u0430\u0442\u0435\u0439\r\n\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0441\u0440\u043E\u043A\u043E\u0432
    \u0441\u0434\u0430\u0447\u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u043E
    \u0443\u0436\u0435 \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0435\r\n\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430\u043C\u0438,
    \u0442.\u043A. \u0443 \u0432\u044A\u0435\u0437\u0434\u0430 \u043D\u0430 \u043C\u043E\u0441\u0442
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0443\u043B. \u041A\u0438\u0440\u043E\u0432\u0430
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430\r\n\u0441\u0442\u0438\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \xAB\u0443\u043B\u0438\u0442\u043A\u0430\xBB \u2013 \u0441\u0438\u043C\u0432\u043E\u043B
    \u043C\u0435\u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
    \u0420\u0430\u0431\u043E\u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432\r\n1955 \u0433. \u041D\u043E\u0432\u044B\u0439
    \u043C\u043E\u0441\u0442 \u0432 1973 \u0433. \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0438\u043C\u044F \u0421.\u041C. \u041A\u0438\u0440\u043E\u0432\u0430. \u0415\u0433\u043E
    \u0434\u043B\u0438\u043D\u0430 \u2013 236 \u043C\u0435\u0442\u0440\u043E\u0432.\r\n\u0412
    2004-2005 \u0433\u0433. \u0431\u044B\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0430
    \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
    \u041A\u0438\u0440\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u043C\u043E\u0441\u0442\u0430,
    \u0432 \u0445\u043E\u0434\u0435\r\n\u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0432 \u0447\u0438\u0441\u043B\u0435 \u043F\u0440\u043E\u0447\u0435\u0433\u043E
    \u0431\u044B\u043B\u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u044B
    \u0442\u0440\u043E\u0442\u0443\u0430\u0440\u044B, \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u043E
    \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0435\r\n\u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435.
    \u0412 2010 \u0433. \u043D\u0430 \u043C\u043E\u0441\u0442\u0443 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
    \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0430."
  _preview: {fileID: 21300000, guid: 078d33255d912434e8327bd4063192df, type: 3}
  _images:
  - _title: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043F\u0430\u0440\u043E\u0432\u043E\u0437\u0430
      \u043F\u043E \u043C\u043E\u0441\u0442\u0443 \u043D\u0430 \u0441\u0442\u0440\u043E\u044F\u0449\u0443\u044E\u0441\u044F
      \u0436\u0435\u043B\u0435\u0437\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0433\u0443
      \u041E\u0440\u0435\u043B - \u0412\u0438\u0442\u0435\u0431\u0441\u043A. 1867
      \u0433. \u0424\u043E\u0442\u043E \u0421. \u042E\u0440\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E"
