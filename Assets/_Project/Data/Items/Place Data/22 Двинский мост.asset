  - _title: "\u0414\u0432\u0438\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u0441\u0442.
      \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430 \u043A. XIX \u0432."
    _image: {fileID: 21300000, guid: 9e73744653c49a245aa54ccf0d16cdbd, type: 3}
  - _title: "\u0414\u0432\u0438\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u0441\u0442.
      \u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: be052810060001540b0dd5196b2add58, type: 3}
