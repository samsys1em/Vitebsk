  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "16 \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0439 \u0441\u0443\u0434"
  m_EditorClassIdentifier: 
  _number: 16
  _name: "\u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0439 \u0441\u0443\u0434"
  _description: "\u041E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0437\u0434\u0430\u043D\u0438\u0439 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u043D\u0430 \u0440\u0443\u0431\u0435\u0436\u0435
    XIX \u2212 \u0425\u0425\r\n\u0432\u0432. \u0431\u044B\u043B\u043E \u0437\u0434\u0430\u043D\u0438\u0435
    \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u0441\u0443\u0434\u0430
    (\u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0434\u0430\u043D\u0438\u0435 \u0425\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043C\u0443\u0437\u0435\u044F \u043D\u0430 \u043F\u043B.\r\n\u0421\u0432\u043E\u0431\u043E\u0434\u044B).
    \u041E\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 1880-\u0445 \u0433\u0433. \u043D\u0430
    \u043C\u0435\u0441\u0442\u0435 \u0434\u043E\u043C\u0430 \u043A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442\u0430\r\n(\u043F\u043E\u0437\u0434\u043D\u0435\u0435
    \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0432 \u0434\u043E\u043C \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430). \u0412 \u0441\u0432\u044F\u0437\u0438
    \u0441\r\n\u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u043E\u0439 \u043D\u043E\u0432\u043E\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u044F \u0431\u044B\u043B\u0430 \u0441\u043A\u043E\u043F\u0430\u043D\u0430
    \u0447\u0430\u0441\u0442\u044C \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439
    \u0433\u043E\u0440\u044B.\r\n\u0421\u0443\u0434 \u043D\u0430\u0447\u0430\u043B
    \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u0434\u0435\u043A\u0430\u0431\u0440\u0435
    1883 \u0433. \u041E\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u043B \u0438\u0437
    \u0434\u0432\u0443\u0445 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0439
    \u2212\r\n\u043F\u043E \u0443\u0433\u043E\u043B\u043E\u0432\u043D\u044B\u043C
    \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u043C \u0434\u0435\u043B\u0430\u043C.\r\n\u0421
    1898 \u043F\u043E 1904 \u0433\u0433. \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C\r\n\u043F\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043B\u044F
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E
    \u0441\u0443\u0434\u0430 \u0437\u0430\u043D\u0438\u043C\u0430\u043B \u0418\u0432\u0430\u043D
    \u0421\u043E\u043B\u043B\u0435\u0440\u0442\u0438\u043D\u0441\u043A\u0438\u0439
    \u2212 \u043E\u0442\u0435\u0446\r\n\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u043C\u0443\u0437\u044B\u043A\u043E\u0432\u0435\u0434\u0430, \u0443\u0440\u043E\u0436\u0435\u043D\u0446\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u0418\u0432\u0430\u043D\u0430
    \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447\u0430 \u0421\u043E\u043B\u043B\u0435\u0440\u0442\u0438\u043D\u0441\u043A\u043E\u0433\u043E.\r\n\u0412
    \u0434\u0435\u043A\u0430\u0431\u0440\u0435 1917 \u0433. \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0439
    \u0441\u0443\u0434 \u0431\u044B\u043B \u043B\u0438\u043A\u0432\u0438\u0434\u0438\u0440\u043E\u0432\u0430\u043D.
    \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435\r\n\u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
    \u043B\u0435\u0442 \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u043A\u0430\u043A \u0414\u0432\u043E\u0440\u0435\u0446
    \u0442\u0440\u0443\u0434\u0430. \u041A\u043E\u043C\u043D\u0430\u0442\u044B \u0432
    \u043D\u0435\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438\r\n\u0440\u0430\u0437\u043D\u044B\u0435
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438:
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0432\u0435\u0442
    \u043F\u0440\u043E\u0444\u0441\u043E\u044E\u0437\u043E\u0432, \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439\r\n\u043A\u043E\u043C\u0438\u0442\u0435\u0442
    \u041C\u041E\u041F\u0420 (\u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0439
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u043F\u043E\u043C\u043E\u0449\u0438
    \u0431\u043E\u0440\u0446\u0430\u043C \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438),\r\n\u0440\u0430\u0434\u0438\u043E\u0443\u0437\u0435\u043B,
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u0438\u0442\u0435\u0442
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \xAB\u0414\u0440\u0443\u0437\u044C\u044F
    \u0434\u0435\u0442\u0435\u0439\xBB, \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u044F
    \u0433\u0430\u0437\u0435\u0442\u044B\r\n\xAB\u0412\u0456\u0446\u0435\u0431\u0441\u043A\u0456
    \u043F\u0440\u0430\u043B\u0435\u0442\u0430\u0440\u044B\u0439\xBB, \u0414\u043E\u043C
    \u043F\u0430\u0440\u0442\u0438\u0439\u043D\u043E\u0433\u043E \u0430\u043A\u0442\u0438\u0432\u0430
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435.\r\n\u0410\u043A\u0442\u043E\u0432\u044B\u0439
    \u0437\u0430\u043B \u0414\u0432\u043E\u0440\u0446\u0430 \u0442\u0440\u0443\u0434\u0430
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043E\u0431\u0449\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445\r\n\u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0439,
    \u043B\u0435\u043A\u0446\u0438\u0439, \u0434\u0438\u0441\u043F\u0443\u0442\u043E\u0432.
    \u0412 1918-\u043C \u2212 \u043D\u0430\u0447\u0430\u043B\u0435 1920-\u0445 \u0433\u0433.
    \u0437\u0434\u0435\u0441\u044C \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043B\u0438\r\n\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438
    \u041C\u0430\u0440\u043A \u0428\u0430\u0433\u0430\u043B, \u041A\u0430\u0437\u0438\u043C\u0438\u0440
    \u041C\u0430\u043B\u0435\u0432\u0438\u0447, \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440
    \u0420\u043E\u043C\u043C, \u0421\u043E\u043B\u043E\u043C\u043E\u043D\r\n\u042E\u0434\u043E\u0432\u0438\u043D,
    \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043E\u0432\u0435\u0434
    \u041B\u0435\u0432 \u041F\u0443\u043C\u043F\u044F\u043D\u0441\u043A\u0438\u0439,
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444 \u041C\u0438\u0445\u0430\u0438\u043B
    \u0411\u0430\u0445\u0442\u0438\u043D \u0438 \u043C\u043D\u043E\u0433\u0438\u0435\r\n\u0434\u0440\u0443\u0433\u0438\u0435.\r\n\u0412
    1938 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u043B
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442 \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439\r\n\u043F\u0430\u0440\u0442\u0438\u0438.
    \u0412 \u0433\u043E\u0434\u044B \u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0439
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438 \u0437\u0434\u0435\u0441\u044C
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C \u0444\u0440\u043E\u043D\u0442\u043E\u0432\u043E\u0439\r\n\u0442\u0435\u0430\u0442\u0440,
    \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u044C \u0438 \u043A\u0430\u0437\u0430\u0440\u043C\u0430
    \u0434\u043B\u044F \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445 \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445.
    \u0412 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435\r\n\u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u0441\u0443\u0434\u0430
    \u0432\u043D\u043E\u0432\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u043E\u0431\u043A\u043E\u043C \u041A\u041F\u0411.\r\n\u041A\u0440\u043E\u043C\u0435
    \u0442\u043E\u0433\u043E, \u0434\u043E \u043D\u0430\u0447\u0430\u043B\u0430 1990-\u0445
    \u0433\u0433. \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F
    \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439 \u043A\u043E\u043C\u0438\u0442\u0435\u0442
    \u041B\u041A\u0421\u041C\u0411.\r\n\u0412 1992 \u0433. \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438
    \u0425\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443
    \u043C\u0443\u0437\u0435\u044E \u2013 \u0444\u0438\u043B\u0438\u0430\u043B\u0443\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0433\u043E \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0443\u0437\u0435\u044F. \u0412 \u0435\u0433\u043E \u044D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B\r\n\u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438, \u0433\u0440\u0430\u0444\u0438\u043A\u0438,
    \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u044B, \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E-\u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0433\u043E\r\n\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430
    XVIII \u2212 \u043D\u0430\u0447\u0430\u043B\u0430 XXI \u0432\u0432."
