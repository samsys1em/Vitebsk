  - _title: "\u041F\u043B. \u0421\u0432\u043E\u0431\u043E\u0434\u044B \u0438 \u0437\u0434\u0430\u043D\u0438\u0435
      \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u0441\u0443\u0434\u0430.
      1-\u044F \u0433\u043E\u0434\u043E\u0432\u0449\u0438\u043D\u0430 \u043E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0439
      \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438. 1918 \u0433."
