  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "37. 1-\u0435 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0435 4-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  m_EditorClassIdentifier: 
  _number: 37
  _name: "1-\u0435 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0435 4-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  _description: "\u0423\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u043E \u0432 1897
    \u0433. \u043F\u0443\u0442\u0435\u043C \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438\u0437\r\n\u0443\u0435\u0437\u0434\u043D\u043E\u0433\u043E 2-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u0433\u043E
    \u0443\u0447\u0438\u043B\u0438\u0449\u0430. \u0420\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u043E\u0441\u044C
    \u0432 3-\u044D\u0442\u0430\u0436\u043D\u043E\u043C \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u043E\u043C
    \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u043F\u043E \u0413\u043E\u0433\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u0435 (\u0441\u0435\u0439\u0447\u0430\u0441 \u0443\u043B.
    \u041B\u0435\u043D\u0438\u043D\u0430, 24). \u0423\u0447\u0438\u043B\u0438\u0449\u0435
    \u0434\u0430\u0432\u0430\u043B\u043E \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435\r\n\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435.
    \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0437\u0434\u0435\u0441\u044C
    \u0431\u044B\u043B \u043E\u0442\u043A\u0440\u044B\u0442 \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u044B\u0439
    \u043A\u043B\u0430\u0441\u0441 \u0441 \u043A\u0443\u0437\u043D\u0435\u0447\u043D\u043E-\r\n\u0441\u043B\u0435\u0441\u0430\u0440\u043D\u044B\u043C
    \u0438 \u0441\u0442\u043E\u043B\u044F\u0440\u043D\u043E-\u0442\u043E\u043A\u0430\u0440\u043D\u044B\u043C
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F\u043C\u0438, \u0433\u0434\u0435
    \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0435 \u043C\u043E\u0433\u043B\u0438
    \u043E\u0441\u0432\u043E\u0438\u0442\u044C\r\n\u0430\u0437\u044B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430. \u0425\u043E\u0442\u044F
    \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u043E\u0441\u044C \u0443\u0447\u0438\u043B\u0438\u0449\u0435
    4-\u043A\u043B\u0430\u0441\u0441\u043D\u044B\u043C,\r\n\u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0432 \u043D\u0435\u043C \u0434\u043B\u0438\u043B\u043E\u0441\u044C
    6 \u043B\u0435\u0442 \u2013 \u0432 \u043F\u0435\u0440\u0432\u044B\u0445 \u0434\u0432\u0443\u0445
    \u043A\u043B\u0430\u0441\u0441\u0430\u0445 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0438\r\n\u0443\u0447\u0438\u043B\u0438\u0441\u044C
    \u043F\u043E \u0434\u0432\u0430 \u0433\u043E\u0434\u0430.\r\n\u0412 1918 \u0433.
    \u0432 \u044D\u0442\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u044B\u043B\u0430
    \u043E\u0442\u043A\u0440\u044B\u0442\u0430 1-\u044F \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F
    \u0442\u0440\u0443\u0434\u043E\u0432\u0430\u044F \u0448\u043A\u043E\u043B\u0430
    2-\u0439\r\n\u0441\u0442\u0443\u043F\u0435\u043D\u0438, \u043F\u043E\u0437\u0436\u0435
    \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0432 \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0448\u043A\u043E\u043B\u0443
    \u2116 1 \u042D\u0442\u043E \u0443\u0447\u0435\u0431\u043D\u043E\u0435\r\n\u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u043E\u0441\u044C \u0437\u0434\u0435\u0441\u044C
    \u0434\u043E 1968 \u0433. \u0417\u0430\u0442\u0435\u043C \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043E\u0434\u043D\u0430 \u0438\u0437\r\n\u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0445
    \u0448\u043A\u043E\u043B, \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0432\u0440\u0435\u043C\u044F \u2013 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0446\u0435\u043D\u0442\u0440\r\n\u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0434\u0435\u0442\u0435\u0439
    \u0438 \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438.\r\n\u041D\u0430 \u0437\u0434\u0430\u043D\u0438\u0438
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0430 \u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0434\u043E\u0441\u043A\u0430, \u0441\u043E\u043E\u0431\u0449\u0430\u044E\u0449\u0430\u044F
    \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\r\n1900-1904 \u0433\u0433.
    \u0432 1-\u043C \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C 4-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u043C
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435 \u0443\u0447\u0438\u043B\u0441\u044F
    \u0441\u0443\u043B\u044C\u043F\u0442\u043E\u0440 \u041E\u0441\u0438\u043F\r\n\u0426\u0430\u0434\u043A\u0438\u043D,
    \u0432 1900-1905 \u0433\u0433. \u2013 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
    \u041C\u0430\u0440\u043A \u0428\u0430\u0433\u0430\u043B."
  _preview: {fileID: 21300000, guid: 885f9cf8f2efbf64ca60a441dcd4093c, type: 3}
  _images:
  - _title: "\u0413\u043E\u0433\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F \u0443\u043B\u0438\u0446\u0430.
      \u0421\u043B\u0435\u0432\u0430 - \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
      1-\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E
      4-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u0433\u043E \u0443\u0447\u0438\u043B\u0438\u0449\u0430.
      1941-1944 \u0433\u0433."
