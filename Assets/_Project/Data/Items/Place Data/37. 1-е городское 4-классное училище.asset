  - _title: "\u0417\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
      1-\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E
      4-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u0433\u043E \u0443\u0447\u0438\u043B\u0438\u0449\u0430.
      2017 \u0433. \u0424\u043E\u0442\u043E \u0418. \u0413\u0443\u0441\u0430\u043A\u043E\u0432\u0430"
