  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "17 \u0444\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u0435\u043B"
  m_EditorClassIdentifier: 
  _number: 17
  _name: "\u0444\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u0435\u043B"
  _description: "\u041D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0444\u0430\u0440\u043D\u044B\u0445 \u043A\u043E\u0441\u0442\u0435\u043B\u043E\u0432\r\n\u2013
    \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0445\u0440\u0430\u043C\u043E\u0432,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u043A\u0430\u043A
    \u043F\u0440\u0438\u0445\u043E\u0434\u0441\u043A\u0438\u0435, \u043D\u0435 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0432\u0448\u0438\u0435\r\n\u043A\u0430\u043A\u043E\u043C\u0443-\u043B\u0438\u0431\u043E
    \u043C\u043E\u043D\u0430\u0448\u0435\u0441\u043A\u043E\u043C\u0443 \u043E\u0440\u0434\u0435\u043D\u0443.
    \u0411\u044B\u043B \u0442\u0430\u043A\u043E\u0439 \u043A\u043E\u0441\u0442\u0435\u043B
    \u0438 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435. \u041D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F\r\n\u0445\u0440\u0430\u043C
    \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438, \u043A \u0441\u0435\u0432\u0435\u0440\u0443
    \u043E\u0442 \u043D\u0435\u0435. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E\r\n\u0444\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u0435\u043B
    \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B \u0431\u044B\u043B \u0441\u0430\u043C\u044B\u043C
    \u0441\u0442\u0430\u0440\u044B\u043C \u0440\u0438\u043C\u0441\u043A\u043E-\u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043A\u043E\u0441\u0442\u0435\u043B\u043E\u043C\r\n\u0432 \u0433\u043E\u0440\u043E\u0434\u0435.
    \u041A\u043E\u0433\u0434\u0430 \u043E\u043D \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D
    \u2013 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
    \u041F\u043E \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0432\u0435\u0440\u0441\u0438\u0439,\r\n\u0444\u0430\u0440\u0430
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430
    \u043A\u043D\u044F\u0437\u0435\u043C \u0412\u0438\u0442\u043E\u0432\u0442\u043E\u043C
    \u0432 XIV \u0432\u0435\u043A\u0435. \u0421\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C\r\n\u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B,
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
    \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0432 1503 \u0433\u043E\u0434\u0443
    \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043A\u043D\u044F\u0437\u044C \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u0439\r\n\u0438
    \u043A\u043E\u0440\u043E\u043B\u044C \u043F\u043E\u043B\u044C\u0441\u043A\u0438\u0439
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u042F\u0433\u0435\u043B\u043B\u043E\u043D\u0447\u0438\u043A
    \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0433\u0438\u0438
    \u044D\u0442\u043E\u043C\u0443\r\n\u043A\u043E\u0441\u0442\u0435\u043B\u0443,
    \xAB\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u043C\u0443 \u0438
    \u043E\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u043E\u043C\u0443
    \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u043A\u0430\u043C\u0438, \u0432\u0435\u043B\u0438\u043A\u0438\u043C\u0438
    \u043A\u043D\u044F\u0437\u044C\u044F\u043C\u0438\r\n\u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u043C\u0438\xBB.
    \u0418\u0437\u0432\u0435\u0441\u0442\u043D\u043E, \u0447\u0442\u043E \u043F\u043E\u0441\u0435\u043B\u0438\u0432\u0448\u0438\u0435\u0441\u044F
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0432 \u043A\u043E\u043D\u0446\u0435
    1630-\u0445 \u0433\u043E\u0434\u043E\u0432\r\n\u0438\u0435\u0437\u0443\u0438\u0442\u044B
    \u0434\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430 (\u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043F\u043B.\r\n\u0421\u0432\u043E\u0431\u043E\u0434\u044B)
    \u0441\u043B\u0443\u0436\u0438\u043B\u0438 \u043F\u0440\u0438 \u0444\u0430\u0440\u043D\u043E\u043C
    \u043A\u043E\u0441\u0442\u0451\u043B\u0435. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u043E\r\n\u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C,
    \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 XVIII \u0432\u0435\u043A\u0430
    (?) \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430\r\n\u0432 \u0441\u0442\u0438\u043B\u0435
    \u0431\u0430\u0440\u043E\u043A\u043A\u043E. \u0412\u043E 2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    XIX \u0432\u0435\u043A\u0430 \u0444\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u0435\u043B
    \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B \u0431\u044B\u043B\r\n\u043F\u0435\u0440\u0435\u0434\u0430\u043D
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E \u043C\u0430\u0440\u0438\u0430\u0432\u0438\u0442\u043E\u043A,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u043C\u0443 \u0432 1749
    \u0433\u043E\u0434\u0443. \u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C\r\n\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u0435\u0435 100 \u043B\u0435\u0442,
    \u043A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 1860-\u0445 \u0433\u043E\u0434\u043E\u0432
    \u043F\u0440\u0438\u0448\u0435\u043B \u0432 \u0443\u043F\u0430\u0434\u043E\u043A.\r\n\u041A\u043E\u0441\u0442\u0435\u043B
    \u0431\u044B\u043B \u0437\u0430\u043A\u0440\u044B\u0442 \u0432 1842\u20131844
    \u0433\u043E\u0434\u0430\u0445 \u043F\u043E \u043F\u0440\u0438\u0447\u0438\u043D\u0435
    \u0435\u0433\u043E \u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438 \u043A \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0439\r\n\u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u043E,
    \u0431\u0430\u0448\u043D\u0438\r\n\u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043D\u044B.
    \u0412 1862 \u0433\u043E\u0434\u0443 \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0430\u0440\u0445\u0438\u0432
    \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u0430\u043A\u0442\u043E\u0432,\r\n\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0432 1852 \u0433\u043E\u0434\u0443 \u0441 \u0446\u0435\u043B\u044C\u044E \u0441\u0431\u043E\u0440\u0430
    \u0438 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432
    \u0430\u043A\u0442\u043E\u0432\u044B\u0445 \u043A\u043D\u0438\u0433\r\n\u0441\u0443\u0434\u0435\u0431\u043D\u044B\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439 \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u043A\u043D\u044F\u0436\u0435\u0441\u0442\u0432\u0430 \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E
    \u0437\u0430 \u043F\u0435\u0440\u0438\u043E\u0434 \u0441 XVI \u0434\u043E\r\n\u043A\u043E\u043D\u0446\u0430
    XVIII \u0432\u0435\u043A\u0430 \u043F\u043E \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438,
    \u043D\u0430\u0445\u043E\u0434\u0438\u0432\u0448\u0435\u0439\u0441\u044F \u0432
    \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439,\r\n\u041C\u043E\u0433\u0438\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0438 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0439
    \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439 \u0438\u043C\u043F\u0435\u0440\u0438\u0438.
    \u042D\u0442\u043E \u0431\u044B\u043B \u043F\u0435\u0440\u0432\u044B\u0439\r\n\u0446\u0435\u043D\u0442\u0440\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439\r\n\u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439\r\n\u0430\u0440\u0445\u0438\u0432
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439\r\n\u0420\u0435\u0441\u043F\u0443\u0431\u043B\u0438\u043A\u0438
    \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u044C. \u0412\u0430\u0436\u043D\u044B\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0430\u0440\u0445\u0438\u0432\u0430 \u0431\u044B\u043B\u0430\r\n\u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044F
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432. \u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
    50 \u043B\u0435\u0442 \u0431\u044B\u043B\u043E \u0432\u044B\u043F\u0443\u0449\u0435\u043D\u043E
    32 \u0442\u043E\u043C\u0430 \xAB\u0418\u0441\u0442\u043E\u0440\u0438\u043A\u043E-\r\n\u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432\xBB \u2013 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
    XVI\u2013XVIII \u0432\u0435\u043A\u043E\u0432, \u0438\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u043D\u044B\u0435
    \u0438\u0437\r\n\u0430\u043A\u0442\u043E\u0432\u044B\u0445 \u043A\u043D\u0438\u0433
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439 \u0438 \u041C\u043E\u0433\u0438\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0439. \u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0431\u044B\u043B\u0438\r\n\u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u044B
    \u0432 \u0441\u0431\u043E\u0440\u043D\u0438\u043A\u0435 \xAB\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F
    \u0441\u0442\u0430\u0440\u0438\u043D\u0430\xBB, \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u043C
    \u043A \u043F\u0435\u0447\u0430\u0442\u0438 \u0438\r\n\u0438\u0437\u0434\u0430\u043D\u043D\u044B\u043C
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u043E\u043C
    \u0410.\u041F. \u0421\u0430\u043F\u0443\u043D\u043E\u0432\u044B\u043C. \u0421
    1 \u044F\u043D\u0432\u0430\u0440\u044F 1903 \u0433\u043E\u0434\u0430\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0430\u0440\u0445\u0438\u0432
    \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u0430\u043A\u0442\u043E\u0432 \u0431\u044B\u043B
    \u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D, \u0432\u0441\u0435 \u0435\u0433\u043E
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B\r\n\u0431\u044B\u043B\u0438
    \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u044B \u0432 \u0412\u0438\u043B\u0435\u043D\u0441\u043A\u0438\u0439
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0430\u0440\u0445\u0438\u0432
    \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u0430\u043A\u0442\u043E\u0432. \u0417\u0434\u0430\u043D\u0438\u0435
    \u0444\u0430\u0440\u043D\u043E\u0433\u043E\r\n\u043A\u043E\u0441\u0442\u0435\u043B\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E \u0434\u043E
    \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B \u0425\u0425 \u0432\u0435\u043A\u0430.
    \u041E\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E
    \u0432 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E \u0432 1950-\u0445 \u0433\u043E\u0434\u0430\u0445."
