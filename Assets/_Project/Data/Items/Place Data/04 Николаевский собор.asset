  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "04 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440"
  m_EditorClassIdentifier: 
  _number: 4
  _name: "\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440 \u0438 \u0430\u0440\u0445\u0438\u0435\u0440\u0435\u0439\u0441\u043A\u0438\u0439
    \u0434\u043E\u043C"
  _description: "\u041D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u043D\u044B\u043D\u0435\u0448\u043D\u0435\u0439 \u043F\u043B. \u0421\u0432\u043E\u0431\u043E\u0434\u044B
    \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C \u0440\u044B\u043D\u043E\u043A\r\n\u0438
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0421\u0432\u044F\u0442\u043E\u0439 \u041F\u0430\u0440\u0430\u0441\u043A\u0435\u0432\u044B
    \u041F\u044F\u0442\u043D\u0438\u0446\u044B. \u041A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    XVII \u0432.\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C. \u042D\u0442\u043E\u0442
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0437\u0435\u043C\u043B\u0438 \u0431\u044B\u043B
    \u0432\u044B\u0434\u0435\u043B\u0435\u043D \u0438\u0435\u0437\u0443\u0438\u0442\u0430\u043C.\r\n\u041A
    1650 \u0433. \u043E\u043D\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435 \u0437\u0434\u0430\u043D\u0438\u044F
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430 (\u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E
    \u0443\u0447\u0435\u0431\u043D\u043E\u0433\u043E\r\n\u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F)
    \u0438 \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u0421\u0432\u044F\u0442\u043E\u0433\u043E
    \u0418\u043E\u0441\u0438\u0444\u0430.\r\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0440\u0443\u0441\u0441\u043A\u043E-\u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 1654\u22121667 \u0433\u0433., \u043A\u043E\u0433\u0434\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B\u0438\r\n\u0440\u0443\u0441\u0441\u043A\u0438\u0435
    \u0432\u043E\u0439\u0441\u043A\u0430, \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043A\u0438\u0435
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C \u0438 \u043A\u043E\u0441\u0442\u0435\u043B
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438 \u0432 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439\r\n\u0410\u043B\u0435\u043A\u0441\u0435\u0435\u0432\u0441\u043A\u0438\u0439
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C. \u0415\u0433\u043E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430
    \xAB\u0427\u0435\u0440\u0442\u0435\u0436\u0435\xBB\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1664 \u0433\u043E\u0434\u0430.\r\n\u041A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    XVIII \u0432. \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445
    \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F \u043A\u043E\u0441\u0442\u0435\u043B\u0430\r\n\u0421\u0432\u044F\u0442\u043E\u0433\u043E
    \u0418\u043E\u0441\u0438\u0444\u0430 (1716\u22121731 \u0433\u0433.) \u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430
    (\u043A 1755 \u0433.). \u041C\u0435\u0446\u0435\u043D\u0430\u0442\u043E\u043C\r\n\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0431\u044B\u043B \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u043A\u0430\u0448\u0442\u0435\u043B\u044F\u043D
    \u041C\u0430\u0440\u0446\u0438\u0430\u043D \u041C\u0438\u0445\u0430\u043B \u041E\u0433\u0438\u043D\u0441\u043A\u0438\u0439.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0443\u043A\u0430\u0437\u0430 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430
    I \u043E \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u0438\u0438 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0438\u0435\u0437\u0443\u0438\u0442\u043E\u0432 \u0432 \u0420\u043E\u0441\u0441\u0438\u0438\r\n(1820
    \u0433.) \u0437\u0434\u0430\u043D\u0438\u044F \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430
    \u0431\u044B\u043B\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u044B \u0431\u0430\u0437\u0438\u043B\u0438\u0430\u043D\u0430\u043C,
    \u0430 \u0432 1839 \u0433. \u043F\u0435\u0440\u0435\u0448\u043B\u0438\r\n\u0432
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0435 \u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u043E.
    \u0412 \u0436\u0438\u043B\u043E\u043C \u043A\u043E\u0440\u043F\u0443\u0441\u0435
    \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438\u0441\u044C
    \u0430\u0440\u0445\u0438\u0435\u0440\u0435\u0439\u0441\u043A\u0438\u0439 \u0434\u043E\u043C
    (\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0446\u0438\u044F \u0430\u0440\u0445\u0438\u0435\u043F\u0438\u0441\u043A\u043E\u043F\u0430)
    \u0438 \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u043E\u0440\u0438\u044F\r\n(\u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F
    \u0438 \u0435\u043F\u0430\u0440\u0445\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u0439 \u0441\u0443\u0434). \u041A\u043E\u0441\u0442\u0435\u043B
    \u0438\u0435\u0437\u0443\u0438\u0442\u043E\u0432 \u0432 1843 \u0433. \u0431\u044B\u043B\r\n\u043E\u0441\u0432\u044F\u0449\u0435\u043D
    \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439
    \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440.
    \u0412 1872 \u0433. \u0431\u0430\u0440\u043E\u0447\u043D\u044B\u0439 \u0445\u0440\u0430\u043C\r\n\u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0441\u044F
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u0440\u0435\u043C\u043E\u043D\u0442\u0443,
    \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\r\n\u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F
    \u0435\u0433\u043E \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0432\u0438\u0434.\r\n\u0425\u0440\u0430\u043C
    \u0437\u0430\u043D\u0438\u043C\u0430\u043B \u0432\u0430\u0436\u043D\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E \u0432 \u0436\u0438\u0437\u043D\u0438 \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0439
    \u0435\u043F\u0430\u0440\u0445\u0438\u0438, \u0441\u0442\u0430\u043B \u043E\u0434\u043D\u0438\u043C\r\n\u0438\u0437
    \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435.
    \u0417\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
    \u0441\u043B\u0443\u0436\u0431\u044B \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441
    \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435\r\n\u0432\u0430\u0436\u043D\u044B\u043C\u0438
    \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438, \u0437\u043D\u0430\u043C\u0435\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u0434\u0430\u0442\u0430\u043C\u0438 \u2212 \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0432 \u0434\u0435\u043D\u044C \u043F\u0443\u0441\u043A\u0430\r\n\u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0442\u0440\u0430\u043C\u0432\u0430\u044F 18 \u0438\u044E\u043D\u044F 1898 \u0433.,
    \u0432 \u0434\u0435\u043D\u044C \u043A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u0438
    \u041D\u0438\u043A\u043E\u043B\u0430\u044F II \u0432 \u043C\u0430\u0435 1896
    \u0433.\r\n\u0412 1915 \u0433. \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u0438\u0437\u0438\u0442\u0430
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440
    \u043B\u0438\u0447\u043D\u043E \u043F\u043E\u0441\u0435\u0442\u0438\u043B \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439\r\n\u0441\u043E\u0431\u043E\u0440.
    \u041F\u043B\u043E\u0449\u0430\u0434\u044C, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u0445\u0440\u0430\u043C,
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \xAB\u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F\xBB.\r\n\u0421 1887 \u043F\u043E
    1917 \u0433\u0433. \u043F\u0440\u0438 \u0441\u043E\u0431\u043E\u0440\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0435\u043F\u0430\u0440\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0421\u0432\u044F\u0442\u043E-\r\n\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u0441\u043A\u043E\u0435
    \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u043E \u2212 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F, \u0446\u0435\u043B\u044C\u044E
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u044F\u0432\u043B\u044F\u043B\u043E\u0441\u044C\r\n\u0434\u0443\u0445\u043E\u0432\u043D\u043E-\u043D\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u043F\u0440\u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u0438 \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
    \u0412 1895 \u0433. \u043D\u0430\r\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0430 \u0438 \u043F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0430 \u0410\u043B\u0435\u043A\u0441\u0435\u044F
    \u0421\u0430\u043F\u0443\u043D\u043E\u0432\u0430 \u0438 \u044D\u0442\u043D\u043E\u0433\u0440\u0430\u0444\u0430\r\n\u0415\u0432\u0434\u043E\u043A\u0438\u043C\u0430
    \u0420\u043E\u043C\u0430\u043D\u043E\u0432\u0430\r\n\u0432 \u0430\u0440\u0445\u0438\u0435\u0440\u0435\u0439\u0441\u043A\u043E\u043C
    \u0434\u043E\u043C\u0435 \u0431\u044B\u043B\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E
    \u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E-\r\n\u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0434\u0440\u0435\u0432\u043B\u0435\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
    (\u043C\u0443\u0437\u0435\u0439). \u0412 \u043D\u0435\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E\u0439
    \u0441\u0442\u0430\u0440\u0438\u043D\u044B \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0439
    \u0435\u043F\u0430\u0440\u0445\u0438\u0438 \u2212 \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u0438\u0435,
    \u0441\u0442\u0430\u0440\u043E\u043E\u0431\u0440\u044F\u0434\u0447\u0435\u0441\u043A\u0438\u0435,\r\n\u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0435\r\n\u0438\u043A\u043E\u043D\u044B,\r\n\u043F\u043B\u0430\u0449\u0430\u043D\u0438\u0446\u044B,\r\n\u0441\u043A\u043B\u0430\u0434\u043D\u0438,\r\n\u0441\u043E\u0441\u0443\u0434\u044B,\r\n\u043E\u0434\u0435\u0436\u0434\u0430\r\n\u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0438\u0442\u0435\u043B\u0435\u0439,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B,
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u043D\u0443\u043C\u0438\u0437\u043C\u0430\u0442\u0438\u043A\u0438.\r\n\u0412
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435\r\n\u0432\u0440\u0435\u043C\u044F\r\n\u0447\u0430\u0441\u0442\u044C\r\n\u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E-\u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E\r\n\u0434\u0440\u0435\u0432\u043B\u0435\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430
    \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F \u0432 \u0444\u043E\u043D\u0434\u0430\u0445
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0447\u0435\u0441\u043A\u043E\u0433\u043E\r\n\u043C\u0443\u0437\u0435\u044F.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F\r\n\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C,
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430 \u043E\u0431\u0440\u0435\u043B\u0438
    \u043D\u043E\u0432\u044B\u0445 \u0445\u043E\u0437\u044F\u0435\u0432: \u0441\u043D\u0430\u0447\u0430\u043B\u0430\r\n\u0437\u0434\u0435\u0441\u044C
    \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0439 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u0442\u0440\u0438\u0431\u0443\u043D\u0430\u043B, \u043F\u043E\u0437\u0436\u0435
    \u2212\r\n\u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C. \u0412 \u0433\u043E\u0434\u044B
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0439
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438\r\n\u0432 \u0431\u044B\u0432\u0448\u0435\u043C
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0435 \u0431\u044B\u043B\u043E
    \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u043E \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0435
    \u0434\u043B\u044F \u043D\u0435\u043C\u0446\u0435\u0432. \u0412\u043E \u0434\u0432\u043E\u0440\u0435
    \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0431\u043E\u0440\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435,
    \u043D\u043E \u0441\u0430\u043C \u0445\u0440\u0430\u043C\r\n\u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u043F\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E\r\n\u041F\u043E\u0441\u043B\u0435
    \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0432
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430 \u0432\u043D\u043E\u0432\u044C\r\n\u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
    \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C, \u0432 1966 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E \u0441\u043D\u0435\u0441\u0435\u043D\u043E.\r\n\u041D\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F \u0434\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438 \u0441\u043E\u0431\u043E\u0440.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435\r\n\u0432\u0440\u0435\u043C\u044F
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u043A\u0430\u043A \u0441\u043A\u043B\u0430\u0434 \u043E\u0442\u0434\u0435\u043B\u0430
    \u0441\u043E\u0446\u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F.
    \u0412 \u0430\u043F\u0440\u0435\u043B\u0435 1957\r\n\u0433. \u0445\u0440\u0430\u043C
    \u0431\u044B\u043B \u0432\u0437\u043E\u0440\u0432\u0430\u043D \u0432\u0432\u0438\u0434\u0443
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \xAB\u2026 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u0435\u0433\u043E \u0442\u0430\u043A\u043E\u0432\u043E, \u0447\u0442\u043E \u043D\u0435
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442\r\n\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
    \u0434\u043B\u044F \u043A\u0430\u043A\u0438\u0445-\u043B\u0438\u0431\u043E \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0446\u0435\u043B\u0435\u0439, \u0430 \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438\r\n\u0441
    \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u043A\u0438
    \u0433\u043E\u0440\u043E\u0434\u0430 \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442
    \u0441\u043D\u043E\u0441\u0443 \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F
    \u0443\u043B\u0438\u0446\u044B\r\n\u0438 \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\xBB."
