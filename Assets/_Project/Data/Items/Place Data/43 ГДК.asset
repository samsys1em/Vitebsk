  m_Name: "43 \u0413\u0414\u041A"
  m_EditorClassIdentifier: 
  _number: 43
  _name: "\u0413\u0414\u041A"
  _description: "\u041D\u0430 \u043A\u0430\u0440\u0442\u0430\u0445 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u043D\u0430\u0447\u0430\u043B\u0430 XX \u0432. \u0437\u0434\u0430\u043D\u0438\u0435
    \u043D\u0430 \u0443\u0433\u043B\u0443 \u0443\u043B\u0438\u0446 \u0411\u0438\u0440\u0436\u0435\u0432\u043E\u0439
    \u0438 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439 (\u043D\u044B\u043D\u0435
    - \u0443\u043B.\r\n\u041C\u0430\u044F\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E,1
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0413\u0414\u041A) \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043E
    \u043A\u0430\u043A \u0412\u0442\u043E\u0440\u043E\u0435 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435. \u041E\u043D\u043E \u0431\u044B\u043B\u043E\r\n\u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E,
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u0432 \u043A\u043E\u043D\u0446\u0435
    XVIII \u2014 \u043D\u0430\u0447\u0430\u043B\u0435 XIX \u0432\u0432. \u0410\u043A\u0432\u0430\u0440\u0435\u043B\u0438
    \u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430
    \u0418\u043E\u0441\u0438\u0444\u0430\r\n\u041F\u0435\u0448\u043A\u0438 (1767-1831)
    \u0434\u0430\u044E\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u044D\u0442\u043E \u0437\u0434\u0430\u043D\u0438\u0435
    \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
    XIX \u0432. \u2014 \u043E\u043D\u043E\r\n\u0431\u044B\u043B\u043E \u0442\u0440\u0435\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u043C,
    \u0440\u0435\u0448\u0435\u043D\u043E \u0432 \u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u044B\u0445
    \u0444\u043E\u0440\u043C\u0430\u0445 \u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C\u0430.
    \u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0432\u0445\u043E\u0434 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u043D\u0430 \u0443\u0433\u043B\u0443, \u043F\u043E\u0442\u043E\u043C \u0431\u044B\u043B
    \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043D \u043D\u0430 \u0444\u0430\u0441\u0430\u0434
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043D\u044B\u043D\u0435\u0448\u043D\u0435\u0439
    \u0443\u043B\u0438\u0446\u044B \u041C\u0430\u044F\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E.
    \u0412\r\n\u044D\u0442\u043E\u0439 \u0436\u0435 \u0447\u0430\u0441\u0442\u0438
    \u043F\u043E\u0437\u0436\u0435 \u0431\u044B\u043B \u043D\u0430\u0434\u0441\u0442\u0440\u043E\u0435\u043D
    \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439 \u044D\u0442\u0430\u0436.\r\n\u041E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u2014 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E-\u0434\u043E\u0441\u0443\u0433\u043E\u0432\u044B\u0435
    \u043D\u0435\u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u043A\u043B\u0443\u0431\u043D\u043E\u0433\u043E\r\n\u0442\u0438\u043F\u0430,
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u043E
    \u0441\u043E\u0441\u043B\u043E\u0432\u043D\u043E\u043C\u0443 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0443
    \u0441 \u0446\u0435\u043B\u044C\u044E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0437\u0430\u0431\u0430\u0432, \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0439
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445\r\n\u0444\u043E\u0440\u043C \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0432\u0440\u0435\u043C\u044F\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438\u0445 \u0447\u043B\u0435\u043D\u043E\u0432. \u0417\u0434\u0435\u0441\u044C
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u044B\u0432\u0430\u043B\u0438\u0441\u044C
    \u0438\u0433\u0440\u044B \u0432 \u043A\u0435\u0433\u043B\u0438,\r\n\u0431\u0438\u043B\u044C\u044F\u0440\u0434,
    \u0432 \u043A\u0430\u0440\u0442\u044B, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u0432 \u043C\u0435\u0441\u044F\u0446 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
    \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0435 \u0438 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u043B\u044C\u043D\u044B\u0435
    \u0432\u0435\u0447\u0435\u0440\u0430,\r\n\u043C\u0430\u0441\u043A\u0430\u0440\u0430\u0434\u044B,
    \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0431\u0430\u043B\u044B, \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u044B\u0432\u0430\u043B\u0438\u0441\u044C
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0438
    - \u043A\u0430\u043A \u043C\u0435\u0441\u0442\u043D\u044B\u0435, \u0442\u0430\u043A\r\n\u0438
    \u0437\u0430\u0440\u0443\u0431\u0435\u0436\u043D\u044B\u0435. \u0414\u043B\u044F
    \u0447\u043B\u0435\u043D\u043E\u0432 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F
    \u0432\u044B\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438\u0441\u044C \u0433\u0430\u0437\u0435\u0442\u044B,
    \u0436\u0443\u0440\u043D\u0430\u043B\u044B, \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u043B\u0438\u0441\u044C\r\n\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u044B
    \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F \u043B\u0435\u043A\u0446\u0438\u0439
    \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0435 \u0442\u0435\u043C\u044B.\r\n\u0417\u0434\u0430\u043D\u0438\u0435
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u0441\u0432\u044F\u0437\u0430\u043D\u043E
    \u0441 \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 1917 \u0433.: \u0432
    \u043E\u043A\u0442\u044F\u0431\u0440\u0435 \u0437\u0434\u0435\u0441\u044C\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435\u0432\u0438\u0441\u0442\u0441\u043A\u0438\u0439
    \u0412\u043E\u0435\u043D\u043D\u043E-\u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0435 \u0441\u043E\u043B\u0434\u0430\u0442\r\n\u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430 \u0432\u0437\u044F\u043B
    \u0432\u043B\u0430\u0441\u0442\u044C \u0432 \u0441\u0432\u043E\u0438 \u0440\u0443\u043A\u0438.
    \u0410 \u0432 \u043D\u043E\u044F\u0431\u0440\u0435 1918 \u0433. \u0437\u0434\u0435\u0441\u044C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0441\u044C \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435\r\n\u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438
    \u0433\u043E\u0440\u043E\u0434\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0431\u044B\u043B\u043E \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u043E
    \u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438\r\n\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u044E\u0437\u0430 \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438.
    \u0427\u0443\u0442\u044C \u043F\u043E\u0437\u0436\u0435 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u0439\r\n\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442 \u043A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u0430.\r\n\u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0446\u044B
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043B\u0438 \u0432
    \u0437\u0434\u0430\u043D\u0438\u0438 \u043A\u043B\u0443\u0431 \u0438 \u0432 1918
    \u0433. \u0445\u043E\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439\r\n\u043A\u043E\u043C\u043C\u0443\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u043E\u0442\u0434\u0435\u043B \u043E \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u0438
    \u0432 \u0441\u0432\u043E\u044E \u043F\u043E\u043B\u044C\u0437\u0443 \u0434\u043E\u043C\u043E\u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F
    \u0410\u043D\u043D\u044B \u0416\u0443\u0434\u0440\u043E, \u0432\u043B\u0430\u0434\u0435\u0432\u0448\u0435\u0439\r\n\u0434\u043E\u043C\u043E\u043C
    \u0438 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u043C \u0434\u043E \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438.
    \u041A\u043B\u0443\u0431 \xAB1-\u0435 \u043C\u0430\u044F\xBB \u0437\u0430\u043D\u044F\u043B
    20 \u043A\u043E\u043C\u043D\u0430\u0442 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438,
    \u0437\u0434\u0435\u0441\u044C \u0436\u0435 \u0430\u0440\u0435\u043D\u0434\u043E\u0432\u0430\u043B\u0438\r\n\u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432
    \u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445.\r\n\u0421
    1923 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u043D\u0430\u0447\u0430\u043B
    \u0440\u0430\u0431\u043E\u0442\u0443 \u043E\u0434\u0438\u043D \u0438\u0437 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445
    \u0432\r\n\u0433\u043E\u0440\u043E\u0434\u0435 \u043A\u043B\u0443\u0431\u043E\u0432
    \u2014 \xAB\u041F\u0440\u043E\u0444\u0438\u043D\u0442\u0435\u0440\u043D\xBB.
    \u0417\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
    \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0438, \u043A\u043E\u043D\u0446\u0435\u0440\u0442\u044B
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F, \u043A\u0438\u043D\u043E\u043F\u043E\u043A\u0430\u0437\u044B,\r\n\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C
    \u043B\u0435\u043A\u0446\u0438\u0438 \u0438 \u0434\u043E\u043A\u043B\u0430\u0434\u044B.
    \u0412 \u043A\u043E\u043D\u0446\u0435 1924 \u0433. \u0432 \u043A\u043B\u0443\u0431\u0435
    \u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u043E\u0441\u044C
    556 \u0447\u043B\u0435\u043D\u043E\u0432, \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
    12\r\n\u043A\u0440\u0443\u0436\u043A\u043E\u0432, \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
    \u0441 \u0447\u0438\u0442\u0430\u043B\u044C\u043D\u0435\u0439, \u0431\u0443\u0444\u0435\u0442.\r\n\u0421
    1955 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043F\u043E \u0443\u043B.
    \u041C\u0430\u044F\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E, 1 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0414\u043E\u043C \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B.
    \u0412 1980-\u0445\r\n\u0433\u0433. \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
    \u043F\u044F\u0442\u044C \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445 \u0438
    \u0434\u0435\u0442\u0441\u043A\u0438\u0445 \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u043E\u0432
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0441\u0430\u043C\u043E\u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
    \u0432\r\n\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u043E\u0441\u044C
    \u0431\u043E\u043B\u0435\u0435 700 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
    \u0447\u0435\u0442\u044B\u0440\u0435 \u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 (\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B,\r\n\u043A\u0443\u043B\u044C\u0442\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432,
    \u0441\u0435\u043C\u0435\u0439\u043D\u043E-\u0431\u044B\u0442\u043E\u0432\u043E\u0439
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B, \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E
    \u0432\u043E\u0438\u043D\u0430), \u0441\u0435\u043C\u044C \u043A\u043B\u0443\u0431\u043E\u0432
    \u043F\u043E\r\n\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u043C. \u0421
    1991 \u0433. \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \u0434\u0438\u0440\u0435\u043A\u0446\u0438\u044F \u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0433\u043E
    \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044F \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\r\n\xAB\u0421\u043B\u0430\u0432\u044F\u043D\u0441\u043A\u0438\u0439
    \u0431\u0430\u0437\u0430\u0440 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435\xBB."
  _preview: {fileID: 21300000, guid: 09975703f5982634a92cd004291b7b3d, type: 3}
