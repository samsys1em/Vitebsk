  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "23 \u043B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u0430\u044F
    \u043A\u0438\u0440\u0445\u0430"
  m_EditorClassIdentifier: 
  _number: 23
  _name: "\u043B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u0430\u044F \u043A\u0438\u0440\u0445\u0430"
  _description: "\u041B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u0430\u044F
    \u043A\u0438\u0440\u0445\u0430 \u2013 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0445\u0440\u0430\u043C \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435.
    \u041D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u043D\u0430\r\n\u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0438
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0443\u043B\u0438\u0446
    \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0410\u0440\u043C\u0438\u0438
    \u0438 \u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0441\u043A\u043E\u0439
    (\u043D\u0430 \u043C\u0435\u0441\u0442\u0435\r\n\u0434\u043E\u043C\u0430 \u21169/22
    \u043F\u043E \u0443\u043B. \u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0441\u043A\u043E\u0439).\r\n\u0418\u0441\u0442\u043E\u0440\u0438\u044F
    \u044D\u0442\u043E\u0433\u043E \u043A\u0443\u043B\u044C\u0442\u043E\u0432\u043E\u0433\u043E
    \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0432 1751\u20131753 \u0433\u0433., \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\r\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0436\u0438\u0442\u0435\u043B\u0435\u0439 \u0433\u043E\u0440\u043E\u0434\u0430
    \u0410\u043D\u0434\u0440\u0435\u044F \u0438 \u0410\u043D\u043D\u044B \u0421\u0432\u0438\u0440\u0449\u0435\u0432\u0441\u043A\u0438\u0445
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0431\u044B\u043B \u043E\u0441\u043D\u043E\u0432\u0430\u043D\r\n\u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
    \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043E\u0440\u0434\u0435\u043D\u0430 \u043F\u0438\u0430\u0440\u043E\u0432. \u0421\u0432\u0438\u0440\u0449\u0435\u0432\u0441\u043A\u0438\u0435
    \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u043C\u043E\u043D\u0430\u0445\u0430\u043C
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A\r\n\u0437\u0435\u043C\u043B\u0438,
    \u043E\u0433\u043E\u0440\u043E\u0434\u044B \u0438 1000 \u0442\u0430\u043B\u0435\u0440\u043E\u0432,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
    \u043A\u043E\u0441\u0442\u0451\u043B \u0411\u043E\u0436\u0438\u0435\u0439 \u041C\u0430\u0442\u0435\u0440\u0438\r\n\u0428\u043A\u0430\u043F\u043B\u0435\u0440\u043D\u043E\u0439
    \u0438 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u0438\u0439
    \u043A\u043E\u0440\u043F\u0443\u0441. \u041F\u0440\u0438 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E \u0443\u0447\u0435\u0431\u043D\u043E\u0435\r\n\u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0434\u043B\u044F \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438 \u2013 \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C.\r\n\u0412\u043E
    2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 XVIII \u0432. \u043A\u043E\u0441\u0442\u0451\u043B
    \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D
    \u0438\u0437 \u043A\u0438\u0440\u043F\u0438\u0447\u0430 \u0432 \u0441\u0442\u0438\u043B\u0435
    \u043F\u043E\u0437\u0434\u043D\u0435\u0433\u043E\r\n\u0431\u0430\u0440\u043E\u043A\u043A\u043E.
    \u042D\u0442\u043E \u0431\u044B\u043B \u043E\u0434\u043D\u043E\u043D\u0435\u0444\u043E\u0432\u044B\u0439
    \u0445\u0440\u0430\u043C \u0441 \u043F\u043E\u043B\u0443\u043A\u0440\u0443\u0433\u043B\u043E\u0439
    \u0430\u043F\u0441\u0438\u0434\u043E\u0439 \u0438 \u0431\u043E\u043A\u043E\u0432\u044B\u043C\u0438\r\n\u0441\u0430\u043A\u0440\u0438\u0441\u0442\u0438\u044F\u043C\u0438
    (\u0440\u0438\u0437\u043D\u0438\u0446\u0430\u043C\u0438). \u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0444\u0430\u0441\u0430\u0434, \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043D\u0430 \u044E\u0433,\r\n\u0444\u043B\u0430\u043D\u043A\u0438\u0440\u043E\u0432\u0430\u043B\u0441\u044F
    \u0434\u0432\u0443\u043C\u044F \u0431\u0430\u0448\u043D\u044F\u043C\u0438 \u0441
    \u0444\u0438\u0433\u0443\u0440\u043D\u044B\u043C\u0438 \u043A\u0443\u043F\u043E\u043B\u0430\u043C\u0438.
    \u041A\u0440\u044B\u0448\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043B\u0430\u0441\u044C\r\n\u043A\u0443\u043F\u043E\u043B\u043E\u043C
    \u0441 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u043C \u043A\u0440\u0435\u0441\u0442\u043E\u043C.\r\n\u0425\u0440\u0430\u043C
    \u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0441\u044F \u043A \u043F\u0438\u0430\u0440\u0441\u043A\u043E\u043C\u0443
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E \u0434\u043E 1822 \u0433.
    \u0412 1822 \u0433. \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C \u0431\u044B\u043B\r\n\u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043D
    \u0432 \u041F\u043E\u043B\u043E\u0446\u043A, \u0430 \u043A\u043E\u0441\u0442\u0451\u043B
    \u0432 1833 \u0433. \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u043D
    \u043B\u044E\u0442\u0435\u0440\u0430\u043D\u0430\u043C. \u041A 1839 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u0432 \u043A\u0438\u0440\u0445\u0443. \u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u0438\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u0431\u044B\u043B\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B.\r\n\u0412
    \u043A\u043E\u043D\u0446\u0435 XIX \u2013 \u043D\u0430\u0447\u0430\u043B\u0435
    XX \u0432\u0432. \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441\u043E
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E\r\n\u0444\u0430\u0441\u0430\u0434\u0430
    \u043A\u0438\u0440\u0445\u0438 \u0431\u044B\u043B \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D
    \u043E\u0431\u044A\u0451\u043C. \u0412 \u0442\u0430\u043A\u043E\u043C \u0432\u0438\u0434\u0435
    \u0445\u0440\u0430\u043C \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D
    \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043A\u0430\u0445\r\n\u043D\u0430\u0447\u0430\u043B\u0430
    \u0425\u0425 \u0432.\r\n\u0417\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0438 \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435\r\n\u0433\u043E\u0434\u044B
    \u0431\u044B\u043B\u043E \u0441\u043D\u0435\u0441\u0435\u043D\u043E."
