      \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F. \u041D\u0430\u0447\u0430\u043B\u043E
      \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: 558959ee0e485ea43b60d25df655ef17, type: 3}
  - _title: "\u0413\u043E\u0433\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F \u0443\u043B.
      (\u0441\u0435\u0439\u0447\u0430\u0441 \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430).
      \u0421\u043F\u0440\u0430\u0432\u0430 - \u0437\u0434\u0430\u043D\u0438\u0435
      \u0431\u044B\u0432\u0448\u0435\u0439 \u0436\u0435\u043D\u0441\u043A\u043E\u0439
      \u041C\u0430\u0440\u0438\u0438\u043D\u0441\u043A\u043E\u0439 \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438.
      1941-1944 \u0433\u0433."
    _image: {fileID: 21300000, guid: 9e259ccba32c36b4ea42f4755f65a11e, type: 3}
  - _title: "\u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0435
      \u0437\u0434\u0430\u043D\u0438\u0435 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u0436\u0435\u043D\u0441\u043A\u043E\u0439 \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438.
      2017 \u0433. \u0424\u043E\u0442\u043E \u0418. \u0413\u0443\u0441\u0430\u043A\u043E\u0432\u0430"
