  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "30 \u0436\u0435\u043D\u0441\u043A\u0430\u044F \u043C\u0430\u0440\u0438\u0438\u043D\u0441\u043A\u0430\u044F
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F"
  m_EditorClassIdentifier: 
  _number: 30
  _name: "\u0436\u0435\u043D\u0441\u043A\u0430\u044F \u043C\u0430\u0440\u0438\u0438\u043D\u0441\u043A\u0430\u044F
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F"
  _description: "\u0413\u0438\u043C\u043D\u0430\u0437\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0432 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0435\u043C\u0441\u044F
    \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0430 \u0413\u043E\u0433\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u0435\r\n(\u043D\u044B\u043D\u0435 \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430;
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u0434\u043E\u043C\u0430 \u211619 \u043F\u043E \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430
    \u0438 \u211614 \u043F\u043E \u0443\u043B.\r\n\u0413\u043E\u0433\u043E\u043B\u044F).
    \u042D\u0442\u043E \u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E \u0432
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0432 1866\u22121917 \u0433\u0433.,\r\n\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u043E\u0441\u044C
    \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439, \u043E\u0440\u0433\u0430\u043D\u043E\u0432
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E\r\n\u0441\u0430\u043C\u043E\u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0435
    \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F.
    \u0413\u0438\u043C\u043D\u0430\u0437\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u043F\u043E\u0434\r\n\u044E\u0440\u0438\u0441\u0434\u0438\u043A\u0446\u0438\u0435\u0439
    \u0412\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u0430 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439
    \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u0440\u0438\u0446\u044B \u041C\u0430\u0440\u0438\u0438
    \u0438 \u043F\u043E\u0442\u043E\u043C\u0443\r\n\u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430\u0441\u044C
    \u041C\u0430\u0440\u0438\u0438\u043D\u0441\u043A\u043E\u0439. \u0417\u0434\u0435\u0441\u044C
    \u043E\u0431\u0443\u0447\u0430\u043B\u0438\u0441\u044C \u0434\u0435\u0432\u043E\u0447\u043A\u0438
    \u0432\u0441\u0435\u0445 \u0441\u043E\u0441\u043B\u043E\u0432\u0438\u0439 \u0438\r\n\u0432\u0435\u0440\u043E\u0438\u0441\u043F\u043E\u0432\u0435\u0434\u0430\u043D\u0438\u0439.
    \u0412\u043D\u0430\u0447\u0430\u043B\u0435 \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F
    \u0431\u044B\u043B\u0430 3-\u043A\u043B\u0430\u0441\u0441\u043D\u043E\u0439,
    \u043A 1890 \u0433. \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430 \u0438\u0437\r\n\u0441\u0435\u043C\u0438
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u043A\u043B\u0430\u0441\u0441\u043E\u0432,
    \u0432\u043E\u0441\u044C\u043C\u043E\u0433\u043E\r\n\u2212\r\n\u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438 \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E\r\n\u2212\r\n\u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E.\r\n\u0423\u0447\u0435\u0431\u043D\u043E\u0435
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \xAB\u0434\u0430\u0432\u0430\u043B\u043E
    \u0434\u0435\u0432\u0443\u0448\u043A\u0430\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438 \u0432\u043E\u0441\u043F\u0438\u0442\u0430\u043D\u0438\u0435,\r\n\u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430\xBB.
    \u0412\u044B\u043F\u0443\u0441\u043A\u043D\u0438\u0446\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u0438
    \u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0442 \u043D\u0430\r\n\u0437\u0432\u0430\u043D\u0438\u0435
    \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0439 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u044B,
    \u0430 \u043E\u0442\u043B\u0438\u0447\u043D\u0438\u0446\u044B \u043C\u043E\u0433\u043B\u0438
    \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442.\r\n\u0417\u0430
    \u0433\u043E\u0434\u044B \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u041C\u0430\u0440\u0438\u0438\u043D\u0441\u043A\u0430\u044F \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F
    \u043E\u0431\u0443\u0447\u0438\u043B\u0430 \u043E\u043A\u043E\u043B\u043E 3 \u0442\u044B\u0441\u044F\u0447\r\n\u0434\u0435\u0432\u0443\u0448\u0435\u043A,
    \u0438\u0437 \u043D\u0438\u0445 \u043E\u043A\u043E\u043B\u043E 1 \u0442\u044B\u0441\u044F\u0447\u0438
    \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430\u043C\u0438.\r\n\u0414\u043E\u043B\u0433\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u043E\u043C
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438 \u0431\u044B\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u0435\u0434\u0430\u0433\u043E\u0433\r\n\u041C.\u0418.
    \u041B\u0435\u0431\u0435\u0434\u0435\u0432. \u0417\u0434\u0435\u0441\u044C \u0436\u0435
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B \u0411\u0435\u0440-\u0410\u0431\u0440\u0430\u043C
    \u0413\u0438\u0442\u0442\u0435\u043B\u044C\u0441\u043E\u043D, \u0434\u0435\u0434
    \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044F\r\n\u0421\u0430\u043C\u0443\u0438\u043B\u0430
    \u041C\u0430\u0440\u0448\u0430\u043A\u0430.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D\u0438\u044F \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438
    \u0432 1918 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u043D\u0430\u0440\u043E\u0434\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u044F.
    \u041F\u043E\u0437\u0436\u0435 \u0442\u0430\u043C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C
    \u0442\u0440\u0443\u0434\u043E\u0432\u0430\u044F\r\n\u0448\u043A\u043E\u043B\u0430,
    \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0435, \u0434\u0435\u0442\u0441\u043A\u0438\u0439
    \u0441\u0430\u0434, \u043A\u043B\u0443\u0431. \u041F\u043E\u0441\u043B\u0435
    \u0432\u043E\u0439\u043D\u044B \u0432 \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0435\u043C
    \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u043E\u0441\u044C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E-\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435 \u2116 37 \u0438\u043C. \u041C\u0438\u043D\u0430\u044F\r\n\u0428\u043C\u044B\u0440\u0435\u0432\u0430.
    \u0412 \u043A\u043E\u043D\u0446\u0435 1970-\u0445 \u0433\u0433. \u0432 \u0445\u043E\u0434\u0435
    \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E\r\n\u0441\u043D\u0435\u0441\u0435\u043D\u043E."
