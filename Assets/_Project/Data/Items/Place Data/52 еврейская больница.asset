  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "52 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0430\u044F \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
  m_EditorClassIdentifier: 
  _number: 52
  _name: "\u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0430\u044F \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
  _description: "\u0421 \u043A\u043E\u043D\u0446\u0430 XIX \u2013 \u043D\u0430\u0447.
    \u0425\u0425 \u0432\u0432. \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0439
    \u043F\u043E \u0443\u043B. \u0413\u0435\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    (\u043D\u044B\u043D\u0435\r\n\u0443\u043B. \u041A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442\u043E\u0432)
    \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0430\u044F
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430. \u041E\u0431\u0449\u0430\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u044D\u0442\u0438\u0445 \u0437\u0434\u0430\u043D\u0438\u0439\r\n\u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    4370 \u043A\u0432. \u043C. \u0413\u043B\u0430\u0432\u043D\u044B\u0439 2-\u044D\u0442\u0430\u0436\u043D\u044B\u0439
    \u043A\u043E\u0440\u043F\u0443\u0441 \u0431\u044B\u043B \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D
    \u0434\u043E 1894 \u0433.\r\n(\u0441\u043E\u0432\u0440. \u0434\u043E\u043C \u2116
    14). \u0417\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C
    \u0430\u043C\u0431\u0443\u043B\u0430\u0442\u043E\u0440\u0438\u044F, \u0430\u043F\u0442\u0435\u043A\u0430,
    \u0440\u043E\u0434\u0438\u043B\u044C\u043D\u043E\u0435\r\n\u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0438 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B \u0434\u043B\u044F \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445.
    \u0412 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445
    \u0440\u044F\u0434\u043E\u043C \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445\r\n\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F\u0445
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435. \u041F\u043E\u0434\u0441\u043E\u0431\u043D\u044B\u0435
    \u0441\u043B\u0443\u0436\u0431\u044B (\u0431\u0430\u043D\u044F,\r\n\u043F\u0440\u0430\u0447\u0435\u0447\u043D\u0430\u044F,
    \u0441\u043A\u043B\u0430\u0434\u044B) \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438
    \u0435\u0449\u0435 \u043E\u0434\u043D\u043E \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435. \u0412 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C\r\n\u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C \u043C\u0430\u0448\u0438\u043D\u043D\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0438 \u0440\u0435\u043D\u0442\u0433\u0435\u043D\u043E\u0432\u0441\u043A\u0438\u0439
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442\r\n(\u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F
    \u0432 1910\u20131912 \u0433\u0433.). \u0412 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u043C
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438
    \u043F\u0440\u0438 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
    \u0431\u043E\u0433\u0430\u0434\u0435\u043B\u044C\u043D\u044F.\r\n\u0414\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043D\u0430 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F\r\n\u0431\u043E\u0433\u0430\u0442\u044B\u0445
    \u0433\u043E\u0440\u043E\u0436\u0430\u043D. \u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0430\u044F
    \u043F\u043E\u043C\u043E\u0449\u044C, \u043A\u0430\u043A \u043F\u043B\u0430\u0442\u043D\u0430\u044F,
    \u0442\u0430\u043A \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F,\r\n\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430\u0441\u044C
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0432\u0440\u0435\u044F\u043C,
    \u043D\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F\u043C
    \u0432\u0441\u0435\u0445 \xAB\u0431\u0435\u0437 \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u044F\r\n\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439\xBB.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 1917 \u0433. \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0435
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u043E\r\n\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C.
    \u0412 1919 \u0433. \u043E\u043D\u043E \u0431\u044B\u043B\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
    \u043A\u0430\u043A \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430.\r\n\u0412 \u043A\u043E\u043D\u0446\u0435
    1930-\u0445 \u0433\u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u044F\u0445 \u0431\u044B\u0432\u0448\u0435\u0439
    \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C\r\n\u043A\u043B\u0438\u043D\u0438\u043A\u043E-\u0430\u043A\u0443\u0448\u0435\u0440\u0441\u043A\u043E-\u0433\u0438\u043D\u0435\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430 \u0438\u043C. \u041B\u0435\u043D\u0438\u043D\u0430,
    \u0436\u0435\u043D\u0441\u043A\u0430\u044F\r\n\u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0438\u044F,
    \u0440\u043E\u0434\u0438\u043B\u044C\u043D\u044B\u0439 \u0434\u043E\u043C.\r\n\u0412
    \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E,
    \u043D\u043E \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E\r\n\u043D\u0435
    \u0431\u044B\u043B\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u0441 1952 \u0433. \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C\r\n\u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0435
    \u0434\u043B\u044F \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0438 \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u043E\u0432, \u043F\u043E\u0437\u0436\u0435\r\n\u0434\u043E
    \u043D\u0430\u0447\u0430\u043B\u0430 1970-\u0445 \u0433\u0433. \u2013 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u0438 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u044F \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E\r\n\u0432\u043E\u043A\u0437\u0430\u043B\u0430,
    \u0441 1973 \u0433. \u0438 \u0434\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2013 \u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u0441\u043A\u043E\u0440\u043E\u0439 \u0438 \u043D\u0435\u043E\u0442\u043B\u043E\u0436\u043D\u043E\u0439\r\n\u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0439
    \u043F\u043E\u043C\u043E\u0449\u0438."
  _preview: {fileID: 21300000, guid: 3ff6461388e37b547b478adbf04cd0b6, type: 3}
  _images:
  - _title: "\u0417\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u0432\u0448\u0435\u0439
      \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B.
      2010-\u0435 \u0433\u0433."
