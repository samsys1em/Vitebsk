      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u0438
      (\u0431\u044B\u0432\u0448\u0430\u044F \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0430\u044F
      \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430). 2010-\u0435 \u0433\u0433."
