  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "19 \u0420\u043E\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 19
  _name: "\u0420\u043E\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0420\u043E\u0436\u0434\u0435\u0441\u0442\u0432\u0430
    \u0425\u0440\u0438\u0441\u0442\u043E\u0432\u0430 \u2212 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0445\u0440\u0430\u043C, \u043D\u0430\u0445\u043E\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F\r\n\u0432
    \u0440\u0430\u0439\u043E\u043D\u0435 \u0417\u0430\u0440\u0443\u0447\u0430\u0432\u044C\u0435
    (\u043D\u0430 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0443\u043B\u0438\u0446\u0435 \u0429\u0435\u0440\u0431\u0430\u043A\u043E\u0432\u0430-\u041D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u0430\u044F
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435\r\n\u0437\u0434\u0430\u043D\u0438\u044F
    \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u043F\u043E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0432\u043D\u0435\u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0441\r\n\u0434\u0435\u0442\u044C\u043C\u0438 \u0438 \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u0430\u043C\u0438).
    \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u0432 XVII\u2212XVIII \u0432\u0432.
    \u0443\u043D\u0438\u0430\u0442\u0430\u043C\u0438, \u0432 1810 \u0433. \u0431\u044B\u043B\u0430\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E. \u0412 \u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u044D\u0442\u043E \u0431\u044B\u043B \u043A\u0440\u0435\u0441\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u0441\r\n\u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u043A\u0443\u043F\u043E\u043B\u043E\u043C \u043D\u0430\u0434 \u0441\u0440\u0435\u0434\u043E\u043A\u0440\u0435\u0441\u0442\u0438\u0435\u043C,
    \u0430\u043B\u0442\u0430\u0440\u0451\u043C \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A.\r\n\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
    \u0440\u0430\u0437\u043C\u0435\u0440\u044B: \u0434\u043B\u0438\u043D\u0430 \u043E\u043A\u043E\u043B\u043E
    15,5 \u043C, \u0448\u0438\u0440\u0438\u043D\u0430 \u043E\u043A\u043E\u043B\u043E
    11 \u043C.\r\n\u0412 1839 \u0433. \u0445\u0440\u0430\u043C \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438.
    \u0412 1889 \u0433. \u043A \u043D\u0435\u043C\u0443\r\n\u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E \u0442\u0440\u0435\u0445\u044A\u044F\u0440\u0443\u0441\u043D\u0443\u044E
    \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044E \u0441 \u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F
    \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u0430\u043C\u0438.\r\n\u0417\u0432\u043E\u043D
    \u0441\u0430\u043C\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
    \u0438\u0437 \u043D\u0438\u0445, 10-\u043F\u0443\u0434\u043E\u0432\u043E\u0433\u043E,
    \u0431\u044B\u043B \u0441\u043B\u044B\u0448\u0435\u043D \u043D\u0430 \u043F\u043E\u043B\u0432\u0435\u0440\u0441\u0442\u044B.\r\n\u0426\u0435\u0440\u043A\u043E\u0432\u044C
    \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u0432 1920-\u0445 \u0433\u0433. \u0417\u0434\u0430\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E
    \u0432 \u0433\u043E\u0434\u044B\r\n\u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u2212 \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0430
    \u0441\u043D\u0435\u0441\u0435\u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u044F\u044F
    \u0447\u0430\u0441\u0442\u044C. \u041F\u043E\r\n\u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C
    \u0432\u0438\u0442\u0435\u0431\u043B\u044F\u043D, \u0432 1950-\u0445 \u0433\u0433.
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0436\u0438\u043B\u0438 \u043B\u044E\u0434\u0438.
    \u0421\u043D\u0435\u0441\u043B\u0438 \u0445\u0440\u0430\u043C \u0432\r\n\u043A\u043E\u043D\u0446\u0435
    1950-\u0445 \u0433\u0433."
  _preview: {fileID: 21300000, guid: 05c0c7d2712b41844a6b9a1ff713a2cf, type: 3}
