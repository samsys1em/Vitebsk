      (\u0441\u043E\u0432\u0440. \u0443\u043B. \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
      \u0410\u0440\u043C\u0438\u0438) 2"
    _image: {fileID: 21300000, guid: b0dd84454312a7c4fa72caee98b85739, type: 3}
  - _title: "\u0421\u043B\u0435\u0432\u0430 - \u0421\u0432\u044F\u0442\u043E-\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430\u044F
      \u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C,
      \u0441\u043F\u0440\u0430\u0432\u0430 - \u043B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u0430\u044F
      \u043A\u0438\u0440\u0445\u0430.\u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425
      \u0432"
    _image: {fileID: 21300000, guid: 83e7b3e587e03e346bc10a6bc7a13a78, type: 3}
  - _title: "\u041D\u0438\u043A\u043E\u043B\u044C\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C.
      \u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: 7dca8a2c177b9a74db55a4ac5faad5ce, type: 3}
  - _title: "\u0421\u0432\u044F\u0442\u043E-\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430\u044F
      \u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C.
      \u0424\u043E\u0442\u043E\u043F\u0440\u043E\u0435\u043A\u0446\u0438\u044F \u0412.
      \u0411\u043E\u0440\u0438\u0441\u0435\u043D\u043A\u043E\u0432\u0430"
