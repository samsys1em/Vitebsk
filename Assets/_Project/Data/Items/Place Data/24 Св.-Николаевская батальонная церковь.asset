  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "24 \u0421\u0432.-\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430\u044F
    \u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 24
  _name: "\u0421\u0432.-\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430\u044F
    \u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0441\u0432\u044F\u0442\u043E\u0433\u043E
    \u041D\u0438\u043A\u043E\u043B\u0430\u044F (\u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F)
    \u2013 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439\r\n\u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C XVIII \u0432. \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435.
    \u041D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0443 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u044F
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445\r\n\u0443\u043B\u0438\u0446
    \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0410\u0440\u043C\u0438\u0438
    \u0438 \u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0441\u043A\u043E\u0439.\r\n\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0441 XVI
    \u0432. \u0412 \u043D\u0430\u0447\u0430\u043B\u0435 XVIII \u0432.\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n\u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u0430\r\n\u0431\u0440\u0430\u0442\u0441\u0442\u0432\u0443\r\n\u0441\u043E\u043B\u043E\u0434\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u043E\u0433\u043E,\r\n\u043F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u043E\u0433\u043E\r\n\u0438\r\n\u0432\u0438\u043D\u043E\u043A\u0443\u0440\u0435\u043D\u043D\u043E\u0433\u043E
    \u0446\u0435\u0445\u043E\u0432. \u0412 1774 (1779) \u0433. \u043F\u043E \u043F\u0440\u0438\u043A\u0430\u0437\u0443
    \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\r\n\u0433\u0440\u0430\u0444\u0430
    \u0421\u0435\u0440\u0433\u0435\u044F \u041C\u0438\u043D\u0438\u0445\u0430 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u043C\u0438
    \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u043D\u043E\u0432\u043E\u0435\r\n\u0437\u0434\u0430\u043D\u0438\u0435 \u0446\u0435\u0440\u043A\u0432\u0438.
    \u0414\u043E 1799 \u0433. \u044D\u0442\u043E\u0442 \u0445\u0440\u0430\u043C \u0431\u044B\u043B
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435\r\n(\u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
    \u0431\u044B\u043B\u043E \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u0438\u043C\u0438).
    \u0418\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430 \u0432 \u0432\u043E\u0435\u043D\u043D\u043E\u043C\r\n\u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u0435,
    \u0435\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u043E\u0439
    \u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u043E\u0439. \u041F\u0440\u0438\u0445\u043E\u0436\u0430\u043D\u0430\u043C\u0438
    \u0445\u0440\u0430\u043C\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0438\r\n\u0432\u043E\u0438\u043D\u0441\u043A\u0438\u0435
    \u0447\u0438\u043D\u044B \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430, \u043D\u0435
    \u0438\u043C\u0435\u044E\u0449\u0438\u0435 \u0448\u0442\u0430\u0442\u043D\u044B\u0445
    \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A\u043E\u0432.\r\n\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0435
    \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0446\u0435\u0440\u043A\u0432\u0438 \u0432\u043C\u0435\u0449\u0430\u043B\u043E
    \u0434\u043E 500 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.\r\n\u0421\u043D\u0430\u0440\u0443\u0436\u0438
    \u043E\u043D\u043E \u0431\u044B\u043B\u043E \u043E\u0431\u0448\u0438\u0442\u043E
    \u0442\u0435\u0441\u043E\u043C \u0438 \u043E\u043A\u0440\u0430\u0448\u0435\u043D\u043E
    \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u044E \u043A\u0440\u0430\u0441\u043A\u043E\u044E,
    \u0432\u043D\u0443\u0442\u0440\u0438\r\n\u043E\u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u0435\u043D\u043E
    \u0438 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u043E \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u0430\u043C\u0438. \u0412 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F\r\n\u0441\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0447\u0435\u0440\u0442\u044B \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
    \u043A\u0443\u043B\u044C\u0442\u043E\u0432\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0433\u043E
    \u0437\u043E\u0434\u0447\u0435\u0441\u0442\u0432\u0430 \u0441\u0435\u0432\u0435\u0440\u043E-\r\n\u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438, \u0431\u0430\u0440\u043E\u043A\u043A\u043E
    \u0438 \u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C\u0430. \u041A\u0440\u0435\u0441\u0442\u043E\u0432\u043E-\u043A\u0443\u043F\u043E\u043B\u044C\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u0438\u043C\u0435\u043B \u043D\u0430\u0434\r\n\u0441\u0440\u0435\u0434\u043E\u043A\u0440\u0435\u0441\u0442\u0438\u0435\u043C
    \u043A\u0443\u043F\u043E\u043B \u043D\u0430 \u0448\u0435\u0441\u0442\u0438\u0433\u0440\u0430\u043D\u043D\u043E\u043C
    \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0435 \u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u043B\u0443\u043A\u043E\u0432\u0438\u0447\u043D\u043E\u0439 \u0433\u043B\u0430\u0432\u0435.
    \u0412\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0432\u0435\u043B\u043E
    \u0434\u0432\u0430 \u0432\u0445\u043E\u0434\u0430, \u043D\u0430\u0434 \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F\r\n\u0434\u0432\u0443\u0445\u044A\u044F\u0440\u0443\u0441\u043D\u0430\u044F
    \u0431\u0430\u0448\u043D\u044F-\u0437\u0432\u043E\u043D\u043D\u0438\u0446\u0430
    \u0441 \u0433\u043B\u0430\u0432\u043E\u0439 \u0438 \u043A\u0440\u0435\u0441\u0442\u043E\u043C.\r\n\u0425\u0440\u0430\u043C
    \u0431\u044B\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u0434\u043E \u0438\u044E\u043B\u044F 1929 \u0433. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439\r\n\u0432\u043E\u0439\u043D\u044B
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E,
    \u0441\u043D\u0435\u0441\u0435\u043D\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F."
  _preview: {fileID: 21300000, guid: bdde8c8e95cb5ad4b843b427730fcec6, type: 3}
  _images:
  - _title: "\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430\u044F
      (\u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F) \u0446\u0435\u0440\u043A\u043E\u0432\u044C.
      1866 \u0433. \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u0410. \u041C\u0438\u043D\u044F\u0442"
