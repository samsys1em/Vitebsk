  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "21 \u0421\u0432\u044F\u0442\u043E-\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0438 \u0442\u044E\u0440\u044C\u043C\u0430"
  m_EditorClassIdentifier: 
  _number: 21
  _name: "\u0421\u0432\u044F\u0442\u043E-\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0438 \u0442\u044E\u0440\u044C\u043C\u0430"
  _description: "\u041D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439 \u0445\u0440\u0430\u043C
    \u0433\u043E\u0440\u043E\u0434\u0430. \u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
    \u043F\u043E\r\n\u0430\u0434\u0440\u0435\u0441\u0443: \u0443\u043B. \u0428\u0443\u0431\u0438\u043D\u0430,
    2\r\n\u0412 1758\u20131760 \u0433\u0433. \u043D\u0430 \u044D\u0442\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435 \u0431\u044B\u043B\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u044B
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u0451\u043B
    \u0438\r\n\u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u0442\u0440\u0438\u043D\u0438\u0442\u0430\u0440\u0438\u0435\u0432.
    \u0412 1806\u20131821 \u0433\u0433. \u044D\u0442\u0438 \u0436\u0435\r\n\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
    \u0431\u044B\u043B\u0438 \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u044B
    \u0438\u0437 \u043A\u0430\u043C\u043D\u044F.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F 1831 \u0433. \u043A\u043E\u0441\u0442\u0451\u043B
    \u0431\u044B\u043B \u0437\u0430\u043A\u0440\u044B\u0442, \u0430 \u0435\u0433\u043E
    \u043E\u0431\u0438\u0442\u0430\u0442\u0435\u043B\u0438-\u043C\u043E\u043D\u0430\u0445\u0438
    \u0432\u044B\u0441\u043B\u0430\u043D\u044B\r\n\u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430.
    \u0412 \u0431\u044B\u0432\u0448\u0435\u043C \u0436\u0438\u043B\u043E\u043C \u043C\u043E\u043D\u0430\u0448\u0435\u0441\u043A\u043E\u043C
    \u043A\u043E\u0440\u043F\u0443\u0441\u0435 \u0432 1838\u20131847 \u0433\u0433.
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F\r\n\u043F\u0440\u0438\u044E\u0442
    \u0434\u043B\u044F \u0434\u0435\u0442\u0435\u0439-\u0441\u0438\u0440\u043E\u0442,
    \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u0415.\u0410. \u0414\u044C\u044F\u043A\u043E\u0432\u043E\u0439, \u0436\u0435\u043D\u044B
    \u0433\u0435\u043D\u0435\u0440\u0430\u043B-\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u041F.\u041D. \u0414\u044C\u044F\u043A\u043E\u0432\u0430. \u0427\u0435\u0440\u0435\u0437
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F
    \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438\r\n\u0436\u0435\u043D\u0441\u043A\u0443\u044E
    \u0442\u044E\u0440\u044C\u043C\u0443, \u043F\u0440\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0432\u0448\u0443\u044E
    \u0432 \u043D\u0435\u043C \u043E\u043A\u043E\u043B\u043E \u0441\u0442\u0430 \u043B\u0435\u0442.
    \u041F\u043E\u0441\u043B\u0435 \u0412\u0435\u043B\u0438\u043A\u043E\u0439\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0434\u043E \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B
    1960-\u0445 \u0433\u0433. \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C
    2-\u0435 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435\r\n\u043C\u0438\u043B\u0438\u0446\u0438\u0438,
    \u0442\u044E\u0440\u044C\u043C\u0430, \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0438\u0437\u043E\u043B\u044F\u0442\u043E\u0440.\r\n\u0417\u0434\u0430\u043D\u0438\u0435
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u0432 1858 \u0433. \u0431\u044B\u043B\u043E
    \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C,
    \u0434\u043E 1865 \u0433. \u0448\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u044B\r\n\u043F\u043E
    \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0435.
    \u0425\u0440\u0430\u043C \u0431\u044B\u043B \u043E\u0441\u0432\u044F\u0449\u0451\u043D
    \u0432 \u0447\u0435\u0441\u0442\u044C \u041F\u043E\u043A\u0440\u043E\u0432\u0430
    \u041F\u0440\u0435\u0441\u0432\u044F\u0442\u043E\u0439 \u0411\u043E\u0433\u043E\u0440\u043E\u0434\u0438\u0446\u044B.\r\n\u0412
    1913 \u0433., \u043A \u044E\u0431\u0438\u043B\u0435\u044E 300-\u043B\u0435\u0442\u0438\u044F
    \u0434\u043E\u043C\u0430 \u0420\u043E\u043C\u0430\u043D\u043E\u0432\u044B\u0445,
    \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0435\u0449\u0451 \u0440\u0430\u0437. \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0432\u0438\u0434 \u0445\u0440\u0430\u043C\u0430
    \u0431\u044B\u043B \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D:\r\n\u043D\u0430\u0434 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u044C\u044E \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D
    \u0431\u0430\u0440\u0430\u0431\u0430\u043D \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C,
    \u0431\u044B\u043B\u0438 \u043D\u0430\u0434\u0441\u0442\u0440\u043E\u0435\u043D\u044B
    \u0434\u0432\u0435\r\n\u0431\u0430\u0448\u043D\u0438 \u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0430
    \u0444\u043E\u0440\u043C\u0430 \u0444\u0440\u043E\u043D\u0442\u043E\u043D\u0430
    \u0441 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439 \u043D\u0430
    \u043F\u043E\u043B\u0443\u043A\u0440\u0443\u0433\u043B\u0443\u044E.\r\n\u0412
    1931 \u0433. \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u043C\u0438
    \u0432\u043B\u0430\u0441\u0442\u044F\u043C\u0438, \u0430 \u0432 \u0433\u043E\u0434\u044B\r\n\u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0439
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438 \u0432\u043D\u043E\u0432\u044C
    \u0441\u0442\u0430\u043B\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439.
    \u0421 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1941 \u043F\u043E\r\n\u043E\u043A\u0442\u044F\u0431\u0440\u044C
    1943 \u0433\u0433. \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u043C\u043E\u0449\u0438 \u0441\u0432\u044F\u0442\u043E\u0439 \u0415\u0432\u0444\u0440\u043E\u0441\u0438\u043D\u0438\u0438
    \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0439,\r\n\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0435\u0441\u044F
    \u0434\u043E \u044D\u0442\u043E\u0433\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C
    \u041C\u0443\u0437\u0435\u0435 \u0430\u0442\u0435\u0438\u0437\u043C\u0430.\r\n\u0412\u043E
    \u0432\u0440\u0435\u043C\u044F \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0433\u043E\u0440\u043E\u0434\u0430 \u0445\u0440\u0430\u043C \u0431\u044B\u043B
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D. \u0414\u043E\u043B\u0433\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u0432 \u0437\u0430\u043F\u0443\u0441\u0442\u0435\u043D\u0438\u0438. \u0412 1980-\u0445
    \u0433\u0433. \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C\r\n\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C.
    \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0440\u043E\u043B\u044C \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B
    \u0441\u044B\u0433\u0440\u0430\u043B\u0430\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F
    \u0438\u043D\u0442\u0435\u043B\u043B\u0438\u0433\u0435\u043D\u0446\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0430\u0441\u044C
    \u0432 \u043A\u043B\u0443\u0431 \xAB\u0423\u0437\u0433\u043E\u0440\u2019\u0435\xBB
    \u0438 \u043F\u0440\u043E\u0432\u0435\u043B\u0430 40\r\n\u0441\u0443\u0431\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432
    \u043F\u043E \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u043A\u0435 \u0437\u0434\u0430\u043D\u0438\u044F.\r\n\u0412
    1986 \u0433. \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u043E
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0445\u0440\u0430\u043C. \u0412 1987\u20131992 \u0433\u0433. \u0432\u0435\u043B\u0430\u0441\u044C\r\n\u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F
    \u043F\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0445
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u043E\u0432 \u0418.
    \u0420\u043E\u0434\u044C\u043A\u043E \u0438 \u0411. \u041B\u044F\u0434\u0435\u043D\u043A\u043E.\r\n\u0412
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0445\u0440\u0430\u043C \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C,
    \u0432 \u0431\u044B\u0432\u0448\u0435\u043C \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u043C\r\n\u043A\u043E\u0440\u043F\u0443\u0441\u0435
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u043F\u0438\u0441\u043D\u043E\u0439
    \u0445\u0440\u0430\u043C \u0432\u043E \u0438\u043C\u044F \u0441\u0432. \u043F\u0440\u0435\u043F\u043E\u0434\u043E\u0431\u043D\u043E\u043C\u0443\u0447\u0435\u043D\u0438\u043A\u0430
    \u0410\u0444\u0430\u043D\u0430\u0441\u0438\u044F,\r\n\u0438\u0433\u0443\u043C\u0435\u043D\u0430
    \u0411\u0440\u0435\u0441\u0442\u0441\u043A\u043E\u0433\u043E.\r\n\u041F\u0440\u0438
    \u0441\u043E\u0431\u043E\u0440\u0435 \u0442\u0430\u043A\u0436\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442:
    \u0441\u0435\u0441\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E, \u043F\u0440\u0438\u0445\u043E\u0434\u0441\u043A\u0430\u044F
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430,\r\n\u0432\u043E\u0441\u043A\u0440\u0435\u0441\u043D\u0430\u044F
    \u0448\u043A\u043E\u043B\u0430, \u0438\u043A\u043E\u043D\u043E\u043F\u0438\u0441\u043D\u0430\u044F
    \u0438 \u043F\u043E\u0448\u0438\u0432\u043E\u0447\u043D\u0430\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0435,
    \u0442\u0440\u0430\u043F\u0435\u0437\u043D\u0430\u044F."
  _preview: {fileID: 21300000, guid: 399d91eb043056f45b3be0c3151f50b7, type: 3}
  _images:
  - _title: "\u0421\u0432\u044F\u0442\u043E-\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F
      \u0446\u0435\u0440\u043A\u043E\u0432\u044C. 1880-\u0435 - 1890-\u0435 \u0433\u0433.
      \u0424\u043E\u0442\u043E \u0421. \u042E\u0440\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E"
