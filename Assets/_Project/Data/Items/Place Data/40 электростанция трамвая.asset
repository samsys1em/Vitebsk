  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "40 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u0442\u0440\u0430\u043C\u0432\u0430\u044F"
  m_EditorClassIdentifier: 
  _number: 40
  _name: "\u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u0442\u0440\u0430\u043C\u0432\u0430\u044F"
  _description: "\u0417\u0434\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0432\u043E\u0439
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u0432 1897\u2013\r\n1898 \u0433\u0433. \u043D\u0430 \u0443\u043B. \u0417\u0430\u0434\u0443\u043D\u043E\u0432\u0441\u043A\u043E\u0439
    (\u0441\u043E\u0432\u0440. \u043F\u0440-\u0442 \u0424\u0440\u0443\u043D\u0437\u0435)
    \u0434\u043B\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0440\u0430\u0431\u043E\u0442\u044B\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0442\u0440\u0430\u043C\u0432\u0430\u044F. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E,
    \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u043B\u0430
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439\r\n\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0443\u044E
    \u0434\u0443\u043C\u0443, \u0442\u0435\u0430\u0442\u0440, \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439
    \u0434\u043E\u043C, \u043B\u0430\u0437\u0430\u0440\u0435\u0442\u044B, \u0443\u043B\u0438\u0447\u043D\u043E\u0435
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435.\r\n\u0412 \u0434\u0432\u0443\u0445
    \u0437\u0430\u043B\u0430\u0445 \u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u043F\u0440\u0438\u0431\u043E\u0440\u044B, \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0435
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E,\r\n\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0435
    \u0435\u0433\u043E \u043F\u043E\u0434\u0430\u0447\u0443 \u043D\u0430 \u043B\u044E\u0431\u043E\u0439
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0441\u0435\u0442\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0435\r\n\u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435
    \u0443\u043B\u0438\u0446 \u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432.\r\n\u042D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430
    \u0438\u0437 \u0442\u0440\u0443\u0431\u0447\u0430\u0442\u044B\u0445 \u043F\u0430\u0440\u043E\u0432\u044B\u0445
    \u043A\u043E\u0442\u043B\u043E\u0432\r\n\u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \xAB\u0411\u0430\u0431\u043A\u043E\u043A-\u0412\u0438\u043B\u044C\u043A\u043E\u043A\u0441\xBB,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0442\u0430\u043F\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u043D\u0435\u0444\u0442\u044C\u044E \u0438\u043B\u0438 \u0434\u0440\u043E\u0432\u0430\u043C\u0438,\r\n\u0442\u0440\u0451\u0445
    \u043F\u0430\u0440\u043E\u0432\u044B\u0445 \u0434\u0432\u0443\u0445\u0446\u0438\u043B\u0438\u043D\u0434\u0440\u043E\u0432\u044B\u0445
    \u043C\u0430\u0448\u0438\u043D \xAB\u041A\u043E\u043C\u043F\u0430\u0443\u043D\u0434\xBB
    \u0438 \u0442\u0440\u0451\u0445 \u0434\u0438\u043D\u0430\u043C\u043E-\u043C\u0430\u0448\u0438\u043D\r\n\u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0433\u043E
    \u0442\u043E\u043A\u0430 \xAB\u0428\u0443\u043A\u043A\u0435\u0440\u0442\xBB \u043E\u0431\u0449\u0435\u0439
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C\u044E 425 \u043A\u0412\u0442
    (\u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C 500\r\n\u2014600
    \u0432\u043E\u043B\u044C\u0442). \u0412 1910 \u0433. \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u0431\u044B\u043B\u0430 \u0434\u043E\u0432\u0435\u0434\u0435\u043D\u0430
    \u0434\u043E\r\n600 \u043A\u0412\u0442 \u0437\u0430 \u0441\u0447\u0435\u0442
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043A\u043E\u0442\u043B\u043E\u0432. \u0417\u0430\u0442\u0435\u043C \u0435\u0449\u0435
    \u0447\u0435\u0440\u0435\u0437 10 \u043B\u0435\u0442\r\n\u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043B\u0438 \u0434\u043E 800 \u043A\u0412\u0442.
    \u041D\u043E \u0438 \u044D\u0442\u043E\u0433\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u043C\u0430\u043B\u043E \u0434\u043B\u044F\r\n\u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F
    \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0435\u0439 \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u043D\u043E
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
    \u0433\u043E\u0440\u043E\u0434\u0430. \u0412 \u0438\u0442\u043E\u0433\u0435 \u0432\r\n1931
    \u0433. \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u0431\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043D\u0430
    \u0432 \u0440\u0435\u0437\u0435\u0440\u0432, \u0430 \u0433\u043B\u0430\u0432\u043D\u0443\u044E
    \u0440\u043E\u043B\u044C\r\n\u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
    \u0441\u0442\u0430\u043B\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u041E\u0440\u0435\u0445\u043E\u0432\u0441\u043A\u0430\u044F \u0413\u0420\u042D\u0421
    (\u0411\u0435\u043B\u0413\u0420\u042D\u0421).\r\n\u0412 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0437\u0434\u0430\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043A\u0430\u043A\r\n\u0436\u0438\u043B\u043E\u0435, \u0441 1989 \u0433. \u043D\u0430
    \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 20 \u043B\u0435\u0442
    \u0432 \u043D\u0435\u043C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F
    \u041B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u0439\r\n\u043C\u0443\u0437\u0435\u0439.
    \u041F\u043E\u0441\u043B\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0430, \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0432\u0448\u0435\u0433\u043E\u0441\u044F
    \u0432 2016 \u0433., \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0441\u044F
    \u041C\u0443\u0437\u0435\u0439\r\n\u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u0447\u0430\u0441\u0442\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F."
  _preview: {fileID: 21300000, guid: e7998fc7c5437da4d9589ee679b04633, type: 3}
  _images:
  - _title: "\u041F\u0430\u043D\u043E\u0440\u0430\u043C\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430.
      \u0421\u043B\u0435\u0432\u0430 - \u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0432\u043E\u0439
