  m_Name: "05 \u0431\u0430\u0448\u043D\u044F \u0414\u0443\u0445\u043E\u0432\u0441\u043A\u043E\u0439
    \u043A\u0440\u0443\u0433\u043B\u0438\u043A"
  m_EditorClassIdentifier: 
  _number: 5
  _name: "\u0431\u0430\u0448\u043D\u044F \u0414\u0443\u0445\u043E\u0432\u0441\u043A\u043E\u0439
    \u043A\u0440\u0443\u0433\u043B\u0438\u043A"
  _description: "\u0412 \u0421\u0440\u0435\u0434\u043D\u0438\u0435 \u0432\u0435\u043A\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A \u0438\u043C\u0435\u043B \u0432\u044B\u0441\u043E\u043A\u0438\u0439
    \u0432\u043E\u0435\u043D\u043D\u044B\u0439, \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439,\r\n\u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439
    \u0441\u0442\u0430\u0442\u0443\u0441, \u043E \u0447\u0435\u043C \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443\u0435\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 XIV \u2013\r\n\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0425VIII
    \u0432\u0435\u043A\u0430\u0445\r\n\u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445
    \u0412\u0435\u0440\u0445\u043D\u0435\u0433\u043E \u0438 \u041D\u0438\u0436\u043D\u0435\u0433\u043E
    \u0437\u0430\u043C\u043A\u043E\u0432.\r\n\u041E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0438\u0437 \u043A\u0430\u043C\u043D\u044F
    \u0431\u044B\u043B\u0438 \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u044B
    \u0432 1330\u20131351 \u0433\u043E\u0434\u0430\u0445\r\n\u043A\u043D\u044F\u0437\u0435\u043C
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u043C \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u043C
    \u043A\u043D\u044F\u0437\u0435\u043C \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u043C
    \u041E\u043B\u044C\u0433\u0435\u0440\u0434\u043E\u043C. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E\r\n\xAB\u0425\u0440\u043E\u043D\u0438\u043A\u0435
    \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0439 \u0438 \u0436\u0435\u043C\u043E\u0439\u0442\u0441\u043A\u043E\u0439\xBB,
    \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0431\u044B\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E
    \u0436\u0435\u043D\u043E\u0439\r\n\u041E\u043B\u044C\u0433\u0435\u0440\u0434\u0430
    \u043A\u043D\u044F\u0433\u0438\u043D\u0435\u0439 \u0423\u043B\u044C\u044F\u043D\u0438\u0435\u0439
    \u0432 1351 \u0433\u043E\u0434\u0443: \xAB\u041C\u0443\u0440\u043E\u043C \u043E\u0431\u0432\u0435\u043B\u0430
    \u0441 \u0431\u0430\u0448\u0442\u0430\u043C\u0438\r\n\u0432\u044B\u043D\u0435\u0441\u043B\u044B\u043C\u0438
    \u0438 \u0432\u0435\u0436\u0430\u043C\u0438\xBB. \u0424\u043E\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C\r\n\u0438\u0437 \u0441\u0430\u043C\u044B\u0445
    \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043D\u044B\u0445 \u0432 \u0412\u0435\u043B\u0438\u043A\u043E\u043C
    \u043A\u043D\u044F\u0436\u0435\u0441\u0442\u0432\u0435 \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u043C
    \u0432 XIV \u0432\u0435\u043A\u0435. \u0412\u043E \u0432\u0440\u0435\u043C\u044F\r\n\u0432\u043E\u0435\u043D\u043D\u044B\u0445
    \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
    \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0445
    \u0437\u0430\u043C\u043A\u043E\u0432 \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0430\u043B\u0438\u0441\u044C,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
    \u0422\u0430\u043A, \u0432\u043E 2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    XVI \u0432\u0435\u043A\u0430\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u0437\u0430\u043C\u043A\u0438 \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u043E\u0432\u043E
    \u043E\u0442\u0441\u0442\u0440\u043E\u0435\u043D\u044B \u0438\u0437 \u0434\u0435\u0440\u0435\u0432\u0430
    \u0438 \u0437\u0435\u043C\u043B\u0438 \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445\r\n\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u0445
    \u2013 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u0445 \u0441\u0442\u0435\u043D
    \u0438 \u0431\u0430\u0448\u0435\u043D XIV \u0432\u0435\u043A\u0430. \u0417\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F\r\n\u0441\u0442\u0435\u043D\u0430\u043C
    \u0437\u0430\u043C\u043A\u043E\u0432 \u0431\u044B\u043B\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u044B
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0442\u0440\u0435\u0445\u043C\u0435\u0441\u044F\u0447\u043D\u043E\u0439
    \u043E\u0441\u0430\u0434\u044B \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\r\n\u0440\u0443\u0441\u0441\u043A\u0438\u043C\u0438
    \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438 \u0432 1654 \u0433\u043E\u0434\u0443.
    \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0433\u043E\u0440\u043E\u0434
    \u0431\u044B\u043B \u0432\u0437\u044F\u0442 \u0438 \u043D\u0430\r\n\u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 13 \u043B\u0435\u0442
    \u044F\u0432\u043B\u044F\u043B\u0441\u044F \u0447\u0430\u0441\u0442\u044C\u044E
    \u0420\u0443\u0441\u0441\u043A\u043E\u0433\u043E \u0446\u0430\u0440\u0441\u0442\u0432\u0430.
    \u041F\u043E\r\n\u043F\u0440\u0438\u043A\u0430\u0437\u0443 \u0446\u0430\u0440\u044F
    \u0410\u043B\u0435\u043A\u0441\u0435\u044F \u041C\u0438\u0445\u0430\u0439\u043B\u043E\u0432\u0438\u0447\u0430
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u044B\u0435 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u0437\u0430\u043C\u043A\u0438 \u0431\u044B\u043B\u0438\r\n\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B
    \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B. \u041F\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0440\u0430\u0431\u043E\u0442 \u0432 1664\r\n\u0433\u043E\u0434\u0443 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0432\u043E\u0435\u0432\u043E\u0434\u0430 \u043A\u043D\u044F\u0437\u044C \u042F\u043A\u043E\u0432
    \u0412\u043E\u043B\u043A\u043E\u043D\u0441\u043A\u0438\u0439 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B
    \u0446\u0430\u0440\u044E \u0447\u0435\u0440\u0442\u0451\u0436 \u0441\r\n\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C
    \u043E\u0431\u043D\u043E\u0432\u043B\u0451\u043D\u043D\u044B\u0445 \u0437\u0430\u043C\u043A\u043E\u0432
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043A. \u041D\u0430\r\n\u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C \u044D\u0442\u043E\u0442 \u0447\u0435\u0440\u0442\u0435\u0436
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0434\u0440\u0435\u0432\u043D\u0435\u0439 \u0438\u0437 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0445\u0441\u044F\r\n\u043A\u0430\u0440\u0442
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430. \u041E\u043D \u0431\u044B\u043B
    \u0438\u0437\u0434\u0430\u043D \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u043E\u043C,
    \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u043E\u043C \u0410.\u041F. \u0421\u0430\u043F\u0443\u043D\u043E\u0432\u044B\u043C
    \u0432 1910\r\n\u0433\u043E\u0434\u0443. \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0432\u0440\u0435\u043C\u044F \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
    \u0432 \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u043C \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\r\n\u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C
    \u0430\u0440\u0445\u0438\u0432\u0435 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
    \u0430\u043A\u0442\u043E\u0432 \u0432 \u041C\u043E\u0441\u043A\u0432\u0435. \u041D\u0430
    \u0447\u0435\u0440\u0442\u0435\u0436\u0435 1664 \u0433\u043E\u0434\u0430\r\n\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044B
    \u0442\u0440\u0438 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0445 \u0437\u0430\u043C\u043A\u0430
    \u2013 \u0412\u0435\u0440\u0445\u043D\u0438\u0439, \u041D\u0438\u0436\u043D\u0438\u0439
    \u0438 \u0412\u0437\u0433\u043E\u0440\u0441\u043A\u0438\u0439,\r\n\u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u044B
    \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0432\u0430\u0436\u043D\u044B\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0443\u043B\u0438\u0446\u044B, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F\r\n\u0432\u043D\u0443\u0442\u0440\u0438
    \u0437\u0430\u043C\u043A\u043E\u0432, \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0437\u0430\u043C\u043A\u043E\u0432, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0432\u0441\u0435 \u0431\u0430\u0448\u043D\u0438
    \u0438 \u043F\u0440\u043E\u0435\u0437\u0434\u043D\u044B\u0435\r\n\u0432\u043E\u0440\u043E\u0442\u0430
    \u0437\u0430\u043C\u043A\u043E\u0432\u044B\u0445 \u0441\u0442\u0435\u043D. \u0412
    1984 \u0433\u043E\u0434\u0443 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A\r\n\u0431\u044B\u043B\u0438
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
    \u0437\u0430\u043C\u043A\u043E\u0432\u044B\u0445 \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439
    \u0425VI\u2013\u0425VII \u0432\u0435\u043A\u043E\u0432 \u0438\r\n\u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0431\u0430\u0448\u0435\u043D \u041D\u0438\u0436\u043D\u0435\u0433\u043E
    \u0437\u0430\u043C\u043A\u0430 \u2013 \xAB\u0414\u0443\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E
    \u043A\u0440\u0443\u0433\u043B\u0438\u043A\u0430\xBB. \u041E\u043D\u0430\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440-\u0442\u0430 \u0424\u0440\u0443\u043D\u0437\u0435, \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
    \u0414\u0443\u0445\u043E\u0432\u0441\u043A\u043E\u0439 \u0433\u043E\u0440\u044B\r\n\u0438
    \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0439\u0441\u044F \u043D\u0430
    \u043D\u0435\u0439 \u0446\u0435\u0440\u043A\u0432\u0438 \u0421\u0432. \u0414\u0443\u0445\u0430.
    \u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0425VII \u0432\u0435\u043A\u0430
    \u0431\u0430\u0448\u043D\u044F\r\n\u0434\u043E\u0441\u0442\u0438\u0433\u0430\u043B\u0430
    \u0432 \u0432\u044B\u0441\u043E\u0442\u0443 9,5 \u043C, \u0438\u043C\u0435\u043B\u0430
    8 \u0441\u0442\u0435\u043D, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
    \u043A\u0440\u0443\u0433\u043B\u043E\u0439 \u2013 \u043E\u0442\u0441\u044E\u0434\u0430\r\n\u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \xAB\u0414\u0443\u0445\u043E\u0432\u0441\u043A\u043E\u0439 \u043A\u0440\u0443\u0433\u043B\u0438\u043A\xBB.
    \u0412 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043D\u043E\u0439
    \u043D\u0430\u0445\u043E\u0434\u043A\u043E\u0439\r\n\u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
    \u0438\u0434\u0435\u044F \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u0430
    \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E\r\n\u0431\u0430\u0448\u043D\u0438,
    \u0432\u0437\u044F\u0432 \u0437\u0430 \u043E\u0441\u043D\u043E\u0432\u0443 \u0444\u043E\u0440\u043C\u0443
    \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F XIV \u0432\u0435\u043A\u0430
    (\u0441 4-\u043C\u044F \u0441\u0442\u0435\u043D\u0430\u043C\u0438).\r\n\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0443
    \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u0432 2007 \u0433\u043E\u0434\u0443.
    \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F\r\n\u0432\u044B\u0441\u0442\u0430\u0432\u043E\u0447\u043D\u044B\u0439
    \u0437\u0430\u043B, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F
    \u044D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u044F, \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0430\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438\r\n\u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044F
    \xAB\u0421\u043B\u0430\u0432\u044F\u043D\u0441\u043A\u0438\u0439 \u0431\u0430\u0437\u0430\u0440
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435\xBB. \u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435\r\n\u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430
    \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0438,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0439 \u043A\u043D\u044F\u0437\u0435\u043C\r\n\u041E\u043B\u044C\u0433\u0435\u0440\u0434\u043E\u043C,
    \u0438 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0441\u0442\u0435\u043D."
