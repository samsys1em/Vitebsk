  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "13 \u0434\u0432\u043E\u0440\u0435\u0446 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430"
  m_EditorClassIdentifier: 
  _number: 13
  _name: "\u0434\u0432\u043E\u0440\u0435\u0446 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430"
  _description: "\u0417\u0434\u0430\u043D\u0438\u0435 \u0434\u0432\u043E\u0440\u0446\u0430
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430 \u2013 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
    \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 XVIII \u0432. \u0411\u044B\u043B\u043E\r\n\u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E,
    \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
    \u043D\u0430 \u0440\u0443\u0431\u0435\u0436\u0435 1760-1770-\u0445 \u0433\u0433.
    \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u043E\r\n\u043F\u043E\u043C\u0435\u0449\u0438\u043A\u0430\u043C
    \u0421\u0443\u0440\u0430\u0436\u0441\u043A\u043E\u0433\u043E \u0443\u0435\u0437\u0434\u0430
    \u041A\u0443\u0434\u0438\u043D\u043E\u0432\u0438\u0447\u0430\u043C. \u0412 1806-1811
    \u0433\u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u043F\u043E\r\n\u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430
    \u0424. \u0421\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0434\u043B\u044F
    \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0446\u0438\u0438
    \u0433\u0435\u043D\u0435\u0440\u0430\u043B-\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u0438\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u2013 \u0432\u044B\u0441\u0448\u0435\u0433\u043E \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
    \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0439
    \u0432\r\n1802 \u0433.\r\n\u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u043F\u0430\u0440\u0430\u0434\u043D\u044B\u0439 \u0432\u0435\u0441\u0442\u0438\u0431\u044E\u043B\u044C
    \u0441 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435\u0439 \u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    \u0434\u043B\u044F\r\n\u043F\u0440\u0438\u0441\u043B\u0443\u0433\u0438, \u043D\u0430
    2-\u043C \u2013 \u0433\u043E\u0441\u0442\u0438\u043D\u0430\u044F, \u043A\u0430\u0431\u0438\u043D\u0435\u0442
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u0430\u0440\u0430\u0434\u043D\u044B\u0435
    \u043A\u043E\u043C\u043D\u0430\u0442\u044B, \u043D\u0430 3-\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u043B\u0438\u0447\u043D\u044B\u0435\r\n\u0430\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u044B
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430 \u0438 \u0435\u0433\u043E
    \u0441\u0435\u043C\u044C\u0438. \u041A 1811 \u0433. \u0441 \u044E\u0436\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u044F
    \u0431\u044B\u043B \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0435\u043D\r\n\u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u0439
    \u041F-\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0439
    \u043A\u043E\u0440\u043F\u0443\u0441, \u043D\u0430 1-\u043C \u044D\u0442\u0430\u0436\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435\r\n\u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0435
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430, \u043D\u0430
    2-\u043C \u044D\u0442\u0430\u0436\u0435 \u2013\r\n\u043F\u0430\u0440\u0430\u0434\u043D\u044B\u0435
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F, \u0441\u0442\u043E\u043B\u043E\u0432\u0430\u044F,
    \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F
    \u0442\u0430\u043A\u0436\u0435 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043A\u043E\u043D\u0446\u0435\u0440\u0442\u043E\u0432 \u0438\r\n\u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0435\u0439;
    \u0432 \u0442\u043E\u0440\u0446\u043E\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C.\r\n\u0421 \u0432\u0435\u0441\u043D\u044B
    1811 \u0433. \u0432 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u043C
    \u0434\u0432\u043E\u0440\u0446\u0435 \u0436\u0438\u043B \u0433\u0435\u0440\u0446\u043E\u0433
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0412\u044E\u0440\u0442\u0435\u043C\u0431\u0435\u0440\u0433\u0441\u043A\u0438\u0439,\r\n\u0433\u0435\u043D\u0435\u0440\u0430\u043B
    \u043E\u0442 \u043A\u0430\u0432\u0430\u043B\u0435\u0440\u0438\u0438, \u0432 1811-1822
    \u0433\u0433. \u0437\u0430\u043D\u0438\u043C\u0430\u0432\u0448\u0438\u0439 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
    \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430.
    \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 1812 \u0433. \u0410. \u0412\u044E\u0440\u0442\u0435\u043C\u0431\u0435\u0440\u0433\u0441\u043A\u0438\u0439
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432\r\n\u0431\u043E\u044F\u0445 \u043F\u0440\u043E\u0442\u0438\u0432 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u043E\u0432
    \u043F\u043E\u0434 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C \u0438
    \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u043C, \u0430 \u0434\u0432\u043E\u0440\u0435\u0446
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430 \u0432 \u0442\u043E\u043C
    \u0436\u0435 \u0433\u043E\u0434\u0443 \u0432\r\n\u0442\u0435\u0447\u0435\u043D\u0438\u0435
    \u0434\u0432\u0443\u0445 \u043D\u0435\u0434\u0435\u043B\u044C \u044F\u0432\u043B\u044F\u043B\u0441\u044F
    \u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0446\u0438\u0435\u0439 \u041D\u0430\u043F\u043E\u043B\u0435\u043E\u043D\u0430
    \u0411\u043E\u043D\u0430\u043F\u0430\u0440\u0442\u0430. \u0412\u044A\u0435\u0445\u0430\u0432
    \u0432 \u0433\u043E\u0440\u043E\u0434 16 \u0438\u044E\u043B\u044F (\u043F\u043E\r\n\u043D\u043E\u0432\u043E\u043C\u0443
    \u0441\u0442\u0438\u043B\u044E 28 \u0438\u044E\u043B\u044F), \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0439
    \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u043D\u0430\u043C\u0435\u0440\u0435\u0432\u0430\u043B\u0441\u044F
    \u0437\u0434\u0435\u0441\u044C \xAB\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F,\r\n\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
    \u0441 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C\u044E, \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
    \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0441\u0432\u043E\u0435\u0439 \u0430\u0440\u043C\u0438\u0438,
    \u0434\u0430\u0442\u044C \u0435\u0439 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C
    \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\r\n\u041F\u043E\u043B\u044C\u0448\u0443\xBB.
    \u041D\u0430\u043F\u043E\u043B\u0435\u043E\u043D \u0440\u0435\u0448\u0438\u043B
    \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435
    \u043D\u0430 \u041C\u043E\u0441\u043A\u0432\u0443, \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u043B
    \u0432\u043E\u0435\u043D\u043D\u044B\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\r\n\u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    1812 \u0433\u043E\u0434\u0430 \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u043D\u044B\u043C\u0438,
    \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u043A\u043E\u0440\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438 \u0443\u0436\u0435 1 \u0430\u0432\u0433\u0443\u0441\u0442\u0430
    1812 \u0433.\r\n\u043F\u043E\u043A\u0438\u043D\u0443\u043B \u0433\u043E\u0440\u043E\u0434\u2026\r\n\u0412
    1814 \u0433. \u0434\u0432\u043E\u0440\u0435\u0446 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u043F\u043E\u0441\u0435\u0442\u0438\u043B\u0430 \u043A\u0430\u0432\u0430\u043B\u0435\u0440\u0438\u0441\u0442-\u0434\u0435\u0432\u0438\u0446\u0430
    \u041D\u0430\u0434\u0435\u0436\u0434\u0430 \u0414\u0443\u0440\u043E\u0432\u0430,
    \u0430 \u0432 \u0438\u044E\u043D\u0435 1831\r\n\u0433. \u0437\u0434\u0435\u0441\u044C
    \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0441\u044F,
    \u0441\u043B\u0435\u0434\u0443\u044F \u0438\u0437 \u0412\u0430\u0440\u0448\u0430\u0432\u044B
    \u0432 \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u0432\u0435\u043B\u0438\u043A\u0438\u0439
    \u043A\u043D\u044F\u0437\u044C \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D
    \u041F\u0430\u0432\u043B\u043E\u0432\u0438\u0447,\r\n\u0431\u0440\u0430\u0442
    \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430
    \u041D\u0438\u043A\u043E\u043B\u0430\u044F I. \u0412 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043A\u043D\u044F\u0437\u044C \u0437\u0430\u0440\u0430\u0437\u0438\u043B\u0441\u044F
    \u0445\u043E\u043B\u0435\u0440\u043E\u0439 \u0438\r\n\u0441\u043A\u043E\u0440\u043E\u043F\u043E\u0441\u0442\u0438\u0436\u043D\u043E
    \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F. \u0422\u0435\u043B\u043E
    \u0435\u0433\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0432 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u043C
    \u0441\u043E\u0431\u043E\u0440\u0435, \u0437\u0430\u0442\u0435\u043C\r\n\u0431\u044B\u043B\u043E
    \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E \u0432
    \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433.\r\n\u0412 1840-\u0445
    \u0433\u0433. \u0432 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u043C
    \u0434\u0432\u043E\u0440\u0446\u0435 \u0434\u0430\u0432\u0430\u043B\u0430 \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0438
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u0431\u0430\u043B\u0435\u0442\u043D\u0430\u044F
    \u0442\u0440\u0443\u043F\u043F\u0430 \u043F\u043E\u0434\r\n\u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    \u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u0431\u0430\u043B\u0435\u0442\u043C\u0435\u0439\u0441\u0442\u0435\u0440\u0430
    \u041C\u043E\u0440\u0438\u0441\u0430 \u041F\u0438\u043E\u043D\u0430. \u0412 1853-1854
    \u0433\u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0430 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439\r\n\u0433\u043E\u0440\u043A\u0435
    \u0431\u044B\u0432\u0430\u043B \u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044C
    \u0418\u0432\u0430\u043D \u041B\u0430\u0436\u0435\u0447\u043D\u0438\u043A\u043E\u0432,
    \u0431\u044B\u0432\u0448\u0438\u0439 \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u043C \u0432\u0438\u0446\u0435-\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u043E\u043C.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439 1917 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u043E\u0440\u0433\u0430\u043D\u044B
    \u043D\u043E\u0432\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u0438: \u043A\u043E\u043C\u0438\u0442\u0435\u0442
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439\r\n\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0420\u0421\u0414\u0420\u041F(\u0431), \u0441 1917 \u043F\u043E 1924 \u0433\u0433.
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0439
    \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442. \u0412\r\n1930-\u0445 \u0433\u0433.
    \u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u043E
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435
    \u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F\r\n\u0433\u043E\u0440\u0441\u043E\u0432\u0435\u0442
    \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u043E\u0442\u0434\u0435\u043B\u0430\u043C\u0438,
    \u0432 \u043A\u043E\u043D\u0446\u0435 1930-\u0445 \u0433\u0433. \u2013 \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439
    \u043E\u0442\u0434\u0435\u043B \u041D\u041A\u0412\u0414, \u0443\u0433\u043E\u043B\u043E\u0432\u043D\u044B\u0439
    \u0440\u043E\u0437\u044B\u0441\u043A,\r\n\u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0435
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0447\u0435-\u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0441\u043A\u043E\u0439
    \u043C\u0438\u043B\u0438\u0446\u0438\u0438.\r\n\u0417\u0434\u0430\u043D\u0438\u0435
    \u0434\u0432\u043E\u0440\u0446\u0430 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E
    \u0432 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B.\r\n\u0412 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0431\u044B\u043B\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E,
    \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u043E\u0441\u044C
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u041A\u0413\u0411
    \u043F\u043E \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439\r\n\u043E\u0431\u043B\u0430\u0441\u0442\u0438.
    \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0434\u043B\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u041A\u0413\u0411 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E \u043D\u043E\u0432\u043E\u0435
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
    \u043D\u0430 \u0443\u043B.\r\n\u041A\u0430\u043B\u0438\u043D\u0438\u043D\u0430.
    \u041A\u0430\u043A\u043E\u0439 \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0430\u044F
    \u0441\u0443\u0434\u044C\u0431\u0430 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0434\u043E\u043C\u0430 \u2013 \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0432\u0440\u0435\u043C\u044F."
