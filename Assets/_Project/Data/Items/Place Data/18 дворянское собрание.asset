  m_Name: "18 \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435"
  m_EditorClassIdentifier: 
  _number: 18
  _name: "\u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435"
  _description: "\u041F\u043E \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0430
    \u041D.\u042F. \u041D\u0438\u043A\u0438\u0444\u043E\u0440\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    \u0437\u0434\u0430\u043D\u0438\u0435\r\n\u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u0432\u043E \u0432\u0441\u0435
    \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u0431\u044B\u043B\u043E \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u043C \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435,
    \u0447\u0442\u043E\r\n\u0441\u043B\u0443\u0436\u0438\u043B\u043E \xAB\u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439
    \u0440\u0430\u0437\u044B\u0441\u043A\u0438\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    \u043C\u0435\u0441\u0442\u0430\xBB \u0432 \u044D\u0442\u043E\u043C \u0440\u0430\u0439\u043E\u043D\u0435
    \u0433\u043E\u0440\u043E\u0434\u0430.\r\n\u0421\u044E\u0434\u0430 \u0447\u0430\u0441\u0442\u043E
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u0438\u0442\u0435\u0431\u043B\u044F\u043D\u0435
    \u0438 \u0433\u043E\u0441\u0442\u0438 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u044E\u0431\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043A\u0440\u0430\u0441\u043E\u0442\u043E\u0439\r\n\u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F
    \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u043C\u0438\u0441\u044F
    \u0432\u0438\u0434\u0430\u043C\u0438 \u043D\u0430 \u0433\u043E\u0440\u043E\u0434.
    \u0417\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u043D\u0430\r\n\u0432\u044B\u0441\u043E\u043A\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443
    \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u044B (\u0441\u0435\u0439\u0447\u0430\u0441
    \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u2013 \u0434\u0440\u0430\u043C\u0442\u0435\u0430\u0442\u0440
    \u0438\u043C. \u042F. \u041A\u043E\u043B\u043E\u0441\u0430). \u041D\u0430\r\n\u043F\u043B\u0430\u043D\u0435
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u043D\u0430\u0447\u0430\u043B\u0430
    1770-\u0445 \u0433\u043E\u0434\u043E\u0432 \u043E\u043D\u043E \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043E
    \u043A\u0430\u043A \xAB\u041F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F\r\n\u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F\xBB.
    \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u0443\u0435\u0437\u0434\u043D\u044B\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435\r\n\u043C\u0435\u0441\u0442\u0430
    \u2013 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B\u0438
    \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435\r\n\u043F\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C
    \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C. \u0412 \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438 \u043F\u043E\u0434 \u0442\u0435\u0440\u043C\u0438\u043D\u043E\u043C
    \xAB\u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435\r\n\u043C\u0435\u0441\u0442\u0430\xBB
    \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441\u0430\u043C\u043E \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
    \u043D\u043E \u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u043C\u043E\u0435
    \u0438\u043C \u0437\u0434\u0430\u043D\u0438\u0435. \u041A\r\n\u043D\u0430\u0447\u0430\u043B\u0443
    XIX \u0432\u0435\u043A\u0430 \u0437\u0434\u0430\u043D\u0438\u0435 \u0441\u0438\u043B\u044C\u043D\u043E
    \u043E\u0431\u0432\u0435\u0442\u0448\u0430\u043B\u043E. \u0412 1806 \u0433\u043E\u0434\u0443
    \u0434\u043E\u043C \u0431\u044B\u043B \u043F\u043E\u0434\u0430\u0440\u0435\u043D\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C\u0443
    \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u0442\u0432\u0443 \u0434\u043B\u044F
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0439 \u0441 \u0443\u0441\u043B\u043E\u0432\u0438\u0435\u043C,
    \u0447\u0442\u043E \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \xAB\u043F\u0440\u0438\u043B\u0438\u0447\u043D\u044B\u043C\r\n\u043E\u0431\u0440\u0430\u0437\u043E\u043C
    \u0443\u0441\u0442\u0440\u043E\u0435\u043D\xBB \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u0442\u0432\u0430. \u041A\u0430\u043F\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0440\u0435\u043C\u043E\u043D\u0442 \u0434\u043B\u0438\u043B\u0441\u044F \u043F\u043E\u0447\u0442\u0438
    60\r\n\u043B\u0435\u0442 \u0438 \u0431\u044B\u043B \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A 1863-\u043C\u0443 \u0433\u043E\u0434\u0443.
    \u0413\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0435 \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0435
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E\r\n\u0432\u044B\u0441\u0448\u0435\u0439
    \u0441\u043E\u0441\u043B\u043E\u0432\u043D\u043E\u0439 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0435\u0439
    \u0434\u0432\u043E\u0440\u044F\u043D. \u041E\u043D\u043E \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B\u043E
    \u0432\u0441\u0435 \u0441\u043E\u0441\u043B\u043E\u0432\u043D\u044B\u0435 \u0434\u0435\u043B\u0430,\r\n\u0440\u0435\u0448\u0430\u043B\u043E
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0432\u044B\u0431\u043E\u0440\u0430
    \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438; \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\r\n\u0434\u0435\u043F\u0443\u0442\u0430\u0442\u043E\u0432
    \u043E\u0442 \u0434\u0432\u043E\u0440\u044F\u043D \u0432 \u043A\u043E\u043C\u0438\u0442\u0435\u0442\u044B,
    \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438; \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u0437\u0430\u0441\u0435\u0434\u0430\u0442\u0435\u043B\u0435\u0439 \u0432 \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0435\r\n\u0441\u0443\u0434\u0435\u0431\u043D\u044B\u0435
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F; \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F
    \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u0438\u0445 \u0443\u0447\u0435\u0431\u043D\u044B\u0445
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0439 \u0438 \u043F\u0440. \u0412
    \u043F\u0435\u0440\u0438\u043E\u0434\r\n\u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F\u043C\u0438
    \u0432\u0441\u0435 \u0441\u043E\u0441\u043B\u043E\u0432\u043D\u044B\u0435 \u0434\u0435\u043B\u0430
    \u0440\u0435\u0448\u0430\u043B\u0438 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0438
    \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u0442\u0432\u0430. \u041E\u043D\u0438\r\n\u0438\u0437\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0432\u044B\u0448\u0435\u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0445
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F\u0445 \u0441\u0440\u043E\u043A\u043E\u043C
    \u043D\u0430 \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u0438\u0437 \u0447\u0438\u0441\u043B\u0430
    \u0443\u0435\u0437\u0434\u043D\u044B\u0445\r\n\u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439\r\n\u0434\u0432\u043E\u0440\u044F\u043D\u0441\u0442\u0432\u0430.\r\n\u041A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u0430\r\n\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u0430\u0441\u044C\r\n\u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u043C.\r\n\u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438 \u0441\u044A\u0435\u0437\u0434\u044B
    \u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u0434\u0432\u043E\u0440\u044F\u043D\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438, \u043D\u043E \u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0435 \u0432\u0435\u0447\u0435\u0440\u0430,
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438 \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0438
    \u0438\r\n\u043A\u043E\u043D\u0446\u0435\u0440\u0442\u044B \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445
    \u0430\u0440\u0442\u0438\u0441\u0442\u043E\u0432. \u041D\u0430\u0447\u0438\u043D\u0430\u044F
    \u0441 1860-\u0445 \u0433\u043E\u0434\u043E\u0432 \xAB\u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0435
    \u0441\u044A\u0435\u0437\u0434\u044B\xBB\r\n\u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
    \u0441\u0442\u0430\u043B\u0438 \u0443\u043A\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F,
    \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u0432 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0439
    \u043A\u043B\u0443\u0431, \u0430 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F \u0431\u044B\u043B\u0438 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u044B
    \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B \xAB\u0433\u043E\u0441\u043F\u043E\u0434
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0445\r\n\u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439\xBB
    \u0438 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F.
    \u0414\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u0438\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F
    \u0431\u044B\u043B\u0438\r\n\u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D\u044B
    \u0432 \u043D\u043E\u044F\u0431\u0440\u0435 1917 \u0433\u043E\u0434\u0430. \u0423\u0436\u0435
    \u0432 1919 \u0433\u043E\u0434\u0443 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C
    \u043A\u043E\u043C\u043D\u0430\u0442 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u0431\u044B\u043B\u0438
    \u0437\u0430\u043D\u044F\u0442\u044B 1-\u0439 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0447\u0443\u043B\u043E\u0447\u043D\u043E-\u0442\u0440\u0438\u043A\u043E\u0442\u0430\u0436\u043D\u043E\u0439
    \u0444\u0430\u0431\u0440\u0438\u043A\u043E\u0439 (\u0441 1928 \u0433\u043E\u0434\u0430
    \u2013\r\n\u0447\u0443\u043B\u043E\u0447\u043D\u043E-\u0442\u0440\u0438\u043A\u043E\u0442\u0430\u0436\u043D\u0430\u044F
    \u0444\u0430\u0431\u0440\u0438\u043A\u0430 \u0438\u043C. \u041A. \u0426\u0435\u0442\u043A\u0438\u043D).
    \u0421 \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0444\u0430\u0431\u0440\u0438\u043A\u0430\r\n\u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u043B\u0430\u0441\u044C,
    \u0435\u0439 \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E
    \u0432\u0441\u0451 \u0437\u0434\u0430\u043D\u0438\u0435, \u0430 \u0432 1920-\u0445
    \u2013 1930-\u0445 \u0433\u043E\u0434\u0430\u0445 \u2013 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435\r\n\u0431\u043B\u0438\u0437\u043B\u0435\u0436\u0430\u0449\u0438\u0435
    \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F. \u0412 \u043F\u0440\u0435\u0434\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0437\u0434\u0430\u043D\u0438\u0439
    \u0444\u0430\u0431\u0440\u0438\u043A\u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\r\n\u043F\u043E\u0447\u0442\u0438
    \u0446\u0435\u043B\u044B\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B \u0432\u0434\u043E\u043B\u044C
    \u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0439 \u0414\u0432\u0438\u043D\u044B.
    \u0417\u0434\u0435\u0441\u044C \u043A\u0440\u043E\u043C\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445\r\n\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u0432 \u0431\u044B\u043B \u043A\u043B\u0443\u0431,
    \u044F\u0441\u043B\u0438, \u0441\u0442\u043E\u043B\u043E\u0432\u0430\u044F, \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u043E\u0435\r\n\u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435.
    \u041D\u0430 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0438
    \u0442\u0440\u0443\u0434\u0438\u043B\u043E\u0441\u044C \u0431\u043E\u043B\u0435\u0435
    2 \u0442\u044B\u0441\u044F\u0447 \u0440\u0430\u0431\u043E\u0447\u0438\u0445.
    \u041F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u044F \u0444\u0430\u0431\u0440\u0438\u043A\u0438\r\n\u2013
    \u0447\u0443\u043B\u043A\u0438, \u043D\u043E\u0441\u043A\u0438, \u0436\u0430\u043A\u0435\u0442\u044B
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0440\u0438\u043A\u043E\u0442\u0430\u0436\u043D\u044B\u0435
    \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u2013\u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C\r\n\u0432\u044B\u0441\u043E\u043A\u0438\u043C
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0434\u0430\u043B\u0435\u043A\u043E \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B
    \u0411\u0421\u0421\u0420. \u0412 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u0444\u0430\u0431\u0440\u0438\u043A\u0438 \u0431\u044B\u043B\u043E \u044D\u0432\u0430\u043A\u0443\u0438\u0440\u043E\u0432\u0430\u043D\u043E
    \u0432 \u0423\u043B\u044C\u044F\u043D\u043E\u0432\u0441\u043A\u0443\u044E\r\n\u043E\u0431\u043B\u0430\u0441\u0442\u044C.
    \u041A 1944 \u0433\u043E\u0434\u0443 \u043A\u043E\u0440\u043F\u0443\u0441\u0430
    \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0431\u044B\u043B\u0438
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B \u0444\u0430\u0431\u0440\u0438\u043A\u0430
    \u043D\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C.
    \u0412 1945 \u0433\u043E\u0434\u0443 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435\r\n\u0432\u043B\u0430\u0441\u0442\u0438
    \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0438
    \u0432\u043E\u043F\u0440\u043E\u0441 \u043E\u0431 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0431\u044B\u0432\u0448\u0435\u0439
    \u0444\u0430\u0431\u0440\u0438\u043A\u0438 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430\r\n\u043B\u0435\u0442\u0447\u0438\u043A\u0430\u043C,
    \u043F\u0430\u0432\u0448\u0438\u043C \u0432 \u0433\u043E\u0434\u044B \u0432\u043E\u0439\u043D\u044B
    \u043D\u0430 \u0431\u043E\u0435\u0432\u043E\u043C \u043F\u0443\u0442\u0438 1-\u0433\u043E
    \u041F\u0440\u0438\u0431\u0430\u043B\u0442\u0438\u0439\u0441\u043A\u043E\u0433\u043E
    \u0444\u0440\u043E\u043D\u0442\u0430.\r\n\u041E\u0434\u043D\u0430\u043A\u043E
    \u044D\u0442\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E
    \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u043E \u0432 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435.
    \u0412 1950-\u0445 \u0433\u043E\u0434\u0430\u0445 \u0437\u0434\u0435\u0441\u044C,
    \u043D\u0430\r\n\u0432\u044B\u0441\u043E\u043A\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443
    \u0414\u0432\u0438\u043D\u044B, \u0431\u044B\u043B\u0438 \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u044B
    \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
    \u0431\u0430\u0440\u0430\u043A\u0438, \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432 1962 \u0433\u043E\u0434\u0443
    \u0431\u044B\u043B\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E\r\n\u0442\u0435\u0430\u0442\u0440\u0430
    \u0438\u043C. \u042F. \u041A\u043E\u043B\u043E\u0441\u0430."
