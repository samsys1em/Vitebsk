    \u0437\u0434\u0430\u043D\u0438\u044F \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
    \u043F\u0440-\u0442\u0430 \u0424\u0440\u0443\u043D\u0437\u0435.\r\n\u0412 2000-\u0445
    \u0433\u0433. \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0430\u0441\u044C
    \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u043D\u043E\u0432\u043E\u0433\u043E\u0434\u043D\u044F\u044F
    \u0451\u043B\u043A\u0430 \u0433\u043E\u0440\u043E\u0434\u0430.\r\n\u0421\u0435\u0439\u0447\u0430\u0441
    \u0437\u0434\u0435\u0441\u044C \u0430\u0432\u0442\u043E\u0441\u0442\u043E\u044F\u043D\u043A\u0430."
