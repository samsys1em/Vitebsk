  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "12. \u041F\u043B\u043E\u0449\u0430\u0434\u044C \u0421\u0432\u043E\u0431\u043E\u0434\u044B
    (\u0431\u044B\u0432\u0448\u0430\u044F \u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C)"
  m_EditorClassIdentifier: 
  _number: 12
  _name: "\u041F\u043B\u043E\u0449\u0430\u0434\u044C \u0421\u0432\u043E\u0431\u043E\u0434\u044B
    (\u0431\u044B\u0432\u0448\u0430\u044F \u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C"
  _description: "\xAB\u041E\u0431\u0438\u043B\u0438\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u0435\u0439\u2026
    \u043E\u0431\u0440\u0430\u0449\u0430\u043B\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430,
    \u0442\u0430\u043A \u043A\u0430\u043A\r\n\u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0435 \u0433\u043E\u0440\u043E\u0434\u0430
    \u043D\u0435 \u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C\r\n\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0430\xBB, \u2212 \u043F\u0438\u0441\u0430\u043B
    \u043A\u0440\u0430\u0435\u0432\u0435\u0434 \u041D\u0438\u043A\u043E\u043B\u0430\u0439
    \u041D\u0438\u043A\u0438\u0444\u043E\u0440\u043E\u0432\u0441\u043A\u0438\u0439
    \u0432 \u043A\u043E\u043D\u0446\u0435 XIX \u0432.\r\n\u041E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u043B\u043E\u0449\u0430\u0434\u0435\u0439 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u044B\u043B\u0430 \u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F\r\n\u043F\u043B\u043E\u0449\u0430\u0434\u044C
    (\u0441\u043E\u0432\u0440. \u043F\u043B. \u0421\u0432\u043E\u0431\u043E\u0434\u044B).
    \u041E\u043D\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0430
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u041D\u0438\u0436\u043D\u0435\u0433\u043E
    \u0437\u0430\u043C\u043A\u0430 \u0438\r\n\u0431\u044B\u043B\u0430 \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0430
    \u0432 1770-\u0445 \u0433\u0433. \u041D\u0430 \u043E\u0434\u043D\u043E\u0439
    \u0435\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0437\u0434\u0430\u043D\u0438\u044F\r\n\u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u0438 \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430
    (\u043F\u043E\u0437\u0436\u0435 \u2212 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440 \u0438 \u0430\u0440\u0445\u0438\u0435\u0440\u0435\u0439\u0441\u043A\u0438\u0439\r\n\u0434\u043E\u043C),
    \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u2212 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
    \u043B\u0430\u0432\u043A\u0438 \u0438 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C\r\n\u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0441\u044C
    \u043F\u043E\u043B\u0438\u0446\u0438\u044F, \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u043A\u0438\u0439
    \u0438 \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u0434\u0432\u043E\u0440\u044B
    (\u043F\u043E\u0437\u0436\u0435 \u044D\u0442\u043E \u0437\u0434\u0430\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E\r\n\u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043E
    \u0432 \u0434\u043E\u043C \u0432\u0438\u0446\u0435-\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430,
    \u0430 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u043B\u0430\u0432\u043E\u043A
    \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u0434\u043E\u043C \u043A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442\u0430\r\n(\u043F\u043E\u0437\u0434\u043D\u0435\u0435
    \u2212 \u0434\u043E\u043C \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430).\r\n\u041F\u043E\u0441\u043B\u0435
    \u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0438\u044F \u0432 1843 \u0433. \u0437\u0434\u0430\u043D\u0438\u044F
    \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u0441\u0442\u0435\u043B\u0430
    \u0432 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439\r\n\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440 \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F.
    \u041A \u043A\u043E\u043D\u0446\u0443 XIX \u0432. \u043E\u043D\u0430\r\n\u0441\u0442\u0430\u043B\u0430
    \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043A\u0440\u0430\u0441\u0438\u0432\u0435\u0439\u0448\u0438\u0445
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435. \u041D\u0430 \u0435\u0435
    \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C\r\n\u0432\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u0438 \u0431\u044B\u0432\u0448\u0438\u0439 \u0438\u0435\u0437\u0443\u0438\u0442\u0441\u043A\u0438\u0439
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C, \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439\r\n\u0432\u043D\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E
    \u0441\u0443\u0434\u0430, \u0441 \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u043E\u0431\u043B\u0438\u043A \u043F\u043B\u043E\u0449\u0430\u0434\u0438\r\n\u0434\u043E\u043F\u043E\u043B\u043D\u044F\u043B\u0438
    \u0437\u0434\u0430\u043D\u0438\u044F, \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0432\u0448\u0438\u0435\u0441\u044F
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0443\u043B. \u0417\u0430\u0434\u0443\u043D\u0430\u0432\u0441\u043A\u043E\u0439
    (\u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u043F\u0440-\u0442\r\n\u0424\u0440\u0443\u043D\u0437\u0435).\r\n\u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043E\u0434\u043D\u043E\u0439 \u0438\u0437
    \u043F\u0435\u0440\u0432\u044B\u0445 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435\r\n\u0441
    \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435\u043C \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
    \u044D\u043F\u043E\u0445\u0438. \u0412 \u043E\u043A\u0442\u044F\u0431\u0440\u0435
    1917 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E
    \u0441\u0443\u0434\u0430\r\n\u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0441\u044C
    \u0437\u0430\u0441\u0435\u0434\u0430\u043D\u0438\u0435, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0431\u044B\u043B \u0438\u0437\u0431\u0440\u0430\u043D \u0412\u043E\u0435\u043D\u043D\u043E-\u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442,\r\n\u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0432\u0448\u0438\u0439
    \u0432\u043B\u0430\u0441\u0442\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.
    \u0412 \u043D\u043E\u044F\u0431\u0440\u0435 1918 \u0433. \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u043F\u0440\u043E\u0448\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u0435\r\n\u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u044B\u0435
    \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
    \u0432\u043B\u0430\u0441\u0442\u0438 \u2212 \u043E\u043D\u0438 \u0431\u044B\u043B\u0438\r\n\u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u044B
    1-\u0439 \u0433\u043E\u0434\u043E\u0432\u0449\u0438\u043D\u0435 \u043E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0439
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438. \u0421 \u043A\u043E\u043D\u0446\u0430
    \u0442\u043E\u0433\u043E \u0436\u0435 \u0433\u043E\u0434\u0430\r\n\u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0441\u0442\u0430\u043B\u0430 \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C\u044E \u0421\u0432\u043E\u0431\u043E\u0434\u044B.\r\n\u0412\u043E
    \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u044C
    \u0421\u0432\u043E\u0431\u043E\u0434\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438,\r\n\u044F\u0432\u043B\u044F\u043B\u0430\u0441\u044C
    \u043C\u0435\u0441\u0442\u043E\u043C \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u0445
    \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0439. \u0417\u0434\u0435\u0441\u044C,
    \u0432 \u043C\u0435\u0441\u0442\u0435\r\n\u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u044F
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445
    \u0443\u043B\u0438\u0446, \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u043E
    \u0448\u0443\u043C\u043D\u043E \u0438 \u043E\u0436\u0438\u0432\u043B\u0435\u043D\u043D\u043E.\r\n\u0412
    1898 \u0433. \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u043E\u0449\u0430\u0434\u044C
    \u0431\u044B\u043B\u0438 \u043F\u0440\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u0442\u0440\u0430\u043C\u0432\u0430\u0439\u043D\u044B\u0435 \u043B\u0438\u043D\u0438\u0438,
    \u0432 1925-\u043C \u043F\u0440\u043E\u0448\u0435\u043B\r\n\u0430\u0432\u0442\u043E\u0431\u0443\u0441\u043D\u044B\u0439
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u0412 1930-\u0445 \u0433\u0433.
    \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0441\u0442\u043E\u044F\u043D\u043A\u0430 \u0442\u0430\u043A\u0441\u0438, \u0430
    \u0432 1933\r\n\u0433. \u0437\u0434\u0435\u0441\u044C \u0431\u044B\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440.\r\n\u0421 \u043A\u043E\u043D\u0446\u0430
    1950-\u0445 \u043E\u0431\u043B\u0438\u043A \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u043D\u0430\u0447\u0430\u043B \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F.
    \u0412 1957 \u0433. \u0431\u044B\u043B \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\r\n\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440, \u0432\u0441\u043A\u043E\u0440\u0435 \u043F\u043E\u0441\u043B\u0435
    \u044D\u0442\u043E\u0433\u043E \u2013 \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438\u0443\u043C\u0430. \u0412 1984 \u0433.\r\n\u0431\u044B\u043B\u0438
