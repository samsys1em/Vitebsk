  m_Name: "50 \u043F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0439
    \u0437\u0430\u0432\u043E\u0434"
  m_EditorClassIdentifier: 
  _number: 50
  _name: "\u043F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0439
    \u0437\u0430\u0432\u043E\u0434"
  _description: "\u041D\u0430 \u0440\u0443\u0431\u0435\u0436\u0435 XIX\u2013XX \u0432\u0432.
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
    \u0442\u0440\u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u0445 \u043F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0445\r\n\u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F:
    \xAB\u0411\u0430\u0432\u0430\u0440\u0438\u044F\xBB \u0413. \u041B\u0435\u0432\u0438\u043D\u0441\u043E\u043D\u0430,
    \u0437\u0430\u0432\u043E\u0434 \u041D. \u041C\u0430\u0440\u0435\u0439\u043D\u043E
    \u0438 \u043F\u0438\u0432\u043E\u043C\u0435\u0434\u043E\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0439\r\n\u0437\u0430\u0432\u043E\u0434
    \xAB\u041D\u043E\u0432\u0430\u044F \u0411\u0430\u0432\u0430\u0440\u0438\u044F\xBB
    \u0431\u0440\u0430\u0442\u044C\u0435\u0432 \u042F\u0445\u043D\u0438\u043D\u044B\u0445
    \u0438 \u042F. \u042D\u043F\u0448\u0442\u0435\u0439\u043D\u0430. \u0417\u0430
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\r\n\u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438
    \u0437\u0430\u0432\u043E\u0434\u044B \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E
    \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u043B\u0438\u0441\u044C \u043D\u0430
    \u0432\u0441\u0435\u043C\u0438\u0440\u043D\u044B\u0445 \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0430\u0445.\r\n\u041D\u0430
    \u043F\u043B\u0430\u043D\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1904 \u0433. \u043E\u0442\u043C\u0435\u0447\u0435\u043D \u0437\u0430\u0432\u043E\u0434
    \u0413.\u0420. \u041B\u0435\u0432\u0438\u043D\u0441\u043E\u043D\u0430. \u041E\u043D
    \u0431\u044B\u043B \u043E\u0441\u043D\u043E\u0432\u0430\u043D \u0432\r\n1875
    \u0433. \u0438 \u0432 \u0441\u043A\u043E\u0440\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0441\u0442\u0430\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445
    \u0432 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438. \u0412 1887 \u0433.\r\n\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043B
    25 \u0442\u044B\u0441\u044F\u0447 \u0432\u0435\u0434\u0435\u0440 \u043F\u0438\u0432\u0430
    \u0432 \u0433\u043E\u0434, \u0434\u043E\u0445\u043E\u0434 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B 23 \u0442\u044B\u0441.
    \u0440\u0443\u0431.,\r\n\u0437\u0434\u0435\u0441\u044C \u0431\u044B\u043B\u043E
    \u0437\u0430\u043D\u044F\u0442\u043E 6 \u0440\u0430\u0431\u043E\u0447\u0438\u0445.
    \u0427\u0435\u0440\u0435\u0437 14 \u043B\u0435\u0442 \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0435
    \u041B\u0435\u0432\u0438\u043D\u0441\u043E\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
    \u0443\u0436\u0435 50\r\n\u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0438\u043C\u0435\u043B\u0441\u044F
    \u043F\u0430\u0440\u043E\u0432\u043E\u0439 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C.
    \u0412 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    \u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u043E\u0441\u044C
    \u043E\u043A\u043E\u043B\u043E\r\n\u043F\u043E\u043B\u0443\u0442\u043E\u0440\u0430
    \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432 \u043F\u0438\u0432\u043D\u044B\u0445
    \u043B\u0430\u0432\u043E\u043A, \u0433\u0434\u0435 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044F\u043C
    \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B\u0438 \u043F\u0438\u0432\u043E
    \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E\r\n\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u0438 \u043F\u0440\u0438\u0432\u043E\u0437\u043D\u043E\u0435.\r\n\u0412 1913
    \u0433. \u041B\u0435\u0432\u0438\u043D\u0441\u043E\u043D \u0441 \u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u0430\u043C\u0438
    \u0443\u0447\u0440\u0435\u0434\u0438\u043B \u043D\u0430 \u0431\u0430\u0437\u0435
    \u0437\u0430\u0432\u043E\u0434\u0430 \u0430\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u043D\u043E\u0435\r\n\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E
    \xAB\u041B\u0435\u0432\u0435\u043D\u0431\u0440\u0435\u0439\xBB. \u0421 \u043D\u0430\u0447\u0430\u043B\u043E\u043C
    \u041F\u0435\u0440\u0432\u043E\u0439 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0432\u044B\u043F\u0443\u0441\u043A \u043F\u0438\u0432\u0430\r\n\u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0441\u044F,
    \u0442.\u043A. \u0447\u0430\u0441\u0442\u044C \u0441\u044B\u0440\u044C\u044F
    \u0437\u0430\u0432\u043E\u0437\u0438\u043B\u0430\u0441\u044C \u0438\u0437 \u0415\u0432\u0440\u043E\u043F\u044B.
    \u041F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u0441\u0440\u043E\u0447\u043D\u043E\r\n\u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0444\u0438\u043B\u0438\u0440\u043E\u0432\u0430\u043B\u0438,
    \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0441\u0442\u0430\u043B\u0438
    \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0445\u043B\u0435\u0431\u043E\u0431\u0443\u043B\u043E\u0447\u043D\u044B\u0435
    \u0438\u0437\u0434\u0435\u043B\u0438\u044F.\r\n\u0412 1920 \u0433. \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435
    \u0431\u044B\u043B\u043E \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043E,
    \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0434 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u043F\u0438\u0432\u0430\r\n\u0431\u044B\u043B\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.
    \u0412 1920-\u0445 \u0433\u0433. \u043A\u0440\u043E\u043C\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u043E\u0433\u043E
    \u0446\u0435\u0445\u0430 \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0435\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043F\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0443
    \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u044B\u0445 \u0432\u043E\u0434, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u043A\u043E\u0444\u0435\u0439\u043D\u0430\u044F
    \u0444\u0430\u0431\u0440\u0438\u043A\u0430.\r\n\u0421 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u043C
    \u043F\u0438\u0432\u043E\u043C \u0441\u0432\u044F\u0437\u0430\u043D\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u0437 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439\r\n\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u044D\u0442\u0430
    \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u0430 \u041C\u0430\u044F\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u043F\u043E\u0435\u0437\u0434\u043A\u0438 \u043F\u043E\r\n\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u043C\u0443
    \u0421\u043E\u044E\u0437\u0443 \u0432 1927 \u0433. \u043F\u043E\u0441\u0435\u0442\u0438\u043B
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A. \u0415\u0433\u043E \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u043E\u0435
    \u0432\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435\r\n\u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0441\u044C
    27 \u043C\u0430\u0440\u0442\u0430 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u0442\u0435\u0430\u0442\u0440\u0430, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
    \u043F\u043E\u044D\u0442 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
    \u0433\u0443\u043B\u044F\u0442\u044C \u043F\u043E\r\n\u0433\u043E\u0440\u043E\u0434\u0443.
    \u041D\u0430 \u0443\u043B. \u0413\u043E\u0433\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    (\u043D\u044B\u043D\u0435 \u041B\u0435\u043D\u0438\u043D\u0430) \u041C\u0430\u044F\u043A\u043E\u0432\u0441\u043A\u0438\u0439
    \u043E\u0431\u0440\u0430\u0442\u0438\u043B \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043D\u0430\r\n\u0432\u044B\u0432\u0435\u0441\u043A\u0443 \u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C
    \u0440\u0430\u043A\u043E\u0432, \u043A\u0440\u0443\u0436\u043A\u0438 \u043F\u0438\u0432\u0430
    \u0438 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E: \xAB\u0417\u0430\u0432\u043E\u0434
    \u0438\u043C. \u0411\u0435\u0431\u0435\u043B\u044F\xBB (\u0432\r\n\u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435
    \u043D\u043E\u0441\u0438\u043B\u043E \u0438\u043C\u044F \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u0441\u043E\u0446\u0438\u0430\u043B-\u0434\u0435\u043C\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439\r\n\u043F\u0430\u0440\u0442\u0438\u0438
    \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438 \u0410\u0432\u0433\u0443\u0441\u0442\u0430
    \u0411\u0435\u0431\u0435\u043B\u044F).\r\n\u041C\u0430\u044F\u043A\u043E\u0432\u0441\u043A\u043E\u043C\u0443
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C\r\n\xAB\u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435\xBB
    \u0438\u043C\u0435\u043D\u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E-\u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0434\u0435\u044F\u0442\u0435\u043B\u044F \u0441 \u043F\u0435\u043D\u0438\u0441\u0442\u044B\u043C
    \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u043C, \u043E\r\n\u0447\u0451\u043C
    \u043E\u043D \u0432\u044B\u0441\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432
    \u0441\u0430\u0442\u0438\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0438
    \xAB\u041F\u0438\u0432\u043E \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u0438\u0437\u043C\xBB\r\n(\u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u043C\u044B\u0441\u043B\u0438\xBB). \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u043A\u0440\u0438\u0442\u0438\u043A\u0430 \u0432\u043E\u0437\u044B\u043C\u0435\u043B\u0430\r\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435,
    \u0442.\u043A. \u0437\u0430\u0432\u043E\u0434 \u0447\u0435\u0440\u0435\u0437
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u0438.\r\n\u0412
    \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u043F\u0438\u0432\u0437\u0430\u0432\u043E\u0434\u0430 \u0431\u044B\u043B\u043E\r\n\u044D\u0432\u0430\u043A\u0443\u0438\u0440\u043E\u0432\u0430\u043D\u043E
    \u0432 \u041F\u0435\u043D\u0437\u0435\u043D\u0441\u043A\u0443\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C,
