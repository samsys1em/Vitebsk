  m_Name: "09 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440
    \u0438 \u0434\u0443\u0445\u043E\u0432\u043D\u0430\u044F \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0438\u044F"
  m_EditorClassIdentifier: 
  _number: 9
  _name: "\u0423\u0441\u043F\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440
    \u0438 \u0434\u0443\u0445\u043E\u0432\u043D\u0430\u044F \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0438\u044F"
  _description: "\u0423\u0441\u043F\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440
    \u2013 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435
    \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439 \u0433\u043E\u0440\u044B.\r\n\u0415\u0449\u0435
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 XV \u0432. \u043D\u0430 \u044D\u0442\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u041F\u0440\u0435\u0441\u0432\u044F\u0442\u043E\u0439
    \u0411\u043E\u0433\u043E\u0440\u043E\u0434\u0438\u0446\u044B.\r\n\u0412 \u043D\u0430\u0447\u0430\u043B\u0435
    XVI \u0432. \u043F\u0440\u0438 \u0445\u0440\u0430\u043C\u0435 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
    \u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0446\u0438\u044F \u0430\u0440\u0445\u0438\u0435\u043F\u0438\u0441\u043A\u043E\u043F\u0430.
    \u0412 1619 \u0433., \u0441\r\n\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C
    \u0418\u043E\u0441\u0430\u0444\u0430\u0442\u0430 \u041A\u0443\u043D\u0446\u0435\u0432\u0438\u0447\u0430
    \u043F\u043E\u043B\u043E\u0446\u043A\u0438\u043C \u0430\u0440\u0445\u0438\u0435\u043F\u0438\u0441\u043A\u043E\u043F\u043E\u043C,
    \u041F\u0440\u0435\u0447\u0438\u0441\u0442\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n\u0431\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u0430
    \u0443\u043D\u0438\u0430\u0442\u0430\u043C \u0438 \u0441\u0442\u0430\u043B\u0430
    \u0430\u0440\u0445\u0438\u0435\u0440\u0435\u0439\u0441\u043A\u043E\u0439. \u041F\u043E\u0441\u043B\u0435
    \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0430\u043C\u0438
    \u0418. \u041A\u0443\u043D\u0446\u0435\u0432\u0438\u0447\u0430\r\n\u0437\u0430
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u043D\u0430\u0441\u0430\u0436\u0434\u0435\u043D\u0438\u0435
    \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0439 \u0432\u0435\u0440\u044B
    \u043F\u043E \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044E
    \u041A\u043E\u043C\u0438\u0441\u0441\u0430\u0440\u0441\u043A\u043E\u0433\u043E
    \u0441\u0443\u0434\u0430 \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n\u0431\u044B\u043B\u0430
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043D\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0437\u0430\u043D\u043E\u0432\u043E \u043E\u0442\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u0437\u0430 \u0441\u0432\u043E\u0439
    \u0441\u0447\u0451\u0442. \u041F\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C,\r\n\u0432
    1629 \u0433. \u0445\u0440\u0430\u043C \u0441\u0433\u043E\u0440\u0435\u043B, \u0432
    1636 \u0433. \u043D\u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u043D\u043E\u0432\u0443\u044E \u0446\u0435\u0440\u043A\u043E\u0432\u044C. \u0418\u043C\u0435\u043D\u043D\u043E
    \u044D\u0442\u043E\u0442 \u0445\u0440\u0430\u043C\r\n\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D
    \u043D\u0430 \u0427\u0435\u0440\u0442\u0435\u0436\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1664 \u0433.\r\n\u041D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 60 \u043B\u0435\u0442
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0445\u0440\u0430\u043C
    \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u043B\u0441\u044F
    \u0438\r\n\u043E\u0442\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0441\u044F
    \u0437\u0430\u043D\u043E\u0432\u043E. \u041F\u0440\u0438\u0447\u0438\u043D\u044B
    \u0442\u043E\u043C\u0443 \u2013 \u043E\u0431\u0432\u0435\u0442\u0448\u0430\u043D\u0438\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u043F\u043E\u0436\u0430\u0440\u044B.
    \u0412 \u0445\u043E\u0434\u0435 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043A,
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0439
    \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0437\u0435\u043C\u0441\u043A\u043E\u0433\u043E \u043F\u0438\u0441\u0430\u0440\u044F
    \u0410\u0434\u0430\u043C\u0430 \u041A\u0438\u0441\u0435\u043B\u044F \u0432\r\n1682
    \u0433., \u0440\u044F\u0434\u043E\u043C \u0441 \u0445\u0440\u0430\u043C\u043E\u043C
    \u0431\u044B\u043B \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D \u043A\u043E\u0440\u043F\u0443\u0441
    \u0431\u0430\u0437\u0438\u043B\u0438\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F.\r\n\u0412 1743 \u0433.
    \u043A\u0441\u0435\u043D\u0434\u0437\u0430\u043C\u0438-\u0431\u0430\u0437\u0438\u043B\u0438\u0430\u043D\u0430\u043C\u0438
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0433\u043E\u0440\u043E\u0436\u0430\u043D
    \u0431\u044B\u043B\u043E \u043D\u0430\u0447\u0430\u0442\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435\r\n\u043D\u043E\u0432\u043E\u0439
    \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u0432 \u0447\u0435\u0441\u0442\u044C \u0423\u0441\u043F\u0435\u043D\u0438\u044F
    \u041F\u0440\u0435\u0441\u0432\u044F\u0442\u043E\u0439 \u0411\u043E\u0433\u043E\u0440\u043E\u0434\u0438\u0446\u044B
    \u0438 \u0441\u0432.\r\n\u043C\u0443\u0447\u0435\u043D\u0438\u043A\u0430 \u0418\u043E\u0441\u043E\u0444\u0430\u0442\u0430.
    \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0441
    \u0445\u0440\u0430\u043C\u043E\u043C \u043D\u0430\u0447\u0430\u043B\u0438 \u0432\u043E\u0437\u0432\u043E\u0434\u0438\u0442\u044C
    \u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F\r\n\u0431\u0430\u0437\u0438\u043B\u0438\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F. \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0432\u0435\u043B\u043E\u0441\u044C \u043F\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0443
    \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u043E\u0433\u043E \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430\r\n\u0418\u043E\u0441\u0438\u0444\u0430
    (\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435) \u0424\u043E\u043D\u0442\u0430\u043D\u0430
    (III). \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
    \u0437\u0430 \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u043E\u043D \u0432\u0437\u044F\u043B
    \u0431\u0430\u0437\u0438\u043B\u0438\u043A\u0443 \u0421\u0430\u043D-\r\n\u041A\u0430\u0440\u043B\u043E-\u0430\u043B\u044C-\u041A\u043E\u0440\u0441\u043E
    \u0432 \u0420\u0438\u043C\u0435. \u041F\u043E\u043D\u0430\u0447\u0430\u043B\u0443
    \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0432\u0435\u043B\u043E\u0441\u044C \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u043D\u043E,
    \u043D\u043E \u0441 \u0433\u043E\u0434\u0430\u043C\u0438\r\n\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C.
    \u041E\u0441\u0432\u044F\u0449\u0435\u043D\u0438\u0435 \u0445\u0440\u0430\u043C\u0430
    \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0441\u044C \u043B\u0438\u0448\u044C
    \u0432 1785 \u0433. \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F,\r\n\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
    \u0431\u044B\u043B\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E
    \u0440\u0430\u043D\u044C\u0448\u0435. \u041E\u0431\u0430 \u0437\u0434\u0430\u043D\u0438\u044F
    \u0438\u043C\u0435\u043B\u0438 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0447\u0435\u0440\u0442\u044B \u043F\u043E\u0437\u0434\u043D\u0435\u0433\u043E\r\n\u0431\u0430\u0440\u043E\u043A\u043A\u043E.
    \u0425\u0440\u0430\u043C \u0441\u0442\u0430\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u0439
    \u0436\u0435\u043C\u0447\u0443\u0436\u0438\u043D\u043E\u0439 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430.
    \u0412 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0438\r\n\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E-\u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0431\u0430\u0437\u0438\u043B\u0438\u0430\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
    \u0437\u0430\u043D\u0438\u043C\u0430\u043B \u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0435\r\n\u043C\u0435\u0441\u0442\u043E.
    \u0418\u043C\u0435\u043D\u043D\u043E \u0432 \u0435\u0433\u043E \u0430\u0440\u0445\u0438\u0432\u0435
    \u0445\u0440\u0430\u043D\u0438\u043B\u0430\u0441\u044C \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
    \u0433\u0440\u0430\u043C\u043E\u0442\u0430 1641 \u0433. \u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0443
    \u041C\u0430\u0433\u0434\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430, \u043F\u0440\u0430\u0432\u0430 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u0430 1681 \u0433. \u043D\u0430
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0438\r\n\u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
    \u0440\u044F\u0434\u044B \u043F\u043E\u0434 \u0440\u0430\u0442\u0443\u0448\u0435\u0439.\r\n\u0412\u043E\u043A\u0440\u0443\u0433
    \u0446\u0435\u0440\u043A\u0432\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u0435 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435.
    \u0421 \u0441\u0435\u0432\u0435\u0440\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F\r\n\u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0441\u0430\u0434. \u0412\u0434\u043E\u043B\u044C \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0444\u0430\u0441\u0430\u0434\u0430 \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u0414\u0432\u0438\u043D\u044B \u0431\u044B\u043B \u0440\u0430\u0437\u0431\u0438\u0442
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u0438\u0439\r\n\u043E\u0433\u043E\u0440\u043E\u0434,
    \u043E\u0433\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u043E\u0433\u0440\u0430\u0434\u043E\u0439.
    \u0423\u043B\u0438\u0446\u044B (\u0431\u0443\u043B\u044C\u0432\u0430\u0440\u0430),
    \u0438\u0434\u0443\u0449\u0435\u0439 \u043F\u043E \u0431\u0435\u0440\u0435\u0433\u0443\r\n\u043A
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u043C\u0443
    \u0434\u0432\u043E\u0440\u0446\u0443, \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043D\u0435 \u0431\u044B\u043B\u043E. \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
    \u043E\u043D\u0430 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u043F\u043E\u0441\u043B\u0435
    \u0442\u043E\u0433\u043E,\r\n\u043A\u0430\u043A \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
    \u0441 \u0443\u043A\u0430\u0437\u043E\u043C \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430
    \u041F\u0430\u0432\u043B\u0430 I \u043E\u0442 18 \u0438\u044E\u043B\u044F 1799
    \u0433. \u0431\u0430\u0437\u0438\u043B\u0438\u0430\u043D\u0441\u043A\u0438\u0439\r\n\u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
    \u0438 \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u044B
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u043C\u0443
    \u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u0443, \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u0447\u0435\u0433\u043E \u0445\u0440\u0430\u043C\r\n\u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u0442\u0430\u0442\u0443\u0441 \u0441\u043E\u0431\u043E\u0440\u0430, \u0430
    \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u0438\u0445
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0441\u044C
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0435\r\n\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435,
    \u043A\u0430\u0437\u0435\u043D\u043D\u0430\u044F \u043F\u0430\u043B\u0430\u0442\u0430
    \u0438 \u043F\u0440\u0438\u0447\u0442 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0431\u043E\u0440\u0430.\r\n\u041D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    XIX \u0432. \u0445\u0440\u0430\u043C \u0431\u044B\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u043E\u0432\u0430\u043D,
    \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0447\u0435\u0433\u043E\r\n\u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0435
    \u0432 \u0441\u0442\u0438\u043B\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0433\u043E
    \u0431\u0430\u0440\u043E\u043A\u043A\u043E \u0437\u0434\u0430\u043D\u0438\u0435
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u043E \u0447\u0435\u0440\u0442\u044B
    \u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C\u0430 (\u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F\r\n\u043A\u0443\u043F\u043E\u043B
    \u0441 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435\u043C \u0432
    \u0432\u0438\u0434\u0435 \u043C\u0430\u043A\u043E\u0432\u043A\u0438, \u043A\u0440\u0438\u0432\u043E\u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0435
    \u0431\u0430\u0440\u043E\u0447\u043D\u044B\u0435 \u0444\u0440\u043E\u043D\u0442\u043E\u043D\u044B
    \u0431\u044B\u043B\u0438\r\n\u0438\u0437\u043C\u0435\u043D\u0435\u043D\u044B
    \u043D\u0430 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435,
    \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F
    \u0434\u0432\u0443\u0445 \u0431\u0430\u0448\u0435\u043D \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0444\u0430\u0441\u0430\u0434\u0430).\r\n\u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u0438
    \u0441\u043E\u0431\u043E\u0440 \u0431\u044B\u043B \u0437\u0430\u043A\u0440\u044B\u0442.
    \u0412 1936 \u0433. \u0432 \u0445\u043E\u0434\u0435 \u0442\u0430\u043A\r\n\u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u043E\u0439
    \xAB\u0431\u0435\u0437\u0431\u043E\u0436\u043D\u043E\u0439 \u043F\u044F\u0442\u0438\u043B\u0435\u0442\u043A\u0438\xBB
    \u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u043C\u0435\u0441\u0442\u043D\u044B\u0445
    \u0432\u043B\u0430\u0441\u0442\u0435\u0439 \u0445\u0440\u0430\u043C \u0431\u044B\u043B
    \u0432\u0437\u043E\u0440\u0432\u0430\u043D. \u041F\u043E\r\n\u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0432\u0448\u0435\u0433\u043E
    \u043F\u043E\u0434\u0440\u044B\u0432\u043D\u044B\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043C\u0438
    \u0441\u0430\u043F\u0435\u0440\u0430 \u041F\u0435\u0442\u0440\u0430 \u0413\u0440\u0438\u0433\u043E\u0440\u0435\u043D\u043A\u043E,\r\n\xAB\u0432\u0437\u0440\u044B\u0432\u0430
    \u0432 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u043C \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0438
    \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
    \u0433\u0443\u043B \u0438 \u0442\u0440\u0435\u0441\u043A\u043E\u0442\u043D\u044F
    \u0441\u044B\u043F\u043B\u044E\u0449\u0438\u0445\u0441\u044F\r\n\u0441\u0432\u0435\u0440\u0445\u0443
    \u043A\u0438\u0440\u043F\u0438\u0447\u0435\u0439\u2026 \u0425\u0440\u0430\u043C
    \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0441\u0435\u043B, \u0438\u0437\u0434\u0430\u0432
    \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439 \u0441\u0442\u043E\u043D,
    \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0432
    \u0433\u0440\u0443\u0434\u0443\r\n\u043A\u0438\u0440\u043F\u0438\u0447\u0435\u0439\xBB.
    \u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u0441\u0442\u043E\u044F\u0432\u0448\u0438\u0439
    \u0440\u044F\u0434\u043E\u043C \u0434\u043E\u043C \u0432\u043E\u043E\u0431\u0449\u0435
    \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B.\r\n\u0412
    1949 \u0433. \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0441\u043E\u0431\u043E\u0440\u0430
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u0446\u0435\u0445 \u0437\u0430\u0432\u043E\u0434\u0430
    \u0437\u0430\u0442\u043E\u0447\u043D\u044B\u0445 \u0441\u0442\u0430\u043D\u043A\u043E\u0432.
    \u041F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435\r\n\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
    \u043D\u0430 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439 \u0433\u043E\u0440\u043A\u0435
    \u0434\u043E 1980-\u0445 \u0433\u0433., \u043F\u043E\u0442\u043E\u043C \u0431\u044B\u043B\u043E
    \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043D\u043E \u0432 \u043D\u043E\u0432\u044B\u0435
    \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u043F\u043E \u043F\u0440. \u0424\u0440\u0443\u043D\u0437\u0435.
    \u0417\u0434\u0430\u043D\u0438\u0435 \u043D\u0430 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439
    \u0433\u043E\u0440\u043A\u0435 \u0431\u044B\u043B\u043E \u0441\u043D\u0435\u0441\u0435\u043D\u043E
    \u0432 1998 \u0433.\r\n\u0412 1990-\u0445 \u0433\u0433. \u0431\u044B\u043B \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D
    \u043F\u0440\u043E\u0435\u043A\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u0445\u0440\u0430\u043C\u0430 \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u0446\u0443
    \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0433\u043E\r\n\u0441\u043E\u0431\u043E\u0440\u0430
    XVIII \u0432. \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439
    \u0432 \u0445\u043E\u0434\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043D\u0430\u0447\u0430\u043B\u0430 XIX \u0432. (\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u044B
    \u0418.\r\n\u0420\u043E\u0442\u044C\u043A\u043E, \u0410. \u041C\u0438\u0445\u0430\u0439\u043B\u044E\u043A\u043E\u0432).
    \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0431\u044B\u043B\u0438 \u043D\u0430\u0447\u0430\u0442\u044B \u0432 \u0438\u044E\u043D\u0435
    2000 \u0433. \u0438\r\n\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0438\u0441\u044C
    10 \u043B\u0435\u0442. 7 \u0430\u043F\u0440\u0435\u043B\u044F 2011 \u0433. \u0432
    \u0441\u043E\u0431\u043E\u0440\u0435 \u043F\u0440\u043E\u0448\u043B\u0430 \u043F\u0435\u0440\u0432\u0430\u044F
    \u0441\u043B\u0443\u0436\u0431\u0430 \u043F\u043E\u0441\u043B\u0435\r\n\u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438.
    \u0421 \u044D\u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0445\u0440\u0430\u043C \u043E\u0442\u043A\u0440\u044B\u0442 \u0434\u043B\u044F
    \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u044F. \u0420\u0430\u0437\u043C\u0435\u0440
    \u0445\u0440\u0430\u043C\u0430 \u2013 55 \u043D\u0430 33\r\n\u043C\u0435\u0442\u0440\u0430.
    \u041E\u0431\u0449\u0430\u044F \u0432\u044B\u0441\u043E\u0442\u0430 \u2013 51,4
    \u043C\u0435\u0442\u0440\u0430."
