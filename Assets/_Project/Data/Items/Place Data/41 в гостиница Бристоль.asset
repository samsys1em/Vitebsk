  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "41 \u0432 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C"
  m_EditorClassIdentifier: 
  _number: 41
  _name: "\u0432 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C"
  _description: "\u0413\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \xAB\u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C\xBB
    \u0431\u044B\u043B\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430 \u0432 1903
    \u0433. \u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0443\u043B.\r\n\u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439,
    \u0431\u044B\u043B\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
    \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430\u0431\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u041F\u0440\u0438 \u0433\u043E\u0442\u0438\u043D\u0438\u0446\u0435\r\n\u0438\u043C\u0435\u043B\u0438\u0441\u044C
    \xAB\u0440\u043E\u0441\u043A\u043E\u0448\u043D\u0435\u0439\u0448\u0438\u0439
    \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D, \u0431\u0438\u043B\u043B\u0438\u0430\u0440\u0434,
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u044B, \u0432\u0430\u043D\u043D\u044B\xBB.
    \u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C\r\n\u044D\u0442\u0430\u0436\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u043B\u0430\u0432\u043A\u0438 \u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B,
    \u0432 \u0442.\u0447. \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0430\u044F
    \u043C\u043E\u043B\u043E\u0447\u043D\u0430\u044F,\r\n\u043C\u0430\u043D\u0443\u0444\u0430\u043A\u0442\u0443\u0440\u043D\u044B\u0439
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0431\u0440\u0430\u0442\u044C\u0435\u0432
    \u0421\u0442\u0435\u0440\u043D\u0438\u043D\u044B\u0445, \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0439
    \u0438 \u0433\u0430\u043B\u0430\u043D\u0442\u0435\u0440\u0435\u0439\u043D\u044B\u0439\r\n\u043C\u0430\u0433\u0430\u0437\u0438\u043D.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C.
    \u0412 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043E,
    \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0432 \u0445\u043E\u0434\u0435 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
    \u0443\u043B. \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439.\r\n\u0412 \u0447\u0438\u0441\u043B\u0435
    \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044C\u0446\u0435\u0432 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B
    \u0431\u044B\u043B\u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0441\u0442\u0438.
    \u0422\u0430\u043A, \u0432 1908\r\n\u0433. \u0437\u0434\u0435\u0441\u044C \u0436\u0438\u043B\u0438
    \u0430\u043A\u0442\u0435\u0440\u044B \u0442\u0440\u0443\u043F\u043F\u044B \u0412\u0441\u0435\u0432\u043E\u043B\u043E\u0434\u0430
    \u041C\u0435\u0439\u0435\u0440\u0445\u043E\u043B\u044C\u0434\u0430, \u0430 \u0432
    1930-\u0445 \u2013 \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\r\n\u043E\u0440\u043A\u0435\u0441\u0442\u0440\u0430
    \u041B\u0435\u043E\u043D\u0438\u0434\u0430 \u0423\u0442\u0435\u0441\u043E\u0432\u0430."
  _preview: {fileID: 21300000, guid: 73e152816ca4a6f43914ad8795e530c9, type: 3}
  _images:
  - _title: "\u0413\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0435 \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439.
      \u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425 \u0432."
    _image: {fileID: 21300000, guid: 2a224fc0506793249919e495f348e05e, type: 3}
  - _title: "\u0413\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C
      \u043D\u0430 \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439 \u0443\u043B\u0438\u0446\u0435.
      \u0414\u043E\u043C\u043E\u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0435 \u0431\u0430\u043D\u043A\u0438\u0440\u0430
      \u0412\u0438\u0448\u043D\u044F\u043A\u0430. \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430
      \u043D\u0430\u0447\u0430\u043B\u0430 XX \u0432\u0435\u043A\u0430"
    _image: {fileID: 21300000, guid: a9ed228b133921e468e6838de3114757, type: 3}
  - _title: "\u0423\u043B\u0438\u0446\u0430 \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F
      \u0438 \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u0432\u0448\u0435\u0439
      \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B \u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C.
      1941-1944 \u0433\u0433."
