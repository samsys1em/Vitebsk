  m_Name: "39 \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0435 \u0436\u0435\u043D\u0441\u043A\u043E\u0435
    \u0435\u043F\u0430\u0440\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  m_EditorClassIdentifier: 
  _number: 39
  _name: "\n\u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0435 \u0436\u0435\u043D\u0441\u043A\u043E\u0435
    \u0435\u043F\u0430\u0440\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  _description: "1 \u0416\u0435\u043D\u0441\u043A\u043E\u0435 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435 \u0438 \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0421\u0432. \u0414\u0443\u0445\u0430. 1906 \u0433.\r\n2 \u0416\u0435\u043D\u0441\u043A\u043E\u0435
    \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435 \u0443\u0447\u0438\u043B\u0438\u0449\u0435
    \u0438 \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0414\u0443\u0445\u0430.
    \u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425 \u0432.\r\n3 \u0416\u0435\u043D\u0441\u043A\u043E\u0435
    \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0435 \u0443\u0447\u0438\u043B\u0438\u0449\u0435.
    1914 \u0433.\r\n4 \u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0414\u0443\u0445\u0430
    \u0438 \u0437\u0434\u0430\u043D\u0438\u0435 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u043B\u0438\u0441\u043F\u043E\u043B\u043A\u043E\u043C\u0430. 1941\u20131944
    \u0433\u0433.\r\n\u0424\u043E\u0442\u043E\u0430\u0440\u0445\u0438\u0432 \u0412.
    \u0411\u043E\u0440\u0438\u0441\u0435\u043D\u043A\u043E\u0432\u0430\r\n5 \u0417\u0434\u0430\u043D\u0438\u0435
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u043B\u0438\u0441\u043F\u043E\u043B\u043A\u043E\u043C\u0430.
    1970-\u0435 \u0433\u0433.\r\n6 \u0417\u0434\u0430\u043D\u0438\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u043B\u0438\u0441\u043F\u043E\u043B\u043A\u043E\u043C\u0430. 2010-\u0435
    \u0433\u0433.\r\n7 \u0417\u0434\u0430\u043D\u0438\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u043B\u0438\u0441\u043F\u043E\u043B\u043A\u043E\u043C\u0430. 2010-\u0435
    \u0433\u0433.\r\n8 \u0417\u0434\u0430\u043D\u0438\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u043B\u0438\u0441\u043F\u043E\u043B\u043A\u043E\u043C\u0430. \u041D\u0430
    \u043C\u0435\u0441\u0442\u0435 \u0446\u0435\u0440\u043A\u0432\u0438 \u0421\u0432.
    \u0414\u0443\u0445\u0430 \u2013 \u0431\u0430\u0448\u043D\u044F \u0441\r\n\u0447\u0430\u0441\u0430\u043C\u0438.
    2000-\u0435 \u0433\u0433."
