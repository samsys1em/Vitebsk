  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "06 \u0414\u0443\u0445\u043E\u0432\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C2"
  m_EditorClassIdentifier: 
  _number: 6
  _name: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0414\u0443\u0445\u0430
    \u0438 \u0436\u0435\u043D\u0441\u043A\u043E\u0435 \u0435\u043F\u0430\u0440\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435"
  _description: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432\u044F\u0442\u043E\u0433\u043E
    \u0414\u0443\u0445\u0430 \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u043F\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u044F\r\n\u0445\u0440\u0430\u043C\u043E\u0432
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430. \u041E\u043D\u0430 \u0431\u044B\u043B\u0430
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0432 XIV \u0432. \u0432\u0435\u043B\u0438\u043A\u0438\u043C
    \u043A\u043D\u044F\u0437\u0435\u043C \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u043C,\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u043C
    \u0438 \u043A\u0440\u0435\u0432\u0441\u043A\u0438\u043C \u041E\u043B\u044C\u0433\u0435\u0440\u0434\u043E\u043C
    \u043D\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
    \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u0439 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\r\n\u0414\u0443\u0445\u043E\u0432\u0441\u043A\u0430\u044F
    \u0433\u043E\u0440\u0430. \u0412 XIV \u0432. \u0432\u0442\u043E\u0440\u0430\u044F
    \u0436\u0435\u043D\u0430 \u043A\u043D\u044F\u0437\u044F \u041E\u043B\u044C\u0433\u0435\u0440\u0434\u0430
    \u0423\u043B\u044C\u044F\u043D\u0438\u044F \u043E\u0441\u043D\u043E\u0432\u0430\u043B\u0430
    \u043F\u0440\u0438\r\n\u0446\u0435\u0440\u043A\u0432\u0438 \u0421\u0432. \u0414\u0443\u0445\u0430
    \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C,
    \u0433\u0434\u0435 \u043F\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435 \u0438
    \u0431\u044B\u043B\u0430 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u0430.\r\n\u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0438 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
    \u0431\u044B\u043B\u0438 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C\u0438,
    \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u0430\u043B\u0438\r\n\u0443\u043D\u0438\u0430\u0442\u0441\u043A\u0438\u043C\u0438.
    \u0412 \u043A\u043E\u043D\u0446\u0435 XVIII \u0432. \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0432 \u0431\u0430\u0440\u043E\u0447\u043D\u043E\u043C\r\n\u0441\u0442\u0438\u043B\u0435
    \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043C\u0435\u0449\u0430\u043D\u0438\u043D\u0430
    \u041F\u043E\u0442\u0430\u043F\u0430 \u0411\u0438\u0431\u043A\u0438 \u0438 \u0435\u0433\u043E
    \u0441\u044B\u043D\u043E\u0432\u0435\u0439. \u0412 1839 \u0433., \u043F\u043E\u0441\u043B\u0435\r\n\u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u0443\u043D\u0438\u0430\u0442\u043E\u0432 \u043A \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u0438\u044E,
    \u0445\u0440\u0430\u043C \u0441\u043D\u043E\u0432\u0430 \u0441\u0442\u0430\u043B
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C, \u043A
    1870\r\n\u0433\u043E\u0434\u0443 \u0431\u044B\u043B \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D
    \u0432 \u043F\u0441\u0435\u0432\u0434\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u043C
    \u0441\u0442\u0438\u043B\u0435.\r\n\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
    \u043F\u0440\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u043E\u043A\u043E\u043B\u043E 500 \u043B\u0435\u0442. \u041A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    XI\u0425 \u0432. \u043E\u043D \u043F\u0440\u0438\u0448\u0435\u043B \u0432\r\n\u0443\u043F\u0430\u0434\u043E\u043A.
    \u041F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D\u0438\u044F
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u0436\u0435\u043D\u0441\u043A\u0430\u044F\r\n\u0442\u044E\u0440\u044C\u043C\u0430,
    \u0430 \u0441 1872 \u0433. \u2013 \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0435
    \u0436\u0435\u043D\u0441\u043A\u043E\u0435 \u0435\u043F\u0430\u0440\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435. \u0426\u0435\u0440\u043A\u043E\u0432\u044C
    \u0421\u0432.\r\n\u0414\u0443\u0445\u0430 \u0441\u0442\u0430\u043B\u0430 \u0434\u043E\u043C\u043E\u0432\u043E\u0439
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\u044E \u044D\u0442\u043E\u0433\u043E
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F \u0443\u0447\u0438\u043B\u0438\u0449\u0430
    (1917 \u0433.) \u0445\u0440\u0430\u043C \u0431\u044B\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u0434\u043E 1923 \u0433. \u0412\r\n\u0437\u0434\u0430\u043D\u0438\u0438 \u0443\u0447\u0438\u043B\u0438\u0449\u0430
    \u0441 1926 \u0433. \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
    \u0448\u0442\u0430\u0431 2-\u0439 \u0430\u0432\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0431\u0440\u0438\u0433\u0430\u0434\u044B, \u0441 1938 \u0433.\r\n\u2013 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442.\r\n\u0412 \u043D\u0430\u0447\u0430\u043B\u0435
    1960-\u0445 \u0433\u0433. \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u043E\u0435
    \u0432 \u0433\u043E\u0434\u044B \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0435
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u043E\r\n\u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E. \u0412 1980-\u0445 \u0433\u0433.
    \u043D\u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435 \u0432\u043E\u0437\u0432\u0435\u043B\u0438
    \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0439\u043A\u0443 \u043A\r\n\u0437\u0434\u0430\u043D\u0438\u044E
    \u043E\u0431\u043B\u0438\u0441\u043F\u043E\u043B\u043A\u043E\u043C\u0430 \u0441
    \u0431\u0430\u0448\u043D\u0435\u0439 \u0438 \u0447\u0430\u0441\u0430\u043C\u0438."
  _preview: {fileID: 21300000, guid: b7c597b49fa4d1b4bb9929fd6ef92570, type: 3}
  _images:
  - _title: "\u0414\u0443\u0445\u043E\u0432\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
      \u043D\u0430 \u0430\u043A\u0432\u0430\u0440\u0435\u043B\u0438 \u042E. \u041F\u0435\u0448\u043A\u0438.
