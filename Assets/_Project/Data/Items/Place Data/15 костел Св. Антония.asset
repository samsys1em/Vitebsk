  m_Name: "15 \u043A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0410\u043D\u0442\u043E\u043D\u0438\u044F"
  m_EditorClassIdentifier: 
  _number: 15
  _name: "\u041A\u043E\u0441\u0442\u0435\u043B \u0421\u0432\u044F\u0442\u043E\u0433\u043E
    \u0410\u043D\u0442\u043E\u043D\u0438\u044F"
  _description: "\u041A\u043E\u0441\u0442\u0435\u043B \u0421\u0432\u044F\u0442\u043E\u0433\u043E
    \u0410\u043D\u0442\u043E\u043D\u0438\u044F \u2013 \u0432\u0430\u0436\u043D\u0430\u044F
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0430\u044F \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u0420\u044B\u043D\u043A\u043E\u0432\u043E\u0439\r\n\u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435, \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0445
    \u0430\u043D\u0441\u0430\u043C\u0431\u043B\u0435\u0439,\r\n\u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438 \u0441\u043B\u043E\u0436\u0438\u043B\u0441\u044F
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0430\u0445 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438.
    \u0412 \u0446\u0435\u043D\u0442\u0440\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u0438,\r\n\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435,
    \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u0442\u043E\u0447\u043A\u0435 \u0440\u0435\u043B\u044C\u0435\u0444\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
    \u0440\u0430\u0442\u0443\u0448\u0430, \u0430 \u043F\u043E \u043E\u0431\u0435\u0438\u043C\r\n\u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C
    \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u043D\u0438\u0437\u043A\u0438\u0445
    \u0442\u043E\u0447\u043A\u0430\u0445 \u0440\u0435\u043B\u044C\u0435\u0444\u0430
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u0445\u0440\u0430\u043C\u044B
    \u2013 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0438 \u043A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0410\u043D\u0442\u043E\u043D\u0438\u044F.
    \u0422\u0430\u043A\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u043E
    \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u0443\u044E\r\n\u041C\u0438\u043A\u0435\u043B\u0430\u043D\u0434\u0436\u0435\u043B\u043E
    \u0432 XVI \u0432. \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u041A\u0430\u043F\u0438\u0442\u043E\u043B\u0438\u044F
    \u0432 \u0420\u0438\u043C\u0435 \u2013 \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u043E\u0435
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E\r\n\u0432
    \u0432\u0438\u0434\u0435 \u0442\u0440\u0430\u043F\u0435\u0446\u0438\u0438 \u0441
    \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430\u043C\u0438
    \u043F\u043E \u0435\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u043C \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C.\r\n\u041A\u0430\u043C\u0435\u043D\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u043A\u043E\u0441\u0442\u0435\u043B\u0430
    \u0421\u0432. \u0410\u043D\u0442\u043E\u043D\u0438\u044F \u0431\u044B\u043B\u043E
    \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E\r\n\u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0433\u043E
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u0431\u0435\u0440\u043D\u0430\u0440\u0434\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    \u0432 \u043E\u0434\u043D\u043E \u0432\u0440\u0435\u043C\u044F \u0441\r\n\u0440\u0430\u0442\u0443\u0448\u0435\u0439
    \u0438 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\u044E \u2013 \u0432 1737\u20131768
    \u0433\u0433. \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0432\u0435\u043B\u043E\u0441\u044C \u043F\u043E\r\n\u043F\u0440\u043E\u0435\u043A\u0442\u0443
    \u0418\u043E\u0441\u0438\u0444\u0430 (\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435)
    \u0424\u043E\u043D\u0442\u0430\u043D\u0430 (III), \u0438\u0437 \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u0438
    \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u0445 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u043E\u0432\r\n(\u043A\u0430\u043D\u0442\u043E\u043D
    \u0422\u0438\u0447\u0438\u043D\u043E). \u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0444\u0430\u0441\u0430\u0434 \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u0438\u043C\u0435\u043B
    \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u044B\u0435 \u0434\u043B\u044F
    \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445\r\n\u0445\u0440\u0430\u043C\u043E\u0432
    \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u0438: \u043E\u043D \u0431\u044B\u043B
    \u0440\u0430\u0441\u0442\u044F\u043D\u0443\u0442 \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438,
    \u0447\u0442\u043E \u043F\u0440\u0438\u0434\u0430\u0432\u0430\u043B\u043E \u0435\u043C\u0443\r\n\u043F\u0440\u0438\u0441\u0430\u0434\u0438\u0441\u0442\u044B\u0439
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440. \u0411\u0430\u0448\u043D\u0438,
    \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0438\u0435 \u0437\u0430
    \u043B\u0438\u043D\u0438\u044E \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0444\u0430\u0441\u0430\u0434\u0430,\r\n\u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0438\u0441\u044C
    \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043B\u0438\u0441\u044C \u0441\u043B\u043E\u0436\u043D\u043E\u0439
    \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u043E\u0442\u0434\u0435\u043B\u043A\u043E\u0439.\r\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0447\u0442\u043E \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0438 \u043E\u0442
    \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0445
    \u0445\u0440\u0430\u043C\u043E\u0432 \u043A\u043E\u0441\u0442\u0451\u043B \u0421\u0432.\r\n\u0410\u043D\u0442\u043E\u043D\u0438\u044F
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043B\u0441\u044F
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438.\r\n\u0412
    1889 \u0433. \u043A\u043E\u0441\u0442\u0435\u043B \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u043B \u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
    \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044F \u0418\u0432\u0430\u043D\u0430
    \u0411\u0443\u043D\u0438\u043D\u0430,\r\n\u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u043F\u0440\u043E\u0435\u0437\u0434\u043E\u043C,
    \u0447\u0442\u043E \u043E\u043D \u043F\u043E\u0441\u0432\u044F\u0442\u0438\u043B
    \u0435\u043C\u0443 \u043E\u0434\u043D\u043E \u0438\u0437 \u0441\u0432\u043E\u0438\u0445
    \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0439\r\n\u2013
    \xAB\u0412 \u043A\u043E\u0441\u0442\u0435\u043B\u0435\xBB. \u041E \u043A\u043E\u0441\u0442\u0435\u043B\u0435
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435, \u0433\u0434\u0435 \u043E\u043D
    \u0441\u043B\u0443\u0448\u0430\u043B \u043E\u0440\u0433\u0430\u043D \u0438 \u043F\u0435\u043D\u0438\u0435
    \u0445\u043E\u0440\u043E\u0432, \u0411\u0443\u043D\u0438\u043D\r\n\u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u0432 \u0430\u0432\u0442\u043E\u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0440\u043E\u043C\u0430\u043D\u0435 \xAB\u0416\u0438\u0437\u043D\u044C \u0410\u0440\u0441\u0435\u043D\u044C\u0435\u0432\u0430\xBB.\r\n\u041F\u0440\u0438
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u0438
    \u0445\u0440\u0430\u043C \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432 1940 \u0433. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
    \u0434\u043E \u043D\u0430\u0447\u0430\u043B\u0430\r\n\u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F
    \u0430\u043D\u0442\u0438\u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u044B\u0439
    \u043C\u0443\u0437\u0435\u0439, \u0432 \u0447\u0438\u0441\u043B\u0435 \u044D\u043A\u0441\u043F\u043E\u043D\u0430\u0442\u043E\u0432\r\n\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0431\u044B\u043B\u0438 \u043C\u043E\u0449\u0438 \u0415\u0432\u0444\u0440\u043E\u0441\u0438\u043D\u0438\u0438
    \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0439. \u041A\u0440\u043E\u043C\u0435
    \u0442\u043E\u0433\u043E, \u0437\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E\r\n\u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043C\u0430\u044F\u0442\u043D\u0438\u043A
    \u0424\u0443\u043A\u043E, \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0438\u0439
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0417\u0435\u043C\u043B\u0438.\r\n\u0412
    \u0433\u043E\u0434\u044B \u0432\u043E\u0439\u043D\u044B \u0445\u0440\u0430\u043C
    \u0431\u044B\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C.
    \u041F\u043E\u0441\u043B\u0435 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u043E\u0435\r\n\u0437\u0434\u0430\u043D\u0438\u0435
    \u0441 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u043C\u0438
    \u0431\u0430\u0448\u043D\u044F\u043C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B\u043E
    \u043F\u043E\u0447\u0442\u0438 15 \u043B\u0435\u0442.\r\n\u041E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043A\u043E\u0441\u0442\u0451\u043B \u0431\u044B\u043B \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D
    \u0432 1961 \u0433. \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435
    \u2013\r\n\u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430 \u0440\u044F\u0434\u043E\u043C
    \u0441 \u0444\u043E\u043D\u0442\u0430\u043D\u043E\u043C \xAB\u0421\u043B\u0438\u044F\u043D\u0438\u0435
    \u0442\u0440\u0435\u0445 \u0440\u0435\u043A\xBB."
