  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "01 \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 1
  _name: "\u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435,
    \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u043C\u043E\u0439 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043B\u0435\u0442\u043E\u043F\u0438\u0441\u0438
    XVII\u2013\r\n\u0425VIII \u0432\u0432., \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u0443\u044E
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u043E\u0441\u043D\u043E\u0432\u0430\u043B\u0430 \u043A\u0438\u0435\u0432\u0441\u043A\u0430\u044F
    \u043A\u043D\u044F\u0433\u0438\u043D\u044F \u041E\u043B\u044C\u0433\u0430:\r\n\xAB\u0412
    \u043B\u0435\u0442\u043E 974 \u0433\u043E\u0434\u0430 \u041E\u043B\u044C\u0433\u0430,
    \u043F\u043E\u0431\u0435\u0434\u0438\u0432 \u044F\u0442\u0432\u044F\u0433\u043E\u0432
    \u0438 \u043F\u0435\u0447\u0435\u043D\u0435\u0433\u043E\u0432, \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043A\u0443\r\n\u0414\u0432\u0438\u043D\u0443
    \u0438 \u0441 \u0432\u043E\u0439\u0441\u043A\u043E\u043C \u0437\u0430\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0430.
    \u041F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0435\u0439
    \u0433\u043E\u0440\u0430, \u0438 \u043E\u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043B\u0430
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439\r\n\u0437\u0430\u043C\u043E\u043A,
    \u043D\u0430\u0437\u0432\u0430\u0432 \u0435\u0433\u043E \u043E\u0442 \u0440\u0435\u043A\u0438
    \u0412\u0438\u0442\u044C\u0431\u044B \u2013 \u0412\u0438\u0442\u044C\u0431\u0435\u0441\u043A,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0430 \u0432 \u0412\u0435\u0440\u0445\u043D\u0435\u043C
    \u0437\u0430\u043C\u043A\u0435\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0441\u0432. \u041C\u0438\u0445\u0430\u0438\u043B\u0430, \u0430 \u0432 \u041D\u0438\u0436\u043D\u0435\u043C
    \u2013 \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0438\u044F
    \u0438, \u043F\u0440\u043E\u0431\u044B\u0432 \u0434\u0432\u0430 \u0433\u043E\u0434\u0430,\r\n\u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
    \u0432 \u041A\u0438\u0435\u0432\xBB.\r\n\u041E\u0434\u043D\u0430\u043A\u043E
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0444\u0430\u043A\u0442\u044B
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442, \u0447\u0442\u043E
    \u041E\u043B\u044C\u0433\u0430 \u0443\u043C\u0435\u0440\u043B\u0430 \u0432 969
    \u0433., \u0437\u0430 5 \u043B\u0435\u0442\r\n\u0434\u043E \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u043C\u044B\u0445
    \u0432 \u043B\u0435\u0433\u0435\u043D\u0434\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u0439.
    \u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u044C \u0412\u0438\u0442\u0435\u0431\u0441\u043A
    \u0438 \u0437\u0430\u043B\u043E\u0436\u0438\u0442\u044C\r\n\u0432 \u043D\u0435\u043C
    \u0445\u0440\u0430\u043C\u044B \u043E\u043D\u0430 \u043D\u0435 \u043C\u043E\u0433\u043B\u0430.
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043B\u0435\u0442\u043E\u043F\u0438\u0441\u0435\u0446
    \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043D\u0435\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C,
    \u0438 \u0432\u043C\u0435\u0441\u0442\u043E\r\n\u0434\u0430\u0442\u044B \xAB947\xBB
    \u043D\u0430\u043F\u0438\u0441\u0430\u043B \xAB974\xBB.\r\n\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u043E\u0432 \u043F\u043E \u0440\u044F\u0434\u0443
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0435\u0439 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u0438 \u043D\u0430\r\n\u043E\u0441\u043D\u043E\u0432\u0435
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0445
    \u0444\u043E\u0440\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
    \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F\r\n\u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u2013 2-\u044F \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
    XII \u0432. \u041F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0431\u0430\u043B\u043A\u0430\u043D\u0441\u043A\u0438\u043C \u0437\u043E\u0434\u0447\u0438\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432 1140-\u0445 \u0433\u0433. \u043F\u0440\u0438\u0432\u0435\u0437\u043B\u0438
    \u0440\u0430\u043D\u0435\u0435\r\n\u0441\u043E\u0441\u043B\u0430\u043D\u043D\u044B\u0435
    \u0432 \u0412\u0438\u0437\u0430\u043D\u0442\u0438\u044E \u043F\u043E\u043B\u043E\u0446\u043A\u0438\u0435
    \u043A\u043D\u044F\u0437\u044C\u044F. \u0423 \u0446\u0435\u0440\u043A\u0432\u0438
    \u0431\u044B\u043B\u0430 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u0430\u044F,
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F\r\n\u0434\u043B\u044F
    \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438 \u043A\u043B\u0430\u0434\u043A\u0430:
    \u0442\u0435\u0441\u0430\u043D\u044B\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044F\u043A\u043E\u0432\u044B\u0435
    \u0431\u043B\u043E\u043A\u0438 \u0447\u0435\u0440\u0435\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \u0441\u043E \u0441\u0434\u0432\u043E\u0435\u043D\u043D\u044B\u043C\u0438\r\n\u0440\u044F\u0434\u0430\u043C\u0438
    \u043F\u043B\u0438\u043D\u0444\u044B (\u043F\u043B\u043E\u0441\u043A\u0438\u0445
    \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0445 \u043A\u0438\u0440\u043F\u0438\u0447\u0435\u0439).
    \u041D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u043F\u044F\u0442\u0438
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0439\r\n\u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u0445\u0440\u0430\u043C\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0430, \u0437\u0434\u0435\u0441\u044C
    \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C\r\n\u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0435
    \u0433\u0440\u0430\u043C\u043E\u0442\u044B \u0438 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435
    \u043A\u043D\u0438\u0433\u0438.\r\n\u0417\u0430 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0430\u0441\u044C
    \u0438\r\n\u043C\u0435\u043D\u044F\u043B\u0430 \u0441\u0432\u043E\u044E \u043A\u043E\u043D\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0443\u044E
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u044C.
    \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0431\u044B\u043B\u0430\r\n\u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0439,
    \u0441 1619 \u043F\u043E 1832 \u0433\u0433. \u2013 \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0439,
    \u0441 1849 \u0433. \u0434\u043E \u043D\u0430\u0447\u0430\u043B\u0430 1920-\u0445
    \u2013\r\n\u0435\u0434\u0438\u043D\u043E\u0432\u0435\u0440\u0447\u0435\u0441\u043A\u043E\u0439.\r\n\u041F\u0435\u0440\u0432\u043E\u0435
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0445\u0440\u0430\u043C\u0430
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u043E \u043D\u0430 \xAB\u0427\u0435\u0440\u0442\u0435\u0436\u0435
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 1664 \u0433.\xBB. \u0412\r\n\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    XVIII \u0432. \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0432 \u0441\u0442\u0438\u043B\u0435
    \u043F\u043E\u0437\u0434\u043D\u0435\u0433\u043E \u0431\u0430\u0440\u043E\u043A\u043A\u043E,\r\n\u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435
    \u043A \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u043C\u0443 \u0444\u0430\u0441\u0430\u0434\u0443
    \u0434\u0432\u0435 \u0431\u0430\u0448\u043D\u0438 \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C
    \u0444\u0438\u0433\u0443\u0440\u043D\u044B\u043C \u0444\u0440\u043E\u043D\u0442\u043E\u043D\u043E\u043C\r\n\u043C\u0435\u0436\u0434\u0443
    \u043D\u0438\u043C\u0438 \u043F\u0440\u0438\u0434\u0430\u043B\u0438 \u0435\u0439
    \u0447\u0435\u0440\u0442\u044B \u043A\u043E\u0441\u0442\u0435\u043B\u0430. \u041F\u043E\u0441\u043B\u0435
    \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u0432 1862 \u0433.\r\n\u0445\u0440\u0430\u043C \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B
    \u0447\u0435\u0440\u0442\u044B \u043F\u0441\u0435\u0432\u0434\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
    \u0441\u0442\u0438\u043B\u044F: \u0431\u0430\u0448\u043D\u0438 \u0438 \u0444\u0440\u043E\u043D\u0442\u043E\u043D
    \u0431\u044B\u043B\u0438 \u0441\u043D\u044F\u0442\u044B, \u043D\u0430\u0434\r\n\u0430\u043B\u0442\u0430\u0440\u0435\u043C
    \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044F\u0445
    \u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E \u0437\u043E\u0434\u0447\u0435\u0441\u0442\u0432\u0430
    \u043A\u0443\u043F\u043E\u043B-\u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0430
    \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u043C\r\n\u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0435.
    \u041F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432 \u0442\u0430\u043A\u043E\u043C \u0432\u0438\u0434\u0435 \u0445\u0440\u0430\u043C
    \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B \u0434\u043E \u0412\u0435\u043B\u0438\u043A\u043E\u0439\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u0432 \u0433\u043E\u0434\u044B \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043E\u043D \u0431\u044B\u043B \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D.\r\n\u0417\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u044D\u0442\u043E\u0433\u043E \u0446\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u044F
    \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u043B\u0430\r\n\u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043A\u043E\u043D\u0442\u0440\u0438\u0431\u0443\u0446\u0438\u044E.
    \u041E\u0434\u043D\u0430\u043A\u043E \u044D\u0442\u0438 \u0434\u0435\u043D\u044C\u0433\u0438
    \u043D\u0435 \u0431\u044B\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B
    \u043D\u0430\r\n\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u0445\u0440\u0430\u043C\u0430. \u0412 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u043E\u043C
    \u0432\u0438\u0434\u0435 \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B
    \u0434\u043E 1961 \u0433., \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\r\n\u043F\u0440\u0438\u043A\u0430\u0437\u0443
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0432\u043B\u0430\u0441\u0442\u0435\u0439
    \u0431\u044B\u043B \u0432\u0437\u043E\u0440\u0432\u0430\u043D.\r\n\u0412 1977
    \u0433. \u0431\u044B\u043B\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0430
    \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430\u0446\u0438\u044F \u0440\u0443\u0438\u043D.
    \u0412 1993\u20131998 \u0433\u0433. \u0448\u043B\u0438\r\n\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0440\u0430\u0431\u043E\u0442\u044B. \u0421\u0442\u0435\u043D\u044B \u0445\u0440\u0430\u043C\u0430
    \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u0438\u0437 \u043E\u0431\u044B\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E\r\n\u043A\u0438\u0440\u043F\u0438\u0447\u0430.
    \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E
    \u043A\u043B\u0430\u0434\u043A\u0443, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u043D\u0430\u0434\u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438\r\n\u043D\u0435\u043E\u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u0435\u043D\u043D\u043E\u0439,
    \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
    \u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0438
    \u0441\u0442\u0435\u043D\u044B \u0432 \u043F\u0435\u0440\u0432\u044B\u0435\r\n\u0432\u0435\u043A\u0430
    \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438.
    \u0421 \u044F\u043D\u0432\u0430\u0440\u044F 1999 \u0433. \u0445\u0440\u0430\u043C
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C."
