  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "27 \u0438\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442\u0441\u043A\u0438\u0435
    \u0441\u043A\u043B\u0430\u0434\u044B - \u043B\u0430\u0431\u0430\u0437\u044B"
  m_EditorClassIdentifier: 
  _number: 27
  _name: "\u0438\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442\u0441\u043A\u0438\u0435
    \u0441\u043A\u043B\u0430\u0434\u044B - \u043B\u0430\u0431\u0430\u0437\u044B"
  _description: "\u0412 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
    \u0441\u0438\u043B\u0430\u0445 \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438 \u0438\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442
    \u2014 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u043D\u043E\u0435 \u043B\u0438\u0446\u043E,\r\n\u0432\u0435\u0434\u0430\u044E\u0449\u0435\u0435
    \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C\u0438 \u0442\u044B\u043B\u043E\u0432\u043E\u0433\u043E
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0432\u043E\u0439\u0441\u043A
    \u0438 \u0441\u0438\u043B. \u0418\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442
    \u043E\u0442\u0432\u0435\u0447\u0430\u043B \u0437\u0430\r\n\u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u0435, \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0435,
    \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0435, \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0435
    \u0438\r\n\u0432\u0435\u0449\u0435\u0432\u043E\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435
    \u0430\u0440\u043C\u0438\u0438. \u0412 \u0434\u043E\u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0420\u043E\u0441\u0441\u0438\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438\r\n\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0438\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442\u0441\u043A\u0438\u0435
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F: \u0432\u0435\u0449\u0435\u0432\u044B\u0435
    \u0441\u043A\u043B\u0430\u0434\u044B, \u043E\u0431\u043C\u0443\u043D\u0434\u0438\u0440\u043E\u0432\u0430\u043B\u044C\u043D\u044B\u0435\r\n\u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0435,
    \u043E\u0431\u043E\u0437\u043D\u044B\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0435,
    \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B, \u0432\u043E\u0435\u043D\u043D\u044B\u0435\r\n\u0445\u043B\u0435\u0431\u043E\u043F\u0435\u043A\u0430\u0440\u043D\u0438,
    \u043C\u0443\u043A\u043E\u043C\u043E\u043B\u044C\u043D\u0438 (\u0432 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
    \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0445 \u043E\u043A\u0440\u0443\u0433\u0430\u0445).\r\n\u0421\u0443\u0434\u044F
    \u043F\u043E \xAB\u041F\u0430\u043C\u044F\u0442\u043D\u044B\u043C \u043A\u043D\u0438\u0436\u043A\u0430\u043C
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438\xBB,
    \u0432 \u043A\u043E\u043D\u0446\u0435 1910-\u0445 \u0433\u0433.\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u0438\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442\u0441\u043A\u0438\u0435
    \u0441\u043A\u043B\u0430\u0434\u044B \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0438
    \u0441\u043E\u0431\u043E\u0439 \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439\r\n\u043C\u0430\u0433\u0430\u0437\u0438\u043D.
    \u0420\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F \u043E\u043D \u0432
    \u0437\u0434\u0430\u043D\u0438\u044F\u0445, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u0441 \u043A\u043E\u043D\u0446\u0430 XVIII \u0432. \u043A\u0430\u043A \u043F\u0440\u043E\u0432\u0438\u0430\u043D\u0442\u0441\u043A\u0438\u0435
    \u0438\r\n\u0441\u043E\u043B\u044F\u043D\u044B\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B
    (\u0441\u043E\u0432\u0440. \u0437\u0434\u0430\u043D\u0438\u044F \u043F\u043E
    \u0443\u043B. \u0427\u0430\u0439\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    3,5).\r\n\u042D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
    \u0431\u044B\u043B \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D \u0432 1774
    \u0433. \u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u043B \u0438\u0437 \u0442\u0440\u0435\u0445
    \u043E\u0434\u043D\u043E\u044D\u0442\u0430\u0436\u043D\u044B\u0445 \u0437\u0434\u0430\u043D\u0438\u0439,\r\n\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u043D\u044B\u0445
    \u0430\u0440\u043A\u0430\u043C\u0438. \u041F\u0440\u043E\u0435\u043A\u0442 \u0431\u044B\u043B
    \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432\u044B\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D
    \u0432 \u0421.-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435 \u0434\u043B\u044F\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0445
    \u0438 \u0443\u0435\u0437\u0434\u043D\u044B\u0445 \u0433\u043E\u0440\u043E\u0434\u043E\u0432.
    \u0413\u043B\u0430\u0432\u043D\u044B\u0435 \u0444\u0430\u0441\u0430\u0434\u044B
    \u0437\u0434\u0430\u043D\u0438\u0439 \u0431\u044B\u043B\u0438 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B
    \u043D\u0430\r\n\u043F\u0440\u0438\u0441\u0442\u0430\u043D\u044C, \u043E\u0442\u043A\u0443\u0434\u0430
    \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u044B.
    \u0417\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432
    \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0439 \u0434\u0432\u043E\u0440\r\n\u0431\u044B\u043B
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D \u0434\u043B\u044F
    \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E \u0437\u0430\u0435\u0437\u0434\u0430
    \u0441\u044E\u0434\u0430 \u043A\u0430\u0440\u0435\u0442 \u0438 \u043F\u043E\u0432\u043E\u0437\u043E\u043A.\r\n\u0412
    \u0440\u0430\u0437\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0437\u0434\u0435\u0441\u044C
    \u0445\u0440\u0430\u043D\u0438\u043B\u0438 \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u043B\u0438
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0442\u043E\u0432\u0430\u0440\u044B, \u0438\u0437-\u0437\u0430
    \u0447\u0435\u0433\u043E \u044D\u0442\u043E\r\n\u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435
    \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443:
    \u043F\u0440\u043E\u0432\u0438\u0430\u043D\u0442\u0441\u043A\u0438\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B,
    \u0445\u043B\u0435\u0431\u043D\u044B\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B,\r\n\u0441\u043E\u043B\u044F\u043D\u044B\u0435
    \u0441\u043A\u043B\u0430\u0434\u044B, \u043B\u0430\u0431\u0430\u0437\u044B. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u0438\u0436\u0438\u043B\u043E\u0441\u044C \u0441\u0440\u0435\u0434\u0438\r\n\u0433\u043E\u0440\u043E\u0436\u0430\u043D,
    \u0447\u0442\u043E \u0443\u043B\u0438\u0446\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F \u044D\u0442\u043E\u0442
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441, \u0441\u0442\u0430\u043B\u0430
    \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F\r\n\u041B\u0430\u0431\u0430\u0437\u043D\u043E\u0439
    (\u0441 1950 \u0433. \u0434\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2013 \u0443\u043B. \u0427\u0430\u0439\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E).\r\n\u0414\u043E
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0438\u0437 \u0432\u0441\u0435\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0434\u0432\u0430 \u0437\u0434\u0430\u043D\u0438\u044F \u2013\r\n\u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438 \u043F\u0440\u0430\u0432\u043E\u0435 \u0431\u043E\u043A\u043E\u0432\u043E\u0435.
    \u0412\u0442\u043E\u0440\u0443\u044E \u0436\u0438\u0437\u043D\u044C \u043E\u043D\u0438
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043F\u043E\u0441\u043B\u0435
    \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438,\r\n\u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0432\u0448\u0435\u0439\u0441\u044F
    \u0432 2007 \u0433. \u0421 \u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \xAB\u041A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E-\r\n\u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \xAB\u0417\u043E\u043B\u043E\u0442\u043E\u0435
    \u043A\u043E\u043B\u044C\u0446\u043E \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \xAB\u0414\u0432\u0438\u043D\u0430\xBB (\u043E\u0441\u043D\u043E\u0432\u0430\u043D
    \u043A\u0430\u043A \u0426\u0435\u043D\u0442\u0440\r\n\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u0440\u0435\u043C\u0451\u0441\u0435\u043B \u0438 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432
    \xAB\u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435\xBB).\r\n\u041F\u0435\u0440\u0435\u0434
    \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439
    \u0437\u0434\u0430\u043D\u0438\u0439, \u0432 1993\u20131994 \u0433\u0433. \u0437\u0434\u0435\u0441\u044C
    \u0431\u044B\u043B\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u044B\r\n\u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u0432
    \u0445\u043E\u0434\u0435 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0431\u044B\u043B
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u0439\r\n\u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u0445\u0440\u0430\u043C\u0430, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0439
    \u0432 \u0441\u0442\u0438\u043B\u0435 \u0440\u0435\u043D\u0435\u0441\u0441\u0430\u043D\u0441.
    \u041F\u043E \u043C\u043D\u0435\u043D\u0438\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0430
    \u0418\u0433\u043E\u0440\u044F\r\n\u0422\u0438\u0448\u043A\u0438\u043D\u0430,
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u043C\u043E\u0433\u043B\u0430 \u0431\u044B\u0442\u044C
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0432 1-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    XVII \u0432., \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0442\u0430\u043A\u0438\u0435\r\n\u043A\u043B\u0430\u0434\u043A\u0438
    \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C \u0432 \u0425VI\u2013\u0425VII
    \u0432\u0432. \u0421\u0443\u0434\u044F \u043F\u043E \u043F\u043B\u0430\u043D\u0443
    \u0432\u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u043E\u0432,\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439,
    \u043F\u043E\u0447\u0442\u0438 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0439.
    \u041D\u043E \u0434\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0435\r\n\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C
    \u043D\u0438 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u0445\u0440\u0430\u043C\u0430,
    \u043D\u0438 \u0435\u0433\u043E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F.
    \u041E\u043D \u0431\u044B\u043B \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D
    \u043D\u0430\r\n\u043F\u043B\u0430\u043D\u0430\u0445 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u043D\u0430\u0447\u0430\u043B\u0430 1770-\u0445 \u0433\u0433. \u0438 \u043A\u043E\u043D\u0446\u0430
    XVIII \u0432.\r\n\u041D\u0430 \u0441\u0443\u0434\u044C\u0431\u0443 \u0446\u0435\u0440\u043A\u0432\u0438
    \u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0432\u043B\u0438\u044F\u0442\u044C
    \u0432\u043E\u0439\u043D\u0430 \u043C\u0435\u0436\u0434\u0443 \u0412\u0435\u043B\u0438\u043A\u0438\u043C
    \u043A\u043D\u044F\u0436\u0435\u0441\u0442\u0432\u043E\u043C\r\n\u041B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u043C
    \u0438 \u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u043C \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E\u043C
    1654\u20131667 \u0433\u0433. \u041F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
    \u0445\u0440\u0430\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F\r\n\u043D\u0435
    \u0432 \u0437\u0430\u043C\u043A\u0435, \u0430 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
    \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0437\u0430 \u0414\u0432\u0438\u043D\u043E\u0439,
    \u043E\u043D \u043C\u043E\u0433 \u0441\u0442\u0430\u0442\u044C \u043B\u0451\u0433\u043A\u043E\u0439
    \u0434\u043E\u0431\u044B\u0447\u0435\u0439\r\n\u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044F,
    \u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u043A\u0430\u043A \u043E\u0433\u043D\u0435\u0432\u0430\u044F \u0442\u043E\u0447\u043A\u0430
    \u0434\u043B\u044F \u043E\u0431\u0441\u0442\u0440\u0435\u043B\u0430 \u041D\u0438\u0436\u043D\u0435\u0433\u043E\r\n\u0437\u0430\u043C\u043A\u0430.
    \u0422\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u0432\u043E
    \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430,
    \u0438\r\n\u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444
    \u043D\u0435 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B \u0440\u0443\u0438\u043D\u044B
    \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435 \u043D\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u043C
    \u0427\u0435\u0440\u0442\u0435\u0436\u0435 1664 \u0433.\r\n\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u043C
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0430
    \u0438 \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0430 \u041B\u044E\u0434\u043C\u0438\u043B\u044B\r\n\u0425\u043C\u0435\u043B\u044C\u043D\u0438\u0446\u043A\u043E\u0439,
    \u0445\u0440\u0430\u043C \u0421\u0440\u0435\u0442\u0435\u043D\u0438\u044F \u0413\u043E\u0441\u043F\u043E\u0434\u043D\u044F
    \u2013 \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A \u043E\u043D \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u0441\u044F
    \u2013\r\n\u043F\u0440\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0432 \u043F\u043E\u043B\u0443\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u043E\u043C
    \u0432\u0438\u0434\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 XVIII \u0432.
    \u0417\u0430\u0442\u0435\u043C \u0435\u0433\u043E \u043E\u0441\u0442\u0430\u0442\u043A\u0438
    \u0443 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u0430
    \u0432\u044B\u043A\u0443\u043F\u0438\u043B\u0438 \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0435
    \u0432\u043B\u0430\u0441\u0442\u0438 \u0434\u043B\u044F \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u043C\u0435\u0441\u0442\u0430 \u043F\u043E\u0434\r\n\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043F\u0440\u043E\u0432\u0438\u0430\u043D\u0442\u0441\u043A\u0438\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432.
    \u0418 \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u043A\u0438\u0440\u043F\u0438\u0447\u0435\u0439
    \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0445\u0440\u0430\u043C\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
    \u0434\u043B\u044F \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0441\u043A\u043B\u0430\u0434\u043E\u0432..."
