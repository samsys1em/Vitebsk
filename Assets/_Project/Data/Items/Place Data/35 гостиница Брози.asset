  m_Name: "35 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u043E\u0437\u0438"
  m_EditorClassIdentifier: 
  _number: 35
  _name: "\u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u043E\u0437\u0438"
  _description: "\u0412 1890 \u0433. \u0432\u043E\u0437\u043B\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043C\u043E\u0441\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 \u0412\u0438\u0442\u044C\u0431\u0443
    \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D \u0434\u043E\u043C,
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0439\r\n\u043A\u0443\u043F\u0446\u0443
    \u0411\u0435\u0439\u043D\u0443\u0441\u0443 \u0412\u0438\u0442\u0442\u0435\u043D\u0431\u0435\u0440\u0433\u0443.
    \u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E\u0435
    \u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043F\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u0437\u0434\u0430\u043D\u0438\u0435\r\n(1820 \u043A\u0432. \u043C), \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u043E\u0435
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0443\u043B\u0438\u0446\u044B
    \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439 (\u043D\u044B\u043D\u0435
    \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430) \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435
    2-\r\n\u0433\u043E \u044D\u0442\u0430\u0436\u0430 \u0430\u0440\u043E\u0447\u043D\u044B\u043C\u0438
    \u043E\u043A\u043D\u0430\u043C\u0438 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
    \u0433\u0430\u043B\u0435\u0440\u0435\u0435\u0439 \u0441 \u0430\u0436\u0443\u0440\u043D\u044B\u043C
    \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C\r\n\u043E\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435\u043C.\r\n\u0414\u043E\u043B\u0433\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u043F\u0435\u0440\u0432\u043E\u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0439
    \u043E\u0442\u0435\u043B\u044C \u0411\u0440\u043E\u0437\u0438, \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0432\u0448\u0438\u0439
    \u0441\u0432\u043E\u0438\u043C\r\n\u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C
    \u0443\u0434\u043E\u0431\u043D\u044B\u0435 \u0431\u043B\u0430\u0433\u043E\u0443\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435
    \u043D\u043E\u043C\u0435\u0440\u0430 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E
    \u043E\u0442 50 \u043A\u043E\u043F\u0435\u0435\u043A \u0434\u043E 3 \u0440\u0443\u0431\u043B\u0435\u0439
    \u0437\u0430\r\n\u0441\u0443\u0442\u043A\u0438. \u0412 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0435
    \u0431\u044B\u043B\u0438 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u044B \u0431\u0438\u043B\u044C\u044F\u0440\u0434\u043D\u044B\u0435
    \u0437\u0430\u043B\u044B, \u043A\u0435\u0433\u0435\u043B\u044C\u0431\u0430\u043D
    \u0438 \u043F\u0435\u0440\u0432\u043E\u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0439\r\n\u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D
    \u0441 \u0440\u0443\u0441\u0441\u043A\u043E\u0439 \u0438 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0439
    \u043A\u0443\u0445\u043D\u0435\u0439, \u0433\u0434\u0435 \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u0432\u0438\u043D\u0430\r\n(\u043E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0438 \u0437\u0430\u0440\u0443\u0431\u0435\u0436\u043D\u044B\u0435) \u0438 \u0440\u0438\u0436\u0441\u043A\u043E\u0435
    \u043F\u0438\u0432\u043E. \u041F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B
    \u043E\u0442\u0435\u043B\u044C \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0443
    \u0411\u0440\u043E\u0437\u0438.\r\n\u0412 1837 \u0433\u043E\u0434\u0443 \u0443\u0440\u043E\u0436\u0435\u043D\u0435\u0446
    \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u0438 \u0425\u0440\u0438\u0441\u0442\u0438\u043D
    \u0411\u0440\u043E\u0437\u0438 \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0432
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A \u0438 \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C\r\n\u0441\u043C\u043E\u0433
    \u043D\u0430\u043B\u0430\u0434\u0438\u0442\u044C \xAB\u0441\u0432\u043E\u0435
    \u0434\u0435\u043B\u043E\xBB \u2013 \u043E\u0442\u043A\u0440\u044B\u043B \u043A\u043E\u043D\u0434\u0438\u0442\u0435\u0440\u0441\u043A\u0443\u044E
    \u0438 \u043E\u0442\u0435\u043B\u044C. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u2013 \u0432\r\n\u0430\u0440\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043D\u043E\u043C
    \u0434\u043E\u043C\u0435 \u043A\u0443\u043F\u0447\u0438\u0445\u0438 \u0424\u0435\u0434\u043E\u0440\u044B
    \u041E\u0440\u0434\u044B\u043D\u0441\u043A\u043E\u0439 \u043D\u0430 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u0435 (\u0441\u0435\u0439\u0447\u0430\u0441 \u0443\u043B.\r\n\u041B\u0435\u043D\u0438\u043D\u0430,
    33), \u0441 1895 \u0433. \u2013 \u0432 \u0434\u043E\u043C\u0435 \u0412\u0438\u0442\u0435\u043D\u0431\u0435\u0440\u0433\u0430.
    \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u0435\u043B\u0435\u043C
    \u0434\u0435\u043B\u0430 \u043E\u0442\u0446\u0430 \u0441\u0442\u0430\u043B \u0441\u0430\u043C\u044B\u0439\r\n\u043C\u043B\u0430\u0434\u0448\u0438\u0439
    \u0438\u0437 \u0434\u0435\u0442\u0435\u0439 \u2013 \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043D
    \u0425\u0440\u0438\u0441\u0442\u0438\u0430\u043D\u043E\u0432\u0438\u0447 \u0411\u0440\u043E\u0437\u0438.
    \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438,\r\n\u043A\u043E\u0433\u0434\u0430
    \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0430\u0441\u044C,
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0438
    \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0411\u0440\u043E\u0437\u0438
    \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u0438 \u0436\u0438\u043B\u0438\r\n\u0432 \u0433\u043E\u0440\u043E\u0434\u0435,
    \u043F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
    \u0434\u043E \u043D\u0430\u0447\u0430\u043B\u0430 2000-\u0445 \u0433\u0433.\r\n\u0412
    \u0434\u043E\u043C\u0435 \u043A\u0443\u043F\u0446\u0430 \u0412\u0438\u0442\u0442\u0435\u043D\u0431\u0435\u0440\u0433\u0430,
    \u043F\u043E\u043C\u0438\u043C\u043E \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B,
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C \u043A\u043E\u043D\u0434\u0438\u0442\u0435\u0440\u0441\u043A\u0430\u044F
    \xAB\u0416\u0430\u043D\r\n\u0410\u043B\u044C\u0431\u0435\u0440\u0442\xBB, \u043C\u0435\u0431\u0435\u043B\u044C\u043D\u044B\u0439
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0425. \u0428\u0435\u0445\u0442\u0435\u0440\u0430,
    \u043F\u0438\u0441\u0447\u0435\u0431\u0443\u043C\u0430\u0436\u043D\u044B\u0439
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0428. \u042F\u0445\u043D\u0438\u043D\u0430,\r\n\u0444\u043E\u0442\u043E\u0430\u0442\u0435\u043B\u044C\u0435
    \u0410. \u041C\u0430\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E. \u041A\u0440\u043E\u043C\u0435
    \u0442\u043E\u0433\u043E, \u0432 \u044D\u0442\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0439
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0438\r\n\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430
    \u0428.-\u041D. \u0420\u043E\u0437\u0435\u043D\u0444\u0435\u043B\u044C\u0434\u0430
    \u2013 \u0442\u0435\u0441\u0442\u044F \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430
    \u041C\u0430\u0440\u043A\u0430 \u0428\u0430\u0433\u0430\u043B\u0430. \u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
    \u043E \u0436\u0438\u0437\u043D\u0438\r\n\u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435,
    \u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
    \u0432 \u043A\u043D\u0438\u0433\u0435 \u0411\u0435\u043B\u043B\u044B \u0420\u043E\u0437\u0435\u043D\u0444\u0435\u043B\u044C\u0434
    \xAB\u0413\u043E\u0440\u044F\u0449\u0438\u0435 \u043E\u0433\u043D\u0438\xBB.\r\n\u041F\u043E\u0441\u043B\u0435
    1917 \u0433. \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0431\u044B\u043B\u0430
    \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0430
    \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0430 \u0432 \xAB1-\u044E
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0443\u044E\r\n\u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0443\xBB,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
    \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 1920-\u0445
    \u0433\u0433. \u0412 1930-\u0445 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C
    \u043E\u0434\u043D\u0430 \u0438\u0437 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0445
    \u0448\u043A\u043E\u043B. \u0412 \u0445\u043E\u0434\u0435 \u0431\u043E\u0435\u0432
    \u0437\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A \u0432 \u0438\u044E\u043D\u0435
    1944 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435\r\n\u0431\u044B\u043B\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E
    \u0438 \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043D\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.\r\n\u0412
    2000-\u0445 \u0433\u0433. \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0437\u0434\u0430\u043D\u0438\u0435
    \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B \u0411\u0440\u043E\u0437\u0438,
    \u043D\u043E \u043F\u0440\u043E\u0435\u043A\u0442 \u043D\u0435\r\n\u0431\u044B\u043B
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D."
