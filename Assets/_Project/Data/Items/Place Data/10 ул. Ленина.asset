  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "10 \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430"
  m_EditorClassIdentifier: 
  _number: 10
  _name: "\u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430"
  _description: "\u0423\u043B\u0438\u0446\u0430 \u041B\u0435\u043D\u0438\u043D\u0430
    \u2013 \u043E\u0434\u043D\u0430 \u0438\u0437 \u0433\u043B\u0430\u0432\u043D\u044B\u0445
    \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043B\u0435\u0439 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430. \u0415\u0435\r\n\u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u2013 2500 \u043C \u043E\u0442 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u041F\u043E\u0431\u0435\u0434\u044B
    \u0434\u043E \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438.
    \u0423\u043B\u0438\u0446\u0430\r\n\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u0438 \u0437\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0430\u0441\u044C
    \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0439.\r\n\u0423\u0447\u0430\u0441\u0442\u043E\u043A
    \u043E\u0442 \u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u0441\u0442\u0430 \u0434\u043E \u0443\u043B. \u042F. \u041A\u0443\u043F\u0430\u043B\u044B
    \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D \u043D\u0430 \xAB\u0427\u0435\u0440\u0442\u0435\u0436\u0435
    \u043C.\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 1664 \u0433\u043E\u0434\u0430\xBB.
    \u0412 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u044D\u0442\u043E \u0431\u044B\u043B\u0430
    \u0412\u0435\u043B\u0438\u043A\u0430\u044F \u0418\u043B\u0435\u043C\u043D\u0438\u0446\u043A\u0430\u044F
    \u0443\u043B\u0438\u0446\u0430, \u043E\u043D\u0430\r\n\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0430
    \u043F\u043E \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0412\u0437\u0433\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0437\u0430\u043C\u043A\u0430 \u0440\u044F\u0434\u043E\u043C \u0441 \u0440\u0430\u0442\u0443\u0448\u0435\u0439
    \u0432 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C\r\n\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.\r\n\u041F\u043E\u0437\u0436\u0435
    \u0443\u043B\u0438\u0446\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430\u0441\u044C
    \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0421\u0443\u0440\u0430\u0436\u0441\u043A\u043E\u0439,\r\n\u0421\u0442\u0430\u0440\u043E\u0441\u0443\u0440\u0430\u0436\u0441\u043A\u043E\u0439,
    \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0439,
    \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439. \u042D\u0442\u0438
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0431\u044B\u043B\u0438\r\n\u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0441 \u0435\u0435 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u043E\u0439:
    \u0443\u043B\u0438\u0446\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0430
    \u043A \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0447\u0435\u0440\u0442\u0435
    \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438\r\n\u0421\u0443\u0440\u0430\u0436\u0430,
    \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0430,
    \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u0430 (\u0434\u043E 1849 \u0433\u043E\u0434\u0430
    \u0447\u0435\u0440\u0435\u0437 \u0421\u0443\u0440\u0430\u0436 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\r\n\u0442\u0440\u0430\u043A\u0442
    \u043D\u0430 \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433,
    \u0434\u043E 1856 \u0433\u043E\u0434\u0430 \u2013 \u0434\u043E\u0440\u043E\u0433\u0430
    \u043D\u0430 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A). \u0412 1923 \u0433\u043E\u0434\u0443\r\n\u0443\u043B\u0438\u0446\u0430
    \u0431\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0430
    \u0432 \u0447\u0435\u0441\u0442\u044C \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u043F\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043B\u044F \u0421\u043E\u0432\u0435\u0442\u0430
    \u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445\r\n\u043A\u043E\u043C\u0438\u0441\u0441\u0430\u0440\u043E\u0432
    \u0421\u0421\u0421\u0420 \u0412.\u0418. \u041B\u0435\u043D\u0438\u043D\u0430
    (\u0435\u0449\u0435 \u043F\u0440\u0438 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u0438).
    \u0412 1950 \u0433\u043E\u0434\u0443 \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430\r\n\u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043B\u0430\u0441\u044C
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u043A \u043D\u0435\u0439 \u0443\u043B. \u041A\u0440\u0430\u0441\u043D\u043E\u0439
    (\u0431\u044B\u0432\u0448\u0435\u0439 \u0413\u0440\u044F\u0437\u043D\u043E\u0439;\r\n\u0441\u0435\u0439\u0447\u0430\u0441
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u043E\u0442 \u043F\u043B. \u041B\u0435\u043D\u0438\u043D\u0430
    \u0434\u043E \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439 \u043F\u043B.).
    \u0412 1961 \u0433\u043E\u0434\u0443 \u0447\u0430\u0441\u0442\u044C\u044E \u0443\u043B.\r\n\u041B\u0435\u043D\u0438\u043D\u0430
    \u0441\u0442\u0430\u043B\u0430 \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043B\u044C,
    \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0432\u0448\u0430\u044F \u043F\u043B.
    \u0421\u0432\u043E\u0431\u043E\u0434\u044B \u0438 \u043F\u043B. \u0427\u0435\u0440\u043D\u044F\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E\r\n(\u043D\u044B\u043D\u0435
    \u043F\u043B. \u041F\u043E\u0431\u0435\u0434\u044B), \u0440\u0430\u043D\u0435\u0435
    \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0432\u0448\u0430\u044F\u0441\u044F
    \u0443\u043B. \u0413\u043E\u0433\u043E\u043B\u044F. \u0412\u043E 2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    XIX \u2013\r\n\u043D\u0430\u0447\u0430\u043B\u0435 XX \u0432\u0435\u043A\u043E\u0432
    \u043D\u0430 \u0443\u043B. \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u0437\u043D\u0430\u043A\u043E\u0432\u044B\u0435
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0438\r\n\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0433\u043E\u0440\u043E\u0434\u0430, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
    \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0435 \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435,
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F \u0434\u0443\u043C\u0430
    \u0438\r\n\u0443\u043F\u0440\u0430\u0432\u0430, \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u043E\u0435
    \u0438 \u0436\u0430\u043D\u0434\u0430\u0440\u043C\u0441\u043A\u043E\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
    \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u044E\u0442, \u043F\u0440\u0438\u043A\u0430\u0437\r\n\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0437\u0440\u0435\u043D\u0438\u044F, \u043A\u0430\u0437\u0435\u043D\u043D\u0430\u044F
    \u043F\u0430\u043B\u0430\u0442\u0430 \u0438 \u043A\u0430\u0437\u043D\u0430\u0447\u0435\u0439\u0441\u0442\u0432\u043E,
    \u043A\u043E\u0441\u0442\u0435\u043B \u0421\u0432.\r\n\u0410\u043D\u0442\u043E\u043D\u0438\u044F,
    \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u0430 \u0411\u0440\u043E\u0437\u0438,
    \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u044F \u0433\u0430\u0437\u0435\u0442\u044B
    \xAB\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435 \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u0438\u0435\r\n\u0432\u0435\u0434\u043E\u043C\u043E\u0441\u0442\u0438\xBB,
    \u043F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
    \u043A\u043E\u043D\u0442\u043E\u0440\u0430, \u043A\u0438\u043D\u043E\u0442\u0435\u0430\u0442\u0440
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435. \u0412 \u0433\u043E\u0434\u044B\r\n\u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0439
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438 \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u0431\u044B\u0432\u0448\u0435\u0439 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u044B\r\n\u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0431\u044B\u043B\u0430 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0430.
    \u0412 \u043A\u043E\u043D\u0446\u0435 1950-\u0445 \u2013 \u043D\u0430\u0447\u0430\u043B\u0435
    1970-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0432 \u0441\u0432\u044F\u0437\u0438
    \u0441\r\n\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435\u043C
    \u043F\u0440\u043E\u0435\u0437\u0436\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0431\u044B\u043B\u0438 \u0441\u043D\u0435\u0441\u0435\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u044F
    \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435\r\n\u0443\u043B\u0438\u0446\u044B
    (\u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0440\u0430\u0442\u0443\u0448\u0438),
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043A\u043E\u0441\u0442\u0435\u043B
    \u0421\u0432. \u0410\u043D\u0442\u043E\u043D\u0438\u044F. \u041F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u0430\u044F\r\n\u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0442\u0438\u043F\u043E\u0432\u044B\u043C\u0438
    4\u20135-\u044D\u0442\u0430\u0436\u043D\u044B\u043C\u0438 \u0436\u0438\u043B\u044B\u043C\u0438
    \u0434\u043E\u043C\u0430\u043C\u0438 \u0441\r\n\u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430\u043C\u0438
    \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0445 \u044D\u0442\u0430\u0436\u0430\u0445."
  _preview: {fileID: 21300000, guid: f4fe02f3a2169a242ad7e23d3dc1248f, type: 3}
