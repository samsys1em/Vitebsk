      \u041F\u043E\u0447\u0442\u043E\u0432\u043E-\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u043D\u0430\u044F
      \u043A\u043E\u043D\u0442\u043E\u0440\u0430. \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430
      \u043D\u0430\u0447. \u0425\u0425 \u0432."
