    _image: {fileID: 21300000, guid: fb9f38985505af94ebe47f2f536d2158, type: 3}
  - _title: "\u0423\u043B. \u041B\u0435\u043D\u0438\u043D\u0430. 1960-\u0435 \u0433\u0433."
