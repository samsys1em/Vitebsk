  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "02 \u0443\u043B. \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F"
  m_EditorClassIdentifier: 
  _number: 2
  _name: "\u0443\u043B. \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F"
  _description: "\u0423\u043B\u0438\u0446\u0430 \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F
    \u2013 \u043E\u0434\u043D\u0430 \u0438\u0437 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0445
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u0417\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u043D\u0430 \u0435\u0435 \u043C\u0435\u0441\u0442\u0435\r\n\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
    \u0435\u0449\u0435 \u0432 XI\u2013XII \u0432\u0432. \u0423\u043B\u0438\u0446\u0430
    \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u041D\u0438\u0436\u043D\u0435\u0433\u043E\r\n\u0437\u0430\u043C\u043A\u0430
    \u0432 XIV\u2013XV \u0432\u0432. \u043F\u043E\u0434 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439. \u041E\u043D\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430
    \u043D\u0430 \xAB\u0427\u0435\u0440\u0442\u0435\u0436\u0435 \u043C.\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1664 \u0433\u043E\u0434\u0430\xBB. \u0412 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u0443\u043B\u0438\u0446\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0430\u0441\u044C
    \u0432\u043E\u0437\u043B\u0435 \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u043E\u0439\r\n\u0446\u0435\u0440\u043A\u0432\u0438
    \u0438 \u0448\u043B\u0430 \u0432\u0434\u043E\u043B\u044C \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u043E\u0439
    \u0441\u0442\u0435\u043D\u044B \u041D\u0438\u0436\u043D\u0435\u0433\u043E \u0437\u0430\u043C\u043A\u0430
    \u0432 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438\r\n(\u043A
    \u043D\u0430\u0447\u0430\u043B\u0443 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440-\u0442\u0430 \u0424\u0440\u0443\u043D\u0437\u0435). \u0412 XVII
    \u2013 1-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 XIX \u0432\u0432.\r\n\u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
    \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u0414\u043E\u043C\u0438\u043D\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439
    \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0438\r\n\u043A\u043E\u0441\u0442\u0435\u043B
    \u0441\u0432. \u0410\u0440\u0445\u0430\u043D\u0433\u0435\u043B\u0430 \u041C\u0438\u0445\u0430\u0438\u043B\u0430,
    \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E \u0443\u043B\u0438\u0446\u0430
    \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430\u0441\u044C\r\n\u0414\u043E\u043C\u0438\u043D\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0439.
    \u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430, \u0441\u043E 2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B
    XIX \u0432., \u0443\u043B\u0438\u0446\u0430\r\n\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439. \u0412 \u043A\u043E\u043D\u0446\u0435
    1922 \u0433. \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F \u0443\u043B\u0438\u0446\u0430
    \u0431\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0430
    \u0432\r\n\u0447\u0435\u0441\u0442\u044C \u041B\u044C\u0432\u0430 \u0422\u0440\u043E\u0446\u043A\u043E\u0433\u043E,
    \u0437\u0430\u0442\u0435\u043C \u0441\u0442\u0430\u043B\u0430 \u0443\u043B\u0438\u0446\u0435\u0439
    \xAB\u041F\u0440\u0430\u0432\u0434\u044B\xBB. \u0412 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0434\u043E\r\n1961 \u0433. \u0443\u043B\u0438\u0446\u0430
    \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430\u0441\u044C \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439,
    \u0434\u043E 1974 \u0433. \u044F\u0432\u043B\u044F\u043B\u0430\u0441\u044C \u0447\u0430\u0441\u0442\u044C\u044E
    \u0443\u043B. \u041A\u0438\u0440\u043E\u0432\u0430. \u0412\r\n\u0441\u0432\u044F\u0437\u0438
    \u0441 \u043F\u0440\u0430\u0437\u0434\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    1000-\u043B\u0435\u0442\u0438\u044F \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0432 1974 \u0433. \u0443\u043B\u0438\u0446\u0435 \u0431\u044B\u043B\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\r\n\u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u043E
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435.
    \u041D\u0430 \u0440\u0443\u0431\u0435\u0436\u0435 XIX\u2013XX \u0432\u0432. \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F
    \u0431\u044B\u043B\u0430\r\n\u043E\u0434\u043D\u0430 \u0438\u0437 \u0433\u043B\u0430\u0432\u043D\u044B\u0445
    \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u0443\u043B\u0438\u0446 \u0433\u043E\u0440\u043E\u0434\u0430.
    \u0417\u0434\u0435\u0441\u044C \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0445
    \u044D\u0442\u0430\u0436\u0430\u0445 \u0436\u0438\u043B\u044B\u0445 \u0434\u043E\u043C\u043E\u0432\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u043E\u0441\u044C
    \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432
    \u0438 \u043B\u0430\u0432\u043E\u043A, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445\r\n\u043C\u043E\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E \u043A\u0443\u043F\u0438\u0442\u044C \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0432\u0441\u0435 \u2013 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B, \u043E\u0434\u0435\u0436\u0434\u0443,
    \u043E\u0431\u0443\u0432\u044C, \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F,\r\n\u0442\u043A\u0430\u043D\u0438,
    \u043F\u0430\u0440\u0444\u044E\u043C\u0435\u0440\u0438\u044E, \u043C\u0435\u0431\u0435\u043B\u044C,
    \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434\u044B, \u0447\u0430\u0441\u044B
    \u0438 \u043C\u043D\u043E\u0433\u043E\u0435 \u0434\u0440\u0443\u0433\u043E\u0435.
    \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043D\u0430\r\n\u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0435
    \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u2013 \xAB\u0411\u0440\u0438\u0441\u0442\u043E\u043B\u044C\xBB \u0438\r\n\u041A\u0443\u0448\u043D\u0435\u0440\u0430,
    \u043F\u043E\u0436\u0430\u0440\u043D\u043E\u0435 \u0434\u0435\u043F\u043E, \u043D\u043E\u0442\u0430\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u043A\u043E\u043D\u0442\u043E\u0440\u044B, \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E\r\n\u0431\u0430\u043D\u043A\u0430,
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0439, \u0432 \u0442\u043E\u043C
    \u0447\u0438\u0441\u043B\u0435 \u0430\u0442\u0435\u043B\u044C\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E\r\n\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0430
    \u0421\u0438\u0433\u0438\u0437\u043C\u0443\u043D\u0434\u0430 \u042E\u0440\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E.
    \u0421 1898 \u0433. \u0434\u043E 2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B
    1930-\u0445 \u0433\u0433. \u043F\u043E\r\n\u0443\u043B\u0438\u0446\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B
    \u0442\u0440\u0430\u043C\u0432\u0430\u0439\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.
    \u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u0443\u043B\u0438\u0446\u044B, \u043A\u0430\u043A \u0438 \u0435\u0435\r\n\u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0435
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u043D\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C. \u0417\u0434\u0430\u043D\u0438\u044F
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u044B\u043B\u0438\r\n\u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u044B
    \u0432 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0435
    \u0431\u044B\u043B\u0438\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B
    \u0432 1950\u201370-\u0445 \u0433\u0433., \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0413\u0435\u043D\u043F\u043B\u0430\u043D\u0443 \u0431\u044B\u043B\u0430 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0430
    \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u0430\r\n\u0443\u043B\u0438\u0446\u044B
    \u0438 \u043E\u043D\u0430 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0430
    \u043F\u043B. \u0421\u0432\u043E\u0431\u043E\u0434\u044B \u0441 \u043C\u043E\u0441\u0442\u043E\u043C
    \u0447\u0435\u0440\u0435\u0437 \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u0443.
    \u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F\r\n\u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u0443\u043B\u0438\u0446\u044B \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    4-\u044D\u0442\u0430\u0436\u043D\u044B\u043C \u0436\u0438\u043B\u044B\u043C \u0434\u043E\u043C\u043E\u043C
    \u043D\u0430 \u0443\u0433\u043B\u0443 \u0441 \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430,\r\n\u0437\u0434\u0430\u043D\u0438\u044F\u043C\u0438
    \u0443\u043D\u0438\u0432\u0435\u0440\u043C\u0430\u0433\u0430, \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B
    \xAB\u0412\u0438\u0442\u0435\u0431\u0441\u043A\xBB, \u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E\r\n\u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0442\u0435\u0430\u0442\u0440\u0430 \u0438\u043C. \u042F. \u041A\u043E\u043B\u043E\u0441\u0430,
    \u043F\u0440\u043E\u0435\u043A\u0442\u043D\u043E-\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0431\u044E\u0440\u043E \u0410\u0421\u0423,\r\n\u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043D\u044B\u043C\u0438
    \u0432 1960-\u0445 \u2013 \u043D\u0430\u0447\u0430\u043B\u0435 1970-\u0445 \u0433\u0433."
