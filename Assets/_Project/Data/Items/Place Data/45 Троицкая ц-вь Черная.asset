      1920-\u0435 \u0433\u0433."
    _image: {fileID: 21300000, guid: 578627407c4035840adad8f7305fa31a, type: 3}
  - _title: "\u0422\u0440\u043E\u0438\u0446\u0430. \u0413\u0440\u0430\u0432\u044E\u0440\u0430
      \u0415. \u041C\u0438\u043D\u0438\u043D\u0430. 1928 \u0433."
    _image: {fileID: 21300000, guid: 9510244533e916a4d901b4671b895072, type: 3}
  - _title: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B
      (\u0427\u0435\u0440\u043D\u0430\u044F \u0422\u0440\u043E\u0438\u0446\u0430).
      \u0410\u043F\u0440\u0435\u043B\u044C 1927 \u0433."
    _image: {fileID: 21300000, guid: 76b460b9e79917e45a592c7a630289ba, type: 3}
  - _title: "\u0428\u0430\u0433\u0430\u043B \u041C\u0430\u0440\u043A. \u0417\u0438\u043C\u043D\u044F\u044F
      \u043D\u043E\u0447\u044C \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435. 
      1948 \u0433."
    _image: {fileID: 21300000, guid: 82016229eb97ad449afb7eb9c3255626, type: 3}
  - _title: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B
      (\u0427\u0435\u0440\u043D\u0430\u044F \u0422\u0440\u043E\u0438\u0446\u0430).
      \u0424\u043E\u0442\u043E\u043F\u0440\u043E\u0435\u043A\u0446\u0438\u044F \u0412.
      \u0411\u043E\u0440\u0438\u0441\u0435\u043D\u043A\u043E\u0432\u0430"
    _image: {fileID: 21300000, guid: 9f9d94e1983d16b499879e75cdee86ff, type: 3}
