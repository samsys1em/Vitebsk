  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "45 \u0422\u0440\u043E\u0438\u0446\u043A\u0430\u044F \u0446-\u0432\u044C
    \u0427\u0435\u0440\u043D\u0430\u044F"
  m_EditorClassIdentifier: 
  _number: 45
  _name: "\u0422\u0440\u043E\u0438\u0446\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    (\xAB\u0427\u0435\u0440\u043D\u0430\u044F \u0422\u0440\u043E\u0438\u0446\u0430\xBB)"
  _description: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0432\u043E \u0438\u043C\u044F
    \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B (\u0437\u0430 \u0446\u0432\u0435\u0442
    \u0441\u0442\u0435\u043D \u0435\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
    \xAB\u0427\u0435\u0440\u043D\u0430\u044F \u0422\u0440\u043E\u0438\u0446\u0430\xBB)
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C\r\n\u043D\u0430
    \u041F\u0435\u0441\u043A\u043E\u0432\u0430\u0442\u0438\u043A\u0435, \u0432\u043E\u0437\u043B\u0435
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0441\u043F\u0435\u043A\u0442\u0430 \u041A\u0443\u0439\u0431\u044B\u0448\u0435\u0432\u0430
    \u0438\r\n\u0421\u0442\u0430\u0440\u043E\u0443\u043B\u0430\u043D\u043E\u0432\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u044B, \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
    22-\u0439 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0448\u043A\u043E\u043B\u044B.\r\n\u041F\u0435\u0440\u0432\u044B\u0439
    \u0445\u0440\u0430\u043C \u0432 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u0435\u0449\u0435 \u043D\u0430
    \u0440\u0443\u0431\u0435\u0436\u0435 XVI \u2013 XVII \u0432\u0432., \u0430 \u0432
    1761 \u0433. \u043D\u0430 \u0435\u0433\u043E\r\n\u043C\u0435\u0441\u0442\u0435
    \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u043D\u043E\u0432\u044B\u0439 \u043D\u0430
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
    \u0448\u043B\u044F\u0445\u0435\u0442\u0441\u043A\u043E\u0433\u043E\r\n\u0440\u043E\u0434\u0430
    \u043A\u043D\u044F\u0437\u044F\r\n\u0422\u0430\u0434\u0435\u0443\u0448\u0430
    \u0424\u0440\u0430\u043D\u0442\u0438\u0448\u0435\u043A\u0430 \u041E\u0433\u0438\u043D\u0441\u043A\u043E\u0433\u043E.
    \u041F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u0431\u044B\u043B\u0430
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0439,\r\n\u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u0430
    \u0443\u043D\u0438\u0430\u0442\u0430\u043C, \u0432 1839 \u0433. \u043F\u0435\u0440\u0435\u0448\u043B\u0430
    \u0432 \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0435
    \u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u043E. \u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u044B\r\n\u043E\u0442\u043C\u0435\u0447\u0430\u044E\u0442,
    \u0447\u0442\u043E \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0421\u0432\u044F\u0442\u043E\u0439 \u0422\u0440\u043E\u0438\u0446\u044B \u2013
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0432 \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u043C\r\n\u0437\u043E\u0434\u0447\u0435\u0441\u0442\u0432\u0435
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u043F\u044F\u0442\u0438\u0441\u0440\u0443\u0431\u043D\u043E\u0433\u043E
    \xAB\u043A\u0440\u0435\u0441\u0442\u043E\u0432\u043E\u0433\u043E\xBB \u0442\u0438\u043F\u0430,
    \u043F\u0440\u0438\u043C\u0435\u0440 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430
    \u043E\u0442 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0439\r\n\u0431\u0430\u0440\u043E\u043A\u043A\u043E
    \u043A \u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C\u0443.\r\n\u0421
    \u043D\u0430\u0447\u0430\u043B\u0430 \u0425\u0425 \u0432. \u0445\u0440\u0430\u043C
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u0432 \u0432\u0435\u0442\u0445\u043E\u043C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0438\u0438. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F\r\n\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
    \u0441\u043F\u0430\u0441\u0442\u0438 \u0437\u0434\u0430\u043D\u0438\u0435, \u043E\u043D\u043E
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u043E \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0442\u044C\u0441\u044F.
    \u0412 \u043F\u043E\u0441\u043B\u0435\u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B \u043E\u0431\u044A\u0435\u043A\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u043F\u043E\u0434 \u043D\u0430\u0434\u0437\u043E\u0440\u043E\u043C \u041A\u043E\u043C\u0438\u0441\u0441\u0438\u0438
    \u043F\u043E\r\n\u043E\u0445\u0440\u0430\u043D\u0435 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u043E\u0432,
    \u043E \u0431\u043B\u0430\u0433\u043E\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435
    \u0438 \u0440\u0435\u043C\u043E\u043D\u0442\u0435 \u0445\u0440\u0430\u043C\u0430
    \u0440\u0430\u0442\u043E\u0432\u0430\u043B\u0438 \u043F\u0440\u0438\u0445\u043E\u0436\u0430\u043D\u0435.
    \u041E\u0434\u043D\u0430\u043A\u043E\r\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u043D\u0435 \u0431\u044B\u043B\u0438 \u043D\u0430\u0439\u0434\u0435\u043D\u044B,
    \u0438 \u0432 1927 \u0433\u043E\u0434\u0443 \u0437\u0434\u0430\u043D\u0438\u0435
    \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u043E\u0441\u044C,
    \u0430 \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0434\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u043E
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C. \u041F\u0440\u0438
    \u0440\u0430\u0437\u0431\u043E\u0440\u0435 \u0437\u0430\u0432\u0430\u043B\u043E\u0432
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B
    \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u0438\u044F XVIII\r\n\u2013
    \u043D\u0430\u0447\u0430\u043B\u0430 XIX \u0432\u0432., \u043C\u043E\u043D\u0435\u0442\u044B
    \u0420\u0435\u0447\u0438 \u041F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434\u0430 \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0410\u0432\u0433\u0443\u0441\u0442\u0430 III \u0438 \u0434\u0440\u0443\u0433\u0438\u0435\r\n\u0446\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B.\r\n\xAB\u0427\u0435\u0440\u043D\u0443\u044E
    \u0422\u0440\u043E\u0438\u0446\u0443\xBB \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043B\u0438
    \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u0440\u0430\u0431\u043E\u0442\u0430\u0445
    \u043C\u043D\u043E\u0433\u0438\u0435 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438
    \u043F\u0435\u0440\u0432\u044B\u0445\r\n\u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u0439
    \u0425\u0425 \u0432. \u2013 \u0415\u0444\u0438\u043C \u041C\u0438\u043D\u0438\u043D,
    \u0421\u043E\u043B\u043E\u043C\u043E\u043D \u042E\u0434\u043E\u0432\u0438\u043D,
    \u041B\u0430\u0437\u0430\u0440\u044C \u041B\u0438\u0441\u0438\u0446\u043A\u0438\u0439,
    \u041B\u0435\u043E\u043D \u0413\u0430\u0441\u043F\u0430\u0440."
  _preview: {fileID: 21300000, guid: 6fc8cd8a71f78a34393486d8df7a5317, type: 3}
  _images:
  - _title: "\u0422\u0440\u043E\u0438\u0446\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C.
      \u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430 \u043D\u0430\u0447. \u0425\u0425
      \u0432."
