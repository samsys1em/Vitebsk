  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "48 \u041F\u043E\u0437\u0435\u043C\u0435\u043B\u044C\u043D\u043E-\u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D.
    \u0431\u0430\u043D\u043A - \u0432\u0435\u0442\u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044F"
  m_EditorClassIdentifier: 
  _number: 48
  _name: "\u041F\u043E\u0437\u0435\u043C\u0435\u043B\u044C\u043D\u043E-\u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D.
    \u0431\u0430\u043D\u043A - \u0432\u0435\u0442\u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044F"
  _description: "\u0417\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0437\u0435\u043C\u0435\u043B\u044C\u043D\u043E-\u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0441\u043A\u043E\u0433\u043E
    \u0431\u0430\u043D\u043A\u0430 \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u043F\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0443\r\n\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430
    \u041A. \u0422\u0430\u0440\u0430\u0441\u043E\u0432\u0430 \u0432 1914\u20131917
    \u0433\u0433. \u043D\u0430 \u0443\u043B. \u041D\u0438\u043A\u043E\u043B\u044C\u0441\u043A\u043E\u0439
    (\u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0443\u043B.\r\n1-\u044F
    \u0414\u043E\u0432\u0430\u0442\u043E\u0440\u0430, 7/11). \u041C\u0435\u0441\u0442\u043E
    \u0434\u043B\u044F \u0431\u0430\u043D\u043A\u0430 (\u0430 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
    \u0425\u0425 \u0432. \u044D\u0442\u043E \u0431\u044B\u043B\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F\r\n\u043E\u043A\u0440\u0430\u0438\u043D\u0430)
    \u0431\u044B\u043B\u043E \u0432\u044B\u0431\u0440\u0430\u043D\u043E \u0438\u0441\u0445\u043E\u0434\u044F
    \u0438\u0437 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0435\u0433\u043E
    \u0431\u0443\u0434\u0443\u0449\u0438\u043C\u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C\u0438
    \u0441\u0442\u0430\u043D\u0443\u0442\r\n\u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0435
    \u0438\u0437 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u044B\u0445 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C.
    \u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0446\u0435\u043B\u044C\u044E
    \u0431\u0430\u043D\u043A\u0430 \u0431\u044B\u043B\u0430 \u0432\u044B\u0434\u0430\u0447\u0430
    \u0441\u0441\u0443\u0434\r\n\u043D\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0443
    \u0437\u0435\u043C\u043B\u0438.\r\n\u0412 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u043C
    \u043F\u043B\u0430\u043D\u0435 \u0437\u0434\u0430\u043D\u0438\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u043C \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F
    \u043C\u043E\u0434\u0435\u0440\u043D\u0430 \u0441\r\n\u043D\u0435\u043E\u0440\u0443\u0441\u0441\u043A\u0438\u043C
    \u0441\u0442\u0438\u043B\u0435\u043C. \u0412 \u043F\u043B\u0430\u043D\u0435 \u043E\u043D\u043E
    \u041F-\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0435, \u0438\u043C\u0435\u0435\u0442
    \u043D\u0435\u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u0443\u044E\r\n\u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E:
    \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u043A\u0440\u044B\u043B\u044C\u044F
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u0439 \u0434\u043B\u0438\u043D\u044B
    \u0438 \u0448\u0438\u0440\u0438\u043D\u044B. \u041D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u044F\u0440\u043A\u0438\u043C\u0438\r\n\u0434\u0435\u0442\u0430\u043B\u044F\u043C\u0438
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u0433\u043E
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0443\u0433\u043B\u043E\u0432\u044B\u0435 \u0431\u0430\u0448\u043D\u0438. \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E\r\n\u0447\u0430\u0441\u0442\u044C
    \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0444\u0430\u0441\u0430\u0434\u0430
    \u0443\u043A\u0440\u0430\u0448\u0430\u0435\u0442 \u043C\u043E\u0437\u0430\u0438\u043A\u0430
    \u043D\u0430 \u0441\u044E\u0436\u0435\u0442 \u0433\u0435\u0440\u0431\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438,
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043D\u043E\u0433\u043E
    \u0432 1781 \u0433.\r\n\u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F \u0431\u0430\u043D\u043A\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0432\u0435\u0441\u0442\u0438\u0431\u044E\u043B\u044C, \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0435\r\n\u043A\u0430\u0431\u0438\u043D\u0435\u0442\u044B,
    \u043F\u0440\u0438\u0451\u043C\u043D\u0430\u044F, \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430
    \u043A\u0443\u0440\u044C\u0435\u0440\u0430. \u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C
    \u044D\u0442\u0430\u0436\u0435 \u2013 \u0437\u0430\u043B \u0437\u0430\u0441\u0435\u0434\u0430\u043D\u0438\u0439,\r\n\u043A\u0430\u0431\u0438\u043D\u0435\u0442\u044B
    \u0438 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438
    \u0431\u0430\u043D\u043A\u0430, \u0432 \u0446\u043E\u043A\u043E\u043B\u044C\u043D\u043E\u043C
    \u044D\u0442\u0430\u0436\u0435\r\n\u2013\r\n\u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0438 \u0430\u0440\u0445\u0438\u0432.\r\n\u0421
    \u044F\u043D\u0432\u0430\u0440\u044F 1918 \u0433. \u043F\u043E \u0444\u0435\u0432\u0440\u0430\u043B\u044C
    1920 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u043E
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435\r\n\u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0435
    \u0437\u0435\u043C\u0435\u043B\u044C\u043D\u043E\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435.
    \u0417\u0430\u0442\u0435\u043C \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
    953-\u0439 \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u044C.\r\n\u0412
    1921 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u0431\u0430\u043D\u043A\u0430 \u0431\u044B\u043B \u043E\u0442\u043A\u0440\u044B\u0442
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u0432\u044B\u0441\u0448\u0438\u0439\r\n\u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C, \u043D\u0430 \u0431\u0430\u0437\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432 1924 \u0433. \u0431\u044B\u043B
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    \u0438\u043C. \u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0439
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438.\r\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    \u0431\u044B\u043B \u044D\u0432\u0430\u043A\u0443\u0438\u0440\u043E\u0432\u0430\u043D
    \u0432\r\n\u0432\u043E\u0441\u0442\u043E\u0447\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C
    \u0421\u0421\u0421\u0420, \u0430 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0431\u0430\u043D\u043A\u0430 \u0432
    \u0433\u043E\u0434\u044B \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C\r\n\u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435\r\n\u043E\u0440\u0433\u0430\u043D\u044B\r\n\u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445\r\n\u0432\u043B\u0430\u0441\u0442\u0435\u0439\r\n\u2013\r\n\u0444\u0435\u043B\u044C\u0434\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0443\u0440\u0430
    \u0438 \u0442\u0430\u0439\u043D\u0430\u044F \u043F\u043E\u043B\u0438\u0446\u0438\u044F.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u044B\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\r\n\u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u0438\u043B
    \u0440\u0430\u0431\u043E\u0442\u0443. \u0412 1994 \u0433. \u043E\u043D \u0431\u044B\u043B
    \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D \u0432
    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044E \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0439\r\n\u043C\u0435\u0434\u0438\u0446\u0438\u043D\u044B.
    \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043D\u0430 5 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u0430\u0445
    \u043E\u0431\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u043A\u043E\u043B\u043E
    5 \u0442\u044B\u0441.\r\n\u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432."
  _preview: {fileID: 21300000, guid: c188145a4a3db6e40b1e8494930743d5, type: 3}
