  m_Name: "32 \u0424\u0440\u0443\u043D\u0437\u0435 \u043F\u0440-\u0442 \u0437\u0434\u0430\u043D\u0438\u044F
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435"
  m_EditorClassIdentifier: 
  _number: 32
  _name: "\u0424\u0440\u0443\u043D\u0437\u0435 \u043F\u0440-\u0442 \u0437\u0434\u0430\u043D\u0438\u044F
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435"
  _description: "\u041C\u0443\u0436\u0441\u043A\u0430\u044F \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0431\u044B\u043B\u0430
    \u043E\u0442\u043A\u0440\u044B\u0442\u0430 \u0432 1809 \u0433. \u043F\u0443\u0442\u0435\u043C\r\n\u0440\u0435\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0447\u0438\u043B\u0438\u0449\u0430.
    \u0414\u043E 1876 \u0433. \u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u043E\u0441\u044C
    \u0432 \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u043E\u043C \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C
    \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0430 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439
    \u0433\u043E\u0440\u043A\u0435 (\u043D\u044B\u043D\u0435 \u0443\u043B.\r\n\u041A\u0440\u044B\u043B\u043E\u0432\u0430,
    7). \u0417\u0430\u0442\u0435\u043C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043B\u0435\u0442 \u2013 \u0432 \u0434\u043E\u043C\u0435 \u043D\u0430 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0439
    \u0443\u043B. (\u0441\u043E\u0432\u0440. \u0443\u043B.\r\n\u041B\u0435\u043D\u0438\u043D\u0430)
    \u0431\u043B\u0438\u0437 \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u0421\u0432.
    \u0410\u043D\u0442\u043E\u043D\u0438\u044F. \u041D\u0430\u043A\u043E\u043D\u0435\u0446,
    \u0432 1880 \u0433. \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0430
    \u0432\r\n\u043D\u043E\u0432\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
    \u043D\u0430 \u0443\u043B. \u0422\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    (\u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C;
    \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435\r\n\u0437\u0434\u0430\u043D\u0438\u0435,
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0435 \u0432 1977
    \u0433. \u0434\u043B\u044F \u043F\u0440\u043E\u0435\u043A\u0442\u043D\u043E-\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0431\u044E\u0440\u043E\r\n\u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u2013 \u041F\u041A\u0411 \u0410\u0421\u0423).\r\n\u0422\u0440\u0435\u0445\u044D\u0442\u0430\u0436\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u0432 1875\u20131879 \u0433\u0433. \u043F\u043E\r\n\u043F\u0440\u043E\u0435\u043A\u0442\u0443
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u043E\u0432 \u041D.
    \u041A\u0430\u0440\u0447\u0435\u0432\u0441\u043A\u043E\u0433\u043E \u0438 \u0410.
    \u041F\u043E\u043B\u043E\u043D\u0441\u043A\u043E\u0433\u043E, \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u0444\u0430\u0441\u0430\u0434\u043E\u043C\r\n\u0431\u044B\u043B\u043E \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u043E
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u044B.
    \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0435\u0433\u043E \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0431\u044B\u043B\u0430\r\n\u0441\u0440\u044B\u0442\u0430 \u0447\u0430\u0441\u0442\u044C
    \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439 \u0433\u043E\u0440\u044B. \u0410\u0432\u0442\u043E\u0440\u044B
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0432\r\n\u043D\u0435\u043C
    \u0443\u0447\u0435\u0431\u043D\u044B\u0445 \u043A\u043B\u0430\u0441\u0441\u043E\u0432,
    \u0433\u0438\u043C\u043D\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438 \u0430\u043A\u0442\u043E\u0432\u043E\u0433\u043E \u0437\u0430\u043B\u043E\u0432,
    \u0434\u043E\u043C\u043E\u0432\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438,\r\n\u043A\u0432\u0430\u0440\u0442\u0438\u0440
    \u0434\u043B\u044F \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430 \u0438
    \u0435\u0433\u043E \u0441\u0435\u043C\u044C\u0438.\r\n\u0413\u0438\u043C\u043D\u0430\u0437\u0438\u044F
    \u0431\u044B\u043B\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u043C \u043E\u0431\u0449\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0443\u0447\u0435\u0431\u043D\u044B\u043C \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C
    \u0434\u043B\u044F\r\n\u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432 \u0432\u0441\u0435\u0445
    \u0441\u043E\u0441\u043B\u043E\u0432\u0438\u0439. \u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
    \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0443\u0441\u0442\u0430\u0432\u0443, \u044F\u0432\u043B\u044F\u043B\u0430\u0441\u044C\r\n\u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
    \u0443\u0447\u0430\u0449\u0438\u0445\u0441\u044F \u043A \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044E
    \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442. \u0417\u0430
    \u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u043E\u0441\u0435\u043C\u044C \u043B\u0435\u0442\r\n\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044E \u043E\u043A\u043E\u043D\u0447\u0438\u043B\u0438
    \u0432\u0441\u0435\u0433\u043E \u0434\u0435\u0441\u044F\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
    \u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C\r\n\u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0443\u0447\u0430\u0449\u0438\u0445\u0441\u044F \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E
    \u043C\u0435\u043D\u044F\u043B\u043E\u0441\u044C. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0432 1892 \u0433. \u0438\u0445 \u0431\u044B\u043B\u043E\r\n385\r\n\u0412 \u0447\u0438\u0441\u043B\u0435
    \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u0441\u043A\u043E\u0439
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438 \u2013\r\n\u044D\u0442\u043D\u043E\u0433\u0440\u0430\u0444
    \u0438 \u0444\u043E\u043B\u044C\u043A\u043B\u043E\u0440\u0438\u0441\u0442 \u041D\u0438\u043A\u043E\u043B\u0430\u0439
    \u041D\u0438\u043A\u0438\u0444\u043E\u0440\u043E\u0432\u0441\u043A\u0438\u0439,
    \u0440\u0430\u0432\u0432\u0438\u043D \u0411\u0435\u0440-\u0410\u0431\u0440\u0430\u043C\r\n\u0413\u0438\u0442\u0442\u0435\u043B\u044C\u0441\u043E\u043D
    (\u0434\u0435\u0434 \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044F \u0421\u0430\u043C\u0443\u0438\u043B\u0430
    \u041C\u0430\u0440\u0448\u0430\u043A\u0430), \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A
    \u0418\u0432\u0430\u043D \u0422\u0440\u0443\u0442\u043D\u0435\u0432,\r\n\u0438\u0441\u0442\u043E\u0440\u0438\u043A-\u043A\u0440\u0430\u0435\u0432\u0435\u0434,
    \u0430\u0440\u0445\u0435\u043E\u0433\u0440\u0430\u0444 \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u0421\u0430\u043F\u0443\u043D\u043E\u0432, \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043E\u0440
    \u041C\u0438\u0445\u0430\u0438\u043B \u0410\u043D\u0446\u0435\u0432\r\n\u0438
    \u0434\u0440\u0443\u0433\u0438\u0435. \u0412 \u0440\u0430\u0437\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0441\u043F\u0438\u0442\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438 \u0431\u044B\u043B\u0438 \u0434\u0435\u043A\u0430\u0431\u0440\u0438\u0441\u0442
    \u0418\u0432\u0430\u043D\r\n\u0413\u043E\u0440\u0431\u0430\u0447\u0435\u0432\u0441\u043A\u0438\u0439,
    \u0430\u0432\u0442\u043E\u0440 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439
    \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0439 \u043F\u043E\u044D\u043C\u044B
    \xAB\u0422\u0430\u0440\u0430\u0441 \u043D\u0430 \u041F\u0430\u0440\u043D\u0430\u0441\u0435\xBB\r\n\u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D
    \u0412\u0435\u0440\u043E\u043D\u0438\u0446\u044B\u043D, \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u0430
    \u0410\u043B\u0435\u043A\u0441\u0435\u0439 \u0412\u043E\u043B\u043A\u043E\u0432\u0438\u0447,\r\n\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C \u0438 \u043A\u0440\u0430\u0435\u0432\u0435\u0434
    \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u0421\u0442\u0443\u043A\u0430\u043B\u0438\u0447,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u0443\u0441\u0441\u043A\u0438\u0439\r\n\u0444\u0438\u043B\u043E\u0441\u043E\u0444\r\n\u041D\u0438\u043A\u043E\u043B\u0430\u0439
    \u041B\u043E\u0441\u0441\u043A\u0438\u0439, \u0432\u0440\u0430\u0447, \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u0436\u043D\u043E-\r\n\u0432\u0435\u043D\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0434\u0438\u0441\u043F\u0430\u043D\u0441\u0435\u0440\u0430 \u0411\u043E\u0440\u0438\u0441
    \u0413\u0435\u0440\u0448\u0443\u043D, \u0437\u0430\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C
    \u043D\u0430\u0440\u043A\u043E\u043C\u0430 \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F\r\n\u0421\u0421\u0421\u0420
    \u0432 1920-\u0445 \u0433\u0433. \u0418\u0432\u0430\u043D \u0422\u0435\u043E\u0434\u043E\u0440\u043E\u0432\u0438\u0447,
    \u043E\u0442\u0435\u0446 \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044F \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430
    \u0413\u0440\u0438\u043D\u0430\r\n\u0421\u0442\u0435\u0444\u0430\u043D \u0413\u0440\u0438\u043D\u0435\u0432\u0441\u043A\u0438\u0439
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438
    \u0432 1918 \u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F
    \u0414\u0435\u0442\u0441\u043A\u043E\u0441\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u0432\u043E\u0435\u043D\u043D\u044B\u0439 \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u044C,
    \u0441 1921 \u0433. \u2013 \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439\r\n\u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442.
    \u0417\u0434\u0430\u043D\u0438\u0435 \u0432\u044B\u0441\u0442\u043E\u044F\u043B\u043E
    \u0432 \u0433\u043E\u0434\u044B \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u043B\u0438\u0445\u043E\u043B\u0435\u0442\u0438\u0439.
    \u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E \u0431\u044B\u043B\u043E
    \u0432\r\n1973 \u0433. \u0432 \u0445\u043E\u0434\u0435 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
    \u0443\u043B. \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439."
