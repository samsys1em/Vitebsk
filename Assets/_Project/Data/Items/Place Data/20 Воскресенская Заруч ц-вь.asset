  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "20 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    \u0417\u0430\u0440\u0443\u0447 \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 20
  _name: "\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    \u0417\u0430\u0440\u0443\u0447\u0435\u0432\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0425\u0440\u0430\u043C \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u044F
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0443\u043B\u0438\u0446
    \u041A\u0430\u043B\u0438\u043D\u0438\u043D\u0430 \u0438\r\n\u041C. \u0428\u0430\u0433\u0430\u043B\u0430
    \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 1618 \u0433. \u043D\u0430
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0446\u0435\u0445\u043E\u0432\u043E\u0439
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u043A\u043E\u0436\u0435\u0432\u043D\u0438\u043A\u043E\u0432.\r\n\u041F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u043A \u0442\u043E\u043C\u0443
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0445\u0440\u0430\u043C \u0432\u043E \u0438\u043C\u044F\r\n\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0438\u044F
    \u0425\u0440\u0438\u0441\u0442\u043E\u0432\u0430 (\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F
    \u043D\u0430 \u0440\u044B\u043D\u043A\u0435, \u0432\u043E\u0437\u043B\u0435 \u0440\u0430\u0442\u0443\u0448\u0438),
    \u044D\u0442\u0443 \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n\u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
    \u043F\u043E \u043C\u0435\u0441\u0442\u0443 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u0417\u0430\u0440\u0443\u0447\u0435\u0432\u0441\u043A\u043E\u0439 (\u043D\u0430
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0440\u0430\u0439\u043E\u043D\u0430\r\n\u0417\u0430\u0440\u0443\u0447\u0430\u0432\u044C\u0435),
    \u0430 \u0435\u0449\u0451 \u2013 \u043A\u043E\u0436\u0435\u043C\u044F\u0442\u0441\u043A\u043E\u0439.\r\n\u041F\u0435\u0440\u0432\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u043E\u0439
    \u0417\u0430\u0440\u0443\u0447\u0435\u0432\u0441\u043A\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438
    \u0431\u044B\u043B\u043E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C.\r\n\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439,
    \u044D\u0442\u043E\u0442 \u0445\u0440\u0430\u043C \u0432\u0441\u043A\u043E\u0440\u0435
    \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B \u0441\u0443\u0434\u044C\u0431\u0443
    \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445\r\n\u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0445
    \u0446\u0435\u0440\u043A\u0432\u0435\u0439 \u0433\u043E\u0440\u043E\u0434\u0430
    \u0438 \u043F\u0435\u0440\u0435\u0448\u0451\u043B \u0432 \u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0443\u043D\u0438\u0430\u0442\u043E\u0432.\r\n\u0412 1771\u20131800 \u0433\u0433.
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0432 \u0441\u0442\u0438\u043B\u0435 \u0432\u0438\u043B\u0435\u043D\u0441\u043A\u043E\u0433\u043E\r\n\u0431\u0430\u0440\u043E\u043A\u043A\u043E.
    \u0410\u043B\u0442\u0430\u0440\u0451\u043C \u0445\u0440\u0430\u043C \u0431\u044B\u043B
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D \u043D\u0430
    \u0432\u043E\u0441\u0442\u043E\u043A, \u0444\u0430\u0441\u0430\u0434 \u0443\u043A\u0440\u0430\u0448\u0430\u043B\u0438
    \u0434\u0432\u0435\r\n\u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044B\u0435
    \u0431\u0430\u0448\u043D\u0438, \u043D\u0430\u0434 \u0441\u0440\u0435\u0434\u043E\u043A\u0440\u0435\u0441\u0442\u0438\u0435\u043C
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u043A\u0443\u043F\u043E\u043B.\r\n\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
    \u0440\u0430\u0437\u043C\u0435\u0440\u044B \u0446\u0435\u0440\u043A\u0432\u0438
    \u2013 34 \u0445 17 \u043C\u0435\u0442\u0440\u043E\u0432.\r\n\u0412 1839 \u0433.
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u0430
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C. \u0412
    XIX \u0432. \u043F\u0440\u0438\u0445\u043E\u0434 \u0445\u0440\u0430\u043C\u0430\r\n\u0438\u043C\u0435\u043B
    \u0448\u043A\u043E\u043B\u044B \u0433\u0440\u0430\u043C\u043E\u0442\u044B, \u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E\u043F\u0440\u0438\u0445\u043E\u0434\u0441\u043A\u0443\u044E
    \u0448\u043A\u043E\u043B\u0443 \u0438 \u0434\u0432\u0435 \u043F\u0440\u0438\u043F\u0438\u0441\u043D\u044B\u0435
    \u0446\u0435\u0440\u043A\u0432\u0438:\r\n\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0443\u044E
    (\u0441\u043E\u0432\u0440. \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0438\u0439
    \u0441\u043E\u0431\u043E\u0440) \u0438 \u041A\u0440\u0435\u0441\u0442\u043E\u0432\u043E\u0437\u0434\u0432\u0438\u0436\u0435\u043D\u0441\u043A\u0443\u044E\r\n\u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435\u043D\u0441\u043A\u0443\u044E
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C (\u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430\u0441\u044C).\r\n\u041F\u043E\u0441\u043B\u0435
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u0445\u0440\u0430\u043C
    \u0431\u044B\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u0435\u0449\u0435 \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u0447\u0435\u0442\u044B\u0440\u0435\u0445\r\n\u043B\u0435\u0442, \u0432 1921
    \u0433. \u0435\u0433\u043E \u0437\u0430\u043A\u0440\u044B\u043B\u0438. \u0417\u0434\u0430\u043D\u0438\u0435
    \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E \u0432 \u0433\u043E\u0434\u044B
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439\r\n\u0432\u043E\u0439\u043D\u044B,
    \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B."
  _preview: {fileID: 21300000, guid: d89c13bd6b87bb14bbb620fb6d62ff30, type: 3}
