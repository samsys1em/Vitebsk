  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "38 \u043A\u0430\u0437\u0430\u0440\u043C\u044B \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u043B\u043A\u0430"
  m_EditorClassIdentifier: 
  _number: 38
  _name: "\u043A\u0430\u0437\u0430\u0440\u043C\u044B \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u043B\u043A\u0430"
  _description: "\u0417\u0434\u0430\u043D\u0438\u044F \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445
    \u043A\u0430\u0437\u0430\u0440\u043C (\u043D\u044B\u043D\u0435 \u0434\u043E\u043C\u0430
    \u2116\u2116 12, 14, 16 \u043F\u043E \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430)
    \u0431\u044B\u043B\u0438\r\n\u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u044B
    \u0432 \u043A. 1880-\u0445 \u2013 \u043D\u0430\u0447. 1890-\u0445 \u0433\u0433.
    \u043D\u0430 \u0443\u043B. \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u041C\u043E\u0433\u0438\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    (\u0441 1902 \u0433. \u2013\r\n\u0413\u043E\u0433\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439)
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0431\u044B\u0432\u0448\u0435\u0433\u043E
    \u0422\u0440\u0438\u043D\u0438\u0442\u0430\u0440\u0441\u043A\u043E\u0433\u043E
    \u0441\u0430\u0434\u0430. \u0421\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0432\r\n\u0437\u0434\u0430\u043D\u0438\u044F\u0445
    \u0431\u044B\u043B \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D 163-\u0439
    \u043F\u0435\u0445\u043E\u0442\u043D\u044B\u0439 \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u0438\u0439
    \u043F\u043E\u043B\u043A \u2013\r\n\u0432\u043E\u0438\u043D\u0441\u043A\u043E\u0435
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435, \u0432\u0445\u043E\u0434\u0438\u0432\u0448\u0435\u0435
    \u0432 41-\u044E \u043F\u0435\u0445\u043E\u0442\u043D\u0443\u044E \u0434\u0438\u0432\u0438\u0437\u0438\u044E
    (16-\u0439 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439\r\n\u043A\u043E\u0440\u043F\u0443\u0441).\r\n\u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u0438\u0439
    \u041F\u0435\u0445\u043E\u0442\u043D\u044B\u0439 \u043F\u043E\u043B\u043A \u0431\u044B\u043B
    \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D \u0432 1874
    \u0433. \u043D\u0430 \u041A\u0430\u0432\u043A\u0430\u0437\u0435. \u0411\u043E\u0435\u0432\u043E\u0435\r\n\u043A\u0440\u0435\u0449\u0435\u043D\u0438\u0435
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432 \u0420\u0443\u0441\u0441\u043A\u043E-\u0442\u0443\u0440\u0435\u0446\u043A\u043E\u0439
    \u0432\u043E\u0439\u043D\u0435 1877\u20131878 \u0433\u0433. \u0412 1883 \u0433.
    \u043F\u043E\u043B\u043A \u0431\u044B\u043B\r\n\u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043D
    \u0432 \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0443\u044E \u0420\u043E\u0441\u0441\u0438\u044E,
    \u0441 1891 \u0433. \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u0441\u044F
    163-\u043C \u041F\u0435\u0445\u043E\u0442\u043D\u044B\u043C\r\n\u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u0438\u043C
    \u043F\u043E\u043B\u043A\u043E\u043C.\r\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0440\u0443\u0441\u0441\u043A\u043E-\u044F\u043F\u043E\u043D\u0441\u043A\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F
    1904 \u0433. \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\r\n\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u0438\u0439
    \u043F\u043E\u043B\u043A \u0431\u044B\u043B \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D
    \u043D\u0430 \u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0412\u043E\u0441\u0442\u043E\u043A
    \u0438 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043D\u0430 \u043E\u0445\u0440\u0430\u043D\u0443\r\n\u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
    \u0434\u043E\u0440\u043E\u0433\u0438. \u041F\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438
    \u0432\u043E\u0439\u043D\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A, \u0430 \u0432 1910 \u0433.
    \u0431\u044B\u043B\r\n\u043F\u0435\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0446\u0438\u0440\u043E\u0432\u0430\u043D
    \u0432 \u041A\u0430\u0437\u0430\u043D\u0441\u043A\u0438\u0439 \u0432\u043E\u0435\u043D\u043D\u044B\u0439
    \u043E\u043A\u0440\u0443\u0433.\r\n\u041F\u043E\u0441\u043B\u0435 \u043E\u0442\u044A\u0435\u0437\u0434\u0430
    \u0432\u043E\u0439\u0441\u043A \u0438\u0437 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0432 \u043A\u0430\u0437\u0430\u0440\u043C\u0430\u0445 \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E\r\n\u043F\u043E\u043B\u043A\u0430
    (\u0441\u043E\u0432\u0440. \u0437\u0434\u0430\u043D\u0438\u0435 \u2116 14) \u0441
    \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1910 \u0433. \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439\r\n\u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    (\u043F\u0435\u0440\u0432\u044B\u0439 \u0432 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438!),
    \u043D\u0430 \u0431\u0430\u0437\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0432 \u043E\u043A\u0442\u044F\u0431\u0440\u0435 1918 \u0433. \u0431\u044B\u043B
    \u043E\u0442\u043A\u0440\u044B\u0442\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439
    \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442. \u041A\u0440\u043E\u043C\u0435
    \u0442\u043E\u0433\u043E, \u0441 1910 \u043F\u043E 1918 \u0433\u0433. \u0432
    \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u0443\u0447\u0435\u043D\u0430\u044F
    \u0430\u0440\u0445\u0438\u0432\u043D\u0430\u044F \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F,
    \u0441 1911 \u043F\u043E 1922 \u0433\u0433. \u2013\r\n\u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430, \u0432 1915\u20131918
    \u0433\u0433. \u2013 \u0448\u0442\u0430\u0431\r\n\u0414\u0432\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u043A\u0440\u0443\u0433\u0430.\r\n\u0412
    \u043D\u044B\u043D\u0435\u0448\u043D\u0435\u043C \u0434\u043E\u043C\u0435 \u2116
    16 \u0432 1910\u20131911 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u0433\u043E\u0434\u0443
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C \u0447\u0430\u0441\u0442\u043D\u0430\u044F\r\n\u043C\u0443\u0436\u0441\u043A\u0430\u044F
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F \u0418.\u0420. \u041D\u0435\u0440\u0443\u0448\u0430,
    \u0441 1918 \u0433. \u2013 1-\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0435 \u043F\u0435\u0445\u043E\u0442\u043D\u044B\u0435\r\n\u043A\u0443\u0440\u0441\u044B.\r\n\u0412
    1922\u20131938 \u0433\u0433. \u0432 \u0431\u044B\u0432\u0448\u0438\u0445 \u043A\u0430\u0437\u0430\u0440\u043C\u0430\u0445
    \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u043B\u043A\u0430 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0441\u044F
    81-\u0439\r\n\u043F\u043E\u043B\u043A 27-\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0439
    \u041E\u043C\u0441\u043A\u043E\u0439 \u0434\u0438\u0432\u0438\u0437\u0438\u0438.
    \u0427\u0430\u0441\u0442\u044C \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439
    \u0432 \u0437\u0434\u0430\u043D\u0438\u044F\u0445\r\n\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u0434\u043B\u044F \u0436\u0438\u043B\u044C\u044F \u0441\u0435\u043C\u044C\u044F\u043C\u0438
    \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445.\r\n\u0412
    \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0437\u0434\u0430\u043D\u0438\u044F\u0445 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C\r\n\u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0435
    \u0432\u0435\u0440\u043C\u0430\u0445\u0442\u0430. \u041F\u043E\u0441\u043B\u0435
    \u0432\u043E\u0439\u043D\u044B \u043E\u0442\u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F \u0431\u044B\u043B\u0438\r\n\u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u044B
    \u0434\u043B\u044F \u0436\u0438\u043B\u044B\u0445 \u043A\u0432\u0430\u0440\u0442\u0438\u0440,
    \u0432 \u043D\u0438\u0445 \u0436\u0438\u043B\u0438 \u0441\u0435\u043C\u044C\u0438
    339-\u0433\u043E \u0438\u043C. \u0421\u0443\u0432\u043E\u0440\u043E\u0432\u0430\r\n\u0432\u043E\u0435\u043D\u043D\u043E-\u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E\u0433\u043E
    \u0430\u0432\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u043A\u0430.\r\n\u0421\u0435\u0439\u0447\u0430\u0441
    \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0445 \u044D\u0442\u0430\u0436\u0430\u0445
    \u044D\u0442\u0438\u0445 \u0437\u0434\u0430\u043D\u0438\u0439 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B, \u0441\u0430\u043B\u043E\u043D\u044B,\r\n\u043A\u0430\u0444\u0435.
    \u0412\u0442\u043E\u0440\u044B\u0435 \u0438 \u0442\u0440\u0435\u0442\u044C\u0438
    \u044D\u0442\u0430\u0436\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434 \u0436\u0438\u043B\u044C\u0435. \u0427\u0430\u0441\u0442\u044C
    \u0434\u043E\u043C\u0430 \u2116 16 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\r\n\u0434\u0435\u043B\u043E\u0432\u043E\u0439
    \u0446\u0435\u043D\u0442\u0440 \xAB\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0438\u0439\xBB."
  _preview: {fileID: 21300000, guid: bf87dbd8f592c6d41bcb360b6715d3d9, type: 3}
  _images:
  - _title: "\u041A\u0430\u0437\u0430\u0440\u043C\u044B \u041B\u0435\u043D\u043A\u043E\u0440\u0430\u043D\u0441\u043A\u043E-\u041D\u0430\u0448\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u043B\u043A\u0430. \u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425
      \u0432."
    _image: {fileID: 21300000, guid: 136b4784dc38b15499581eca1dbf2dce, type: 3}
  - _title: "\u041C\u0443\u0436\u0441\u043A\u0430\u044F \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F
      \u0418.\u0420. \u041D\u0435\u0440\u0443\u0448\u0430 \u0438 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
      \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u0432 \u0437\u0434\u0430\u043D\u0438\u044F\u0445
      \u0431\u044B\u0432\u0448\u0438\u0445 \u043A\u0430\u0437\u0430\u0440\u043C.
      1910-\u0435 \u0433\u0433."
    _image: {fileID: 21300000, guid: 032a8957cfb09c94999c60607c32114c, type: 3}
  - _title: "\u0413\u0438\u043C\u043D\u0430\u0437\u0438\u044F \u0418.\u0420. \u041D\u0435\u0440\u0443\u0448\u0430
