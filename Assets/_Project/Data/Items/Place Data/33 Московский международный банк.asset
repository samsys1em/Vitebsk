  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "33 \u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u0439 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
    \u0431\u0430\u043D\u043A"
  m_EditorClassIdentifier: 
  _number: 33
  _name: "\u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u0439 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
    \u0431\u0430\u043D\u043A"
  _description: "\u0412 1900-\u0445 \u0433\u0433. \u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u0439
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
    \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0431\u0430\u043D\u043A \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B
    3-\r\n\u044D\u0442\u0430\u0436\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0443\u043B. \u041F\u043E\u0434\u0432\u0438\u043D\u0441\u043A\u043E\u0439
    (\u043D\u044B\u043D\u0435 \u0443\u043B. \u0422\u043E\u043B\u0441\u0442\u043E\u0433\u043E,
    2) \u0434\u043B\u044F\r\n\u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u0432 \u043D\u0435\u043C \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F. \u0417\u0434\u0430\u043D\u0438\u0435
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u0432 1856 \u0433.,\r\n\u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u0435\u0433\u043E
    \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u0431\u044B\u043B\u0438
    \u043A\u0443\u043F\u0446\u044B \u0412\u0438\u0442\u0435\u043D\u0431\u0435\u0440\u0433\u0438.
    \u0418\u043C \u0436\u0435 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\r\n\u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B
    \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439 \u0434\u043E\u043C (\u043D\u044B\u043D\u0435
    \u0443\u043B. \u0422\u043E\u043B\u0441\u0442\u043E\u0433\u043E, 4).\r\n\u0412
    \u0434\u043E\u043C\u0435 \u21162 \u0431\u0430\u043D\u043A \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u0431\u043E\u043B\u0435\u0435 100 \u043B\u0435\u0442, \u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F:
    \u0441\r\n1922 \u0433. \u2013 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0431\u0430\u043D\u043A\u0430 \u0420\u0421\u0424\u0421\u0420 (\u043F\u043E\u0437\u0436\u0435
    \u0421\u0421\u0421\u0420),\r\n\u0432 1930-\u0445 \u0433\u0433. \u2013 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E,
    \u043A\u043E\u043C\u043C\u0443\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0438 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0433\u043E\r\n\u0431\u0430\u043D\u043A\u043E\u0432,
    \u0432 1960-\u0445 \u2013 1980-\u0445 \u2013 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0431\u0430\u043D\u043A\u0430. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\r\n\u0437\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \xAB\u0411\u0435\u043B\u0430\u0433\u0440\u043E\u043F\u0440\u043E\u043C\u0431\u0430\u043D\u043A\u0430\xBB.\r\n\u0412
    \u0434\u043E\u043C\u0435 \u2116 4 \u0432 1906\u20131910 \u0433\u0433. \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C
    \u0447\u0430\u0441\u0442\u043D\u0430\u044F \u043C\u0443\u0436\u0441\u043A\u0430\u044F
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F\r\n\u0418\u0432\u0430\u043D\u0430
    \u041D\u0435\u0440\u0443\u0448\u0430. \u0420\u0443\u0441\u0441\u043A\u0438\u0439
    \u044F\u0437\u044B\u043A \u0438 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u043A\u0443
    \u0432 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u043A\u043B\u0430\u0441\u0441\u0435 \u0432\r\n1906\u20131909 \u0433\u0433. \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u043B
    \u043A\u0440\u0430\u0435\u0432\u0435\u0434, \u044D\u0442\u043D\u043E\u0433\u0440\u0430\u0444
    \u041D\u0438\u043A\u043E\u043B\u0430\u0439 \u041D\u0438\u043A\u0438\u0444\u043E\u0440\u043E\u0432\u0441\u043A\u0438\u0439.
    \u0412\r\n1911\u20131919 \u0433\u0433. \u0432 \u0434\u043E\u043C\u0435 \u0436\u0438\u043B\u0430
    \u0441\u0435\u043C\u044C\u044F \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u0430
    \u041A\u0440\u0430\u0441\u043D\u044F\u043D\u0441\u043A\u043E\u0433\u043E, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E\r\n\u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
    \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0430, \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0430,
    \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0430, \u043C\u0443\u0437\u0435\u0439\u043D\u043E\u0433\u043E
    \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0430. \u0412 \u0447\u0435\u0441\u0442\u044C\r\n\u044D\u0442\u0438\u0445
    \u0434\u0432\u0443\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u0432\u0438\u0442\u0435\u0431\u043B\u044F\u043D \u0432 1996 \u0433. \u043D\u0430
    \u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u044B\u043B\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B\r\n\u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0434\u043E\u0441\u043A\u0438.\r\n\u0412 1930-\u0445 \u0433\u0433. \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u043E\u0441\u044C \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435\r\n\u043A\u043E\u043C\u043C\u0443\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0431\u0430\u043D\u043A\u0430. \u0412 \u0433\u043E\u0434\u044B \u0432\u043E\u0439\u043D\u044B
    \u2013 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F \u0443\u043F\u0440\u0430\u0432\u0430.
    \u0412 1960-\u0445 \u0433\u0433. \u2013\r\n\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0431\u0430\u043D\u043A, \u0434\u0435\u0442\u0441\u043A\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430
    \u043C\u0438\u043B\u0438\u0446\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043A\u043E\u0435
    \u043F\u043E\u043B\u0438\u043A\u043B\u0438\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435\r\n\u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u043E\u0433\u043E \u0440\u0430\u0439\u043E\u043D\u0430.
    \u0412 1980-\u0445 \u2013 \u0442\u0440\u0435\u0441\u0442 \xAB\u0421\u0442\u0440\u043E\u0439\u0431\u044B\u0442\u0440\u0435\u043C\u043E\u043D\u0442\xBB.\r\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442
    \u043E\u0444\u0438\u0441\u044B \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439."
  _preview: {fileID: 21300000, guid: f9a31ae2504ce8445a2042eaccedf8f9, type: 3}
  _images:
  - _title: "\u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u0439 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0431\u0430\u043D\u043A.
      \u041D\u0430\u0447\u0430\u043B\u043E \u0425\u0425 \u0432."
