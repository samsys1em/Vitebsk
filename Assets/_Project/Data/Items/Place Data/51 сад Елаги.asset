  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "51 \u0441\u0430\u0434 \u0415\u043B\u0430\u0433\u0438"
  m_EditorClassIdentifier: 
  _number: 51
  _name: "\u0441\u0430\u0434 \u0415\u043B\u0430\u0433\u0438"
  _description: "\u0415\u043B\u0430\u0433\u0438 \u2013 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0440\u0430\u0439\u043E\u043D \u0432 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0432 \u0416\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u043C\r\n\u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u043C
    \u0440\u0430\u0439\u043E\u043D\u0435, \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0438\u0439\u0441\u044F
    \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    XIX \u0432. \u0432\u043E\u043A\u0440\u0443\u0433\r\n\u043E\u0434\u043D\u043E\u0438\u043C\u0451\u043D\u043D\u043E\u0433\u043E
    \u0444\u043E\u043B\u044C\u0432\u0430\u0440\u043A\u0430 (\u0443\u0441\u0430\u0434\u044C\u0431\u044B).
    \u0424\u043E\u043B\u044C\u0432\u0430\u0440\u043A \u0415\u043B\u0430\u0433\u0438
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435\r\n\u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    2-\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B
    (\u0443\u043B. \u041D\u0435\u043A\u0440\u0430\u0441\u043E\u0432\u0430, 10\u0430).\r\n\u0412
    1-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 XIX \u0432. \u0444\u043E\u043B\u044C\u0432\u0430\u0440\u043A
    \u0415\u043B\u0430\u0433\u0438 \u0431\u044B\u043B \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0435\u043C
    \u043D\u0430\u0434\u0432\u043E\u0440\u043D\u043E\u0433\u043E \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u0430\r\n\u0413\u0435\u0440\u043E\u043D\u0438\u043C\u0430
    \u041C\u0438\u043B\u044C\u043A\u0435\u0432\u0438\u0447\u0430.\r\n\u0415\u043B\u0430\u0433\u0438\u043D\u0441\u043A\u0438\u0439
    \u0441\u0430\u0434 \u044F\u0432\u043B\u044F\u043B\u0441\u044F \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0445 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.
    \u0421\u043E\u0437\u0434\u0430\u043D \u0432 XIX \u0432. \u0438\u0437\r\n\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043B\u0435\u0441\u0430, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F
    \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u042E\u0440\u044C\u0435\u0432\u043E\u0439
    \u0433\u043E\u0440\u043A\u0438. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0431\u044B\u043B\r\n\u0447\u0430\u0441\u0442\u043D\u044B\u043C, \u0432 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u0430\u043B \u043E\u0431\u0449\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C.
    \u0412 1919 \u0433. \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D
    \u0432 \u0421\u0430\u0434\r\n\u041A\u043E\u043C\u043C\u0443\u043D\u044B, \u0437\u0430\u0442\u0435\u043C
    \u0435\u043C\u0443 \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u0441\u0432\u043E\u0435\u043D\u043E
    \u0438\u043C\u044F \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043B\u044F
    \u0412\u0426\u0418\u041A\u0430 \u0420\u0421\u0424\u0421\u0420\r\n\u042F. \u0421\u0435\u0440\u0434\u043B\u043E\u0432\u0430.\r\n\u0412
    \u043D\u0430\u0447\u0430\u043B\u0435 1920-\u0445 \u0433\u0433. \u0437\u0434\u0435\u0441\u044C
    \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u043F\u0435\u0440\u0432\u044B\u0439
    \u0441\u0442\u0430\u0434\u0438\u043E\u043D \u0433\u043E\u0440\u043E\u0434\u0430,
    \u0433\u0434\u0435\r\n\u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u043C\u0430\u0441\u0441\u043E\u0432\u044B\u0435 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0435
    \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u0412
    1930-\u0445 \u0431\u044B\u043B \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u043A\u0430\u043A \u0441\u0430\u0434\r\n\u0438\u043C. \u041A\u0430\u0433\u0430\u043D\u043E\u0432\u0438\u0447\u0430
    (\u043D\u0430\u0437\u0432\u0430\u043D \u0432 \u0447\u0435\u0441\u0442\u044C \u0442\u043E\u0433\u0434\u0430\u0448\u043D\u0435\u0433\u043E
    \u043D\u0430\u0440\u043A\u043E\u043C\u0430 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E\r\n\u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430).\r\n\u0421
    \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B 1950-\u0445 \u0433\u0433. \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u0430\u0440\u043A\u043E\u043C \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B
    \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\r\n\u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u043E\u0432.
    \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0435\u0433\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043E\u043A\u043E\u043B\u043E 2,5 \u0433\u0430.\r\n\u0417\u0434\u0435\u0441\u044C
    \u0432\u044B\u0441\u0430\u0436\u0435\u043D\u043E \u043E\u043A\u043E\u043B\u043E
    300 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u0438 \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u0438\u043A\u043E\u0432
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043F\u043E\u0440\u043E\u0434.
    \u0412 \u0446\u0435\u043D\u0442\u0440\u0435\r\n\u043F\u0430\u0440\u043A\u0430
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u043F\u0440\u0443\u0434."
  _preview: {fileID: 21300000, guid: c98d9baa871a72b4ea12961d2577fa53, type: 3}
