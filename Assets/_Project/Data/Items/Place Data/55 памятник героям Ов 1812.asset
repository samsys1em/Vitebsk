  m_Name: "55 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u0433\u0435\u0440\u043E\u044F\u043C
    \u041E\u0432 1812"
  m_EditorClassIdentifier: 
  _number: 55
  _name: "\u041F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u0432 \u0447\u0435\u0441\u0442\u044C
    \u0433\u0435\u0440\u043E\u0435\u0432 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 1812 \u0433\u043E\u0434\u0430"
  _description: "\u041E\u0431\u0435\u043B\u0438\u0441\u043A \u0432 \u0447\u0435\u0441\u0442\u044C
    \u0433\u0435\u0440\u043E\u0435\u0432 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 1812 \u0433. \u0431\u044B\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D
    \u0432 1912\r\n\u0433. \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u043F\u0435\u0440\u0435\u0434 \u0434\u0432\u043E\u0440\u0446\u043E\u043C \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430.
    \u042D\u0442\u043E \u0431\u044B\u043B \u043F\u0435\u0440\u0432\u044B\u0439 \u0432
    \u0433\u043E\u0440\u043E\u0434\u0435\r\n\u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A.
    \u0418\u043D\u0438\u0446\u0438\u0430\u0442\u043E\u0440\u043E\u043C \u0435\u0433\u043E
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F \u0443\u0447\u0435\u043D\u0430\u044F
    \u0430\u0440\u0445\u0438\u0432\u043D\u0430\u044F\r\n\u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F,
    \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0432 1909 \u0433.
    \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u043E\u0441\u043E\u0431\u044B\u0439
    \u043A\u043E\u043C\u0438\u0442\u0435\u0442 \u043F\u043E \u0447\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044E\r\n\u044E\u0431\u0438\u043B\u0435\u044F
    \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 1812 \u0433.\r\n\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u0434\u043B\u044F \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430
    (30 \u0442\u044B\u0441\u044F\u0447 \u0440\u0443\u0431\u043B\u0435\u0439)\r\n\u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0433\u043E\u0434\u0430. \u0427\u0430\u0441\u0442\u044C
    \u0438\u0445 \u0431\u044B\u043B\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430
    \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0439
    \u043E\u0442\r\n\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439
    \u0438 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439 \u0433\u043E\u0440\u043E\u0434\u0430,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0434\u043E\u0445\u043E\u0434\u043E\u0432 \u043E\u0442 \u0447\u0442\u0435\u043D\u0438\u044F\r\n\u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0445
    \u043B\u0435\u043A\u0446\u0438\u0439. \u0427\u0430\u0441\u0442\u044C \u0434\u0435\u043D\u0435\u0433
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u043A\u0430\u0437\u043D\u044B.\r\n\u0412 \u043D\u0430\u0447\u0430\u043B\u0435
    1911 \u0433. \u0447\u0435\u0440\u0435\u0437 \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0435
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u043E\u0432
    \u0431\u044B\u043B \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\r\n\u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439
    \u043A\u043E\u043D\u043A\u0443\u0440\u0441 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430 \u0432\u043E\u0438\u043D\u0430\u043C
    \u0440\u0443\u0441\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438, \u043F\u0430\u0432\u0448\u0438\u043C
    \u0432\r\n\u0441\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u0445 \u043F\u043E\u0434
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C \u0432 1812 \u0433.\r\n\u041F\u0435\u0440\u0432\u0430\u044F
    \u043F\u0440\u0435\u043C\u0438\u044F \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u0441\u0443\u0436\u0434\u0435\u043D\u0430\r\n\u043F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u043C\u0443
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0443 \u0418\u0432\u0430\u043D\u0443
    \u0424\u043E\u043C\u0438\u043D\u0443. \u0415\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442
    \xAB\u041E\u0431\u0435\u043B\u0438\u0441\u043A\xBB, \u043A\u0430\u043A \u043E\u0442\u043C\u0435\u0447\u0430\u043B\u0430\r\n\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F, \xAB\u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u044F\u043C\u0438
    \u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C\r\n\u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435\u043C\xBB.\r\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0444\u0430\u043A\u0442: \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0431\u044B\u043B \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D
    \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D \u043D\u0430\r\n\u0414\u0432\u043E\u0440\u0446\u043E\u0432\u043E\u0439
    \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u0432\u044B\u044F\u0432\u0438\u0442\u044C \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438\r\n\u0441\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0424\u043E\u043C\u0438\u043D\u044B\u043C \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F.\r\n\u041F\u0430\u043C\u044F\u0442\u043D\u0438\u043A,
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    6 \u0434\u0435\u043A\u0430\u0431\u0440\u044F 1912 \u0433. \u043F\u0435\u0440\u0435\u0434
    \u0434\u0432\u043E\u0440\u0446\u043E\u043C \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430,\r\n\u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    \u0441\u043E\u0431\u043E\u0439 \u043E\u0431\u0435\u043B\u0438\u0441\u043A \u0432\u044B\u0441\u043E\u0442\u043E\u0439
    26 \u043C, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0438\u0437
    11 \u0431\u043B\u043E\u043A\u043E\u0432 \u0448\u043B\u0438\u0444\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E\r\n\u0444\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0433\u0440\u0430\u043D\u0438\u0442\u0430. \u041E\u0431\u0435\u043B\u0438\u0441\u043A
    \u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u043F\u044C\u0435\u0434\u0435\u0441\u0442\u0430\u043B\u0435,
    \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u0442\u043E\u0440\u043E\u043D
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E\r\n\u0431\u044B\u043B\u0430
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0430 \u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0434\u043E\u0441\u043A\u0430 \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E:
    \xAB\u0411\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u043D\u043E\u0439 \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u0438
    \u0433\u0435\u0440\u043E\u0435\u0432\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u2013 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432
    \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u043F\u043E\u0434 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C
    13, 14, 15 \u0438\u044E\u043B\u044F \u0438 26\r\n\u043E\u043A\u0442\u044F\u0431\u0440\u044F
    1812 \u0433\u043E\u0434\u0430\xBB. \u041D\u0430 \u0431\u043E\u043A\u043E\u0432\u044B\u0445
    \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u0445 \u043F\u044C\u0435\u0434\u0435\u0441\u0442\u0430\u043B\u0430
    \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438\r\n\u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u2013 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435
    \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F \u0438 \u0448\u043B\u0435\u043C\u044B
    (\u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C).\r\n\u0412\u0435\u043D\u0447\u0430\u043B
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u0434\u0432\u0443\u0433\u043B\u0430\u0432\u044B\u0439
    \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439 \u043E\u0440\u0435\u043B
    \u043D\u0430 \u0448\u0430\u0440\u0435 (\u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0435 \u0418.\r\n\u0424\u043E\u043C\u0438\u043D\u0430
    \u044D\u0442\u0430 \u0434\u0435\u0442\u0430\u043B\u044C \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430).\r\n\u041F\u043E\u0437\u0436\u0435
    \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430
    \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0447\u0435\u0442\u044B\u0440\u0435
    \u0447\u0443\u0433\u0443\u043D\u043D\u044B\u0435 \u043C\u043E\u0440\u0442\u0438\u0440\u044B,
    \u043E\u0442\u043B\u0438\u0442\u044B\u0435\r\n\u0432 1839 \u0433. \u0412\u0435\u0441
    \u043E\u0434\u043D\u043E\u0439 \u043C\u043E\u0440\u0442\u0438\u0440\u044B \u2013
    \u043E\u043A\u043E\u043B\u043E 1000 \u043A\u0433. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u043B\u0435\u0433\u0435\u043D\u0434\u0435, \u043C\u043E\u0440\u0442\u0438\u0440\u044B
    \u0431\u044B\u043B\u0438\r\n\u043D\u0430\u0439\u0434\u0435\u043D\u044B \u0432
    1920-\u0445 \u0433\u0433. \u0432 \u043A\u043E\u043D\u044E\u0448\u043D\u044F\u0445
    \u043F\u0440\u0438 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u043C
    \u0434\u0432\u043E\u0440\u0446\u0435. \u0412 \u0434\u043E\u0432\u043E\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F\r\n\u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
    \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0430 \u043B\u0435\u0436\u0430\u043B\u043E
    29 \u0447\u0443\u0433\u0443\u043D\u043D\u044B\u0445 \u044F\u0434\u0435\u0440,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435, \u043F\u043E \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044E\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0445
    \u0441\u0442\u0430\u0440\u043E\u0436\u0438\u043B\u043E\u0432, \u0432 \u0433\u043E\u0434\u044B
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0439
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438 \u0431\u044B\u043B\u0438
    \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u044B \u0432\r\n\u0440\u0435\u043A\u0443.
    \u0421\u0430\u043C \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u0438 \u043C\u043E\u0440\u0442\u0438\u0440\u044B
    \u0432 \u0433\u043E\u0434\u044B \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
    \u043B\u0438\u0445\u043E\u043B\u0435\u0442\u044C\u044F \u0443\u0446\u0435\u043B\u0435\u043B\u0438.
    \u0421\u043A\u043E\u043B\u044B \u043D\u0430\r\n\u0433\u0440\u0430\u043D\u0438\u0442\u0435
    \u043E\u0431\u0435\u043B\u0438\u0441\u043A\u0430, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0435\u0441\u044F
