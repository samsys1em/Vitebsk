  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "26 \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 26
  _name: "\u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0432\u043E \u0438\u043C\u044F \u041F\u0435\u0442\u0440\u0430 \u0438 \u041F\u0430\u0432\u043B\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435
    \u0441 \u043D\u0430\u0447\u0430\u043B\u0430 XVII\r\n\u0432. (\u0431\u044B\u043B\u0430
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435
    1618 \u0433.). \u041F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
    \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043E\u043D\u0430\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u044B
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435 \u0441\u043E\u043B\u044F\u043D\u044B\u0445
    \u0441\u043A\u043B\u0430\u0434\u043E\u0432 (\u0441\u0435\u0439\u0447\u0430\u0441\r\n\xAB\u041A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E-\u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \xAB\u0417\u043E\u043B\u043E\u0442\u043E\u0435
    \u043A\u043E\u043B\u044C\u0446\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \xAB\u0414\u0432\u0438\u043D\u0430\xBB,\r\n\u0443\u043B. \u0427\u0430\u0439\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    3, 5).\r\n\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0432 \u0441\u0442\u0438\u043B\u0435 \u0432\u0438\u043B\u0435\u043D\u0441\u043A\u043E\u0433\u043E\r\n\u0431\u0430\u0440\u043E\u043A\u043A\u043E
    \u0432 1780 \u0433. \u043F\u043E \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u044E
    \u043F\u043E\u043B\u043E\u0446\u043A\u043E\u0433\u043E \u0443\u043D\u0438\u0430\u0442\u0441\u043A\u043E\u0433\u043E
    \u0430\u0440\u0445\u0438\u0435\u043F\u0438\u0441\u043A\u043E\u043F\u0430 \u0418\u0440\u0430\u043A\u043B\u0438\u044F\r\n\u041B\u0438\u0441\u043E\u0432\u0441\u043A\u043E\u0433\u043E
    \u043D\u0430 \u043D\u043E\u0432\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u2013
    \u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0438
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0443\u043B\u0438\u0446
    \u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0441\u043A\u043E\u0439
    \u0438\r\n\u0417\u0435\u043D\u044C\u043A\u043E\u0432\u043E\u0439. \u0425\u0440\u0430\u043C
    \u0431\u044B\u043B 4-\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u043C \u0432
    \u043F\u043B\u0430\u043D\u0435, \u0431\u0435\u0437 \u043A\u0443\u043F\u043E\u043B\u0430,
    \u0441 \u0430\u043B\u0442\u0430\u0440\u0435\u043C,\r\n\u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u043D\u0430 \u044E\u0433. \u041D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u043C
    \u0444\u0430\u0441\u0430\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0434\u0432\u0435 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044B\u0435\r\n\u0434\u0432\u0443\u0445\u044A\u044F\u0440\u0443\u0441\u043D\u044B\u0435
    \u0431\u0430\u0448\u043D\u0438 \u0441 \u0443\u0437\u043A\u0438\u043C \u0431\u0430\u0440\u043E\u0447\u043D\u044B\u043C
    \u0444\u0440\u043E\u043D\u0442\u043E\u043D\u043E\u043C \u043C\u0435\u0436\u0434\u0443
    \u043D\u0438\u043C\u0438. \u0421\u0440\u0435\u0434\u0438\r\n\u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0439
    \u0445\u0440\u0430\u043C\u0430 \u0432\u044B\u0434\u0435\u043B\u044F\u043B\u0438\u0441\u044C
    \u0432\u043E\u0441\u0435\u043C\u044C \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0445
    \u043A\u0440\u0430\u0441\u043A\u0430\u043C\u0438 \u0436\u0435\u043D\u0441\u043A\u0438\u0445
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445\r\n\u0441\u0442\u0430\u0442\u0443\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u043B\u0443\u0447\u0448\u0438\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430: \u0432\u0435\u0440\u0443, \u0431\u043B\u0430\u0433\u043E\u0440\u0430\u0437\u0443\u043C\u0438\u0435,\r\n\u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E\u0441\u0442\u044C,
    \u0443\u0441\u0435\u0440\u0434\u0438\u0435, \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C,
    \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E\u0441\u0442\u044C, \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C,
    \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C.\r\n\u0412 1839 \u0433.
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u0430
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u043C.\r\n\u0412
    \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A\u043E\u043C
    \u043F\u0440\u0438\u0445\u043E\u0434\u0435 \u0438\u043C\u0435\u043B\u0430\u0441\u044C
    \u0431\u043E\u0433\u0430\u0434\u0435\u043B\u044C\u043D\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0432\r\n\u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C
    \u0434\u043E\u043C\u0435 \u043D\u0430 \u041F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E-\u041F\u0435\u0442\u0440\u043E\u0432\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u0435 (\u043D\u044B\u043D\u0435 \u0443\u043B. \u0417\u0435\u043D\u044C\u043A\u043E\u0432\u043E\u0439),
    \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432\r\n\u0441\u0430\u043C\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438. \u0412 1886 \u0433. \u0432\u043E\u0437\u043B\u0435
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \xAB\u0442\u0451\u043F\u043B\u0430\u044F\xBB \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0420\u043E\u0436\u0434\u0435\u0441\u0442\u0432\u0430\r\n\u0411\u043E\u0433\u043E\u0440\u043E\u0434\u0438\u0446\u044B.\r\n\u0412
    \u043C\u0430\u0440\u0442\u0435 1920 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435
    \u0446\u0435\u0440\u043A\u0432\u0438 \u0431\u044B\u043B\u043E \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E
    \u0432 \xAB\u0421\u043F\u0438\u0441\u043E\u043A \u0437\u0434\u0430\u043D\u0438\u0439
    \u0433\u043E\u0440\u043E\u0434\u0430\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430,
    \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u0435\xBB,
    \u0434\u043E 1921 \u0433. \u0445\u0440\u0430\u043C \u0431\u044B\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C.\r\n\u0412
    \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0435 \u0446\u0435\u0440\u043A\u0432\u0438
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\r\n\u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E,
    \u0431\u044B\u043B\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B."
  _preview: {fileID: 21300000, guid: 332520b3629cca442a508975aa021ce8, type: 3}
