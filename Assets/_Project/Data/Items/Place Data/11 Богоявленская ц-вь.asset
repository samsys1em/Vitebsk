  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "11 \u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 11
  _name: "\u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u0430\u044F
    (\u0421\u0438\u043C\u0435\u043E\u043D\u043E\u0432\u0441\u043A\u0430\u044F, \u0421\u0432.
    \u0421\u0438\u043C\u0435\u043E\u043D\u0430 \u0421\u0442\u043E\u043B\u043F\u043D\u0438\u043A\u0430)
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n\u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0445\u0440\u0430\u043C \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435,
    \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u0417\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0414\u0432\u0438\u043D\u044B. \u041D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F\r\n\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0434\u043E\u043C\u0430 \u211637/1 \u043D\u0430 \u0443\u043B. \u0418\u043B\u044C\u0438\u043D\u0441\u043A\u043E\u0433\u043E.\r\n\u0412
    XVI \u0432. \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u0430\u044F \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0432\u043E \u0438\u043C\u044F \u0421\u0438\u043C\u0435\u043E\u043D\u0430 \u0421\u0442\u043E\u043B\u043F\u043D\u0438\u043A\u0430
    (\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435
    1539 \u0433.). \u0412 1790\u20131805 \u0433\u0433.\r\n\u043D\u0430 \u0435\u0435
    \u043C\u0435\u0441\u0442\u0435 \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u0432\u043E \u0438\u043C\u044F \u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F.
    \u0412 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u043C
    \u043F\u043B\u0430\u043D\u0435\r\n\u043E\u043D \u0441\u043E\u0447\u0435\u0442\u0430\u043B
    \u0432 \u0441\u0435\u0431\u0435 \u0447\u0435\u0440\u0442\u044B \u0431\u0430\u0440\u043E\u043A\u043A\u043E
    \u0438 \u043A\u043B\u0430\u0441\u0441\u0438\u0446\u0438\u0437\u043C\u0430. \u041D\u0430
    \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u0444\u0430\u0441\u0430\u0434\u0435
    \u0431\u044B\u043B\u0438\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u0434\u0432\u0435 \u043E\u0434\u043D\u043E\u044F\u0440\u0443\u0441\u043D\u044B\u0435
    \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044B\u0435 \u0431\u0430\u0448\u043D\u0438
    \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0444\u0440\u043E\u043D\u0442\u043E\u043D
    \u043C\u0435\u0436\u0434\u0443\r\n\u043D\u0438\u043C\u0438. \u041D\u0430\u0434
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043E\u0431\u044A\u0451\u043C\u043E\u043C
    \u0445\u0440\u0430\u043C\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u043B\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0443\u043F\u043E\u043B \u0441
    \u0431\u0430\u0448\u0435\u043D\u043A\u043E\u0439.\r\n\u0410\u043B\u0442\u0430\u0440\u0451\u043C
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0430
    \u043D\u0430 \u044E\u0433. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E\r\n\u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u0431\u044B\u043B\u043E \u043D\u0430\u043B\u0438\u0447\u0438\u0435
    \u0444\u0440\u0435\u0441\u043A\u043E\u0432\u043E\u0439 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438.
    \u0415\u044E \u0431\u044B\u043B\u0438 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u044B\r\n\u043F\u0430\u0440\u0443\u0441\u0430
    \u0441\u0432\u043E\u0434\u043E\u0432, \u043A\u0443\u043F\u043E\u043B, \u0430\u043B\u0442\u0430\u0440\u044C,
    \u043F\u0440\u0438\u0442\u0432\u043E\u0440, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B.\r\n\u0412
    1812 \u0433., \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u0440\u043E\u0434 \u0431\u044B\u043B
    \u043E\u043A\u043A\u0443\u043F\u0438\u0440\u043E\u0432\u0430\u043D \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u043C\u0438
    \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438, \u0432 \u0445\u0440\u0430\u043C\u0435\r\n\u0431\u044B\u043B\u0438
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u044B \u043E\u0440\u0443\u0434\u0438\u044F,
    \u0430 \u043E\u043A\u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u043D\u044B
    \u0432 \u0430\u043C\u0431\u0440\u0430\u0437\u0443\u0440\u044B.\r\n\u0412 1841
    \u0433. \u043F\u0440\u0438 \u0446\u0435\u0440\u043A\u0432\u0438 \u0431\u044B\u043B\u0430
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0430 \u0431\u043E\u0433\u0430\u0434\u0435\u043B\u044C\u043D\u044F.
    \u0412 1898 \u0433. \u0440\u044F\u0434\u043E\u043C \u0441 \u0445\u0440\u0430\u043C\u043E\u043C,\r\n\u0432\u043D\u0443\u0442\u0440\u0438
    \u043E\u0433\u0440\u0430\u0434\u044B, \u0431\u044B\u043B\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E-\u043F\u0440\u0438\u0445\u043E\u0434\u0441\u043A\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B.\r\n\u041F\u043E\u0441\u043B\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u0439
    1917 \u0433. \u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C, \u043A\u0430\u043A \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0445\u0440\u0430\u043C\u044B \u0433\u043E\u0440\u043E\u0434\u0430,\r\n\u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430
    \u0431\u044B\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439.
    \u0412 1920 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u0445\u0440\u0430\u043C\u0430
    \u0431\u044B\u043B\u043E \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E \u0432
    \xAB\u0421\u043F\u0438\u0441\u043E\u043A\r\n\u0437\u0434\u0430\u043D\u0438\u0439
    \u0433\u043E\u0440\u043E\u0434\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430,
    \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u0435\xBB.\r\n\u0426\u0435\u0440\u043A\u043E\u0432\u044C
    \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430
    \u0432 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u0437\u0434\u0430\u043D\u0438\u0435\r\n\u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u043D\u0435\u0441\u043B\u0438 \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B."
  _preview: {fileID: 21300000, guid: 5182d03825fde494891047e244ba003a, type: 3}
  _images:
  - _title: "\u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u0430\u044F
      \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
