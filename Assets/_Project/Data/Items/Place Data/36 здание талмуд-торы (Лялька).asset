  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "36 \u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B
    (\u041B\u044F\u043B\u044C\u043A\u0430)"
  m_EditorClassIdentifier: 
  _number: 36
  _name: "\u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B
    (\u041B\u044F\u043B\u044C\u043A\u0430)"
  _description: "\u0412 1912\u22121914 \u0433\u0433. \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u0431\u044B\u0432\u0448\u0435\u0439 \u0417\u0430\u043C\u043A\u043E\u0432\u043E\u0439
    \u0433\u043E\u0440\u044B, \u0441\u0435\u0432\u0435\u0440\u043D\u0435\u0435 \u0437\u0434\u0430\u043D\u0438\u044F\r\n\u043C\u0443\u0436\u0441\u043A\u043E\u0439
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438, \u0431\u044B\u043B\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B
    \u2013 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0439\r\n\u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u043E\u0439
    \u0448\u043A\u043E\u043B\u044B \u0434\u043B\u044F \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u043E\u0432
    \u0438\u0437 \u043C\u0430\u043B\u043E\u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u0445
    \u0441\u0435\u043C\u0435\u0439 (\u043D\u044B\u043D\u0435 \u0443\u043B.\r\n\u041F\u0443\u0448\u043A\u0438\u043D\u0430,
    2, \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u0442\u0435\u0430\u0442\u0440
    \xAB\u041B\u044F\u043B\u044C\u043A\u0430\xBB). \u0412 \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u043E\u043C
    \u043E\u0441\u043E\u0431\u043D\u044F\u043A\u0435\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u043A\u043B\u0430\u0441\u0441\u044B,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043A\u0443\u0445\u043D\u044F, \u0441\u0442\u043E\u043B\u043E\u0432\u0430\u044F,
    \u0430\u043F\u0442\u0435\u043A\u0430, \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F,\r\n\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0430\u044F,
    \u0430\u043A\u0442\u043E\u0432\u044B\u0439 \u0437\u0430\u043B, \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F.\r\n\u0412
    \u0433\u043E\u0434\u044B \u041F\u0435\u0440\u0432\u043E\u0439 \u041C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043E
    \u043F\u043E\u0434\r\n\u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u044C,
    \u043D\u043E \u0438 \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u0430
    \u0442\u043E\u0436\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0430
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u0421 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    1921 \u0433. \u0432\r\n\u0437\u0434\u0430\u043D\u0438\u0438 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
    \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C \u2212 \u043D\u0430 \u0442\u043E
    \u0432\u0440\u0435\u043C\u044F\r\n\u043F\u0435\u0440\u0432\u044B\u0439 \u0432
    \u0421\u0421\u0421\u0420. \u0423\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u043E \u043A\u0430\u0434\u0440\u044B
    \u0434\u043B\u044F \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u0438\u0445 \u0448\u043A\u043E\u043B
    \u0438\r\n\u0434\u043E\u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0445 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439.\r\n\u0412
    1937 \u0433. \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C \u0431\u044B\u043B
    \u0440\u0435\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D
    \u0432 \u0443\u0447\u0438\u043B\u0438\u0449\u0435, \u0430 \u0432\u0441\u043A\u043E\u0440\u0435
    \u0431\u044B\u043B \u0437\u0430\u043A\u0440\u044B\u0442.\r\n\u041F\u0435\u0440\u0435\u0434
    \u0432\u043E\u0439\u043D\u043E\u0439 \u0432 \u0437\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C \u0444\u0435\u043B\u044C\u0434\u0448\u0435\u0440\u0441\u043A\u043E-\u0430\u043A\u0443\u0448\u0435\u0440\u0441\u043A\u0430\u044F
    \u0448\u043A\u043E\u043B\u0430 \u0438\r\n\u043C\u0435\u0431\u0435\u043B\u044C\u043D\u044B\u0439
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D \xAB\u041F\u0440\u043E\u043C\u0442\u043E\u0440\u0433\xBB.\r\n\u0412
    \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u0438\u0442\u0435\u0442\r\n\u041A\u043E\u043C\u043C\u0443\u043D\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043F\u0430\u0440\u0442\u0438\u0438 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438
    \u0438 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u0438\u0442\u0435\u0442
    \u043A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u0430. \u0412 1990\r\n\u0433.
    \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u043E\u043C\u0443
    \u0442\u0435\u0430\u0442\u0440\u0443, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0431\u044B\u043B \u043E\u0441\u043D\u043E\u0432\u0430\u043D \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u0432 1986 \u0433.\r\n\u043A\u0430\u043A \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u0430\u044F
    \u0442\u0440\u0443\u043F\u043F\u0430 \u043F\u0440\u0438 \u0434\u0440\u0430\u043C\u0442\u0435\u0430\u0442\u0440\u0435
    \u0438\u043C. \u042F. \u041A\u043E\u043B\u043E\u0441\u0430. \u0412 1990 \u0433.
    \u0442\u0440\u0443\u043F\u043F\u0430\r\n\u0432\u044B\u0434\u0435\u043B\u0438\u043B\u0430\u0441\u044C
    \u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0442\u0435\u0430\u0442\u0440."
  _preview: {fileID: 21300000, guid: bd9d1eaff6bce584b9f9886f5e1a6ce8, type: 3}
  _images:
  - _title: "\u041F\u0440\u043E\u0435\u043A\u0442 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
      \u0444\u0430\u0441\u0430\u0434\u0430 \u0437\u0434\u0430\u043D\u0438\u044F \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B.
      1912 \u0433. \u041D\u0418\u0410\u0411"
    _image: {fileID: 21300000, guid: d203c2835a5bdc74fa7f52ab54063b81, type: 3}
  - _title: "\u0412\u0438\u0434 \u0441 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439
      \u0433\u043E\u0440\u044B. \u0412 \u0446\u0435\u043D\u0442\u0440\u0435 - \u0441\u0442\u0440\u043E\u044F\u0449\u0435\u0435\u0441\u044F
      \u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B.
      1912 \u0433. \u0424\u043E\u0442\u043E \u0421. \u041F\u0440\u043E\u043A\u0443\u0434\u0438\u043D\u0430-\u0413\u043E\u0440\u0441\u043A\u043E\u0433\u043E"
    _image: {fileID: 21300000, guid: 6d92b97c8f7e50240a9a00957ecc5523, type: 3}
  - _title: "\u0412\u0438\u0434 \u0441 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439
      \u0433\u043E\u0440\u044B. \u0421\u043B\u0435\u0432\u0430 - \u0441\u0442\u0440\u043E\u044F\u0449\u0435\u0435\u0441\u044F
      \u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B.
      1912 \u0433. \u0424\u043E\u0442\u043E \u0421. \u041F\u0440\u043E\u043A\u0443\u0434\u0438\u043D\u0430-\u0413\u043E\u0440\u0441\u043A\u043E\u0433\u043E"
    _image: {fileID: 21300000, guid: ef1253cd06bb68147aedd7e1faf01186, type: 3}
  - _title: "\u0417\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u0432\u0448\u0435\u0439
      \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B. 1941-1944 \u0433\u0433."
    _image: {fileID: 21300000, guid: 3f6f249e8e609df448d2490e67066a00, type: 3}
  - _title: "\u0412\u0438\u0434 \u0441 \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u043E\u0439
      \u0433\u043E\u0440\u044B \u043D\u0430 \u0446\u0435\u043D\u0442\u0440 \u0438
      \u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u0430\u043B\u043C\u0443\u0434-\u0442\u043E\u0440\u044B.
      1946 \u0433. \u0424\u043E\u0442\u043E \u0418. \u0413\u0443\u0449\u0438\u043D\u0430"
    _image: {fileID: 21300000, guid: 780878de3c128ac45a2fc41aaea9620c, type: 3}
  - _title: "\u0421\u0443\u0431\u0431\u043E\u0442\u043D\u0438\u043A \u0432\u043E\u0437\u043B\u0435
      \u0437\u0434\u0430\u043D\u0438\u044F \u0442\u0435\u0430\u0442\u0440\u0430 \u041B\u044F\u043B\u044C\u043A\u0430.
      \u0411\u043B\u0430\u0433\u043E\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435 1000-\u043B\u0435\u0442\u0438\u044F
      \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430. 1974 \u0433."
    _image: {fileID: 21300000, guid: 64454a3cc5d61d64aac13a36799f5e97, type: 3}
  - _title: "\u0412\u0438\u0434 \u043D\u0430 \u0437\u0434\u0430\u043D\u0438\u0435
      \u0442\u0435\u0430\u0442\u0440\u0430 \u041B\u044F\u043B\u044C\u043A\u0430 (\u0431\u044B\u0432\u0448\u0443\u044E
