  m_Name: "29 \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430"
  m_EditorClassIdentifier: 
  _number: 29
  _name: "\u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430"
  _description: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043E \u0435\u0432\u0440\u0435\u044F\u0445 \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435
    \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A 1551 \u0433.\r\n\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0435
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
    \u043F\u0435\u0440\u0432\u043E\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435\r\n\u0437\u0434\u0430\u043D\u0438\u0435
    \u0434\u043B\u044F \u043C\u043E\u043B\u0438\u0442\u0432\u044B, \u044F\u0432\u043B\u044F\u044E\u0449\u0435\u0435\u0441\u044F
    \u0446\u0435\u043D\u0442\u0440\u043E\u043C \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438 \u043E\u0431\u0449\u0438\u043D\u044B, \u2013\r\n\u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430.
    \u0412 1865 \u0433. \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0443\u0436\u0435 34 \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0434\u043E\u043C\u0430.\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0438 \u0432\u043E\u0437\u0432\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0438\u0437 \u0434\u0435\u0440\u0435\u0432\u0430 \u0438 \u0432\r\n\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u043C
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0432\u044B\u0434\u0435\u043B\u044F\u043B\u0438\u0441\u044C \u043D\u0430 \u0444\u043E\u043D\u0435
    \u0440\u044F\u0434\u043E\u0432\u043E\u0439\r\n\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438. \u041E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0445 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445
    \u0441\u0438\u043D\u0430\u0433\u043E\u0433, \u0438\u043C\u0435\u044E\u0449\u0438\u0445\r\n\u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0439
    \u043E\u0431\u043B\u0438\u043A, \u0431\u044B\u043B\u0430 \u0413\u043B\u0430\u0432\u043D\u0430\u044F
    \u0425\u043E\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430
    \u0432\r\n\u043D\u0430\u0447\u0430\u043B\u0435 \u0443\u043B. \u041C\u0430\u043B\u043E-\u041C\u043E\u0433\u0438\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    (\u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0443\u043B.
    \u041A\u0430\u043B\u0438\u043D\u0430; \u0437\u0434\u0430\u043D\u0438\u0435 \u043D\u0435\r\n\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C).
    \u041D\u0430 \u0440\u0443\u0431\u0435\u0436\u0435 XIX\u2013\u0425\u0425 \u0432\u0432.
    \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437
    \u0442\u0440\u0435\u0445 \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u0445
    \u0432\r\n\u0433\u043E\u0440\u043E\u0434\u0435. \u0412\u0441\u0435\u0433\u043E
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u043E\u0441\u044C
    \u043E\u043A\u043E\u043B\u043E 60 \u0441\u0438\u043D\u0430\u0433\u043E\u0433
    \u0438\r\n\u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0434\u043E\u043C\u043E\u0432, \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0435
    \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u0433\u043E\u0440\u043E\u0434\u0430
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u043E \u0431\u043E\u043B\u0435\u0435
    50 %.\r\n\u041A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0435 \u0432
    \u043F\u043B\u0430\u043D\u0435 \u0437\u0434\u0430\u043D\u0438\u0435 \u0438\u043C\u0435\u043B\u043E
    \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0439
    \u0438 \u0437\u0430\u0434\u043D\u0438\u0439\r\n\u0444\u0430\u0441\u0430\u0434\u044B.
    \u0421\u0432\u043E\u0434\u044B \u0437\u0434\u0430\u043D\u0438\u044F, \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430 \u0434\u0435\u0432\u044F\u0442\u044C \u0440\u0430\u0432\u043D\u044B\u0445
    \u043F\u043E\u043B\u0435\u0439, \u043E\u043F\u0438\u0440\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430\r\n\u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0442\u043E\u043B\u0431\u0430
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0435. \u0422\u043E\u043B\u0449\u0438\u043D\u0430
    \u0441\u0442\u0435\u043D \u0443 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u043E\u0432
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u043B\u0430 2 \u043C.\r\n\u0416\u0435\u043D\u0441\u043A\u0438\u0435
    \u0433\u0430\u043B\u0435\u0440\u0435\u0438 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C
    \u044D\u0442\u0430\u0436\u0435 \u0431\u044B\u043B\u0438 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0435\u043D\u044B
    \u0441 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
    \u041F\u043E\r\n\u0442\u0430\u043A\u043E\u0439 \u0441\u0445\u0435\u043C\u0435
    \u0432 XVI\u2013XVIII \u0432\u0432. \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u043E\u0437\u0432\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0438 \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430\r\n\u2013 \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0438\u043F \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430\u043B\u044C\u043D\u044B\u0445
    \u0437\u0434\u0430\u043D\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F
    \u043D\u0438\u0433\u0434\u0435,\r\n\u043A\u0440\u043E\u043C\u0435 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438,
    \u041F\u043E\u043B\u044C\u0448\u0438 \u0438 \u0423\u043A\u0440\u0430\u0438\u043D\u044B.
    \u0421 \u044E\u0436\u043D\u043E\u0439 \u0438 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D \u043A \u0437\u0434\u0430\u043D\u0438\u044E\r\n\u043F\u0440\u0438\u043C\u044B\u043A\u0430\u043B\u0438
    \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435
    \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u0435 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0439\u043A\u0438.
    \u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0439
    \u0434\u0435\u043A\u043E\u0440\r\n\u0437\u0434\u0430\u043D\u0438\u044F \u0438
    \u0430\u043D\u0430\u043B\u0438\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u043F\u043B\u0430\u043D\u043E\u0432 \u0433\u043E\u0440\u043E\u0434\u0430 1-\u0439
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B XIX \u0432. \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442\r\n\u0441\u043A\u0430\u0437\u0430\u0442\u044C,
    \u0447\u0442\u043E \u044D\u0442\u0430 \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430
    \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043F\u043E\u0437\u0434\u043D\u043E
    \u2013 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0432\r\n1830\u20131840-\u0445
    \u0433\u0433.\r\n\u041F\u043E\u0441\u043B\u0435 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438
    1917 \u0433. \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430 \u0431\u044B\u043B\u0430
    \u0437\u0430\u043A\u0440\u044B\u0442\u0430. \u0412 1929 \u0433. \u043F\u043E\r\n\u0445\u043E\u0434\u0430\u0442\u0430\u0439\u0441\u0442\u0432\u0443
    \u0440\u0430\u0431\u043E\u0447\u0438\u0445 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0448\u0432\u0435\u0439\u043D\u043E\u0439 \u0444\u0430\u0431\u0440\u0438\u043A\u0438
    \xAB\u041F\u0440\u043E\u0444\u0438\u043D\u0442\u0435\u0440\u043D\xBB \u0437\u0434\u0430\u043D\u0438\u0435\r\n\u0431\u044B\u043B\u043E
    \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E \u0434\u043B\u044F \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u043A\u043B\u0443\u0431\u0430 \u0448\u0432\u0435\u0439\u043D\u0438\u043A\u043E\u0432.
    \u0412 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439\r\n\u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u043E\u043D\u043E \u0431\u044B\u043B\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E, \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u043D\u0435\u0441\u0435\u043D\u043E \u0432\r\n1950-\u0445 \u0433\u0433.
    \u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u2013 \u0447\u0430\u0441\u0442\u044C \u043F\u0430\u0440\u043A\u0430 \u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u0435\u0439."
