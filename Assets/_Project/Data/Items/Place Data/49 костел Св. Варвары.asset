  m_Name: "49 \u043A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0412\u0430\u0440\u0432\u0430\u0440\u044B"
  m_EditorClassIdentifier: 
  _number: 49
  _name: "\u043A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0412\u0430\u0440\u0432\u0430\u0440\u044B"
  _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
    \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0445\u0440\u0430\u043C.
    \u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u043F\u043E \u0430\u0434\u0440\u0435\u0441\u0443:
    \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u0430\u044F,\r\n27
    \u0411\u044B\u043B \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D \u0432 1785
    \u0433. \u043D\u0430 \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u0437\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0447\u0435\u0440\u0442\u043E\u0439,
    \u0432\u043E\u0437\u043B\u0435 \u0448\u043E\u0441\u0441\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0435\u043B\u043E \u0432 \u0413\u043E\u0440\u043E\u0434\u043E\u043A. \u0414\u0435\u043D\u044C\u0433\u0438
    \u043D\u0430\r\n\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0445\u0440\u0430\u043C\u0430 \u0432\u044B\u0434\u0435\u043B\u0438\u043B \u0433\u043E\u0440\u043E\u0434\u043E\u043A\u0441\u043A\u0438\u0439
    \u0443\u0435\u0437\u0434\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
    \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u0442\u0432\u0430\r\n\u0410\u043D\u0442\u043E\u043D\u0438\u0439
    \u041A\u043E\u0441\u0441\u043E\u0432. \u0427\u0435\u0440\u0435\u0437 15 \u043B\u0435\u0442
    \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u043E\u0441\u0442\u0435\u043B\u043E\u043C
    \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E\r\n\u0445\u043E\u0440\u0443\u043D\u0436\u0435\u0433\u043E
    \u041F\u0435\u0442\u0440\u0430 \u041B\u0438\u043E\u0437\u043A\u043E \u0431\u044B\u043B\u0430
    \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0430 \u0447\u0430\u0441\u043E\u0432\u043D\u044F
    \u0432\u043E \u0438\u043C\u044F \u0412\u043E\u0437\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u041A\u0440\u0435\u0441\u0442\u0430.\r\n\u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043A\u043E\u0441\u0442\u0451\u043B \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u043B
    \u0440\u043E\u043B\u044C \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435\u043D\u0441\u043A\u043E\u0433\u043E
    \u0445\u0440\u0430\u043C\u0430, \u043D\u043E \u043F\u043E\r\n\u043F\u0440\u043E\u0448\u0435\u0441\u0442\u0432\u0438\u0438
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0441\u0442\u0430\u043B \u043F\u0430\u0440\u0430\u0444\u0438\u0430\u043B\u044C\u043D\u044B\u043C
    (\u043F\u0440\u0438\u0445\u043E\u0434\u0441\u043A\u0438\u043C). \u0412 \u043A\u043E\u043D\u0446\u0435
    XIX\r\n\u0432. \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u0438\u0445\u043E\u0436\u0430\u043D
    \u043A\u043E\u0441\u0442\u0451\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u043E
    \u043E\u043A\u043E\u043B\u043E 2000 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
    \u0445\u043E\u0442\u044F \u0432\u043C\u0435\u0449\u0430\u043B\r\n\u0445\u0440\u0430\u043C
    \u0442\u043E\u043B\u044C\u043A\u043E 150 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
    \u0418\u0437-\u0437\u0430 \u0447\u0430\u0441\u0442\u043E\u0439 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u043E\r\n\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u043E \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
    \u043D\u043E\u0432\u043E\u0433\u043E \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u043E\u0433\u043E
    \u043A\u043E\u0441\u0442\u0451\u043B\u0430 \u0431\u043E\u043B\u044C\u0448\u0435\u0439
    \u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u0438.\r\n\u0410\u0432\u0442\u043E\u0440\u043E\u043C
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0441\u0442\u0430\u043B \u0438\u043D\u0436\u0435\u043D\u0435\u0440-\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440
    \u0412\u0438\u043A\u0442\u043E\u0440 \u041F\u0438\u043E\u0442\u0440\u043E\u0432\u0441\u043A\u0438\u0439.
    4 \u0434\u0435\u043A\u0430\u0431\u0440\u044F 1885\r\n\u0433. \u043D\u043E\u0432\u044B\u0439
    \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u0451\u043B,
    \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0449\u0438\u0439 \u0432 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0435
    \u0447\u0435\u0440\u0442\u044B \u043D\u0435\u043E\u0433\u043E\u0442\u0438\u043A\u0438
    \u0438\r\n\u043D\u0435\u043E\u0440\u043E\u043C\u0430\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u0442\u0438\u043B\u044F, \u0431\u044B\u043B \u043E\u0441\u0432\u044F\u0449\u0435\u043D
    \u0432 \u0447\u0435\u0441\u0442\u044C \u0441\u0432\u044F\u0442\u044B\u0445 \u0412\u0430\u0440\u0432\u0430\u0440\u044B
    \u0438 \u0418\u043E\u0441\u0438\u0444\u0430. \u041F\u0440\u0438\r\n\u043A\u043E\u0441\u0442\u0451\u043B\u0435
    \u0431\u044B\u043B\u0438 \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u044B
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435 \u0434\u043E\u043C
    \u043A\u0441\u0451\u043D\u0434\u0437\u0430 \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u0431\u043E\u043B\u044C\u043D\u0438\u0447\u043A\u0430.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439 1917 \u0433. \u0436\u0438\u0437\u043D\u044C
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
    \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E \u0434\u043E\u043B\u0433\u043E\u0439
    \u2013 \u0435\u0433\u043E\r\n\u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432 1935 \u0433., \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0441\u0442\u0430\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u043A\u043B\u0430\u0434\u0430\r\n\u0443\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0439.\r\n\u0412
    \u0412\u0435\u043B\u0438\u043A\u0443\u044E \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0432\u043E\u0439\u043D\u0443 \u0431\u0430\u0448\u043D\u0438 \u043A\u043E\u0441\u0442\u0451\u043B\u0430
    \u0431\u044B\u043B\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B.\r\n\u0412
    \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435 \u0433\u043E\u0434\u044B
    \u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E \u0432 \u0443\u043F\u0430\u0434\u043E\u043A.
    \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\r\n\u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0445\u0440\u0430\u043C\u0430 \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C
    \u0432 1988\u20131990 \u0433\u0433. \u041F\u0440\u0430\u0432\u0434\u0430, \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0432 \u0437\u0434\u0430\u043D\u0438\u0438\r\n\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043A\u043E\u043D\u0446\u0435\u0440\u0442\u043D\u044B\u0439
    \u0437\u0430\u043B. \u0421\u0442\u0430\u0440\u0430\u043D\u0438\u044F\u043C\u0438
    \u043E\u0442\u0446\u0430 \u042F\u043D\u0443\u0448\u0430 \u0421\u043A\u0435\u0447\u0435\u043A\u0430
    \u043A\u043E\u0441\u0442\u0451\u043B\r\n\u0441\u0442\u0430\u043B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0445\u0440\u0430\u043C\u043E\u043C.
    \u0412 1992 \u0433. \u0431\u044B\u043B\u0430 \u0432\u043D\u043E\u0432\u044C \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0430\r\n\u043F\u0430\u0440\u0430\u0444\u0438\u044F
    \u0421\u0432. \u0412\u0430\u0440\u0432\u0430\u0440\u044B (\u0411\u0430\u0440\u0431\u0430\u0440\u044B).\r\n\u0427\u0442\u043E
    \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0430
    \u043F\u0440\u0438 \u0445\u0440\u0430\u043C\u0435, \u0442\u043E \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u043E
    \u043E\u043D\u043E, \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u0432
    \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435\r\nXVIII \u0432. \u041D\u0430
    \u0440\u0443\u0431\u0435\u0436\u0435 XIX\u2013XX \u0432\u0432. \u0431\u044B\u043B\u043E
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043A\u0430\u0442\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u0412\r\n1901 \u0433. \u0437\u0434\u0435\u0441\u044C
    \u0431\u044B\u043B \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444
    \u0421\u0438\u0433\u0438\u0437\u043C\u0443\u043D\u0434\r\n\u042E\u0440\u043A\u043E\u0432\u0441\u043A\u0438\u0439.
    \u0414\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435 \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C
    \u2013 \u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\r\n\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u043B\u0438
    \u0441 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0434\u043E 1980-\u0445 \u0433\u0433.
    \u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u0435\u0433\u043E \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0410\u0422\u041F-4."
