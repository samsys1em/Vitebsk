  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "14 \u0421\u043F\u0430\u0441\u0441\u043A\u0430\u044F \u0446-\u0432\u044C"
  m_EditorClassIdentifier: 
  _number: 14
  _name: "\u0421\u043F\u0430\u0441\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C"
  _description: "\u0421\u043F\u0430\u0441\u043E-\u041F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C, \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043D\u0430\u044F
    \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 1552 \u0433., \u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0430\u0441\u044C\r\n\u043A
    \u0447\u0438\u0441\u043B\u0443 \u0441\u0430\u043C\u044B\u0445 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435. \u0418\u0437 \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F
    1785 \u0433. \u0443\u0437\u043D\u0430\u0435\u043C, \u0447\u0442\u043E \xAB\u0421\u043F\u0430\u0441\u0441\u043A\u0430\u044F\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B,
    \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0435,
    \u0441 \u0442\u0435\u0441\u0430\u043D\u044B\u0445 \u0431\u0440\u0443\u0441\u044C\u0435\u0432...,
    \u043E\r\n\u043F\u044F\u0442\u0438 \u043A\u0443\u043F\u043E\u043B\u0430\u0445
    \u0441 \u0436\u0435\u0441\u0442\u044F\u043D\u044B\u043C\u0438 \u043A\u0440\u0435\u0441\u0442\u0430\u043C\u0438,
    \u043A\u0440\u044B\u0442\u0430 \u0433\u043E\u043D\u0442\u043E\u043C\xBB. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0445\u0440\u0430\u043C\r\n\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u043A\u0432\u0435\u0440\u0430 \u0433\u0435\u0440\u043E\u0435\u0432 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B 1812\r\n\u0433.\r\n\u0412 \u043A\u043E\u043D\u0446\u0435
    XVIII \u0432. \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0445\u0440\u0430\u043C
    \u0441\u0433\u043E\u0440\u0435\u043B, \u0443\u0446\u0435\u043B\u0435\u043B\u0430
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F\r\n\u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044F,
    \u043F\u043E\u0434 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C
    \u0431\u043E\u0433\u0430\u0434\u0435\u043B\u044C\u043D\u044F. \u0412 1810 \u0433.
    \xAB\u0441\u0442\u0430\u0440\u0430\u043D\u0438\u044F\u043C\u0438\r\n\u043F\u0440\u0438\u0445\u043E\u0436\u0430\u043D\xBB
    \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u043E\u043C\u0430 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u0431\u044B\u043B\u0430 \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u0430 \u043D\u043E\u0432\u0430\u044F
    \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C.\r\n\u041D\u043E
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0445\u0440\u0430\u043C\u0430 \u0432\u0438\u0442\u0435\u0431\u043B\u044F\u043D\u0430\u043C
    \u043F\u043E\u043C\u0435\u0448\u0430\u043B\u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u044F
    \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439\r\n\u0432\u043E\u0439\u043D\u044B
    1812 \u0433. \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u043C\u0438
    \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438 \u043F\u043E \u043F\u0440\u0438\u043A\u0430\u0437\u0443\r\n\u041D\u0430\u043F\u043E\u043B\u0435\u043E\u043D\u0430
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0431\u044B\u043B\u0430 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043D\u0430,
    \u0442. \u043A. \u043C\u0435\u0448\u0430\u043B\u0430 \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443
    \xAB\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0434\r\n\u0441\u0432\u043E\u0438\u043C
    \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u0434\u0432\u043E\u0440\u0446\u043E\u043C
    \u0443\u0434\u043E\u0431\u043D\u0443\u044E \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u043E\u0434\u043E\u0432
    \u0432\u043E\u0439\u0441\u043A \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443\xBB.\r\n\u0412
    1813 \u0433. \u0421\u043F\u0430\u0441\u0441\u043A\u0443\u044E \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0447\u0430\u043B\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C,
    \u043D\u043E \u043D\u0435 \u043D\u0430 \u043F\u0440\u0435\u0436\u043D\u0435\u043C\r\n\u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0435,
    \u0430, \u043A\u0430\u043A \u043F\u0438\u0448\u0435\u0442 \u0410. \u0421\u0435\u043C\u0435\u043D\u0442\u043E\u0432\u0441\u043A\u0438\u0439,
    \xAB\u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0421\u043F\u0430\u0441\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u044B, \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432\r\n\u0441\u0442\u0430\u0440\u043E\u0433\u043E
    \u043E\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0447\u043D\u043E\u0439,
    \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u0441\u0442\u043E\u043B\u0431\u0430\u0445,
    \u0440\u0435\u0448\u0435\u0442\u043A\u043E\u0439 \u0435\u0432\u0440\u0435\u0439\u0441\u043A\u043E\u0433\u043E\r\n\u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0430\xBB.
    \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0431\u044B\u043B\u043E \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u043E \u0432
    1819 \u0433. \u0417\u0434\u0430\u043D\u0438\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u0432\r\n1847 \u0438 1855 \u0433\u0433., \u0432 1863 \u0433. \u0445\u0440\u0430\u043C
    \u0431\u044B\u043B \u043E\u0441\u0432\u044F\u0449\u0435\u043D \u0430\u0440\u0445\u0438\u0435\u043F\u0438\u0441\u043A\u043E\u043F\u043E\u043C
    \u041F\u043E\u043B\u043E\u0446\u043A\u0438\u043C \u0438\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u043C
    \u0412\u0430\u0441\u0438\u043B\u0438\u0435\u043C. \u0412 1847 \u0433. \u0432\u043E\u0437\u043B\u0435
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B\u0430 \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0430
    \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044F.\r\n\u0421\u043F\u0430\u0441\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0441\u0442\u0430\u043B\u0430 \u0434\u043E\u0441\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0443\u043B\u0438\u0446\u044B \u0438 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435\u043C
    \u0432\u0441\u0435\u0433\u043E\r\n\u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E
    \u0431\u0435\u0440\u0435\u0433\u0430 \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u044B.\r\n\u041F\u043E\u0441\u043B\u0435
    \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0431\u044B\u043B\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430. \u0412 \u0433\u043E\u0434\u044B
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u0438, \u043A\u043E\u0433\u0434\u0430
    \u0431\u044B\u043B\u0430\r\n\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u041F\u043E\u043B\u043E\u0446\u043A\u043E-\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0435\u043F\u0430\u0440\u0445\u0438\u0438, \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u043E\u0441\u044C\r\n\u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u043F\u0440\u0438\u0445\u043E\u0434 \u0421\u043F\u0430\u0441\u043E-\u041F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 (\u0432 \u0438\u044E\u043D\u0435 1943 \u0433.).
    \u041D\u043E, \u0441\u0443\u0434\u044F \u043F\u043E\r\n\u0432\u0441\u0435\u043C\u0443,
    \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E,
    \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u043E\u0441\u0435\u043D\u044C\u044E
    1943 \u0433. \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044F\r\n\u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445
    \u043E\u043A\u043A\u0443\u043F\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439 (\u0446\u0435\u0440\u043A\u043E\u0432\u043D\u044B\u0445
    \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435) \u0432 \u041F\u043E\u043B\u043E\u0446\u043A.\r\n\u0412
    \u0445\u043E\u0434\u0435 \u0431\u043E\u0435\u0432 \u0437\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 \u0437\u0434\u0430\u043D\u0438\u0435
    \u0421\u043F\u0430\u0441\u0441\u043A\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438
    \u0431\u044B\u043B\u043E\r\n\u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043E.
    \u041F\u043E\u043B\u0443\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0439
    \u0445\u0440\u0430\u043C \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D
    \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u0445
    \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B 1950-\u0445\r\n\u0433\u0433.,
    \u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D
    \u043E\u043D \u043D\u0435 \u0431\u044B\u043B. \u0414\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E\r\n\u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442
    \u0437\u0434\u0430\u043D\u0438\u044F.\r\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0444\u0430\u043A\u0442: \u0438\u043C\u0435\u043D\u043D\u043E \u0421\u043F\u0430\u0441\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u0441\u0442\u0430\u043B\u0430 \u043E\u0431\u043E\u0431\u0449\u0435\u043D\u043D\u044B\u043C\r\n\u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
    \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0445\u0440\u0430\u043C\u0430 \u043D\u0430 \u043F\u043E\u043B\u043E\u0442\u043D\u0430\u0445
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0430 \u041C\u0430\u0440\u043A\u0430
    \u0428\u0430\u0433\u0430\u043B\u0430. \u0415\u0451 \u043C\u043E\u0436\u043D\u043E\r\n\u0443\u0432\u0438\u0434\u0435\u0442\u044C
    \u043D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0430\u0445 \xAB\u0412\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430\u0434 \u0433\u043E\u0440\u043E\u0434\u043E\u043C\xBB, \xAB\u0412\u0438\u0434
    \u0438\u0437 \u043E\u043A\u043D\u0430\xBB, \xAB\u041E\u043A\u043D\u043E. \u0412\u0438\u0442\u0435\u0431\u0441\u043A\xBB\r\n\u0438
    \u043C\u043D\u043E\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445. \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u0434\u043E\u043C \u0428\u0430\u0433\u0430\u043B\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
    \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u043C\r\n\u0431\u0435\u0440\u0435\u0433\u0443
    \u0440\u0435\u043A\u0438, \u043D\u0430 \u0443\u043B. \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u043E\u0439.
    \xAB\u041C\u043E\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
    \u043F\u043E\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C \u0432 \u043D\u0430\u0448\u0435\u043C
    \u0436\u0435 \u0434\u0432\u043E\u0440\u0435.\r\n\u041A\u043E\u043C\u043D\u0430\u0442\u0443
    \u0437\u0430\u043B\u0438\u0432\u0430\u043B \u0433\u0443\u0441\u0442\u043E-\u0441\u0438\u043D\u0438\u0439
    \u0441\u0432\u0435\u0442 \u0438\u0437 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043E\u043A\u043D\u0430. \u041E\u043D \u0448\u0435\u043B \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430:
    \u0441\r\n\u0445\u043E\u043B\u043C\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0441\u0442\u043E\u044F\u043B\u0430 \u0446\u0435\u0440\u043A\u043E\u0432\u044C.
    \u042D\u0442\u043E\u0442 \u043F\u0440\u0438\u0433\u043E\u0440\u043E\u043A \u0441
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\u044E \u044F \u043D\u0435 \u0440\u0430\u0437
    \u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\r\n\u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u043B \u043D\u0430 \u0441\u0432\u043E\u0438\u0445
    \u043A\u0430\u0440\u0442\u0438\u043D\u0430\u0445... \u0426\u0435\u043F\u043E\u0447\u043A\u0430
    \u0434\u043E\u043C\u043E\u0432 \u0438 \u0431\u0443\u0434\u043E\u043A, \u043E\u043A\u043E\u0448\u043A\u0438,\r\n\u0432\u043E\u0440\u043E\u0442\u0430,
    \u043A\u0443\u0440\u044B, \u0437\u0430\u043A\u043E\u043B\u043E\u0447\u0435\u043D\u043D\u044B\u0439
    \u0437\u0430\u0432\u043E\u0434\u0438\u043A, \u0446\u0435\u0440\u043A\u043E\u0432\u044C,
    \u043F\u043E\u043B\u043E\u0433\u0438\u0439 \u0445\u043E\u043B\u043C (\u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0435\r\n\u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435).
    \u0412\u0441\u0435 \u043A\u0430\u043A \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438,
    \u0435\u0441\u043B\u0438 \u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0438\u0437
    \u0447\u0435\u0440\u0434\u0430\u0447\u043D\u043E\u0433\u043E \u043E\u043A\u043E\u0448\u043A\u0430,\r\n\u043F\u0440\u0438\u043C\u043E\u0441\u0442\u0438\u0432\u0448\u0438\u0441\u044C
    \u043D\u0430 \u043F\u043E\u043B\u0443\xBB, \u2014 \u043F\u0438\u0448\u0435\u0442
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u0432 \u0441\u0432\u043E\u0435\u0439
    \u0430\u0432\u0442\u043E\u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043A\u043D\u0438\u0433\u0435\r\n\xAB\u041C\u043E\u044F \u0436\u0438\u0437\u043D\u044C\xBB."
