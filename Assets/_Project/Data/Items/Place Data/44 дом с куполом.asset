  - _title: "\u0423\u043B\u0438\u0446\u0430 \u0421\u0443\u0432\u043E\u0440\u043E\u0432\u0430
      \u0438 \u0434\u043E\u043C \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C.
      1950-\u0435 \u0433\u0433. \u0424\u043E\u0442\u043E \u0418. \u0413\u0443\u0441\u0430\u0440\u0435\u0432\u0438\u0447\u0430"
    _image: {fileID: 21300000, guid: 1701203a12258e2429f0a9468c758c41, type: 3}
