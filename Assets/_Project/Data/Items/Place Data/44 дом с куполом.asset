  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "44 \u0434\u043E\u043C \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C"
  m_EditorClassIdentifier: 
  _number: 44
  _name: "\u0434\u043E\u043C \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C"
  _description: "\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C
    \u0438 \u0448\u043F\u0438\u043B\u0435\u043C \u043F\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C
    \u043D\u0430 \u0443\u043B. \u0421\u0443\u0432\u043E\u0440\u043E\u0432\u0441\u043A\u043E\u0439
    \u0432\r\n\u043D\u0430\u0447\u0430\u043B\u0435 \u0425\u0425 \u0432. (\u0441\u0435\u0439\u0447\u0430\u0441
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0414\u0425\u0428 \u2116 1 \u043F\u043E
    \u0443\u043B. \u0421\u0443\u0432\u043E\u0440\u043E\u0432\u0430,3). \u041E\u043D\u043E
    \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u0432\r\n\u0441\u0442\u0438\u043B\u0435 \u043C\u043E\u0434\u0435\u0440\u043D,
    \u0434\u043E \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u043E
    \u042D. \u0428\u0435\u0439\u043D\u0438\u043D\u0443, \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443
    \u0447\u0430\u0441\u0442\u043D\u043E\u0439\r\n\u0442\u0438\u043F\u043E\u0433\u0440\u0430\u0444\u0438\u0438.
    \u041F\u043E\u0441\u043B\u0435 1917 \u0433. 2-\u044D\u0442\u0430\u0436\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u0438 \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435\r\n1923 \u0433.
    \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0438 \u0437\u0434\u0435\u0441\u044C
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C. \u042D\u0442\u043E \u0443\u0447\u0435\u0431\u043D\u043E\u0435
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E\r\n\u043E\u0442\u043A\u0440\u044B\u0442\u043E
    \u0432 1919 \u0433. \u043A\u0430\u043A \u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0435
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435 \u043F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435
    \u041C\u0430\u0440\u043A\u0430\r\n\u0428\u0430\u0433\u0430\u043B\u0430, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u043C\u0435\u043D\u044F\u043B\u043E \u0441\u0432\u043E\u0439
    \u0441\u0442\u0430\u0442\u0443\u0441 \u0438 \u043C\u0435\u0441\u0442\u043E\u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435.
    \u0421 1934 \u0433.\r\n\u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0441\u0442\u0430\u043B\u043E \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435\u043C, \u043E\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0434\u043E 1941 \u0433.\r\n\u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B
    \u0432 \xAB\u0434\u043E\u043C\u0435 \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C\xBB
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B\u0438\u0441\u044C \u0443\u0447\u0435\u0431\u043D\u044B\u0435
    \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u043D\u044B\u0445\r\n\u043F\u0440\u043E\u0444\u0438\u043B\u0435\u0439:
    \u0432 1951\u20131957 \u0433\u0433. \u2013 \u0444\u0438\u0437\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C, \u0432 1959\u20131964 \u0433\u0433.
    \u2013\r\n\u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0435
    \u0443\u0447\u0438\u043B\u0438\u0449\u0435, \u0441 1964 \u043F\u043E 1992 \u0433.
    \u2013 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0448\u043A\u043E\u043B\u0430,
    \u0441 1992 \u0433. \u043F\u043E\r\n\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0432\u0440\u0435\u043C\u044F \u2013 \u0414\u0435\u0442\u0441\u043A\u0430\u044F
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0448\u043A\u043E\u043B\u0430 \u2116 1\r\n\u041D\u0438 \u043D\u0430 \u043A\u0430\u043A\u043E\u043C
    \u0434\u0440\u0443\u0433\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u0433\u043E\u0440\u043E\u0434\u0430
    \u043D\u0435\u0442 \u0442\u0430\u043A\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0445\r\n\u0434\u043E\u0441\u043E\u043A.
    \u0412\u0441\u0435 \u043E\u043D\u0438 \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u044B
    \u0443\u0447\u0430\u0449\u0438\u043C\u0441\u044F \u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F\u043C
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E\r\n\u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C\u0430:
    \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u0443 \u0421\u0435\u0440\u0433\u0435\u044E
    \u0421\u0435\u043B\u0438\u0445\u0430\u043D\u043E\u0432\u0443, \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0443
    \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u0443 \u041A\u043E\u0440\u043E\u043B\u044E,\r\n\u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u0430\u043C
    \u0410\u043D\u0434\u0440\u0435\u044E \u0411\u0435\u043C\u0431\u0435\u043B\u044E
    \u0438 \u0417\u0430\u0438\u0440\u0443 \u0410\u0437\u0433\u0443\u0440\u0443, \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044E
    \u0412\u0430\u0441\u0438\u043B\u044E \u0411\u044B\u043A\u043E\u0432\u0443,\r\n\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0443
    \u041F\u0430\u0432\u043B\u0443 \u041C\u0430\u0441\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432\u0443,
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0443 \u0438 \u043F\u0435\u0434\u0430\u0433\u043E\u0433\u0443
    \u0424\u0435\u0434\u043E\u0440\u0443 \u0424\u043E\u0433\u0442\u0443. \u0412 \u044D\u0442\u043E\u043C\r\n\u0437\u0434\u0430\u043D\u0438\u0438
    \u0442\u0430\u043A\u0436\u0435 \u0443\u0447\u0438\u043B\u0438\u0441\u044C \u0431\u0443\u0434\u0443\u0449\u0438\u0435
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438
    \u0418\u0441\u0430\u0430\u043A \u0411\u043E\u0440\u043E\u0432\u0441\u043A\u0438\u0439,
    \u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D\r\n\u0414\u0437\u0435\u0436\u0438\u0446,
    \u0415\u0432\u0433\u0435\u043D\u0438\u0439 \u0417\u0430\u0439\u0446\u0435\u0432,
    \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u041A\u0443\u0445\u0430\u0440\u0435\u0432,
    \u0412\u0438\u0442\u0430\u043B\u0438\u0439 \u0426\u0432\u0438\u0440\u043A\u043E,
    \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440 \u0410\u043B\u0435\u043A\u0441\u0435\u0439\r\n\u0413\u043B\u0435\u0431\u043E\u0432
    \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435.
    \u0412 \u0447\u0438\u0441\u043B\u0435 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C\u0430 \u2013\r\n\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438
    \u0415\u0444\u0438\u043C \u041C\u0438\u043D\u0438\u043D, \u0418\u0432\u0430\u043D
    \u0410\u0445\u0440\u0435\u043C\u0447\u0438\u043A, \u041B\u0435\u0432 \u041B\u0435\u0439\u0442\u043C\u0430\u043D,
    \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440 \u041C\u0438\u0445\u0430\u0438\u043B\r\n\u041A\u0435\u0440\u0437\u0438\u043D,
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A-\u043A\u0435\u0440\u0430\u043C\u0438\u0441\u0442
    \u041D\u0438\u043A\u043E\u043B\u0430\u0439 \u041C\u0438\u0445\u043E\u043B\u0430\u043F
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0435."
  _preview: {fileID: 21300000, guid: 0b767188858038342ae5fcf21167f6f0, type: 3}
  _images:
  - _title: "\u0414\u043E\u043C \u0441 \u043A\u0443\u043F\u043E\u043B\u043E\u043C.
      \u0417\u0434\u0430\u043D\u0438\u0435 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0442\u0435\u0445\u043D\u0438\u043A\u0443\u043C\u0430. 1932 \u0433."
