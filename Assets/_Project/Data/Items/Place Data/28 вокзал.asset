  - _title: "\u0416\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0432\u043E\u043A\u0437\u0430\u043B. 1910-\u0435 \u0433\u0433."
    _image: {fileID: 21300000, guid: 3bd45747315c3524e9413a4336bcc8d5, type: 3}
