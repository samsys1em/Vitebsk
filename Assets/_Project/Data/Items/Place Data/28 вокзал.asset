  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "28 \u0432\u043E\u043A\u0437\u0430\u043B"
  m_EditorClassIdentifier: 
  _number: 28
  _name: "\u0432\u043E\u043A\u0437\u0430\u043B"
  _description: "\u0417\u0434\u0430\u043D\u0438\u0435 \u0432\u043E\u043A\u0437\u0430\u043B\u0430
    \u0431\u044B\u043B\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043E
    \u0432 1866 \u0433. \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u043E\u0439
    \u0414\u0438\u043D\u0430\u0431\u0443\u0440\u0433\u043E-\r\n\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438.
    \u0410\u0432\u0442\u043E\u0440 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u2013
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440 \u041F. \u0427\u0435\u0440\u0432\u0438\u043D\u0441\u043A\u0438\u0439.
    \u042D\u0442\u043E\r\n\u0431\u044B\u043B\u043E \u0437\u043D\u0430\u043A\u043E\u0432\u043E\u0435
    \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0434\u043B\u044F \u0433\u043E\u0440\u043E\u0434\u0430, \u043D\u043E \u0438
    \u0434\u043B\u044F \u0432\u0441\u0435\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0438.\r\n\u0422\u0440\u0435\u0445\u044D\u0442\u0430\u0436\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0438\u043C\u0435\u043B\u043E \u0441\u043B\u043E\u0436\u043D\u0443\u044E
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u0443\u044E
    \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E. \u0421\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B\r\n\u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0444\u0430\u0441\u0430\u0434\u0430 \u043F\u043E \u043E\u0431\u0435\u0438\u043C
    \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0438\u0435\r\n\u043E\u0431\u044A\u0435\u043C\u044B
    \u0432 \u0432\u0438\u0434\u0435 \u0431\u0430\u0448\u0435\u043D, \u043F\u0435\u0440\u0432\u044B\u0439
    \u044D\u0442\u0430\u0436 \u0431\u044B\u043B \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D
    \u0430\u0440\u043A\u0430\u043C\u0438, \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435
    2-\u0433\u043E \u044D\u0442\u0430\u0436\u0430\r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435
    \u043D\u0438\u0448\u0438, \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0435
    \u043B\u0435\u043F\u043D\u0438\u043D\u043E\u0439. \u0417\u0430\u0434\u043D\u0438\u0439
    \u0444\u0430\u0441\u0430\u0434\r\n\u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B
    \u0431\u043E\u043B\u0435\u0435 \u0441\u043A\u0440\u043E\u043C\u043D\u043E. \u041A
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C \u0432\u0435\u043B\u0438
    \u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u0438\u0430\u0434\u0443\u043A\u0438.
    \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\r\n\u0432\u043E\u043A\u0437\u0430\u043B\u0430
    \u043E\u043A\u0430\u0437\u0430\u043B\u043E \u0432\u043B\u0438\u044F\u043D\u0438\u0435
    \u043D\u0430 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0435\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438:
    \u0437\u0434\u0435\u0441\u044C\r\n\u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
    \u043D\u043E\u0432\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u2013
    \u041F\u0440\u0438\u0432\u043E\u043A\u0437\u0430\u043B\u044C\u043D\u0430\u044F.
    \u0421\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u0437\u0434\u0430\u043D\u0438\u044F,
    \u043D\u0430 \u041E\u0440\u043B\u043E\u0432\u0441\u043A\u043E\u0439\r\n\u043F\u043B\u043E\u0449\u0430\u0434\u0438,
    \u0431\u044B\u043B \u0437\u0430\u043B\u043E\u0436\u0435\u043D \u0441\u0430\u0434
    \u0432 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C \u0441\u0442\u0438\u043B\u0435
    (\u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0441\u043A\u0432\u0435\u0440
    \u043F\u043E \u0443\u043B.\r\n\u041A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442\u043E\u0432).\r\n\u0412
    1912 \u0433. \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u044F \u0432\u043E\u043A\u0437\u0430\u043B\u0430
    \u0431\u044B\u043B\u0430 \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0430
    \u043E\u0434\u043D\u043E\u044D\u0442\u0430\u0436\u043D\u0430\u044F\r\n\u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0439\u043A\u0430.
    \u0412 \u0442\u0430\u043A\u043E\u043C \u0432\u0438\u0434\u0435 \u0432\u043E\u043A\u0437\u0430\u043B
    \u043F\u0440\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0434\u043E 1941 \u0433.\r\n\u0412 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439
    \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B \u0437\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043E. \u0420\u0435\u0448\u0435\u043D\u0438\u0435
    \u043E\r\n\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
    \u043D\u043E\u0432\u043E\u0433\u043E \u0432\u043E\u043A\u0437\u0430\u043B\u0430
    \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u043E \u0443\u0436\u0435
    \u0432 1945 \u0433., \u0430 \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\r\n\u0440\u0430\u0431\u043E\u0442\u044B
    \u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C 1 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    1949 \u0433. (\u0430\u0432\u0442\u043E\u0440 \u043F\u0440\u043E\u0435\u043A\u0442\u0430
    \u2013 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440 \u0411. \u041C\u0435\u0437\u0435\u043D\u0446\u0435\u0432).\r\n\u0417\u0434\u0430\u043D\u0438\u0435
    \u0432\u043E\u0437\u0432\u043E\u0434\u0438\u043B\u0438 \u043D\u0430 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u0445 \u0441\u043E
    \u0441\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C \u0435\u0433\u043E \u043E\u0441\u0438
    \u0441 \u043E\u0441\u044C\u044E\r\n\u0443\u043B\u0438\u0446\u044B \u041A\u0438\u0440\u043E\u0432\u0430.
    \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0432\u0430\u0436\u043D\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
    \u043F\u043E\u0434\r\n\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C
    \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0432\u043B\u0430\u0441\u0442\u0435\u0439.
    \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0431\u044B\u043B\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u044B
    \u043A \u043A\u043E\u043D\u0446\u0443 1951 \u0433., \u0430\r\n\u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u043D\u043E\u0432\u043E\u0433\u043E
    \u0432\u043E\u043A\u0437\u0430\u043B\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0441\u044C
    \u0432 \u0444\u0435\u0432\u0440\u0430\u043B\u0435 1952 \u0433.\r\n\u0412 2010
    \u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u0432\u043E\u043A\u0437\u0430\u043B\u0430
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u043D\u0430 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438,
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0431\u044B\u043B\u0430\r\n\u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0430
    \u0437\u0430\u043C\u0435\u043D\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0447\u043D\u044B\u0445
    \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439, \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F
    \u043B\u0435\u043F\u043D\u0438\u043D\u044B, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430\r\n\u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0430.
    \u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0431\u044B\u043B \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D
    \u043F\u0440\u0438\u0433\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u0437\u0430\u043B.
    \u0422\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043E\u0447\u043D\u044B\u0435\r\n\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B
    \u0441\u0442\u0430\u043B\u0438 \u043A\u0440\u044B\u0442\u044B\u043C\u0438.\r\n\u0412
    \u0438\u044E\u043B\u0435 2011 \u0433. \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u0439
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435 \u0432\u043E\u043A\u0437\u0430\u043B\u0430
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u043D\u0443\u044E\r\n\u0433\u0440\u0443\u043F\u043F\u0443
    \xAB\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0449\u0438\u0435\xBB (\u0430\u0432\u0442\u043E\u0440\u044B
    \u2013 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u044B \u0410. \u041D.
    \u0422\u043E\u0440\u043E\u0441\u044F\u043D, \u0410. \u041D. \u0413\u0432\u043E\u0437\u0434\u0438\u043A\u043E\u0432)."
  _preview: {fileID: 21300000, guid: b42d069e5d318c748b3e9dba6cc5a130, type: 3}
