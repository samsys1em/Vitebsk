  m_Script: {fileID: 11500000, guid: 6127933f9afb42a4a9843b51e2994ba3, type: 3}
  m_Name: "53 \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F \u0446-\u0432\u044C
    \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435"
  m_EditorClassIdentifier: 
  _number: 53
  _name: "\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F \u0446-\u0432\u044C
    \u0432 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435"
  _description: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C \u041F\u043E\u043A\u0440\u043E\u0432\u0430
    \u041F\u0440\u0435\u0441\u0432\u044F\u0442\u043E\u0439 \u0411\u043E\u0433\u043E\u0440\u043E\u0434\u0438\u0446\u044B
    \u2013 \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F
    \u0445\u0440\u0430\u043C \u0432\r\n\u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0417\u0430\u0434\u0432\u0438\u043D\u044C\u044F.
    \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u0432 \u0440\u0430\u0439\u043E\u043D\u0435
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0443\u043B\u0438\u0446\r\n\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u043E\u0439
    \u0438 \u041C\u044F\u0441\u043D\u0438\u043A\u043E\u0432\u0430.\r\n\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F
    \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u0441 XVIII \u0432. \u041D\u043E
    \u0443\u0436\u0435 \u0432 1838 \u0433. \u043E\u043D\u0430\r\n\u0431\u044B\u043B\u0430
    \u0432\u0435\u0442\u0445\u043E\u0439 \u0438 \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439,
    \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u043B\u0430\u0441\u044C
    \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0438 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438\r\n\u0433\u043E\u0440\u043E\u0434\u0430,
    \u043F\u043E\u043A\u0430 \u043D\u0435 \u0431\u044B\u043B\u0430 \u0441\u043D\u0435\u0441\u0435\u043D\u0430
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F
    1863\u20131864 \u0433\u0433. \u041F\u043E\u0437\u0436\u0435 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435\r\n\u043F\u0440\u0435\u0441\u0442\u043E\u043B\u0430
    \u0445\u0440\u0430\u043C\u0430 \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D
    \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
    \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u0439 \u0441\u0442\u043E\u043B\u0431\u0438\u043A
    \u0441 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u043C\r\n\u043A\u0440\u0435\u0441\u0442\u043E\u043C
    \u043D\u0430\u0432\u0435\u0440\u0445\u0443.\r\n\u0412 1865 \u0433. \u043D\u0430
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435 \u0445\u0440\u0430\u043C\u0430
    \u0418\u043B\u044C\u0438 \u041F\u0440\u043E\u0440\u043E\u043A\u0430 \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0430
    \u043D\u043E\u0432\u0430\u044F \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u0430\u044F\r\n\u0446\u0435\u0440\u043A\u043E\u0432\u044C
    \u041F\u043E\u043A\u0440\u043E\u0432\u0430 \u0432 \u043F\u0441\u0435\u0432\u0434\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u043C
    \u0441\u0442\u0438\u043B\u0435. \u0425\u0440\u0430\u043C \u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F
    \u043F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u0438\u0438\r\n\u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430 \u0412.\u041D.
    \u0412\u0435\u0440\u0435\u0432\u043A\u0438\u043D\u0430. \u0412 \u043D\u0435\u043C
    \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u0438\u043A\u043E\u043D\u044B,
    \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435\r\n\u0435\u0433\u043E
    \u0441\u0443\u043F\u0440\u0443\u0433\u043E\u0439 \u0415.\u041F. \u0414\u0430\u0440\u0430\u0433\u0430\u043D.
    \u0421\u0432\u044F\u0442\u043E-\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C \u044F\u0432\u043B\u044F\u043B\u0430\u0441\u044C
    \u043F\u0440\u0438\u043F\u0438\u0441\u043D\u043E\u0439 \u043A\r\n\u0418\u043B\u044C\u0438\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438. \u0425\u0440\u0430\u043C \u0434\u0430\u043B
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u043E\u0439
    \u0443\u043B\u0438\u0446\u0435.\r\n\u0426\u0435\u0440\u043A\u043E\u0432\u044C
    \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B, \u0431\u044B\u043B\u0430\r\n\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0430
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0432\u043E\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0434\u044B."
  _preview: {fileID: 21300000, guid: efbd806b3a03373468050f5a3f2eea2c, type: 3}
  _images:
  - _title: "\u0417\u0430\u0434\u0432\u0438\u043D\u044C\u0435. \u041F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0439
      \u0437\u0430\u0432\u043E\u0434, \u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F
