--- !u!114 &7306128219543020299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5399937857400698909}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0416\u0438\u043A\u0433\u0438\u043C\u043E\u043D\u0442 \u0422\u0440\u0435\u0442\u0438\u0438,
    \u0411\u043E\u0436\u044E \u043C\u043B\u0441\u0442\u044E \u043A\u043E\u0440\u043E\u043B
    \u043F\u043E\u043B\u0441\u043A\u0438\u0438[2]. \u041E\u0437\u043D\u0430\u0438\u043C\u0443\u0435\u043C\u044A
    \u0441\u0438\u043C \u043B\u0438\u0441\u0442\u043E\u043C\u044A \u043D\u0430\u0448\u0438\u043C
    \u0432\u0441\u0438\u043C\u044A \u0432\u043E\u0431\u0435\u0446\u044A \u0438 \u043A\u043E\u0436\u0434\u043E\u043C\u0443
    \u0437\u043E\u0441\u043E\u0431\u043D\u0430, \u043D\u0438\u043D\u0435\u0448\u043D\u0438\u043C\u044A
    \u0438 \u043D\u0430\u043F\u043E\u0442\u043E\u043C\u044A \u0431\u0443\u0434\u0443\u0447\u0438\u043C\u044A,
    \u043A\u043E\u043C\u0443 \u0431\u044B \u0442\u043E \u0432\u0435\u0434\u0430\u0442\u0438
    \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u043E, \u0438\u0436\u044C \u0441\u043B\u0430\u0432\u0443\u0442\u043D\u044B\u0435
    \u043C\u0435\u0449\u0430\u043D\u0435 \u043A\u043E\u043D\u043D\u044B\u0435 \u043F\u043E\u0441\u0435\u043B\u0441\u043A\u0438\u0435
    \u0438 \u0432\u0441\u0435 \u043F\u043E\u0441\u043F\u043E\u043B\u0441\u0442\u0432\u043E
    \u043C\u0435\u0441\u0442\u0430 \u043D\u0430\u0448\u043E\u0433\u043E \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E,
    \u043C\u0430\u044E\u0447\u0438 \u0437 \u0434\u0430\u0432\u043D\u044B\u0445\u044A
    \u0447\u0430\u0441\u043E\u0432\u044A \u0432\u0435\u043B\u0438\u043A\u0438\u0435
    \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u0438, \u043E\u0442 \u043F\u0440\u043E\u0434\u043A\u043E\u0432\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A \u043A\u043E\u0440\u043E\u043B\u0435\u0438
    \u0438\u0445\u044A \u043C\u0438\u043B\u043E\u0441\u0442\u0438 \u043F\u043E\u043B\u044C\u0441\u043A\u0438\u0445\u044A
    \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u0445\u044A \u043A\u043D\u044F\u0437\u0435\u0438
    \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u0445\u044A \u0438\u043C \u043D\u0430\u0434\u0430\u043D\u044B\u0435,
    \u0430 \u043D\u0435 \u043C\u0430\u044E\u0447\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0438 \u0431\u0443\u0434\u0443\u0447\u044B \u043F\u043E\u0434\u044A \u043F\u0440\u0438\u0441\u0443\u0434\u043E\u043C\u044A
    \u0437\u0430\u043C\u043A\u0443 \u043D\u0430\u0448\u043E\u0433\u043E \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0433\u043E,
    \u043D\u0435 \u043C\u043E\u0433\u043B\u0438 \u043A\u0443 \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u043E\u043C\u0443
    \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u0438 \u0440\u043E\u0437\u044A\u0448\u0438\u0440\u0435\u043D\u044C\u044E
    \u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u043D\u0430\u0448\u043E\u0433\u043E
    \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0438 \u0440\u043E\u0437\u043C\u044A\u043D\u043E\u0436\u0438\u0442\u0438
    \u0438 \u0431\u0438\u043B\u0438 \u043D\u0430\u043C\u044A, \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0443,
    \u0447\u043E\u043B\u043E\u043C\u044A \u0432\u0441\u0438 \u043E\u0433\u0443\u043B\u043E\u043C\u044A
    \u0447\u0435\u0440\u0435\u0437\u044A \u043F\u043E\u0441\u043B\u0430\u043D\u044A\u0446\u043E\u0432
    \u0441\u0432\u043E\u0438\u0445\u044A, \u0430\u0431\u044B \u0435\u0441\u043C\u043E
    \u0434\u043B\u044F \u043B\u0435\u043F\u044A\u0448\u043E\u0433\u043E \u0440\u043E\u0437\u044A\u043C\u043D\u043E\u0436\u0435\u043D\u044C\u044F
    \u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u0443\u043A\u0440\u0430\u0438\u043D\u044A\u043D\u043E\u0433\u043E
    \u0438 \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C\u044A
    \u043F\u0440\u043E\u0434\u043A\u043E\u0432\u044A \u043D\u0430\u0448\u0438\u0445\u044A,
    \u0432\u044B\u0437\u0432\u043E\u043B\u0438\u0432\u0448\u0438 \u0438\u0445\u044A
    \u043E\u0442 \u0432\u0448\u0435\u043B\u044F\u043A\u043E\u0435 \u0432\u043B\u0430\u0434\u0437\u044B,
    \u0437\u0432\u0438\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0432\u0440\u0430\u0434\u0443
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u043A\u043E\u0433\u043E \u0437\u0430\u043C\u043A\u043E\u0432\u043E\u0433\u043E
    \u0438 \u0438\u043D\u044A\u0448\u0438\u0445 \u0432\u0440\u0430\u0434\u043E\u0432\u044A
    \u0437\u0435\u043C\u044A\u0441\u043A\u0438\u0445\u044A, \u043F\u0440\u0430\u0432\u043E
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0435 \u0438\u043C\u044A
    \u043D\u0430\u0434\u0430\u043B\u0438 \u0438 \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u043C\u044A
    \u043D\u0430\u0448\u0438\u043C\u044A \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438.
    \u0417\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u0438 \u0438\u0445\u044A
    \u043C\u0438\u043B\u043E\u0441\u0442 \u043F\u0430\u043D\u043E\u0432\u0435 \u0440\u0430\u0434\u0430
    \u0438 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u0438 \u043D\u0430\u0448\u0438
    \u043E\u0431\u043E\u0435\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0443, \u043D\u0430
    \u0442\u0435\u043F\u0435\u0440\u0435\u0448\u043D\u0435\u043C\u044A \u0441\u043E\u0438\u043C\u0435
    \u0432\u0430\u043B\u043D\u043E\u043C\u044A \u043F\u0440\u0438 \u043D\u0430\u0441\u044A
    \u0431\u0443\u0434\u0443\u0447\u044B\u0435, \u0438 \u043F\u0430\u043D\u044A \u0432\u043E\u0435\u0432\u043E\u0434\u0430
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0438 \u0432\u0435\u043B\u044C\u043C\u043E\u0436\u043D\u044B\u0438
    \u041C\u0438\u043A\u043E\u043B\u0430\u0438 \u0421\u0430\u043F\u0435\u0433\u0430
    \u0447\u0435\u0440\u0435\u0437\u044A \u043B\u0438\u0441\u0442\u044C \u0441\u0432\u043E\u0438
    \u0441\u0442\u0430\u043B\u0443\u044E \u0432\u0435\u0440\u044A\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043F\u043E\u0434\u0434\u0430\u043D\u0441\u0442\u0432\u043E \u0438\u0445\u044A,
    \u0430 \u0437\u0432\u043B\u0430\u0449\u0430 \u043F\u043E\u0434\u044A \u0447\u0430\u0441\u043E\u043C\u044A
    \u0432\u0430\u043B\u043A\u0438 \u0437 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0435\u043C\u044A,
    \u0432\u0435\u043B\u0438\u043A\u0438\u043C\u044A \u043A\u043D\u0437\u0435\u043C\u044A
    \u043C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0438\u043C\u044A, \u043F\u0440\u043E\u0434\u044A\u043A\u043E\u043C\u044A
    \u043D\u0430\u0448\u0438\u043C\u044A \u0438 \u0420\u0435\u0447\u0438 \u041F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0438
    \u0446\u0430\u043B\u0435 \u043E\u0442\u0434\u0430\u0432\u0430\u043D\u043E\u0435,
    \u043F\u0435\u0440\u0435\u0434\u044A \u043D\u0430\u043C\u0438 \u0437\u0430\u043B\u0435\u0446\u0430\u044E\u0447\u044B
    \u0432 \u043F\u0440\u0438\u0447\u0438\u043D\u0435 \u043D\u0430\u0441\u044A \u0437\u0430
    \u043D\u0438\u043C\u0438 \u0436\u0435\u0434\u0430\u043B\u0438, \u0443\u043A\u0430\u0437\u0443\u044E\u0447\u044B
    \u0442\u043E, \u0436\u0435 \u043C\u0435\u0449\u0430\u043D\u0435 \u0438 \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0438
    \u043C\u0435\u0441\u0442\u0430 \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0433\u043E,
    \u043A\u043E\u0433\u0434\u044B \u0442\u043E\u0435 \u043F\u0440\u0430\u0432\u043E
    \u0437 \u043B\u0430\u0441\u043A\u0438 \u043D\u0430\u0448\u043E\u0435 \u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C,
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0430\u043D\u044A
    \u0441\u0432\u043E\u0438 \u043B\u0435\u043F\u044A\u0448\u0438\u043C\u044A \u0443\u0447\u0438\u043D\u0438\u0442\u0438,
    \u0430\u043B\u0435 \u0442\u0435\u0436\u044A, \u043A\u043E\u0433\u0434\u044B \u0441\u0435
    \u0440\u043E\u0437\u044A\u043C\u043D\u043E\u0436\u0430\u0442\u044C, \u0432 \u043C\u0430\u0435\u0442\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u043F\u043E\u043C\u043E\u0433\u0443\u0442\u044C \u0438 \u043C\u0435\u0441\u0442\u043E
    \u043D\u0430\u0448\u043E \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0435 \u044F\u043A\u043E
    \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0435, \u043D\u0430
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043D\u0430\u043C\u044A \u0438 \u0420\u0435\u0447\u0438
    \u041F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0438 \u043D\u0435\u043C\u0430\u043B\u043E
    \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C, \u0437\u0430 \u0447\u0430\u0441\u043E\u043C\u044A
    \u043B\u0435\u043F\u0435\u0438 \u0430 \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0435\u0438
    \u043E\u0431\u0432\u0430\u0440\u043E\u0432\u0430\u043D\u043E \u0438 \u0432\u044A
    \u0431\u043E\u043B\u0448\u0443\u044E \u0431\u0435\u0437\u044A\u043F\u0435\u0447\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u043E\u0442\u0438\u0432\u044A \u043A\u043E\u0436\u0434\u043E\u0433\u043E
    \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044F \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u043E
    \u043C\u0435\u0442\u0438 \u043C\u043E\u0433\u0443\u0442\u044C. \u0410 \u0442\u0430\u043A\u044A
    \u043C\u044B, \u0433\u0441\u0434\u0440\u044A, \u0432\u0438\u0434\u0435\u0447\u0438
    \u0442\u043E, \u0436\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0438[3] \u043C\u0430\u0435\u0441\u0442\u0430\u0442\u044A
    \u043C\u043E\u043D\u0430\u0440\u0445\u043E\u0432 \u0438 \u043A\u043D\u044F\u0436\u0430\u0442\u044A
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0432\u044B\u0442\u044F\u0436\u044A\u0441\u0442\u0432\u043E\u043C\u044A
    \u0432\u0430\u043B\u043A\u044A \u0431\u044B\u0432\u0430\u0435\u0442\u044C \u043F\u043E\u0434\u0432\u044B\u0448\u043E\u043D\u044A,
    \u0430\u043B\u0435 \u0442\u0435\u0436\u044A \u0441 \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D\u044C\u044F
    \u043F\u0440\u0430\u0432\u044A \u0438 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u0445\u044A
    \u0443\u0441\u0442\u0430\u0432\u044A \u0434\u043E \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u044C\u044F
    \u043F\u0430\u043D\u044A\u0441\u0442\u0432\u044A \u0438 \u043F\u043E\u043C\u043D\u043E\u0436\u0435\u043D\u044C\u044F
    \u0432\u0441\u0435\u0433\u043E \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C.
    \u0411\u043E \u0437 \u0434\u043E\u0431\u0440\u044B\u0445\u044A \u0443\u0441\u0442\u0430\u0432\u044A
    \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
    \u0432\u0441\u0438\u0445\u044A \u043C\u0435\u0441\u0442\u044A \u043D\u0435\u043D\u0430\u0440\u0443\u0448\u043E\u043D\u044B\u0438
    \u0435\u0441\u0442\u044C \u0444\u0443\u043D\u044A\u0434\u0430\u043C\u0435\u043D\u0442
    \u0438 \u0442\u043E\u044E \u0441\u0430\u043C\u043E\u044E \u0437 \u043C\u0430\u043B\u044B\u0445
    \u0432\u0435\u043B\u0438\u043A\u0438\u0435 \u0438 \u0441\u043B\u0430\u0432\u043D\u044B\u0435
    \u043C\u0435\u0441\u0442\u0430 \u0437 \u043E\u0437\u044A\u0434\u043E\u0431\u043E\u044E
    \u0438 \u043F\u043E\u0436\u0438\u0442\u043A\u043E\u043C\u044A \u0420\u0435\u0447\u0438
    \u041F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0435 \u0443\u0440\u043E\u0441\u0442\u0430\u044E\u0442\u044C,
    \u0430 \u0433\u0434\u0435 \u0437\u0430\u0441\u044C \u043F\u043E\u0440\u0430\u0434\u043D\u044B\u0445\u044A
    \u0443\u0441\u0442\u0430\u0432\u044A \u0438 \u043F\u0440\u0430\u0432\u0430 \u043F\u0438\u0441\u0430\u043D\u043E\u0433\u043E
    \u0432\u0430\u0440\u043E\u0432\u043D\u043E\u0433\u043E \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0438
    \u043D\u0435 \u043C\u0430\u044E\u0442\u044C, \u0442\u0430\u043C\u044A \u0434\u043B\u044F
    \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0435\u043F\u043E\u0440\u0430\u0434\u043A\u0443
    \u0432\u0435\u043B\u0438\u043A\u0438\u0435 \u0438 \u043C\u043E\u0436\u043D\u044B\u0435
    \u043C\u0435\u0441\u0442\u0430 \u0434\u043E \u0437\u0433\u0443\u0431\u044B \u0438
    \u0437\u043D\u0438\u0449\u0435\u043D\u044C\u044F \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442\u044C
    \u0438 \u0432 \u043D\u0438\u0432\u043E\u0448\u0442\u043E \u0441\u044F \u043E\u0431\u043E\u0440\u043E\u0447\u0430\u044E\u0442\u044C.  
    1. \u0417\u0430 \u0447\u044B\u043C\u044A \u0442\u0435\u0436\u044A \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u0435
    \u043B\u0430\u0441\u043A\u0438 \u043D\u0430\u0448\u043E\u0435, \u0445\u043E\u0442\u0435\u0447\u0438
    \u0441\u0442\u0430\u043D\u044A \u0438 \u043A\u043E\u043D\u0434\u044B\u0446\u044B\u044E
    \u0442\u044B\u0445\u044A \u043C\u0435\u0449\u0430\u043D\u044A \u043D\u0430\u0448\u0438\u0445\u044A
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0445\u044A \u043B\u0435\u043F\u044A\u0448\u0443\u044E
    \u0443\u0447\u0438\u043D\u0438\u0442\u044C \u0438 \u0437 \u044B\u043D\u044A\u0448\u0438\u043C\u0438
    \u043C\u0435\u0441\u0442\u044B \u043D\u0430\u0448\u0438\u043C\u0438 \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u043C\u0438
    \u0442\u0430\u043A\u044A \u0432 \u041A\u043E\u0440\u0443\u043D\u0435 \u041F\u043E\u043B\u0441\u043A\u043E\u0438
    \u044F\u043A\u043E \u0438 \u0432\u044A \u0412\u0435\u043B\u0438\u043A\u043E\u043C\u044A
    \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0435 \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u043C\u044A
    \u043F\u043E\u0440\u043E\u0432\u044A\u043D\u0430\u0442\u0438, \u0437\u0430 \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u044E
    \u0438\u0445\u044A \u043C\u043B\u0441\u0442\u0438 \u043F\u0430\u043D\u043E\u0432\u044A
    \u0440\u0430\u0434\u044A \u0438 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u0432\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A \u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
    \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0435 \u044F\u043A\u043E
    \u0443 \u0441\u0432\u043E\u0438\u0445\u044A \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445\u044A
    \u0437\u0430\u043B\u043E\u0436\u043E\u043D\u043E\u0435 \u0435\u0441\u0442\u044A
    \u0438 \u0442\u0435\u043F\u0435\u0440\u044A \u0441\u0435 \u043C\u0430\u0435\u0442
    \u0438 \u0432\u0441\u0438\u0445\u044A \u043E\u0433\u0443\u043B\u043E\u043C\u044A
    \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u0432\u044A \u043C\u0435\u0441\u0442\u0430
    \u0442\u043E\u0433\u043E \u0432 \u043C\u0435\u0441\u0442\u0435, \u043D\u0430
    \u043F\u0435\u0440\u0435\u0434\u043C\u0435\u0441\u0442\u044E \u0438 \u0432\u044A
    \u0444\u043E\u043B\u0432\u0430\u0440\u044A\u043A\u0430\u0445\u044A \u043F\u043E
    \u0441\u0435\u043B\u0430\u0445\u044A \u043C\u0435\u0448\u043A\u0430\u044E\u0447\u044B\u0445\u044A,
    \u0437\u044A \u0438\u0445\u044A \u0432\u0441\u0438\u043C\u0438 \u0434\u043E\u0431\u0440\u044B,
    \u043F\u043E\u0434\u0434\u0430\u043D\u044B\u043C\u0438, \u043C\u0430\u0435\u0442\u043D\u043E\u0441\u0442\u044C\u044E
    \u0438 \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0441 \u043F\u0440\u0430\u0432\u0430 \u0437\u0435\u043C\u044A\u0441\u043A\u043E\u0433\u043E
    \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430
    \u041B\u0438\u0442\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E, \u043E\u0442
    \u0432\u0441\u044F\u043A\u043E\u0435 \u044E\u0440\u0438\u0437\u0434\u0438\u0446\u044B\u0438
    \u0438 \u043C\u043E\u0446\u044B \u0441\u0443\u0434\u043E\u0432\u044A \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u0445\u044A
    \u0442\u0440\u0438\u0431\u0443\u043D\u0430\u043B\u043D\u044B\u0445\u044A, \u0442\u0430\u043A\u044A\u0436\u0435
    \u0437 \u043C\u043E\u0446\u044B \u0432\u0441\u0438\u0445\u044A \u0432\u043E\u0435\u0432\u043E\u0434
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0445 \u0438 \u0437 \u044B\u043D\u044A\u0448\u0438\u0445\u044A
    \u0432\u0441\u044F\u043A\u0438\u0445\u044A \u0432\u043E\u0435\u0432\u043E\u0434\u044A,
    \u043A\u0430\u0448\u0442\u0430\u043B\u044F\u043D\u043E\u0432\u044A, \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044A,
    \u0434\u0435\u0440\u0436\u0430\u0432\u0435\u0446, \u0432\u0440\u0430\u0434\u043E\u0432\u044A
    \u0437\u0435\u043C\u044A\u0441\u043A\u0438\u0445\u044A \u0438 \u0438\u043D\u044A\u0448\u0438\u0445\u044A
    \u043F\u0440\u0435\u043B\u043E\u0436\u043E\u043D\u044B\u0445\u044A \u0438 \u0434\u0435\u0446\u043A\u0438\u0445\u044A
    \u0432\u044B\u0438\u043C\u0443\u0435\u043C\u044A \u0438 \u0432\u044B\u043B\u0443\u0447\u0430\u0435\u043C\u044A
    \u0438 \u0432\u0435\u0447\u043D\u0435 \u0432\u044B\u0437\u0432\u0430\u043B\u044F\u0435\u043C\u044A,
    \u0430 \u043F\u043E\u0434\u044A\u0434\u0430\u0435\u043C\u044A \u0438\u0445\u044A
    \u043F\u0440\u0430\u0432\u0443 \u0438 \u0441\u0443\u0434\u0443 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u043C\u0443
    \u0438 \u0443\u0441\u0442\u0430\u0432\u0443\u0435\u043C\u044A \u0442\u043E, \u0438\u0436\u044A
    \u043C\u0435\u0449\u0430\u043D\u044A \u043C\u0435\u0441\u0442\u0430 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E
    \u043D\u0438\u0445\u0442\u043E \u0438\u043D\u044A\u0448\u0438\u0438 \u0441\u0443\u0434\u0438\u0442\u0438
    \u0438 \u0432\u043B\u0430\u0434\u0437\u044B \u043C\u0435\u0442\u0438 \u043D\u0435
    \u0431\u0443\u0434\u0435\u0442\u044C, \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0438\u0442\u044A
    \u0441\u0430\u043C \u0438 \u0441\u043F\u043E\u043B\u043D\u0435 \u0437 \u0431\u0443\u0440\u043C\u0438\u0441\u0442\u0440\u0430\u043C\u0438,
    \u0440\u0430\u0438\u0446\u0430\u043C\u0438 \u0438 \u043B\u0430\u0432\u043D\u0438\u043A\u0430\u043C\u0438
    \u0432\u043E\u0434\u043B\u0443\u0433\u044A \u0441\u043F\u043E\u0441\u043E\u0431\u0443
    \u0438 \u043F\u043E\u0440\u0430\u0434\u043A\u0443 \u043F\u0440\u0430\u0432\u0430
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u0433\u043E
    \u0438 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438\u043D\u044A\u0448\u0438\u0445\u044A
    \u043C\u0435\u0441\u0442\u044A \u043D\u0430\u0448\u0438\u0445\u044A \u0441\u0443\u0434\u0438\u0442\u0438
    \u0431\u0443\u0434\u0443\u0442\u044C.   2. \u0410 \u0432\u043E\u0438\u0442\u0430
    \u043C\u044B \u0438 \u043F\u043E\u0442\u043E\u043C\u044A\u043A\u043E\u0432\u0435
    \u043D\u0430\u0448\u0438, \u043A\u043E\u0440\u043E\u043B\u0438 \u043F\u043E\u043B\u0441\u043A\u0438\u0435
    \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u0435 \u043A\u043D\u0437\u0438 \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u0435,
    \u0437 \u043D\u0430\u0440\u043E\u0434\u0443 \u0448\u043B\u044F\u0445\u0435\u0442\u0441\u043A\u043E\u0433\u043E
    \u0432\u0435\u0440\u044B \u0445\u0440\u0435\u0441\u0442\u0438\u044F\u043D\u044A\u0441\u043A\u043E\u0435
    \u043F\u043E\u0432\u0448\u0435\u0445\u044A\u043D\u043E\u0435, \u044F\u043A\u043E
    \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0435
    \u0434\u0430\u0432\u043D\u043E\u0435 \u0443\u043A\u0430\u0437\u0443\u0435\u0442\u044C,
    \u0432\u043E\u0434\u043B\u0435 \u0432\u043E\u043B\u0438 \u043D\u0430\u0448\u043E\u0435
    \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0438 \u0431\u0443\u0434\u0435\u043C\u044A.
    \u0412\u0435\u0434 \u0436\u0435 \u043A\u0430\u0436\u0434\u044B\u0438 \u0432\u043E\u0438\u0442\u044A
    \u043F\u043E \u0443\u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0432\u0430\u043D\u044C\u044E
    \u043D\u0430\u0448\u043E\u043C\u044A \u0430\u0431\u043E \u043F\u043E\u0442\u043E\u043C\u044A\u043A\u043E\u0432\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A, \u043E\u0442 \u0432\u044B\u0448\u044A\u0448\u043E\u0433\u043E
    \u0434\u043E \u043D\u0430\u043C\u0435\u043D\u0448\u043E\u0433 \u0441\u0442\u0430\u043D\u0443
    \u0448\u043B\u044F\u0445\u0435\u0442\u0441\u043A\u043E\u0433\u043E, \u0437\u0430\u0440\u043E\u0432\u043D\u043E
    \u0432 \u0442\u043E\u043C\u044A \u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0447\u044B,
    \u043F\u0435\u0440\u0432\u0435\u0438 \u043F\u0440\u0438\u0441\u0435\u0433\u0443
    \u043D\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u043E\u0432\u0430\u043D\u044C\u0435
    \u0441\u0443\u0434\u043E\u0432\u044A \u0438 \u043D\u0430 \u0442\u043E, \u0436\u0435
    \u043C\u0435\u0441\u0442\u0443 \u0437\u044B\u0447\u043B\u0438\u0432\u044B\u0438,
    \u043F\u0440\u0430\u0432\u0430 \u0432 \u0446\u0435\u043B\u043E\u0441\u0442\u0438
    \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u0438, \u0437\u0433\u0443\u0431\u044B
    \u043F\u0435\u0440\u0435\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0442\u0438,
    \u0430 \u043E \u043F\u043E\u043C\u043D\u043E\u0436\u0435\u043D\u044C\u0435 \u0438
    \u0440\u043E\u0437\u044A\u0448\u0438\u0440\u0435\u043D\u044C\u0435 \u043F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0433\u043E
    \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043C\u0435\u0441\u043A\u043E\u0433\u043E
    \u0441\u0442\u0430\u0440\u0430\u0442\u0438\u0441\u0435 \u0431\u0443\u0434\u0435\u0442
    \u0432\u044B\u043A\u043E\u043D\u044B\u0432\u0430\u0442\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C\u044A
    \u0432\u0440\u0430\u0434\u043E\u043C\u044A \u0432\u043E\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u043C\u044A
    \u0432\u043B\u0430\u0434\u043D\u0443\u0442\u0438 \u043C\u0430\u044E\u0442. \u042F\u043A\u043E
    \u0436\u044A \u0432\u0436\u043E \u0434\u0430\u043B\u0438 \u0435\u0441\u043C\u043E
    \u0442\u043E\u0435 \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u0442\u0432\u043E
    \u0437\u0435\u043C\u0435\u043D\u0438\u043D\u0443 \u043D\u0430\u0448\u043E\u043C\u0443
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E
    \u0443\u0440\u043E\u0436\u043E\u043D\u043E\u043C\u0443 \u042E\u0440\u044A\u044E
    \u041B\u0435\u0442\u0435\u0446\u044A\u043A\u043E\u043C\u0443 \u0434\u043E \u0436\u0438\u0432\u043E\u0442\u0430
    \u0435\u0433\u043E.   3. \u041D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u0442\u0432\u043E \u0434\u0440\u0430\u0433\u0438\u043B\u043D\u043E\u0435
    \u0438 \u0441\u0435\u043B\u043E \u041A\u043E\u0440\u043E\u0432\u0430\u0438\u043D\u043E,
    \u044F\u043A\u043E \u043F\u0435\u0440\u0435\u0434 \u0442\u044B\u043C\u044A \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u043E,
    \u0438 \u043F\u0440\u043E\u0448\u043B\u044B\u0435 \u0432\u043E\u0438\u0442\u043E\u0432\u0435
    \u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B\u0438, \u0438 \u0442\u0435\u043F\u0435\u0440\u0435\u0448\u043D\u0438\u0438
    \u0432\u0436\u043E \u0432 \u0434\u0435\u0440\u0436\u0430\u043D\u044C\u044E \u0441\u0432\u043E\u0435\u043C\u044A
    \u043C\u0430\u0435\u0442\u044C, \u0442\u0430\u043A\u044A \u0438 \u0432 \u0447\u0430\u0441\u044A
    \u043F\u0440\u0438\u0448\u043B\u044B\u0438 \u0442\u043E\u0435 \u0441\u0435\u043B\u043E
    \u0437\u043E \u0432\u0441\u0438\u043C\u0438 \u043F\u0440\u0438\u043D\u0430\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0438 \u043F\u043E\u0436\u0438\u0442\u043A\u0430\u043C\u0438 \u0438 \u0432\u0441\u0435
    \u0442\u043E, \u0448\u0442\u043E \u043F\u0435\u0440\u044A\u0432\u044B\u0435 \u0432\u043E\u0438\u0442\u043E\u0432\u0435
    \u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B\u0438 \u0438 \u044F\u043A\u0438\u0445\u044A
    \u043A\u043E\u043B\u044C\u0432\u0435\u043A\u044A \u043F\u043E\u0436\u0438\u0442\u043A\u043E\u0432\u044A
    \u0438 \u0434\u043E\u0445\u043E\u0434\u043E\u0432\u044A \u0443\u0436\u0438\u0432\u0430\u043B\u0438,
    \u043D\u0430 \u0442\u043E\u0435 \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u0442\u0432\u043E
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0435 \u0432\u0435\u0447\u043D\u044B\u043C\u0438
    \u0447\u0430\u0441\u044B \u0444\u0443\u043D\u044A\u0434\u0443\u0435\u043C\u044A
    \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0430\u0435\u043C\u044A.   4. \u041A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
    \u0432\u043E\u0438\u0442\u0443 \u043D\u0430\u0448\u043E\u043C\u0443 \u0442\u0435\u043F\u0435\u0440\u0435\u0448\u043D\u0435\u043C\u0443
    \u0438 \u043F\u043E\u0442\u043E\u043C\u044A \u0431\u0443\u0434\u0443\u0447\u0438\u043C\u044A
    \u0434\u0430\u0435\u043C\u044A \u0432\u043E \u0432\u0441\u0438\u0445\u044A \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u0430\u0445,
    \u0438 \u0432 \u0438\u043D\u044A\u0448\u0438\u0445\u044A \u0441\u0443\u0434\u0430\u0445\u044A,
    \u0438 \u0432\u043E \u0432\u0441\u0438\u0445\u044A \u0441\u043F\u0440\u0430\u0432\u0430\u0445\u044A
    \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u0445\u044A \u0438 \u043F\u043E\u0442\u043E\u0447\u043D\u044B\u0445
    \u0437\u0443\u043F\u043E\u043B\u043D\u0443\u044E \u043C\u043E\u0446\u044A \u0432\u043E\u0434\u043B\u0443\u0433\u044C
    \u043E\u043F\u0438\u0441\u0430\u043D\u044C\u044F \u043F\u0440\u0430\u0432\u0430
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0441\u0443\u0434\u0438\u0442\u0438, \u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u0438
    \u0438 \u0432\u0438\u043D\u044A\u043D\u044B\u0445\u044A \u043A\u0430\u0440\u0430\u0442\u0438.  
    5. \u0414\u043E \u0442\u043E\u0433\u043E \u0432\u043E\u0438\u0442\u0443 \u0432\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C\u0443
    \u043B\u0435\u043D\u0442\u044A\u0432\u043E\u0438\u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u043C\u044A, \u043F\u043E\u0434\u044A
    \u043F\u0440\u0430\u0432\u043E\u043C\u044A \u0442\u0430\u043C\u043E\u0448\u043D\u0438\u043C\u044A
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u043C\u044A \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u0438\u043C\u044A
    \u043E\u0441\u0435\u043B\u043E\u0433\u043E.   6. \u041E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0438
    \u0442\u0435\u0436\u044A \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0435
    \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u0438\u0435 \u0431\u0443\u0440\u044A\u043C\u0438\u0441\u0442\u0440\u043E\u0432\u044A,
    \u0440\u0430\u0438\u0446\u043E\u0432 \u0438 \u043B\u0430\u0432\u043D\u0438\u043A\u043E\u0432\u044A
    \u0432\u043E\u0434\u043B\u0443\u0433\u044A \u043F\u043E\u0440\u0430\u0434\u044A\u043A\u0443
    \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u0433\u043E
    \u0438 \u0437\u0432\u044B\u0447\u0430\u0435\u0432\u044A \u043C\u0435\u0441\u0442\u0430
    \u043D\u0430\u0448\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0435\u0447\u043D\u043E\u0433\u043E
    \u0412\u0438\u043B\u0435\u043D\u044C\u0441\u043A\u043E\u0433\u043E \u0438 \u0438\u043D\u044A\u0448\u0438\u0445\u044A
    \u043C\u0435\u0441\u0442\u044A \u043D\u0430\u0448\u0438\u0445\u044A \u043E\u0431\u0438\u0440\u0430\u0442\u044C
    \u0438 \u0432\u043E\u0438\u0442\u0443 \u043D\u0430\u0448\u043E\u043C\u0443 \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u043C\u0443
    \u043E\u043A\u0430\u0437\u043E\u0432\u0430\u0442\u0438 \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438
    \u0431\u0443\u0434\u0443\u0442\u044C. \u0410 \u0432\u043E\u0438\u0442\u044A \u043E\u0441\u043E\u0431\u044A,
    \u043D\u0430 \u0442\u044B\u0435 \u0432\u0440\u0430\u0434\u044B \u0432\u043E\u0434\u043B\u0435
    \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u0440\u0430\u043D\u044B\u0445\u044A, \u043F\u0440\u0438\u0441\u0435\u0433\u0438
    \u0432\u044B\u0441\u043B\u0443\u0445\u0430\u0442\u0438 \u0438 \u0434\u043E \u0441\u0435\u0431\u0435
    \u043D\u0430 \u0441\u0443\u0434\u044B \u043F\u0440\u0438\u0438\u043C\u043E\u0432\u0430\u0442\u0438
    \u0438 \u0437 \u043D\u0438\u043C\u0438 \u0441\u043F\u0440\u0430\u0432\u044B \u0441\u0443\u0434\u043E\u0432\u044B\u0435
    \u043E\u043D\u044A \u0441\u0430\u043C\u044A \u0430\u0431\u043E \u043B\u0435\u043D\u0442\u044A\u0432\u043E\u0438\u0442\u044A
    \u0435\u0433\u043E \u043F\u043E\u0440\u0430\u0434\u043A\u043E\u043C\u044A \u043F\u0440\u0430\u0432\u0430
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u043E\u0442\u043F\u0440\u0430\u0432\u043E\u0432\u0430\u0442\u0438 \u043C\u0430\u0435\u0442\u044C.  
    7. \u0410 \u043C\u0435\u0449\u0430\u043D\u0435 \u0438 \u0432\u0441\u0435 \u043F\u043E\u0441\u043F\u043E\u043B\u0441\u0442\u0432\u043E
    \u043C\u0435\u0441\u0442\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u043E \u0432\u044A\u0441\u044F\u043A\u0438\u0435 \u0440\u0435\u0447\u0438 \u043A\u0440\u0432\u0430\u0432\u044B\u0435
    \u0438 \u043F\u043E\u0442\u043E\u0447\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u0434
    \u0442\u044B\u043C\u044A \u0432\u0440\u0430\u0434\u043E\u043C\u044A \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u043A\u0438\u043C\u044A
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u043C\u044A \u043A\u043E\u0436\u0434\u043E\u043C\u0443
    \u0436\u0430\u043B\u043E\u0431\u043B\u0438\u0432\u043E\u043C\u0443 \u0443\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044F\u0442\u0438\u0441\u0435
    \u0438 \u0437\u0430 \u043D\u0430\u043A\u0430\u0437\u043E\u043C\u044A \u0441\u0443\u0434\u043E\u0432\u044B\u043C\u044A
    \u0434\u043E\u0441\u044B\u0442\u044C \u0447\u0438\u043D\u0438\u0442\u0438 \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438
    \u0431\u0443\u0434\u0443\u0442\u044C, \u0430 \u0432\u0435\u0434 \u0436\u0435
    \u043D\u0435 \u0438\u043D\u044A\u0448\u0438\u043C\u044A \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u044A
    \u043F\u0440\u0430\u0432\u043E\u043C\u044A, \u043E\u0434\u043D\u043E \u0432\u043E\u0434\u043B\u0443\u0433\u044A
    \u0430\u0440\u0442\u044B\u043A\u0443\u043B\u043E\u0432\u044A \u0438 \u043E\u043F\u0438\u0441\u0430\u043D\u044C\u044F
    \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0433\u043E,
    \u044F\u043A\u043E \u0441\u0435 \u0432\u044B\u0448\u0435\u0438 \u043F\u043E\u043C\u0435\u043D\u0438\u043B\u043E.  
    8. \u0410 \u0435\u0441\u0442\u043B\u0438 \u0431\u044B \u0441\u0435 \u043A\u043E\u043C\u0443
    \u0436\u044A \u043A\u043E\u043B\u044C\u0432\u0435\u043A\u044A \u0441\u0443\u0434\u044A
    \u0432\u0440\u044F\u0434\u0443 \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u043E\u0433\u043E
    \u0441 \u043A\u0440\u0438\u0432\u044A\u0434\u043E\u044E \u0431\u044B\u0442\u0438
    \u0432\u0438\u0434\u0435\u043B\u044A, \u0442\u0430\u043A\u043E\u0432\u043E\u043C\u0443
    \u043A\u043E\u0436\u0434\u043E\u043C\u0443 \u0432\u043E\u043B\u043D\u043E \u0431\u0443\u0434\u0435\u0442\u044C
    \u0434\u043E \u043D\u0430\u0441\u044A, \u0433\u0441\u0434\u0440\u0430, \u0438
    \u0434\u043E \u043F\u043E\u0442\u043E\u043C\u043A\u043E\u0432 \u043D\u0430\u0448\u0438\u0445\u044A
    \u0437\u0430 \u0434\u0432\u043E\u0440\u043E\u043C\u044A \u0430\u043F\u0435\u043B\u0435\u0432\u0430\u0442\u0438,
    \u0432\u0435\u0434\u044A \u0436\u0435 \u0438 \u043D\u0430 \u0434\u0432\u043E\u0440\u0435
    \u043D\u0430\u0448\u043E\u043C\u044A \u0442\u044B\u043C\u044A \u0436\u0435 \u043F\u0440\u0430\u0432\u043E\u043C
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u0438\u043C\u044A
    \u0441\u0443\u0436\u043E\u043D\u044B \u0431\u044B\u0442\u0438 \u043C\u0430\u044E\u0442\u044C.  
    9. \u0410 \u0433\u0434\u0435 \u0431\u044B \u0432\u043E\u0438\u0442\u044A \u0432
    \u0441\u0443\u0434\u0435\u0445\u044A \u0432\u0430\u0436\u043D\u044B\u0445\u044A
    \u0441\u0430\u043C\u044A \u0430\u0431\u043E \u0438 \u0437 \u044B\u043D\u0448\u0438\u043C\u0438
    \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u0438 \u043D\u0435 \u0437 \u043E\u0441\u043E\u0431\u044B,
    \u0430\u043B\u0435 \u0437 \u0443\u0440\u044F\u0434\u0443 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043A\u0440\u0438\u0432\u0434\u0443 \u043A\u043E\u043C\u0443 \u0443\u0447\u0438\u043D\u0438\u043B\u0438,
    \u0442\u043E\u0433\u0434\u044B \u0437\u0430 \u043F\u043E\u0437\u0432\u043E\u043C\u044A
    \u043D\u0430\u0448\u0438\u043C\u044C \u0431\u0443\u0434\u0443\u0442\u044C \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438
    \u043F\u0435\u0440\u0435\u0434\u044C \u043D\u0430\u043C\u0438, \u0433\u0441\u0434\u0440\u0435\u043C\u044A,
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438\u0441\u0435 \u0438 \u0432\u043E\u0434\u043B\u0443\u0433\u044A
    \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u043E\u0433\u043E
    \u0443\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044F\u0442\u0438
    \u043F\u0435\u0432\u043D\u044B\u043C\u044A \u0440\u043E\u043A\u043E\u043C\u044A
    \u043E\u0442 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044C\u044F \u043F\u043E\u0437\u0432\u0443
    \u043D\u0430\u0448\u043E\u0433\u043E, \u0435\u0441\u0442\u043B\u0438 \u0432 \u041A\u043E\u0440\u0443\u043D\u0435
    \u041F\u043E\u043B\u0441\u043A\u043E\u0438 \u2014 \u0437\u0430 \u043E\u0441\u043C\u044C
    \u043D\u0435\u0434\u0435\u043B\u044C, \u0430 \u0435\u0441\u0442\u043B\u0438 \u0443
    \u0412\u0435\u043B\u0438\u043A\u043E\u043C\u044A \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0435
    \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u043C\u044A \u0431\u0443\u0434\u0435\u043C\u044A
    \u2014 \u0437\u0430 \u0447\u043E\u0442\u044B\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438.  
    10. \u0413\u0435\u0440\u0431\u044A \u0442\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443
    \u043D\u0430\u0448\u043E\u043C\u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u0443:
    \u0432 \u0431\u043B\u0435\u043A\u0438\u0442\u043D\u043E\u043C \u043F\u043E\u043B\u044E
    \u043E\u0431\u0440\u0430\u0437\u044A \u0441\u0432\u0435\u0442\u043E\u0433\u043E
    \u0421\u043F\u0430\u0441\u0430 \u0417\u0431\u0430\u0432\u0438\u0442\u0435\u043B\u044F
    \u043D\u0430\u0448\u043E\u0433\u043E, \u0438 \u043F\u0440\u0438 \u0442\u043E\u043C\u044A
    \u0437\u0430\u0440\u0430\u0437\u044A \u0442\u0440\u043E\u0445\u0443 \u043D\u0438\u0436\u0435\u0438
    \u043C\u0435\u0447\u044A \u0433\u043E\u043B\u044B\u0438 \u0447\u0438\u0440\u0432\u043E\u043D\u044B\u0438,
    \u0448\u0442\u043E \u0441\u0435 \u043C\u0430\u0435\u0442\u044C \u0440\u043E\u0437\u0443\u043C\u0435\u0442\u044C
    \u043A\u0440\u0432\u0430\u0432\u044B\u0438. \u0418 \u0442\u0430\u043A\u043E\u0432\u0430\u0433\u043E
    \u0433\u0435\u0440\u044A\u0431\u0443 \u043F\u0435\u0447\u0430\u0442\u044C \u0442\u043E\u043C\u0443
    \u043C\u0435\u0441\u0442\u0443 \u043D\u0430\u0434\u0430\u0435\u043C\u044A, \u0443\u0442\u0432\u0435\u0440\u044A\u0436\u0430\u0435\u043C\u044A
    \u0438 \u0432 \u0441\u0435\u043C \u043B\u0438\u0441\u0442\u0435 \u043D\u0430\u0448\u043E\u043C
    \u0432\u044B\u043C\u0430\u043B\u0435\u0432\u0430\u0442\u044C \u0435\u0441\u043C\u043E
    \u043A\u0430\u0437\u0430\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u044E
    \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0432\u0440\u0430\u0434 \u043E\u043D\u043E\u0433\u043E
    \u043C\u0435\u0441\u0442\u0430 \u0443 \u0441\u0443\u0434\u043E\u0432\u044A \u0438
    \u0432 \u044B\u043D\u0448\u0438\u0445\u044A \u0441\u043F\u0440\u0430\u0432\u0430\u0445
    \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u0430\u0445\u044C \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0445\u044A
    \u043F\u0435\u0447\u0430\u0442\u043E\u0432\u0430\u0442\u044C \u0438 \u0442\u043E\u0433\u043E
    \u0433\u0435\u0440\u0431\u0443 \u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
    \u0443\u0436\u0438\u0432\u0430\u0442\u0438 \u043C\u0430\u0435\u0442\u044C \u0432\u0435\u0447\u043D\u044B\u043C\u0438
    \u0447\u0430\u0441\u044B.   11. \u0418\u0436\u044A \u0442\u0435\u0436\u044A \u043C\u0435\u0441\u0442\u0430
    \u043D\u0430\u0448\u0438 \u0443\u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0432\u0430\u043D\u044B\u0435
    \u0434\u043B\u0430 \u043E\u0437\u0434\u043E\u0431\u044B \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u0435
    \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A\u0438 \u043C\u0430\u044E\u0442\u044C,
    \u0442\u043E\u0433\u0434\u044B \u043C\u044B \u0442\u0435\u0436\u044A \u0438 \u0442\u043E\u043C\u0443
    \u043C\u0435\u0441\u0442\u0443 \u043D\u0430\u0448\u043E\u043C\u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u0443
    \u043C\u0435\u0436\u0438 \u0438\u043D\u044A\u0448\u0438\u043C\u0438 \u043E\u0437\u0434\u043E\u0431\u0430\u043C\u0438
    \u0438 \u0442\u043E\u0442\u044C \u043A\u043B\u0435\u0438\u043D\u043E\u0442\u044A,
    \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A, \u043F\u043E\u0434\u044A \u0442\u044B\u043C\u044A
    \u0436\u0435 \u0432\u044B\u0448\u0435\u0438 \u043C\u0435\u043D\u0435\u043D\u044B\u043C\u044A
    \u0433\u0435\u0440\u044A\u0431\u043E\u043C\u044A \u043D\u0430\u0434\u0430\u0435\u043C\u044A
    \u0438 \u0443 \u0432\u0435\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B \u0443\u0442\u0432\u0435\u0440\u044A\u0436\u0430\u0435\u043C\u044A.
    \u041C\u0430\u044E\u0442\u044C \u043C\u0435\u0449\u0430\u043D\u0435 \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0435
    \u0442\u043E\u0435 \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A\u0438 \u0437\u0430
    \u0441\u043F\u0440\u0430\u0432\u043E\u044E \u0443\u0440\u0430\u0434\u0443 \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u043E\u0433\u043E
    \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E \u0443\u0436\u0438\u0432\u0430\u0442\u0438,
    \u0430 \u043F\u043E\u0434\u0447\u0430\u0441\u044A \u043F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0433\u043E
    \u0440\u0443\u0448\u0435\u043D\u044C\u044F \u043F\u043E\u0442\u0440\u0435\u0431\u044B
    \u0432\u043E\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u0438 \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A\u0438
    \u0437\u0435\u043C\u044A\u0441\u043A\u043E\u0438 \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0438
    \u0441 \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A\u044E \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u044E
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u044E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438\u0441\u0435
    \u0438, \u043D\u0438\u043A\u043E\u0442\u043E\u0440\u044B\u0445\u044A \u043D\u0435\u0437\u0433\u043E\u0434\u044A
    \u0438 \u0440\u043E\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u044C\u044F \u043D\u0435
    \u0443\u0436\u0438\u0432\u0430\u044E\u0447\u044B, \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A
    \u0437\u0435\u043C\u044A\u0441\u043A\u0443\u044E \u043F\u043E\u0432\u0435\u0442\u043E\u0432\u0443\u044E
    \u0438 \u0441\u0442\u0430\u043D\u044A \u0440\u044B\u0446\u0435\u0440\u0441\u043A\u0438\u0438
    \u0448\u043B\u044F\u0445\u0435\u0442\u0441\u043A\u0438\u0438 \u0432\u044A \u0437\u0432\u044B\u043A\u043B\u043E\u043C\u044A
    \u0443\u0448\u0430\u043D\u043E\u0432\u0430\u043D\u044C\u044E \u0438 \u0443\u0447\u0442\u0438\u0432\u043E\u0441\u0442\u0438
    \u043C\u0430\u044E\u0447\u044B, \u043E\u0442\u043F\u043E\u0440\u044A \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044E
    \u0437\u043E\u0434\u044A\u043D\u043E\u0433\u043E \u0434\u043E\u0432\u0430\u0442\u0438.  
    12. \u0418 \u043B\u044E\u0434\u0435\u043C\u044A \u0442\u0435\u0436\u044A \u0440\u0435\u043C\u0435\u0441\u043D\u044B\u043C\u044A
    \u043A\u043E\u0436\u0434\u043E\u043C\u0443 \u0446\u0435\u0445\u0443 \u0441\u0432\u043E\u044E
    \u0445\u043E\u0440\u0443\u0433\u043E\u0432\u044A \u0432 \u0442\u043E\u043C\u044A
    \u043C\u0435\u0441\u0442\u0435 \u0437\u0430 \u0441\u043F\u0440\u0430\u0432\u043E\u044E
    \u0438 \u0432\u0435\u0434\u043E\u043C\u043E\u0441\u0442\u044C\u044E \u0432\u0440\u0430\u0434\u0443
    \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u0433\u043E \u043C\u0435\u0442\u044C
    \u043F\u043E\u0437\u0432\u0430\u043B\u044F\u0435\u043C \u0438 \u0432\u0435\u0447\u043D\u0435
    \u0443\u0442\u0432\u0435\u0440\u0436\u0430\u0435\u043C\u044A.   13. \u0410 \u0448\u0442\u043E
    \u0441\u0435 \u0434\u043E\u0442\u044B\u0447\u0435\u0442 \u0432\u0438\u043D\u044A
    \u0441\u0443\u0434\u043E\u0432\u044A \u043F\u0440\u0430\u0432\u0430 \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u0433\u043E,
    \u0432 \u0442\u043E\u043C\u044A \u043C\u0435\u0441\u0442\u0435 \u0442\u0430\u043A\u044A
    \u0445\u043E\u0432\u0430\u0442\u044C \u0443\u0441\u0442\u0430\u0432\u0443\u0435\u043C\u044A,
    \u044F\u043A\u043E \u0442\u043E\u0435 \u043F\u0440\u0430\u0432\u043E \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0435[4]
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u0435
    \u0443\u0447\u0438\u0442\u044C.   14. \u041E\u0442\u0447\u0438\u0437\u043D\u044B
    \u0438\u0445\u044A, \u0444\u043E\u043B\u0432\u0430\u0440\u044A\u043A\u0438, \u0438\u043C\u0435\u043D\u044C\u044F,
    \u0441\u0435\u043B\u0430, \u043F\u043E\u043B\u044F \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u0438\u0435,
    \u0437\u0434\u0430\u0432\u043D\u0430 \u0442\u044B\u043C \u043C\u0435\u0449\u0430\u043D\u043E\u043C\u044A
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u043C\u044A \u043D\u0430\u043B\u0435\u0436\u0430\u0447\u0438\u0435,
    \u0438 \u043F\u0443\u0449\u0438 \u0442\u044B\u0445\u044A, \u044F\u043A\u043E
    \u0445\u0442\u043E \u0447\u043E\u0433\u043E \u043F\u0435\u0440\u0430\u0434 \u0442\u044B\u043C\u044A
    \u0443\u0436\u0438\u0432\u0430\u043B\u044A, \u0442\u0430\u043A\u044A \u0438 \u043D\u0430
    \u0432\u0441\u0438 \u043F\u043E\u0442\u043E\u043C\u043D\u044B\u0435 \u0432\u0435\u0447\u043D\u044B\u0435
    \u0447\u0430\u0441\u044B \u0443\u0436\u0438\u0432\u0430\u0442\u0438 \u043C\u0430\u0435\u0442\u044C
    \u043F\u043E\u0434\u044A \u043F\u0440\u0430\u0432\u043E\u043C\u044A \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u0441\u043A\u0438\u043C\u044A
    \u0438 \u0437\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044B\u043E \u0432\u0440\u0430\u0434\u0443
    \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0433\u043E \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E
    \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u043E\u0433\u043E.   15. \u041A\u0443
    \u0442\u043E\u043C\u0443 \u0442\u0435\u0436\u044A \u043A\u0440\u0430\u043C\u044A\u043D\u0438\u0446\u044B
    \u0438 \u043A\u043E\u043C\u043E\u0440\u044B \u0434\u043B\u044F \u0441\u043A\u043B\u0430\u0434\u0430\u043D\u044C\u044F
    \u0440\u0435\u0447\u0435\u0438 \u0438 \u0442\u043E\u0432\u0430\u0440\u043E\u0432\u044A,
    \u0442\u0430\u043A\u044A \u0442\u0435\u0436\u044A \u044F\u0442\u044A\u043A\u0438
    \u043C\u0435\u0441\u043D\u044B\u0435, \u043F\u043E\u0441\u0442\u0440\u044B\u0433\u0430\u043B\u043D\u044E,
    \u0442\u043E\u0440\u044A\u0433\u043E\u0432\u043E\u0435, \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u044A
    \u043D\u0430 \u0440\u0435\u0446\u0435 \u0414\u0432\u0438\u043D\u0435 \u0438 \u041B\u0443\u0447\u043E\u0441\u0435,
    \u043B\u0430\u0437\u043D\u044E \u043C\u0435\u0441\u0442\u0441\u043A\u0443\u044E
    \u043D\u0430 \u043F\u043E\u0436\u0438\u0442\u043E\u043A\u044A \u0442\u043E\u0433\u043E
    \u043C\u0435\u0441\u0442\u0430 \u0437\u0431\u0443\u0434\u043E\u0432\u0430\u0442\u0438
    \u0442\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443 \u043D\u0430\u0434\u0430\u0435\u043C\u044A.  
    16. \u0414\u043E\u043C\u044A \u0442\u0435\u0436\u044A \u0433\u043E\u0441\u0442\u0438\u043D\u044A\u043D\u044B\u0438,
    \u0434\u043B\u044F \u043B\u044E\u0434\u0435\u0438 \u043F\u0440\u0438\u0435\u0436\u0434\u0447\u0438\u0445\u044A
    \u043A\u0443\u043F\u0435\u0446\u044A\u043A\u0438\u0445\u044A \u0437\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u044B\u0438,
    \u0437 \u0432\u0430\u0433\u043E\u044E \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u044E,
    \u0432\u043E\u0434\u043B\u0435 \u043F\u0435\u0440\u0432\u044A\u0448\u043E\u0433\u043E
    \u0434\u0430\u0432\u043D\u0435\u0433\u043E \u0437\u0432\u044B\u0447\u0430\u044E
    \u0438\u0445\u044A, \u0438 \u043F\u043E\u043C\u0435\u0440\u044A\u043D\u043E\u0435
    \u043E\u0442 \u0437\u0431\u043E\u0436\u044F \u0432\u0448\u0435\u043B\u044F\u043A\u043E\u0433\u043E
    \u043F\u043E\u0434\u044A \u0441\u043F\u0440\u0430\u0432\u0443, \u043F\u043E\u0436\u0438\u0442\u043E\u043A\u044A
    \u0438 \u043F\u0440\u0438\u0441\u0443\u0434\u044A \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0438
    \u043F\u0440\u0438\u043B\u0443\u0447\u0430\u0435\u043C\u044A \u0438 \u043F\u043E\u0434\u0434\u0430\u0435\u043C\u044A
    \u0432\u0435\u0447\u043D\u044B\u043C\u0438 \u0447\u0430\u0441\u044B.   17. \u0414\u043E
    \u0442\u043E\u0433\u043E \u044F\u043A\u043E \u0437 \u0434\u0430\u0432\u043D\u044B\u0445\u044A
    \u0447\u0430\u0441\u043E\u0432\u044A \u043E\u0442 \u043F\u0440\u043E\u0434\u043A\u043E\u0432\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A, \u043A\u043E\u0440\u043E\u043B\u0435\u0438
    \u0438\u0445\u044A \u043C\u043B\u0441\u0442\u0438 \u043F\u043E\u043B\u044C\u0441\u043A\u0438\u0445\u044A
    \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u0445\u044A \u043A\u043D\u0437\u0435\u0438
    \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u0445\u044A, \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0438
    \u043C\u0435\u0441\u0442\u0430 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u044E\u0442\u044C \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u044F
    \u0441\u043E\u0431\u0435 \u043D\u0430\u0434\u0430\u043D\u044B\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
    \u0438\u0445\u044A \u043D\u0430 \u0432\u0435\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B
    \u043E\u0442 \u043C\u044B\u0442\u044A \u0432\u0448\u0435\u043B\u044F\u043A\u0438\u0445\u044A
    \u0432\u043E \u0432\u0441\u0438\u0445\u044A \u043F\u0430\u043D\u044A\u0441\u0442\u0432\u0430\u0445
    \u043D\u0430\u0448\u0438\u0445\u044A \u0432\u043E\u043B\u043D\u044B\u043C\u0438
    \u0443\u0447\u044B\u043D\u0435\u043D\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u0438 \u043E\u043D\u0438 \u0438 \u0434\u043E
    \u0441\u0438\u0445 \u0447\u0430\u0441\u043E\u0432\u044A \u0441\u043F\u043E\u043A\u043E\u0438\u043D\u0435
    \u0443\u0436\u0438\u0432\u0430\u044E\u0442\u044C, \u0442\u043E\u0433\u0434\u044B
    \u0438 \u0442\u044B\u043C\u044A \u0442\u0435\u043F\u0435\u0440\u0435\u0448\u043D\u0438\u043C\u044A
    \u043F\u0440\u0438\u0432\u0438\u043B\u044C\u0435\u043C\u044A, \u0432\u043E\u0434\u043B\u0443\u0433\u044A
    \u0442\u044B\u0445 \u0436\u0435 \u043F\u0440\u0438\u0432\u0438\u043B\u044C\u0435\u0432\u044A
    \u043F\u0440\u043E\u0434\u044A\u043A\u043E\u0432\u044A \u043D\u0430\u0448\u0438\u0445\u044A
    \u0438 \u0432\u043E\u0434\u043B\u0443\u0433\u044A \u0443\u0436\u0438\u0432\u0430\u043D\u044C\u044F
    \u0438\u0445\u044A, \u043E\u0442 \u043F\u043B\u0430\u0447\u0435\u043D\u044C\u044F
    \u043C\u044B\u0442\u044A \u0441\u0442\u0430\u0440\u044B\u0445 \u0432\u043E \u0432\u0441\u0438\u0445\u044A
    \u043F\u0430\u043D\u044A\u0441\u0442\u0432\u0430\u0445\u044A \u043D\u0430\u0448\u0438\u0445\u044A
    \u2014 \u0432 \u041A\u043E\u0440\u0443\u043D\u0435 \u041F\u043E\u043B\u0441\u043A\u043E\u0438,
    \u0438 \u0412\u0435\u043B\u0438\u043A\u043E\u043C\u044A \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0435
    \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u043C\u044A, \u0438 \u0432\u044A
    \u0437\u0435\u043C\u043B\u0438 \u041B\u0438\u0444\u043B\u044F\u043D\u0442\u044A\u0441\u043A\u043E\u0438,
    \u0432 \u043C\u0435\u0441\u0442\u0435\u0445\u044A \u043D\u0430\u0448\u0438\u0445,
    \u043A\u043D\u044F\u0437\u0441\u043A\u0438\u0445\u044A, \u043F\u0430\u043D\u044C\u0441\u043A\u0438\u0445\u044A,
    \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u0445\u044A \u0438 \u0441\u0432\u0435\u0442\u0441\u043A\u0438\u0445\u044A,
    \u0438 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445 \u043A\u0443\u043F\u044A\u0446\u043E\u0432\u044A
    \u043C\u0435\u0441\u0442\u0430 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E
    \u0432\u044B\u0437\u0432\u0430\u043B\u044F\u0435\u043C\u044A \u0438 \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u044C
    \u0438\u043C\u044A \u0432 \u0442\u043E\u043C\u044A \u0437\u0434\u0430\u0432\u043D\u0430
    \u043D\u0430\u0434\u0430\u043D\u0443\u044E \u0443\u0442\u0432\u0435\u0440\u044A\u0436\u0430\u0435\u043C\u044A.  
    18. \u041A\u0443 \u0442\u043E\u043C\u0443 \u0442\u0435\u0436\u044A \u0432\u0441\u0438
    \u043F\u043E\u0436\u0438\u0442\u043A\u0438 \u0438 \u0434\u043E\u0445\u043E\u0434\u044B,
    \u0442\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u0443
    \u0437\u0434\u0430\u0432\u043D\u0430 \u043D\u0430\u043B\u0435\u0436\u0430\u0447\u0438\u0435,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043E\u043D\u0438 \u0438 \u0434\u043E
    \u0441\u0438\u0445\u044A \u0447\u0430\u0441\u043E\u0432 \u0432 \u0443\u0436\u0438\u0432\u0430\u043D\u044C\u044E
    \u0431\u044B\u043B\u0438 \u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0442
    \u0432\u043E\u0435\u0432\u043E\u0434 \u043D\u0430\u0448\u0438\u0445\u044A \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0445\u044A
    \u0438 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u043E\u0432\u044A
    \u0438\u0445\u044A \u043D\u0430 \u043D\u0438\u0445\u044A \u043D\u0430\u0434\u044A
    \u043F\u0440\u0430\u0432\u0430 \u0438 \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u0438
    \u0438\u0445\u044A \u0432\u044B\u0442\u0435\u0433\u0438\u0432\u0430\u043D\u043E
    \u0438 \u0437 \u043C\u0443\u0441\u0443 \u0431\u0440\u0430\u043D\u043E, \u044F\u043A\u043E
    \u0441\u0442\u0440\u0443\u0433\u043E\u0432\u043E\u0435, \u0447\u043E\u043B\u044A\u043D\u043E\u0432\u043E\u0435,
    \u0432\u043E\u0437\u043E\u0432\u043E\u0435, \u0443\u0437\u0432\u0435\u0441\u0442\u043A\u0438
    \u0438 \u043A\u0432\u0438\u0442\u043E\u0432\u043E\u0435, \u043A\u0433\u0434\u044B
    \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0443 \u0435\u0434\u0443\u0442\u044C,
    \u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0443, \u043D\u0430 \u041B\u0443\u0436\u043E\u0441\u043D\u0435,
    \u0443 \u0421\u0443\u0440\u0430\u0436\u0443 \u0438 \u043D\u0430 \u0412\u0435\u043B\u0438\u0436\u0443,
    \u0442\u0430\u043A\u044A\u0436\u0435 \u0438 \u0442\u044B\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u043B\u0430\u0441\u043D\u0435 \u0431\u0440\u0430\u0442\u044C \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u0438,
    \u044F\u043A\u043E \u043F\u0435\u0440\u0435\u0441\u0443\u0434\u044B, \u0432\u0438\u043D\u044B
    \u0438 \u0432\u0441\u0438 \u0438\u043D\u044A\u0448\u0438\u0435 \u043F\u043E\u0436\u0438\u0442\u043A\u0438,
    \u0434\u043E\u0445\u043E\u0434\u044B \u0442\u0435\u043F\u0435\u0440\u0435\u0448\u043D\u0438\u043C\u044A
    \u043B\u0438\u0441\u0442\u043E\u043C \u043F\u0440\u0438\u0432\u0438\u043B\u044C\u0435\u043C\u044A
    \u043D\u0430\u0448\u0438\u043C\u044A \u0438\u043C\u044A \u0432\u0435\u0447\u043D\u0435
    \u0434\u0430\u0435\u043C\u044A \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0430\u0435\u043C\u044A.
    \u041C\u0430\u044E\u0442\u044C \u043E\u043D\u0438 \u0442\u044B\u0445\u044A \u0432\u0441\u0438\u0445\u044A
    \u043F\u043E\u0436\u0438\u0442\u043A\u043E\u0432\u044A, \u0432 \u0442\u043E\u043C\u044A
    \u043F\u0440\u0438\u0432\u0438\u043B\u044C\u044E \u043F\u043E\u043C\u0435\u043D\u0435\u043D\u044B\u0445,
    \u044F\u043A\u043E \u0438 \u0442\u044B\u0445\u044A, \u043A\u043E\u0442\u043E\u0440\u044B\u0445\u044A
    \u0432 \u0434\u0435\u0440\u0436\u0430\u043D\u044C\u044E \u0434\u043E \u0442\u043E\u0433\u043E
    \u0447\u0430\u0441\u0443 \u0431\u044B\u043B\u0438, \u0438 \u043D\u0430\u043F\u043E\u0442\u043E\u043C\u044A
    \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u0442\u0438 \u043C\u043E\u0433\u0443\u0442\u044C
    \u043D\u0430 \u0432\u0440\u0430\u0434 \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0438
    \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u043A\u0438\u0438 \u0438 \u043A\u0443
    \u0440\u0430\u0442\u0443\u0448\u0443 \u043D\u0430 \u043F\u043E\u0436\u0438\u0442\u043E\u043A\u044A
    \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0438 \u0443\u0436\u0438\u0432\u0430\u0442\u0438
    \u043D\u0430 \u0432\u0441\u0438 \u043F\u043E\u0442\u043E\u043C\u043D\u044B\u0435
    \u0447\u0430\u0441\u044B.   19. \u0410 \u0437\u0430 \u0442\u043E \u043C\u0435\u0449\u0430\u043D\u0435
    \u043C\u0435\u0441\u0442\u0430 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E
    \u0440\u0430\u0442\u0443\u0448\u044A \u043A\u0443 \u043E\u0437\u0434\u043E\u0431\u0435
    \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u0438 \u0431\u0443\u0434\u043E\u0432\u0430\u0442\u0438
    \u0438 \u0444\u0443\u043D\u044A\u0434\u043E\u0432\u0430\u0442\u0438 \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438
    \u0431\u0443\u0434\u0443\u0442\u044C.   20. \u041D\u0430 \u0443\u043B\u0438\u0446\u0430\u0445\u044A
    \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0445\u044A, \u0433\u0434\u0435 \u0431\u044B
    \u043A\u043E\u043B\u0432\u0435\u043A\u044A \u043F\u043E\u0442\u0440\u0435\u0431\u0430
    \u0442\u043E\u0433\u043E \u0431\u044B\u043B\u0430, \u043C\u043E\u0441\u0442 \u043C\u043E\u0441\u0442\u0438\u0442\u0438
    \u0430\u0431\u043E \u0431\u0440\u0443\u043A\u043E\u0432\u0430\u0442\u0438 \u0438
    \u043E\u043F\u0430\u0442\u0440\u043E\u0432\u0430\u0442\u0438 \u043C\u0430\u044E\u0442\u044C
    \u0437\u0430 \u0441\u043F\u0440\u0430\u0432\u043E\u044E \u0438 \u0434\u043E\u0437\u043E\u0440\u043E\u043C\u044A
    \u0432\u0440\u044F\u0434\u0443 \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u043E\u0433\u043E
    \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0433\u043E \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E.  
    21. \u0410 \u0438\u0436\u044A \u0442\u0435\u0436\u044A \u043F\u0440\u0435\u0440\u0435\u0447\u043E\u043D\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E \u043D\u0430\u0448\u043E \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0435
    \u0437 \u0434\u0430\u0432\u043D\u044B\u0445\u044A \u0447\u0430\u0441\u043E\u0432\u044A
    \u043E\u0442 \u043F\u0440\u043E\u0434\u043A\u043E\u0432\u044A \u043D\u0430\u0448\u0438\u0445\u044A
    \u043C\u0435\u0436\u0438 \u0438\u043D\u044A\u0448\u0438\u043C\u0438 \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0438 \u0442\u043E \u043E\u0431\u044A\u0432\u0430\u0440\u043E\u0432\u0430\u043D\u043E
    \u043C\u0430\u0435\u0442\u044C, \u0436\u0435 \u043A\u043D\u0437\u0435\u043C\u044A,
    \u043F\u0430\u043D\u043E\u043C\u044A, \u0448\u043B\u044F\u0445\u0442\u0435 \u043C\u0435\u0449\u0430\u043D\u044A
    \u0441\u0432\u043E\u0438\u0445 \u0432 \u043C\u0435\u0441\u0442\u0435 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u044A
    \u043D\u0435 \u0432\u043E\u043B\u043D\u043E \u043C\u0435\u0442\u044C, \u0442\u043E\u0433\u0434\u044B
    \u043C\u044B \u044F\u043A\u043E \u043F\u0440\u0438 \u0432\u0441\u0438\u0445\u044A
    \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u044F\u0445\u044A, \u0442\u0430\u043A\u044A
    \u0438 \u043F\u0440\u0438 \u0442\u043E\u043C\u044A \u043F\u0440\u0430\u0432\u0435
    \u0438\u0445\u044A \u0432 \u0446\u0435\u043B\u043E\u0441\u0442\u0438 \u0437\u043E\u0441\u0442\u0430\u0432\u0443\u044E\u0447\u044B,
    \u0443\u0442\u0432\u0435\u0440\u044A\u0436\u0430\u0435\u043C\u044A \u0438 \u0432\u0435\u0447\u043D\u044B\u043C\u0438
    \u0447\u0430\u0441\u044B \u043C\u0435\u0442\u0438 \u0445\u043E\u0447\u0435\u043C\u044A,
    \u0430\u0431\u044B \u043D\u0438\u0445\u044A\u0442\u043E \u0432\u0448\u0435\u043B\u044F\u043A\u043E\u0433\u043E
    \u0441\u0442\u0430\u043D\u0443 \u043B\u044E\u0434\u0435\u0438 \u043E\u0442 \u0432\u044B\u0448\u044A\u0448\u043E\u0433\u043E
    \u0434\u043E \u043D\u0430\u043C\u0435\u043D\u044A\u0448\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u0443
    \u0432 \u043F\u043E\u043C\u0435\u043D\u0435\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u043D\u0430\u0448\u043E\u043C\u044A \u0438 \u043D\u0430 \u043F\u044A\u0440\u0435\u0434\u043C\u0435\u0441\u0442\u044C\u044F\u0445\u044A
    \u0441\u043E\u0431\u0435 \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0430\u0449\u0430\u043B
    \u0438 \u043D\u0435 \u043C\u0435\u043B, \u043A\u0433\u0434\u044B\u0436\u044A
    \u043C\u043D\u043E\u0433\u0438\u043C\u0438 \u044E\u0440\u0438\u0437\u0434\u0438\u0446\u044B\u044F\u043C\u0438
    \u0438 \u0437\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u043C\u0435\u0441\u0442\u0430 \u043D\u0438\u0449\u0435\u044E\u0442\u044C. \u042F\u043A\u043E
    \u0436\u044A \u0438 \u043F\u043E \u0434\u0430\u0442\u0435 \u0441\u0435\u0433\u043E
    \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u044E \u043D\u0430\u0448\u043E\u0433\u043E
    \u043D\u0438\u043A\u043E\u0433\u043E \u0438 \u043D\u0438\u043A\u043E\u0442\u043E\u0440\u044B\u0445\u044A
    \u0434\u043E\u0431\u0440\u044A \u043E\u0442 \u044E\u0440\u0438\u0437\u0434\u0438\u0446\u044B\u0438
    \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u0435 \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0435
    \u0432\u044B\u043B\u0443\u0447\u0430\u0442\u0438 \u0438 \u0432\u044B\u0437\u0432\u0430\u043B\u044F\u0442\u0438
    \u043D\u0435 \u043C\u0430\u0435\u043C\u044A \u0438 \u043D\u0438\u043A\u043E\u043C\u0443
    \u0436\u0430\u0434\u043D\u044B\u0445\u044A \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0435\u0432\u044A
    \u0437 \u0443\u0438\u043C\u043E\u044E \u0432\u043B\u0430\u0434\u0437\u044B \u0437\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0432\u0440\u0430\u0434\u0443 \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0433\u043E
    \u0438 \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u0433\u043E
    \u043C\u0435\u0441\u0442\u0441\u043A\u043E\u0433\u043E \u0434\u0430\u0432\u0430\u0442\u0438
    \u043D\u0435 \u0431\u0443\u0434\u0435\u043C\u044A. \u0410 \u0445\u043E\u0442\u044F
    \u0431\u044B \u0445\u0442\u043E \u0438 \u043E\u0434\u0435\u0440\u0436\u0430\u043B\u044A
    \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0438 \u043E\u0442 \u043D\u0430\u0441\u044A,
    \u0441\u0435\u043C\u0443 \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u044E \u043D\u0430\u0448\u043E\u043C\u0443
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u044B\u0438, \u0442\u043E\u0433\u0434\u044B
    \u0442\u0430\u043A\u043E\u0432\u044B\u0438 \u043D\u0438\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043C\u043E\u0446\u044B \u0432 \u043A\u043E\u0436\u044A\u0434\u043E\u043C \u0441\u0443\u0434\u0435
    \u0438 \u043C\u0435\u0441\u0442\u0446\u0443 \u043C\u0435\u0442\u0438 \u043D\u0435
    \u043C\u0430\u0435\u0442\u044C, \u0430\u043B\u0435 \u0441\u0435\u0441\u044C \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0438
    \u043D\u0430\u0448\u044A \u044F\u043A\u043E \u0432\u043E \u0432\u0441\u0435\u043C,
    \u0442\u0430\u043A\u044A \u0438 \u0432 \u0442\u043E\u043C\u044A \u043F\u043E\u043C\u0435\u043D\u0435\u043D\u043E\u043C\u044A
    \u0430\u0440\u044A\u0442\u044B\u043A\u0443\u043B\u0435, \u043C\u043E\u0446\u043D\u043E
    \u0434\u0435\u0440\u0436\u0430\u043D\u044A \u0431\u044B\u0442\u0438\u0438 \u043C\u0430\u0435\u0442\u044C.
    \u0410 \u0433\u0434\u0435 \u0431\u044B \u043A\u043E\u0442\u043E\u0440\u044B\u0438
    \u0448\u043B\u044F\u0445\u044A\u0442\u0438\u0447\u044A \u043E\u0442 \u0432\u044B\u0448\u044A\u0448\u043E\u0433\u043E
    \u0434\u043E \u043C\u043D\u0435\u0438\u0448\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u0443,
    \u0437\u0430\u0440\u043E\u0432\u043D\u043E \u0432 \u0442\u043E\u043C\u044A \u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0447\u044B,
    \u043E\u0441\u0435\u043B\u043E\u0441\u0442\u0438 \u0432 \u043C\u0435\u0441\u0442\u0435
    \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u044A \u0430\u0431\u043E
    \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043C\u0435\u0441\u0442\u044C\u044E
    \u043D\u0430\u0431\u044B\u043B\u044A, \u0442\u043E\u0433\u0434\u044B \u0441 \u0442\u043E\u044E
    \u043E\u0441\u0435\u043B\u043E\u0441\u0442\u044C\u044E \u043D\u0435 \u0438\u043D\u044A\u0448\u043E\u043C\u0443,
    \u0430\u043B\u0435 \u0442\u043E\u043C\u0443 \u043F\u0440\u0430\u0432\u0443 \u0438
    \u044E\u0440\u0438\u0437\u044A\u0434\u044B\u0446\u044B\u0438 \u0432\u0440\u0430\u0434\u0443
    \u043C\u0435\u0441\u0442\u044C\u0441\u043A\u043E\u0433\u043E \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0433\u043E
    \u0432\u043E \u0432\u0441\u0435\u043C \u043F\u043E\u0434\u044A\u043B\u0435\u0433\u0430\u0442\u0438
    \u0438 \u0432\u0448\u0435\u043B\u044F\u043A\u0438\u0435 \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u0440\u043E\u0432\u043D\u043E \u0437\u043E \u0432\u0441\u0438\u043C\u0438
    \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0438 \u0432\u044B\u043A\u043E\u043D\u044B\u0432\u0430\u0442\u0438
    \u043F\u043E\u0432\u0438\u043D\u0435\u043D\u044A \u0431\u0443\u0434\u0435\u0442\u044C.  
    22. \u0415\u0441\u0442\u043B\u0438 \u0436\u0435 \u0442\u0435\u0436\u044A \u043B\u044E\u0434\u0438
    \u0440\u043E\u0437\u043D\u044B\u0445\u044A \u0441\u0442\u0430\u043D\u043E\u0432\u044A
    \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u0445\u044A \u0438 \u0441\u0432\u0435\u0442\u0441\u043A\u0438\u0445\u044A
    \u044F\u043A\u0438\u043C\u044A \u043A\u043E\u043B\u0432\u0435\u043A\u044A \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C\u044A
    \u0432 \u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u043D\u0430\u0448\u043E\u043C\u044A
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C\u044A \u0438 \u043D\u0430
    \u043F\u044A\u0440\u0435\u0434\u043C\u0435\u0441\u0442\u044F\u0445 \u043E\u0441\u0435\u043B\u043E\u0441\u0442\u0438
    \u0441\u0432\u043E\u0438 \u043C\u0430\u044E\u0442 \u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0442\u0435\u0436\u044A \u043A\u0443\u043F\u0435\u0446\u0442\u0432\u0430, \u0440\u0435\u043C\u0435\u0441\u043B\u0430
    \u0430\u043B\u044C\u0431\u043E \u0442\u043E\u0440\u044A\u0433\u043E\u0432\u044A
    \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0445\u044A \u0443\u0436\u0438\u0432\u0430\u044E\u0442\u044C,
    \u0442\u043E\u0433\u0434\u044B, \u0431\u0443\u0434\u0443\u0447\u044B \u043F\u043E\u0434\u044A
    \u0442\u044B\u043C\u044A \u043F\u0440\u0430\u0432\u043E\u043C\u044A \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u0438\u043C\u044A,
    \u0437\u0430\u0436\u0438\u0432\u0430\u044E\u0447\u044B \u0438 \u0432\u0435\u0441\u0435\u043B\u0435\u0447\u0438\u0441\u044F
    \u0437 \u043D\u0435\u0433\u043E, \u043F\u043E\u0434 \u0432\u0441\u0438 \u0442\u0435\u0436\u0430\u0440\u044B
    \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0435 \u043F\u043E\u0434\u043B\u0435\u0433\u0430\u0442\u0438
    \u0438 \u0437\u0430\u0440\u043E\u0432\u043D\u043E \u0437 \u044B\u043D\u0448\u0438\u043C\u0438
    \u043C\u0435\u0449\u0430\u043D\u044B \u043D\u0430\u0448\u0438\u043C\u0438 \u0442\u0435\u0436\u0430\u0440\u044B
    \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u044A
    \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044F \u0432\u044B\u043A\u043E\u043D\u044B\u0432\u0430\u0442\u0438
    \u043C\u0430\u044E\u0442\u044C.   23. \u0410 \u043D\u0430\u0434 \u0442\u043E
    \u043A\u0443 \u043F\u043E\u0436\u0438\u0442\u043A\u0443 \u0438 \u0440\u043E\u0437\u044A\u043C\u043D\u043E\u0436\u0435\u043D\u044C\u044E
    \u0438\u0445\u044A \u043D\u0430\u0434\u0430\u043B\u0438 \u0438 \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438
    \u0435\u0441\u043C\u043E \u0432 \u0442\u043E\u043C\u044A \u0436\u0435 \u043C\u0435\u0441\u0442\u0435
    \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u044A \u044F\u0440\u043C\u0430\u0440\u043E\u043A\u044A
    \u0433\u043E\u0434\u043E\u0432\u044B\u0438 \u043E\u0434\u0438\u043D, \u043D\u0430
    \u0434\u0435\u043D \u0441\u0432\u0435\u0442\u0430\u0433\u043E \u041F\u0435\u0442\u0440\u0430,
    \u0441\u0432\u044F\u0442\u0430 \u0440\u0438\u043C\u0441\u043A\u043E\u0433\u043E,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0438 \u0447\u0435\u0440\u0435\u0437\u044A
    \u0447\u043E\u0442\u044B\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u0442\u0440\u0432\u0430\u0442\u0438
    \u043C\u0430\u0435\u0442\u044C.   24. \u0410 \u0447\u0435\u0440\u0435\u0437 \u0442\u043E\u0442
    \u044F\u0440\u044A\u043C\u0430\u0440\u043A\u044A \u0432\u0448\u0435\u043B\u044F\u043A\u043E\u0433\u043E
    \u0441\u0442\u0430\u043D\u0443 \u043B\u044E\u0434\u0438 \u043D\u0430\u0448\u0438
    \u0438 \u0447\u0443\u0436\u043E\u0437\u0435\u043C\u044A\u0446\u044B, \u0442\u0430\u043A\u044A
    \u0442\u044B\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u043E\u0440\u044A\u0433\u043E\u0432\u0430\u0442\u0438
    \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438, \u044F\u043A\u043E
    \u0438 \u0442\u044B\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043A\u0443\u043F\u043E\u0432\u0430\u0442\u0438
    \u0431\u0443\u0434\u0443\u0442\u044C, \u043D\u0438\u043A\u043E\u0442\u043E\u0440\u044B\u0445\u044A
    \u043C\u044B\u0442\u044A \u0438 \u0446\u0435\u043B \u043D\u0430\u0448\u0438\u0445\u044A
    \u0438 \u0436\u0430\u0434\u043D\u044B\u0445\u044A \u0438\u043D\u044A\u0448\u0438\u0445\u044A
    \u043D\u0438\u043A\u043E\u043C\u0443 \u0434\u0430\u0432\u0430\u0442\u0438 \u043D\u0435
    \u043C\u0430\u044E\u0442\u044C \u0438 \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438
    \u043D\u0435 \u0431\u0443\u0434\u0443\u0442\u044C.   25. \u041D\u0430 \u0442\u043E\u0442\u044A
    \u0436\u0435 \u044F\u0440\u043C\u0430\u0440\u043E\u043A\u044A \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u043C\u044A
    \u0438\u043C\u044A \u043C\u0435\u0442\u0438 \u0441\u043A\u043B\u0430\u0434 \u2014
    \u0441\u0442\u043E \u043C\u0435\u0434\u043D\u0438\u0446\u044A \u043C\u0435\u0434\u0443,
    \u0440\u043E\u0437\u044A\u0441\u044B\u0442\u0438\u0432\u0448\u0438, \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u043D\u0435
    \u0438 \u0431\u0435\u0437\u044A\u043C\u044B\u0442\u043D\u0435 \u0432\u044B\u0448\u0438\u043D\u043A\u043E\u0432\u0430\u0442\u044C.  
    26. \u0422\u043E\u0440\u044A\u0433\u0438 \u0442\u0435\u0436\u044A \u0432\u043E\u043B\u043D\u044B\u0435
    \u043A\u043E\u0436\u0434\u043E\u0433\u043E \u0434\u043D\u044F \u0432\u043E\u043B\u043D\u043E
    \u0438\u043C \u043C\u0435\u0432\u0430\u0442\u044C, \u043E\u043A\u0440\u043E\u043C\u044A
    \u0441\u0432\u044F\u0442 \u0443\u0440\u043E\u0447\u0438\u0441\u0442\u044B\u0445
    \u0438 \u043D\u0435\u0434\u0435\u043B\u0438, \u0442\u044B\u0435 \u0432\u043E\u0434\u043B\u0435
    \u043E\u0431\u0440\u0430\u0434\u0443 \u0438 \u0437\u0432\u044B\u0447\u0430\u044E
    \u043A\u043E\u0441\u0442\u0435\u043B\u0430 \u043F\u043E\u0432\u0448\u0435\u0445\u044A\u043D\u043E\u0433\u043E
    \u0440\u044B\u043C\u044A\u0441\u043A\u043E\u0433\u043E \u0431\u0435\u0437\u044A
    \u043E\u0442\u043F\u0440\u0430\u0432\u043E\u0432\u0430\u043D\u044C\u044F \u0440\u043E\u0431\u043E\u0442\u044A
    \u0438 \u0442\u043E\u0440\u044A\u0433\u043E\u0432\u044A \u0432 \u0443\u0448\u0430\u043D\u043E\u0432\u0430\u043D\u044C\u044E
    \u043E\u0442\u043F\u0440\u0430\u0432\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0443\u0435\u043C\u044A.  
    27. \u042F\u043A\u043E \u0436\u044A \u0432\u0441\u0438\u043C\u044A \u044F\u043A\u043E\u0433\u043E
    \u043A\u043E\u043B\u0432\u0435\u043A\u044A \u0441\u0442\u0430\u043D\u0443 \u043B\u044E\u0434\u0435\u043C\u044A
    \u043A\u0443\u043F\u0435\u0446\u043A\u0438\u043C\u044A, \u0444\u0443\u0440\u044A\u043C\u0430\u043D\u043E\u043C\u044A
    \u0438 \u043A\u043E\u0436\u044A\u0434\u043E\u043C\u0443 \u043F\u0440\u0438\u0435\u0436\u044A\u0434\u0447\u043E\u043C\u0443,
    \u043E\u0442\u043A\u0443\u043B\u044C \u0445\u0442\u043E \u043A\u043E\u043B\u0432\u0435\u043A\u044A
    \u0434\u043E \u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u043D\u0430\u0448\u043E\u0433\u043E
    \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E \u0441 \u0442\u043E\u0432\u0430\u0440\u044A\u043C\u0438
    \u043D\u0430 \u0442\u043E\u0440\u044A\u0433\u0438 \u0438 \u044F\u0440\u043C\u0430\u0440\u044A\u043A\u044A
    \u043F\u0440\u0438\u0435\u0434\u0435\u0442\u044C, \u0434\u0430\u0435\u043C\u044A
    \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438,
    \u043A\u0443\u043F\u043E\u0432\u0430\u0442\u0438, \u0437\u0430\u043C\u0435\u043D\u044F\u0442\u0438
    \u0438 \u0437 \u043D\u0438\u0445 \u0432\u043E\u043B\u043D\u043E \u0438 \u0431\u0435\u0437\u044A\u0431\u0435\u0447\u043D\u043E
    \u043E\u0434\u0435\u0436\u0434\u0447\u0430\u0442\u0438, \u043E\u0442\u0434\u0430\u0432\u0448\u0438
    \u0438 \u043F\u043E\u043F\u043B\u0430\u0442\u0438\u0432\u0448\u0438 \u043F\u043E\u0432\u0438\u043D\u043D\u043E\u0441\u0442
    \u043C\u0435\u0441\u0442\u0441\u043A\u0443\u044E, \u043A\u0440\u043E\u043C\u044A
    \u0442\u0430\u043A\u043E\u0432\u044B\u0445\u044A \u043B\u044E\u0434\u0435\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u044B \u0442\u0430\u043C\u044A
    \u043F\u0440\u0438\u0435\u0445\u0430\u0432\u0448\u0438 \u044F\u043A\u043E\u0433\u043E
    \u0437\u043B\u043E\u0447\u0438\u043D\u044A\u0441\u0442\u0432\u0430 \u0437\u0430\u0436\u0438\u0432\u0430\u043B\u0438,
    \u0437\u0430 \u0442\u044B\u043C\u044A \u0442\u0430\u043A\u043E\u0432\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430 \u0438 \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u0438
    \u0443\u0436\u0438\u0432\u0430\u0442\u0438 \u0438 \u0442\u043E\u0432\u0430\u0440\u044B\u0448\u044A\u0441\u0442\u0432\u0430
    \u043C\u0435\u0436\u0438 \u043B\u044E\u0434\u0435\u0438 \u0434\u043E\u0431\u0440\u044B\u0445\u044A
    \u043C\u0435\u0442\u0438 \u0433\u043E\u0434\u043D\u044B\u043C\u0438 \u043D\u0435
    \u0431\u044B\u043B\u0438, \u0442\u044B\u0435 \u0442\u0430\u043A\u043E\u0432\u044B\u0445\u044A
    \u043F\u0440\u0430\u0432\u044A, \u043E\u0442 \u043D\u0430\u0441\u044A \u043F\u043E\u0434\u0430\u043D\u044B\u0445\u044A,
    \u0437\u0430\u0436\u0438\u0432\u0430\u0442\u0438 \u043D\u0435 \u043C\u0430\u044E\u0442\u044C.  
    28. \u0412\u0435\u0434 \u0436\u0435 \u043A\u0443\u043F\u044A\u0446\u044B \u043F\u0440\u0438\u0435\u0436\u0434\u0447\u0438\u0435
    \u043D\u0435 \u043E\u0431\u044A\u0447\u0438\u043C\u044A \u043A\u0443\u043F\u0446\u043E\u043C\u044A,
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0443\u043F\u044A\u0446\u043E\u043C\u044A
    \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u043C\u044A \u043C\u0435\u0441\u0442\u0430
    \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E \u0432\u0441\u044F\u043A\u0438\u0435
    \u0442\u043E\u0432\u0430\u0440\u044B \u043E\u0433\u0443\u043B\u043E\u043C\u044A
    \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438 \u043C\u0430\u044E\u0442\u044C.
    \u0410 \u043E\u043D\u0438 \u0437\u0430\u0441, \u043A\u0443\u043F\u0446\u044B
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u0435, \u043A\u043E\u0436\u0434\u043E\u043C\u0443
    \u043E\u0431\u044A\u0447\u043E\u043C\u0443 \u0438 \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
    \u0442\u0430\u043A \u0436\u0435 \u0438 \u0432\u044A \u043C\u0435\u0441\u0442\u0435
    \u043F\u043E \u0440\u043E\u0437\u043D\u0443 \u0442\u044B\u0435 \u0436\u044A \u0442\u043E\u0432\u0430\u0440\u044B
    \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438 \u0431\u0443\u0434\u0443\u0442\u044C.  
    29. \u0413\u043E\u0441\u0442\u0438 \u043F\u0440\u0438\u0435\u0436\u0434\u0447\u0438\u0435,
    \u043A\u0443\u043F\u044A\u0446\u044B \u043D\u0438\u0433\u0434\u0435 \u0438\u043D\u044A\u0434\u0435\u0438,
    \u043E\u0434\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u044A \u0432\u043E\u0438\u0442\u043E\u043C\u044A,
    \u0432\u0440\u0430\u0434\u043E\u043C \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u043C\u044A
    \u0442\u0430\u043C\u043E\u0448\u043D\u0438\u043C\u044A \u0441\u0443\u0434\u0438\u0442\u0438\u0441\u0435
    \u0438 \u0441\u043F\u0440\u0430\u0432\u044B \u0441\u0432\u043E\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043E\u0432\u0430\u0442\u0438
    \u0438 \u043A\u043E\u0436\u0434\u043E\u043C\u0443 \u0443\u043A\u0440\u0438\u0432\u0436\u043E\u043D\u043E\u043C\u0443
    \u0443\u0441\u043F\u044A\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438 \u0431\u0443\u0434\u0443\u0442\u044C
    \u043E \u0432\u0448\u0435\u043B\u044F\u043A\u0438\u0435 \u0435\u043A\u0441\u0446\u0435\u0441\u044B
    \u0438 \u0432\u044B\u0441\u0442\u0443\u043F\u044A\u043A\u0438, \u0442\u0430\u043C\u044A
    \u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0443 \u043F\u043E\u043F\u043E\u043B\u044A\u043D\u0435\u043D\u044B\u0435
    \u0438 \u0441\u0442\u0430\u043B\u044B\u0435.   30. \u0410 \u0438\u0436\u044A
    \u043A\u043E\u0436\u0434\u044B\u0438 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u044A
    \u0434\u043B\u044F \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0448\u043E\u0433\u043E
    \u043E\u0442\u043F\u0440\u0430\u0432\u043E\u0432\u0430\u043D\u044C\u044F \u0441\u043F\u0440\u0430\u0432\u044A,
    \u0432\u0440\u0430\u0434\u0443 \u0435\u0433\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u0447\u0438\u0445,
    \u0441\u043F\u043E\u043A\u043E\u0438\u043D\u043E\u0433\u043E \u043C\u0435\u0448\u043A\u0430\u043D\u044C\u044F
    \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u044C \u0438 \u0434\u043B\u044F
    \u0442\u043E\u0433\u043E \u043F\u043E\u043A\u043E\u0435\u043C \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u044B\u043C\u044A
    \u043F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u0435 \u043E\u0431\u044A\u0432\u0430\u0440\u043E\u0432\u044B\u0432\u0430\u043D\u044B
    \u0431\u044B\u0432\u0430\u044E\u0442\u044C, \u044F\u043A\u043E \u043E \u0442\u043E\u043C\u044A
    \u044F\u0441\u043D\u044B\u0438 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044A
    \u0432 \u044B\u043D\u044A\u0448\u0438\u0445\u044A \u043C\u0435\u0441\u0442\u0435\u0445\u044A
    \u043D\u0430\u0448\u0438\u0445\u044C \u0443\u043F\u0440\u0438\u0432\u0438\u043B\u044C\u0435\u0432\u0430\u043D\u044B\u0445\u044A
    \u0435\u0441\u0442\u044C, \u0442\u043E\u0433\u0434\u044B \u0438 \u0442\u043E\u043C\u0443
    \u043C\u0435\u0441\u0442\u0443 \u043D\u0430\u0448\u043E\u043C\u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u0443
    \u0437 \u043B\u0430\u0441\u043A\u0438 \u043D\u0430\u0448\u043E\u0435 \u0432\u0430\u0440\u0443\u0435\u043C\u044A,
    \u0436\u0435 \u043D\u0430 \u0440\u0430\u0442\u0443\u0448\u0443, \u0442\u0430\u043A\u044A\u0436\u0435
    \u0432 \u0434\u043E\u043C\u0435\u0445\u044A \u0432\u043E\u0438\u0442\u043E\u0432\u044A\u0441\u043A\u043E\u043C\u044A,
    \u0431\u0443\u0440\u043C\u0438\u0441\u0442\u0440\u043E\u0432\u0441\u043A\u0438\u0445\u044A,
    \u0440\u0430\u0438\u0446\u043E\u0432\u044A \u0438 \u043B\u0430\u0432\u043D\u0438\u043A\u043E\u0432
    \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u0438 \u043D\u0430\u0448\u0438, \u0436\u043E\u043B\u043D\u0435\u0440\u044B,
    \u0433\u0430\u0438\u0434\u0443\u043A\u0438, \u0441\u043B\u0443\u0433\u0438 \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u043A\u0438\u0435
    \u0432\u0440\u0430\u0434\u043E\u0432\u044B\u0435 \u0438 \u043D\u0438\u0445\u0442\u043E
    \u0437 \u0433\u043E\u0441\u0442\u0435\u0438 \u043F\u0440\u0438\u0435\u0436\u0434\u0447\u0438\u0445\u044A
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438\u0441\u0435 \u043D\u0435
    \u043C\u0430\u044E\u0442\u044C \u0438 \u043D\u0438\u043A\u043E\u043C\u0443 \u0433\u043E\u0441\u043F\u043E\u0434\u044B
    \u0443 \u043D\u0438\u0445 \u0437 \u0443\u0440\u0430\u0434\u0443 \u0437\u0430\u043F\u0438\u0441\u043E\u0432\u0430\u043D\u044B
    \u0431\u044B\u0442\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442\u044C, \u043E\u043F\u0440\u043E\u0447\u044A
    \u0441\u0430\u043C\u043E\u0435 \u0431\u044B\u0442\u043D\u043E\u0441\u0442\u0438
    \u043D\u0430\u0448\u043E\u0435 \u0433\u0441\u0434\u0440\u044A\u0441\u043A\u043E\u0435.  
    31. \u0416\u0438\u0434\u043E\u0432\u0435 \u0442\u0435\u0436\u044A \u0432 \u0442\u043E\u043C\u044A
    \u043C\u0435\u0441\u0442\u0435 \u043D\u0430\u0448\u043E\u043C\u044A \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C\u044A
    \u043D\u0438\u044F\u043A\u0438\u0445\u044A \u043E\u0441\u0435\u043B\u043E\u0441\u0442\u0435\u0438
    \u0432\u043E\u0434\u043B\u0443\u0433\u044A \u0434\u0430\u0432\u043D\u043E\u0433\u043E
    \u0437\u0432\u044B\u0447\u0430\u044E \u043C\u0435\u0442\u0438 \u043D\u0435 \u043C\u0430\u044E\u0442\u044C.  
    32. \u041B\u044E\u0434\u0435\u0438 \u0440\u0435\u043C\u0435\u0441\u0442\u043D\u044B\u0445\u044A,
    \u0437\u043E\u043B\u043E\u0442\u0430\u0440\u043E\u0432\u044A, \u043A\u0440\u0430\u0432\u044A\u0446\u043E\u0432\u044A,
    \u0441\u043B\u0435\u0441\u0430\u0440\u043E\u0432\u044A, \u043A\u043E\u0432\u0430\u043B\u0435\u0432,
    \u043A\u043E\u0442\u044A\u043B\u044F\u0440\u043E\u0432, \u0440\u0435\u0437\u043D\u0438\u043A\u043E\u0432\u044A,
    \u0441\u044B\u0440\u043E\u043C\u044F\u0442\u043D\u0438\u043A\u043E\u0432\u044A,
    \u043A\u043E\u0436\u0435\u043C\u044F\u043A, \u043F\u0435\u043A\u0430\u0440\u043E\u0432\u044A,
    \u0433\u043E\u043D\u044A\u0447\u0430\u0440\u043E\u0432\u044A, \u0448\u0435\u0432\u0446\u043E\u0432\u044A,
    \u0442\u0435\u0441\u043B\u0435\u0432\u044A, \u043A\u0443\u0448\u043D\u0435\u0440\u043E\u0432\u044A
    \u0438 \u0438\u043D\u044A\u0448\u0438\u0445\u044A \u0432\u0441\u044F\u043A\u0438\u0445\u044A
    \u0440\u0435\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u043E\u0432 \u043E\u0442
    \u0440\u043E\u0431\u043E\u0442\u044B \u0437\u0430\u043C\u044A\u043A\u043E\u0432\u043E\u0435
    \u0432\u043E\u043B\u043D\u044B\u043C\u0438 \u0447\u0438\u043D\u0438\u043C\u044A.  
    33. \u0410 \u043F\u043E\u0434\u044A\u0432\u043E\u0434 \u043F\u043E\u0434\u044A
    \u043F\u043E\u0441\u043B\u0430\u043D\u044A\u0446\u044B \u043D\u0430\u0448\u0438
    \u044F\u043A\u043E \u043F\u0435\u0440\u0435\u0434 \u0442\u044B\u043C\u044A \u043D\u0435
    \u0434\u0430\u0432\u0430\u043B\u0438, \u0442\u0430\u043A\u044A \u0438 \u0442\u0435\u043F\u0435\u0440\u044A
    \u0434\u0430\u0432\u0430\u0442\u0438 \u043D\u0435 \u043C\u0430\u044E\u0442 \u0432\u0435\u0447\u043D\u044B\u043C\u0438
    \u0447\u0430\u0441\u044B.   34. \u0410 \u043F\u043E \u0432\u044B\u0438\u0441\u0442\u044E
    \u043F\u0435\u0440\u0435\u043C\u0435\u0440\u044F, \u043F\u043E\u0434\u044A \u0447\u0430\u0441\u044A
    \u043D\u0435\u043F\u043E\u043A\u043E\u044E \u0438 \u0432\u0430\u043B\u043A\u0438
    \u0437 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0435\u043C\u044A
    \u043F\u0430\u043D\u044A\u0441\u0442\u0432\u044A \u043D\u0430\u0448\u0438\u0445\u044A,
    \u0432\u0435\u043B\u0438\u043A\u0438\u043C\u044A \u043A\u043D\u0437\u0435\u043C\u044A
    \u043C\u043E\u0441\u043A\u043E\u0432\u044A\u0441\u043A\u0438\u043C\u044A, \u0438
    \u043F\u0440\u043E\u0442\u0438\u0432\u044A \u043A\u043E\u0436\u044A\u0434\u043E\u0433\u043E
    \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044F \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0438
    \u043C\u0435\u0441\u0442\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0432\u043E\u0434\u043B\u0443\u0433\u044A \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u043E\u0433\u043E
    \u0437\u0432\u044B\u0447\u0430\u044E, \u043F\u043E\u0434 \u0441\u043F\u0440\u0430\u0432\u043E\u044E
    \u0432\u043E\u0438\u0442\u0430 \u0441\u0432\u043E\u0435\u0433\u043E \u0431\u0443\u0434\u0443\u0447\u044B,
    \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u0438 \u0432\u0441\u044E \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u043E\u0441\u0442\u044C
    \u0432\u043E\u0435\u043D\u044A\u043D\u0443\u044E \u0432\u044B\u043A\u043E\u043D\u044B\u0432\u0430\u0442\u0438
    \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u0438 \u0431\u0443\u0434\u0443\u0442\u044C.
    \u0410\u043B\u0435 \u043F\u043E\u0434 \u0447\u0430\u0441\u044A \u043F\u0430\u043A\u043E\u044E
    \u0438 \u043F\u0435\u0440\u0435\u043C\u0438\u0440\u044F \u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0435
    \u0442\u0435\u0436\u0430\u0440\u0438, \u0432\u043E\u0438\u043D\u0435 \u0438 \u043D\u0435\u0431\u0435\u0437\u044A\u043F\u0435\u0447\u0435\u043D\u044A\u0441\u0442\u0432\u0443
    \u043D\u0430\u043B\u0435\u0436\u0430\u0447\u0438\u0435, \u043E\u043D\u0438 \u043F\u0440\u0438\u043C\u0443\u0448\u0430\u043D\u0438
    \u0431\u044B\u0442\u0438\u0438 \u043D\u0435 \u043C\u0430\u044E\u0442\u044C \u0438
    \u043E\u0432\u0448\u0435\u043C\u044A \u0432 \u043F\u043E\u043A\u043E\u044E \u0437\u0430\u0445\u043E\u0432\u0430\u043D\u0438
    \u0431\u0443\u0434\u0443\u0442\u044C.   35. \u0412\u0438\u043B\u043A\u0435\u0440,
    \u0442\u043E \u0435\u0441\u0442\u044A \u0441\u043F\u043E\u0441\u043E\u0431\u044A
    \u043F\u043E\u0440\u0430\u0434\u043A\u0443 \u043F\u043E\u0432\u0438\u043D\u044A\u043D\u043E\u0441\u0442\u0435\u0438
    \u0438 \u0438\u043D\u044C\u0448\u0438\u0445\u044A \u0440\u043E\u0437\u043D\u044B\u0445\u044A
    \u0441\u043F\u0440\u0430\u0432\u044A \u043A\u0443 \u0434\u043E\u0431\u0440\u043E\u043C\u0443
    \u043F\u043E\u0441\u043F\u043E\u043B\u0438\u0442\u043E\u043C\u0443, \u043C\u0435\u0449\u0430\u043D\u043E\u043C\u044A
    \u043D\u0430\u0448\u0438\u043C\u044A \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u043C\u044A
    \u0437\u0433\u043E\u0434\u043D\u0435 \u0437 \u0432\u043E\u0438\u0442\u043E\u043C\u044A
    \u043D\u0430\u043C\u043E\u0432\u0438\u0442\u044C \u0438 \u0437\u0430\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u043C\u044A \u0438 \u043F\u043E
    \u043D\u0430\u043C\u043E\u0432\u0435\u043D\u044E \u0438 \u0437\u0430\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D\u044C\u044E
    \u0438\u0445\u044C \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0438 \u0432\u043E\u0434\u043B\u0435
    \u0442\u043E\u0433\u043E \u0441\u0435 \u0437\u0430\u0445\u043E\u0432\u0430\u0442
    \u0432\u0441\u0438\u043C\u044A \u043F\u0440\u0438\u043A\u0430\u0437\u0443\u0435\u043C\u044A
    \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0430\u0435\u043C\u044A.   36. \u0410
    \u0438\u0436\u044A \u0442\u0435\u0436\u044A \u0432 \u0442\u043E\u043C\u044A \u043C\u0435\u0441\u0442\u0435
    \u043D\u0448\u043E\u043C \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C
    \u043C\u0435\u0449\u0430\u043D\u0435 \u0442\u0430\u043C\u043E\u0448\u043D\u0438\u0435
    \u0434\u043E \u0441\u0435\u0433\u043E \u0447\u0430\u0441\u0443 \u0434\u0432\u0443\u0445
    \u043D\u0430\u0437\u0432\u0438\u0441\u043A\u044A \u0437\u0430\u0436\u0438\u0432\u0430\u043B\u0438,
    \u043E\u0434\u043D\u044B \u043A\u043E\u043D\u043D\u044B\u043C\u0438, \u0430 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043F\u043E\u0441\u043F\u043E\u043B\u0441\u0442\u0432\u043E\u043C\u044A \u0441\u0435
    \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u0438 \u043E\u0434\u043D\u044B
    \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445\u044A \u0441\u0435 \u043F\u0440\u0435\u043A\u043B\u0430\u0434\u0430\u043B\u0438,
    \u0442\u043E\u0433\u0434\u044B \u043C\u044B, \u0438\u043C\u044A \u0432\u0441\u0438\u043C\u044A
    \u0442\u043E\u0435 \u043F\u0440\u0430\u0432\u043E \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u0435
    \u043D\u0430\u0434\u0430\u044E\u0447\u044B, \u0432\u0441\u0438\u0445\u044A \u0440\u043E\u0432\u043D\u0430\u0435\u043C\u044A
    \u0442\u0430\u043A\u044A, \u0438\u0436\u044A \u0432\u0436\u043E \u043D\u0430\u0437\u0432\u0438\u0441\u043A\u044A
    \u0441\u043E\u0431\u0435 \u043D\u0438\u044F\u043A\u0438\u0445\u044A \u043D\u0435
    \u0432\u044B\u043D\u0430\u0438\u0434\u0443\u044E\u0447\u044B \u0430\u043D\u0438
    \u043E\u0434\u043D\u044B \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445\u044A
    \u043D\u0435 \u043F\u0440\u0435\u043A\u043B\u0430\u0434\u0430\u044E\u0447\u044B,
    \u0432\u0441\u0438 \u043E\u0434\u043D\u043E\u0435 \u043A\u043E\u043D\u0434\u044B\u0446\u0435\u0438
    \u0431\u044B\u0442\u0438\u0438 \u043C\u0430\u044E\u0442\u044C, \u044F\u043A\u043E
    \u0432 \u044B\u043D\u0448\u0438\u0445\u044A \u043C\u0435\u0441\u0442\u0435\u0445\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A \u0443\u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0432\u0430\u043D\u044B\u0445\u044A.  
    37. \u0414\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u043D\u044C\u044F \u0434\u043E\u0445\u043E\u0434\u043E\u0432\u044A
    \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0445\u044A \u0442\u044B\u0435 \u0436\u044A
    \u043F\u0440\u0438\u0441\u044F\u0436\u043D\u044B\u0435 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u0438
    \u043C\u0435\u0441\u0442\u0441\u043A\u0438\u0435 \u0431\u044B\u0442\u0438 \u043C\u0430\u044E\u0442\u044C,
    \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u0445\u044A \u0434\u043E\u0445\u043E\u0434\u043E\u0432\u044A
    \u0438 \u0432\u044A\u0441\u0438\u0445\u044A \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u0432\u044A
    \u0438 \u0440\u043E\u0441\u0445\u043E\u0434\u043E\u0432\u044A \u043C\u0435\u0441\u0442\u044A\u0441\u043A\u0438\u0445\u044A
    \u0432 \u043A\u043E\u0436\u0434\u044B\u0438 \u0433\u043E\u0434\u044A \u043D\u0430
    \u0434\u0435\u043D\u044C \u041D\u043E\u0432\u043E\u0433\u043E \u043B\u0435\u0442\u0430,
    \u0432\u043E\u0434\u043B\u0435 \u043A\u0430\u043B\u0435\u043D\u044A\u0434\u0430\u0440\u0443
    \u0440\u0438\u043C\u0441\u043A\u043E\u0433\u043E, \u043B\u0438\u0447\u044A\u0431\u0443
    \u043F\u0435\u0440\u0435\u0434 \u0432\u043E\u0438\u0442\u043E\u043C\u044A \u0438
    \u043F\u043E\u0441\u043F\u043E\u043B\u0441\u0442\u0432\u043E\u043C \u0447\u0438\u043D\u0438\u0442\u0438
    \u043F\u043E\u0432\u0438\u043D\u043D\u0438 \u0431\u0443\u0434\u0443\u0442\u044C.
    \u0410 \u0432\u043E\u0438\u0442\u044A, \u043B\u0438\u0447\u044A\u0431\u044B \u0432\u044B\u0441\u043B\u0443\u0445\u0430\u0432\u0448\u044B,
    \u0437 \u0432\u0435\u0434\u043E\u043C\u043E\u0441\u0442\u044E \u043F\u043E\u0441\u043F\u043E\u043B\u0441\u0442\u0432\u0430
    \u0438\u0445\u044A \u043A\u0432\u0438\u0442\u043E\u0432\u0430\u0442\u0438 \u0431\u0443\u0434\u0435\u0442\u044C.
    \u0410 \u043A\u0432\u0438\u0442\u0430\u0446\u0435\u044F \u0432\u043E\u0438\u0442\u043E\u0432\u0430
    \u0442\u0430\u043A\u044A, \u044F\u043A\u043E \u043D\u0430\u0448\u0430 \u0433\u0441\u0434\u0440\u044A\u0441\u043A\u0430\u044F
    \u0432\u0430\u0436\u043D\u0430 \u0431\u044B\u0442\u0438 \u043C\u0430\u0435\u0442\u044C.  
    \u0412 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0442\u043E\u043C\u044A \u043F\u0440\u0430\u0432\u0435
    \u043C\u0430\u0438\u0434\u0435\u0431\u043E\u0440\u044A\u0441\u043A\u043E\u043C,
    \u043E\u0442 \u043D\u0430\u0441\u044A \u043D\u0430\u0434\u0430\u043D\u043E\u043C,
    \u0442\u0430\u043A\u044A\u0436\u0435 \u0438 \u0432 \u044B\u043D\u0448\u0438\u0445\u044A
    \u0432\u0441\u0438\u0445\u044A \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u044F\u0445,
    \u043E\u0442 \u043F\u0440\u043E\u0434\u043A\u043E\u0432\u044A \u043D\u0430\u0448\u0438\u0445
    \u043D\u0430\u0434\u0430\u043D\u044B\u0445\u044A \u0438 \u043E\u0434 \u043D\u0430\u0441\u044A
    \u043F\u043E\u043F\u0440\u0438\u0441\u0435\u0436\u043E\u043D\u044B\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0445\u044A
    \u0438 \u0434\u043E \u0441\u0435\u0433\u043E \u0447\u0430\u0441\u0443 \u0432
    \u0441\u043F\u0430\u043A\u043E\u0438\u043D\u043E\u043C\u044A \u0443\u0436\u044B\u0432\u0430\u043D\u044C\u044E
    \u0431\u044B\u043B\u0438 \u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u043C\u044A
    \u0442\u0435\u043F\u0435\u0440\u044A \u043E\u0442 \u043D\u0430\u0441\u044A \u043D\u0430\u0434\u0430\u043D\u044B
    \u0438 \u0443\u0442\u0432\u0435\u0440\u044A\u0436\u043E\u043D\u044B \u0441\u0443\u0442\u044C,
    \u043F\u0440\u0435\u0440\u0435\u0447\u043E\u043D\u044B\u0445\u044A \u043C\u0435\u0449\u0430\u043D\u044A,
    \u0438 \u043E\u0431\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u0432 \u043C\u0435\u0441\u0442\u0430
    \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u0433\u043E, \u0438 \u043F\u043E\u0442\u043E\u043C\u043A\u043E\u0432\u044A
    \u0449\u0430\u0434\u043A\u043E\u0432 \u0438\u0445\u044A, \u0438 \u0442\u044B\u0445
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u044B \u043E\u0441\u0435\u043B\u043E\u0441\u0442\u0435\u0438
    \u0441\u043B\u0443\u0448\u043D\u0435 \u043F\u043E\u0442\u043E\u043C\u044A \u0442\u0430\u043C\u044A
    \u043D\u0430\u0431\u044B\u043B\u0438, \u043D\u0438\u043A\u043E\u0433\u043E \u0437
    \u043D\u0438\u0445\u044A \u043D\u0435 \u0432\u044B\u043B\u0443\u0447\u0430\u044E\u0447\u044B,
    \u0430\u043B\u0435 \u0432\u0441\u0438\u0445\u044A \u043E\u0433\u0443\u043B\u043E\u043C\u044A
    \u0432 \u043C\u0435\u0441\u0442\u0435, \u043D\u0430 \u043F\u044A\u0440\u0435\u0434\u043C\u0435\u0441\u0442\u0435\u0445\u044A
    \u043C\u0435\u0448\u043A\u0430\u044E\u0447\u044B\u0445\u044A, \u0437 \u043A\u0433\u0440\u0443\u043D\u044A\u0442\u044B
    \u0438 \u0444\u043E\u043B\u0432\u0430\u0440\u044A\u043A\u0430\u043C\u0438 \u0438\u0445\u044A
    \u043D\u0430 \u0441\u0435\u043B\u0430\u0445 \u0431\u0443\u0434\u0443\u0447\u0438\u043C\u0438,
    \u0432\u0435\u0447\u044A\u043D\u0435 \u0437\u0430\u0445\u043E\u0432\u0430\u0442\u0438
    \u0445\u043E\u0447\u0435\u043C\u044A \u0438 \u0437\u0430 \u043F\u043E\u0442\u043E\u043C\u044A\u043A\u043E\u0432\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A, \u043A\u043E\u0440\u043E\u043B\u0435\u0438
    \u043F\u043E\u043B\u0441\u043A\u0438\u0445\u044A \u0438 \u0432\u0435\u043B\u0438\u043A\u0438\u0445\u044A
    \u043A\u043D\u0437\u0435\u0438 \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u0438\u0445\u044A,
    \u043E\u0431\u0435\u0446\u0443\u0435\u043C\u044A \u0438 \u043F\u0440\u0438\u0440\u0435\u043A\u0430\u0435\u043C\u044A.
    \u0410 \u0432\u043E\u0435\u0432\u043E\u0434\u0435 \u043D\u0430\u0448\u043E\u043C\u0443
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u0443 \u0442\u0435\u043F\u0435\u0440\u0435\u0448\u043D\u0435\u043C\u0443
    \u0438 \u043D\u0430\u043F\u043E\u0442\u043E\u043C\u044A \u0431\u0443\u0434\u0443\u0447\u0438\u043C,
    \u0442\u0430\u043A\u044A\u0436\u0435 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u043C
    \u043D\u0430\u0448\u0438\u043C \u0437\u0435\u043C\u044A\u0441\u043A\u0438\u043C\u044A,
    \u0434\u0432\u043E\u0440\u043D\u044B\u043C\u044A, \u043A\u0433\u0440\u043E\u0434\u0441\u043A\u0438\u043C,
    \u0430 \u043E\u0441\u043E\u0431\u044A\u043B\u0438\u0432\u0435 \u0441\u0443\u0434\u044A\u044F\u043C\u044A
    \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u043C\u044A \u0442\u0440\u0438\u0431\u0443\u043D\u0430\u043B\u043D\u044B\u043C\u044A,
    \u0438 \u0438\u043D\u044A\u0448\u0438\u043C\u044A \u0432\u0441\u044F\u043A\u0438\u043C\u044A
    \u0441\u0443\u0434\u043E\u043C\u044A, \u0438 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u043C\u044A
    \u043D\u0430\u0448\u0438\u043C\u044A \u043F\u0440\u0438\u043A\u0430\u0437\u0443\u0435\u043C\u044A,
    \u0430\u0431\u044B \u043D\u0430\u0434 \u0442\u043E\u0435 \u043F\u0440\u0430\u0432\u043E,
    \u043E\u0434 \u043D\u0430\u0441\u044A \u043C\u0435\u0441\u0442\u0443 \u0412\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u043E\u043C\u0443
    \u043D\u0430\u0434\u0430\u043D\u043E\u0435, \u0436\u0430\u0434\u043D\u043E\u0435
    \u0442\u0440\u0443\u0434\u044A\u043D\u043E\u0441\u0442\u0438 \u043C\u0435\u0449\u0430\u043D\u043E\u043C\u044A
    \u0432\u0438\u0442\u0435\u0431\u044A\u0441\u043A\u0438\u043C\u044A \u043D\u0435
    \u0447\u0438\u043D\u0438\u043B\u0438, \u0430\u043B\u0435 \u0432\u043E \u0432\u0441\u0438\u0445\u044A
    \u0442\u044B\u0445 \u0432\u043E\u043B\u043D\u043E\u0441\u0442\u044F\u0445\u044A
    \u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u0430\u0445\u044A, \u0437\u0434\u0430\u0432\u043D\u0430
    \u0438 \u0442\u0435\u043F\u0435\u0440 \u0438\u043C\u044A \u043D\u0430\u0434\u0430\u043D\u044B\u0445\u044A,
    \u0442\u0430\u043A\u0438\u043C\u044A \u043F\u043E\u0440\u0430\u0434\u043A\u043E\u043C,
    \u044F\u043A\u043E \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u044A \u043C\u0435\u0449\u0430\u043D\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A \u0432\u0438\u043B\u0435\u043D\u044C\u0441\u043A\u0438\u0445\u044A
    \u0438 \u0438\u043D\u044A\u0448\u0438\u0445\u044A \u043C\u0435\u0441\u0442\u044A
    \u0443\u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0432\u0430\u043D\u044B\u0445\u044A
    \u0437\u0430\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u0435 \u0437\u0432\u044B\u043A\u043B\u0438,
    \u0430\u0431\u044B \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u044A \u0438\u0445\u044A
    \u0442\u0430\u043A\u044A\u0436\u0435 \u0441\u0435 \u0441\u043F\u043E\u043A\u043E\u0438\u043D\u0435
    \u0437\u0430\u0445\u043E\u0432\u0430\u043B\u0438 \u0434\u043B\u044F \u043B\u0430\u0441\u043A\u0438
    \u043D\u0430\u0448\u043E\u0435 \u0433\u0441\u0434\u0440\u044A\u0441\u043A\u043E\u0435.  
    \u0410 \u0434\u043B\u044F \u043B\u0435\u043F\u044A\u0448\u043E\u0435 \u0432\u0435\u0440\u044B
    \u0438 \u043F\u0435\u0432\u043D\u043E\u0441\u0442\u0438 \u0442\u043E\u0435 \u0440\u0435\u0447\u0438
    \u0441\u0435\u0441\u044C \u043D\u0430\u0448\u044A \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0438,
    \u0440\u0443\u043A\u043E\u044E \u043D\u0430\u0448\u043E\u044E \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u0432\u0448\u0438,
    \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430\u0448\u0443 \u043A \u043D\u0435\u043C\u0443
    \u043F\u0440\u0438\u0432\u0435\u0441\u0438\u0442\u0438 \u0435\u0441\u043C\u043E
    \u0440\u043E\u0441\u043A\u0430\u0437\u0430\u043B\u0438.   \u041F\u0438\u0441\u0430\u043D\u044A
    \u0443 \u0412\u0430\u0440\u0448\u0430\u0432\u0435 \u043D\u0430 \u0441\u043E\u0438\u043C\u0435
    \u0432\u0430\u043B\u043D\u043E\u043C\u044A, \u043B\u0435\u0442\u0430 \u043E\u0442
    \u043D\u0430\u0440\u043E\u0436\u0435\u043D\u044C\u044F \u0421\u044B\u043D\u0430
    \u0411\u043E\u0436\u044C\u0435\u0433\u043E \u0442\u0438\u0441\u0435\u0447\u0430
    \u043F\u044F\u0442\u044C\u0441\u043E\u0442\u044A \u0434\u0435\u0432\u0435\u0442\u0434\u0435\u0441\u044F\u0442\u044A
    \u0441\u0435\u043C\u043E\u0433\u043E, \u043C\u0441\u0446\u0430 \u043C\u0430\u0440\u0446\u0430
    \u0441\u0435\u043C\u044A\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
    \u0434\u043D\u044F.   \u041F\u0440\u0438 \u0431\u044B\u0442\u043D\u043E\u0441\u0442\u0438
    \u0438\u0445 \u043C\u043B\u0441\u0442\u0438 \u0432\u0435\u043B\u0435\u0431\u043D\u044B\u0445
    \u0432 \u0411\u043E\u0437\u0435 \u044F\u0441\u043D\u0435\u0435 \u0432\u0435\u043B\u043C\u043E\u0436\u043D\u044B\u0445
    \u0438 \u0443\u0440\u043E\u0436\u043E\u043D\u044B\u0445 \u043F\u0430\u043D\u043E\u0432\u044A
    \u0441\u0435\u043D\u0430\u0442\u043E\u0440\u043E\u0432\u044A \u043D\u0430\u0448\u0438\u0445\u044A
    \u0434\u0443\u0445\u043E\u0432\u043D\u044B\u0445\u044A \u0438 \u0441\u0432\u0435\u0446\u043A\u0438\u0445\u044A,
    \u0442\u0430\u043A\u044A\u0436\u0435 \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u0432\u044A
    \u0437\u0435\u043C\u044A\u0441\u043A\u0438\u0445\u044A \u0438 \u0434\u0432\u043E\u0440\u043D\u044B\u0445\u044A
    \u041A\u043E\u0440\u043E\u043D\u044B \u041F\u043E\u043B\u0441\u043A\u043E\u0435
    \u0438 \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430
    \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E: \u0421\u0442\u0430\u043D\u0438\u0441\u043B\u0430\u0432\u0430
    \u041A\u0430\u0440\u043D\u044A\u043A\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E,
    \u0430\u0440\u0446\u044B\u0431\u0438\u0441\u043A\u0443\u043F\u0430 \u0433\u043D\u0435\u0437\u044A\u043D\u0435\u043D\u044C\u0441\u043A\u043E\u0433\u043E;
    \u042F\u043D\u0430 \u0414\u043C\u0438\u0442\u0440\u0430 \u0421\u0443\u043B\u0438\u043A\u043E\u0432\u0441\u043A\u043E\u0433,
    \u0430\u0440\u0446\u044B\u0431\u0438\u0441\u043A\u0443\u043F\u0430 \u043B\u044C\u0432\u043E\u0432\u0441\u043A\u043E\u0433\u043E;
    \u042E\u0440\u044F \u0420\u0430\u0434\u0438\u0432\u0438\u043B\u0430, \u043A\u043D\u0435\u0436\u0430\u0442\u0438
    \u043D\u0430 \u041E\u043B\u044B\u0446\u0435 \u0438 \u041D\u0435\u0441\u0432\u0438\u0436\u0443,
    \u043A\u0430\u0440\u0434\u044B\u043D\u0430\u043B\u0430, \u0431\u0438\u0441\u043A\u0443\u043F\u0430
    \u043A\u0440\u0430\u043A\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E; \u0411\u0435\u0440\u043D\u0430\u0442\u0430
    \u041C\u0430\u0442\u0435\u0435\u0432\u044A\u0441\u043A\u043E\u0433\u043E, \u043B\u0443\u0446\u043A\u043E\u0433\u043E
    \u0438 \u0431\u0435\u0440\u0435\u0441\u0442\u0435\u0438\u0441\u043A\u043E\u0433\u043E;
    \u0412\u0430\u0432\u0440\u0438\u043D\u0446\u0430 \u041A\u0433\u043E\u0441\u043B\u0438\u0446\u044A\u043A\u043E\u0433\u043E,
    \u043F\u0440\u0435\u043C\u044B\u0441\u0441\u043A\u043E\u0433\u043E \u0431\u0438\u0441\u043A\u0443\u043F\u043E\u0432\u044A;
    \u042F\u043D\u0443\u0448\u0430 \u043A\u043D\u0435\u0436\u0430\u0442\u0438 \u041E\u0441\u0442\u0440\u043E\u0437\u044A\u0441\u043A\u043E\u0433\u043E,
    \u043A\u0430\u0448\u0442\u0430\u043B\u044F\u043D\u0430 \u043A\u0440\u0430\u043A\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E;
    \u042F\u043D\u0430 \u0424\u0438\u0440\u043B\u0435\u044F \u0437 \u0414\u0443\u0431\u0440\u043E\u0432\u0438\u0446\u044B,
    \u0432\u043E\u0435\u0432\u043E\u0434\u044B \u043A\u0440\u0430\u043A\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E,
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u043D\u043E\u0432\u043E\u043C\u0435\u0441\u0442\u0441\u043A\u043E\u0433\u043E;
    \u042F\u0440\u043E\u0448\u0430 \u041A\u0433\u043E\u0441\u0442\u043E\u043C\u0441\u043A\u043E\u0433\u043E,
    \u0432\u043E\u0435\u0432\u043E\u0434\u044B \u043F\u043E\u0437\u043D\u0430\u043D\u0441\u043A\u043E\u0433\u043E;
    \u041A\u0440\u0438\u0448\u0442\u043E\u0444\u0430 \u0420\u0430\u0434\u0438\u0432\u0438\u043B\u0430,
    \u043A\u043D\u0435\u0436\u0430\u0442\u0438 \u043D\u0430 \u0411\u0438\u0440\u0436\u0430\u0445\u044A
    \u0438 \u0414\u0443\u0431\u0438\u043D\u044A\u043A\u0430\u0445\u044A, \u0432\u043E\u0435\u0432\u043E\u0434\u044B
    \u0432\u0438\u043B\u0435\u043D\u044C\u0441\u043A\u043E\u0433\u043E, \u0433\u0435\u0442\u043C\u0430\u043D\u0430
    \u043D\u0430\u0438\u0432\u044B\u0448\u044A\u0448\u043E\u0433\u043E \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430 \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E;
    \u042F\u0440\u043E\u043D\u0438\u043C\u0430 \u0425\u043E\u0434\u043A\u0435\u0432\u0438\u0447\u0430,
    \u043A\u0430\u0448\u0442\u0430\u043B\u044F\u043D\u0430 \u0432\u0438\u043B\u0435\u043D\u044C\u0441\u043A\u043E\u0433\u043E;
    \u042E\u0440\u044F \u041C\u043D\u0438\u0448\u043A\u0430, \u0432\u043E\u0435\u0432\u043E\u0434\u044B
    \u0441\u0435\u043D\u0434\u043E\u043C\u0438\u0440\u044A\u0441\u043A\u043E\u0433\u043E;
    \u042F\u043D\u0430 \u0410\u0431\u0440\u0430\u043C\u043E\u0432\u0438\u0447\u0430,
    \u0432\u043E\u0435\u0432\u043E\u0434\u044B \u0441\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u043E\u0433\u043E,
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u043B\u0438\u0434\u0441\u043A\u043E\u0433\u043E;
    \u0422\u0435\u043E\u0434\u043E\u0440\u0430 \u0421\u043A\u0443\u043C\u0438\u043D\u0430,
    \u0432\u043E\u0435\u0432\u043E\u0434\u044B \u043D\u043E\u0432\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E,
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u0433\u043E\u0440\u043E\u0434\u0435\u043D\u044C\u0441\u043A\u043E\u0433\u043E;
    \u041A\u0440\u044B\u0448\u0442\u043E\u0444\u0430 \u0417\u0435\u043D\u043E\u0432\u044A\u0435\u0432\u0438\u0447\u0430,
    \u0432\u043E\u0435\u0432\u043E\u0434\u044B \u0431\u0435\u0440\u0435\u0441\u0442\u0435\u0438\u0441\u043A\u043E\u0433\u043E;
    \u042F\u043D\u0430 \u0417\u0430\u0432\u0438\u0448\u0438, \u0432\u043E\u0435\u0432\u043E\u0434\u044B
    \u043C\u0441\u0442\u0438\u0441\u043B\u0430\u0432\u0441\u043A\u043E\u0433\u043E;
    \u0410\u043D\u044A\u0434\u0440\u0435\u044F \u0417\u0431\u043E\u0440\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    \u043A\u0430\u0448\u0442\u0435\u043B\u044F\u043D\u0430 \u0431\u0435\u0446\u043A\u043E\u0433\u043E[5];
    \u041C\u0438\u043A\u043E\u043B\u0430\u044F \u0416\u0430\u0431\u0440\u0438\u0434\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    \u043C\u0430\u0440\u0448\u0430\u043B\u044A\u043A\u0430 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E, \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B
    \u043A\u0440\u0430\u043A\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E; \u042F\u043D\u0430
    \u0417\u0430\u043C\u043E\u0438\u0441\u043A\u043E\u0433\u043E, \u043A\u0430\u043D\u044A\u0446\u043B\u0435\u0440\u0430
    \u0438 \u0433\u0435\u0442\u044A\u043C\u0430\u043D\u0430 \u043A\u043E\u0440\u043E\u043D\u044A\u043D\u043E\u0433\u043E,
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u0431\u0435\u043B\u0437\u044A\u0441\u043A\u043E\u0433\u043E[6];
    \u041B\u044C\u0432\u0430 \u0421\u0430\u043F\u0435\u0433\u0438, \u043A\u0430\u043D\u044A\u0446\u043B\u0435\u0440\u0430
    \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430
    \u041B\u0438\u0442\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E, \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B
    \u0441\u043B\u043E\u043D\u0438\u043C\u0441\u043A\u043E\u0433\u043E; \u042F\u043D\u0430
    \u0422\u0430\u0440\u044A\u043D\u043E\u0432\u044A\u0441\u043A\u043E\u0433\u043E,
    \u043F\u043E\u0434\u043A\u0430\u043D\u044A\u0446\u043B\u0435\u0440\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E; \u041A\u0433\u0430\u0431\u0440\u0438\u0435\u043B\u044F
    \u0412\u043E\u0438\u043D\u044B, \u043F\u043E\u0434\u043A\u0430\u043D\u044A\u0446\u043B\u0435\u0440\u043E\u0433\u043E
    \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430
    \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E, \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B
    \u043C\u0435\u0440\u0435\u0446\u043A\u043E\u0433\u043E; \u042F\u043D\u0430 \u0424\u0438\u0440\u043B\u0435\u044F
    \u0437 \u0414\u0443\u0431\u0440\u043E\u0432\u0438\u0446\u044B, \u043F\u043E\u0434\u044A\u0441\u043A\u0430\u0440\u0431\u0435\u0433\u043E
    \u0437\u0435\u043C\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043D\u044A\u043D\u043E\u0433\u043E;
    \u0414\u0435\u043C\u0435\u0442\u0440\u0430 \u0425\u0430\u043B\u0435\u0446\u044A\u0441\u043A\u043E\u0433\u043E
    \u0441 \u0425\u0430\u043B\u0447\u0430, \u043F\u043E\u0434\u044A\u0441\u043A\u0430\u0440\u0431\u0435\u0433\u043E
    \u0437\u0435\u043C\u0441\u043A\u043E\u0433\u043E \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430 \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E,
    \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u0431\u0435\u0440\u0435\u0441\u0442\u0435\u0438\u0441\u043A\u043E\u0433;
    \u0412\u0430\u0432\u0440\u0438\u043D\u0446\u0430 \u041A\u0433\u0435\u043D\u0431\u0438\u0446\u044A\u0441\u043A\u043E\u0433\u043E,
    \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u0430 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E; \u041C\u0430\u0442\u0435\u044F
    \u0412\u043E\u0438\u043D\u044B \u0438 \u042F\u0440\u043E\u0448\u0430 \u0412\u043E\u043B\u043E\u0432\u0438\u0447\u0430,
    \u043F\u0438\u0441\u0430\u0440\u043E\u0432\u044A \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u041A\u043D\u044F\u0437\u0441\u0442\u0432\u0430 \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433;
    \u041C\u0438\u043A\u043E\u043B\u0430\u044F \u0421\u0430\u043F\u0435\u0433\u0438;
    \u041C\u0430\u0442\u0435\u0443\u0448\u0430 \u0411\u0443\u0440\u0438\u043C\u0438\u043D\u0441\u043A\u043E\u0433\u043E;
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 \u041A\u043E\u0440\u0432\u0438\u043D\u0430
    \u041A\u0433\u043E\u0441\u0435\u0432\u0441\u043A\u043E\u0433\u043E; \u0414\u043E\u043C\u0435\u043D\u0438\u043A\u0430
    \u041E\u0431\u0440\u044B\u043D\u0441\u043A\u043E\u0433\u043E, \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u043E\u0432\u044A,
    \u0438 \u0438\u043D\u044A\u0448\u0438\u0445\u044A \u043C\u043D\u043E\u0433\u0438\u0445\u044A
    \u0432\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u0432\u044A \u0438 \u0434\u0432\u043E\u0440\u0430\u043D\u044A
    \u043D\u0430\u0448\u0438\u0445\u044A.   \u0423 \u0442\u043E\u0433\u043E \u043F\u0440\u044B\u0432\u0438\u043B\u0435\u044E
    \u043F\u0435\u0447\u0430\u0442 \u0437\u0430\u0432\u0435\u0441\u0438\u0441\u0442\u0430\u044F,
    \u0430 \u043F\u043E\u0434\u043F\u0438\u0441 \u0442\u044B\u043C\u0438 \u0441\u043B\u043E\u0432\u044B:
    Sigismundus Rex. \u041C\u0430\u0442\u0435\u0438 \u0412\u043E\u0438\u043D\u0430,
    \u043F\u0438\u0441\u0430\u0440[7].\r\n\r\n\r\n[1] \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043A\u043E\u043F\u0438\u0438
    \u0438\u0437 \u043A\u043D\u0438\u0433\u0438 83 \u041C\u0435\u0442\u0440\u0438\u043A\u0438
    \u0412\u041A\u041B.\r\n[2] \u0412 \u043A\u043D\u0438\u0433\u0435 115 \u041C\u0435\u0442\u0440\u0438\u043A\u0438
    \u0412\u041A\u041B \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
    \u0441\u043B\u043E\u0432\u0430 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E:
    \xAB\u0432\u0435\u043B\u0438\u043A\u0438 \u043A\u043D\u044F\u0437  \u043B\u0438\u0442.,
    \u0440\u0443\u0441\u043A\u0438, \u043F\u0440\u0443\u0441\u043A\u0438, \u0436\u043E\u043C\u043E\u0438\u0442\u0441\u043A\u0438,
    \u043C\u0430\u0437\u043E\u0432\u0435\u0446\u043A\u0438, \u0438\u043D\u0444\u043B\u044F\u043D\u0442\u0441\u043A\u0438\u0438,
    \u0430 \u0448\u0432\u0435\u0434\u0441\u043A\u0438, \u043A\u0433\u043E\u0434\u0441\u043A\u0438,
    \u0432\u0430\u043D\u044A\u0434\u0430\u043B\u0441\u043A\u0438 \u0434\u0435\u0434\u044B\u0447\u043D\u044B
    \u043A\u043E\u0440\u043E\u043B\xBB.\r\n[3] \u0412 \u043A\u043D\u0438\u0433\u0435
    115 \u041C\u0435\u0442\u0440\u0438\u043A\u0438 \u0412\u041A\u041B: \xAB\u0432\u0435\u043B\u0438\u043A\u0438\xBB.\r\n[4]
    \u0412 \u043A\u043D\u0438\u0433\u0435 115 \u041C\u0435\u0442\u0440\u0438\u043A\u0438
    \u0412\u041A\u041B: \xAB\u043C\u0435\u0441\u0442\u043A\u043E\u0435\xBB.\r\n[5]
    \u0412 \u043A\u043D\u0438\u0433\u0435 115 \u041C\u0435\u0442\u0440\u0438\u043A\u0438
    \u0412\u041A\u041B: \xAB\u0431\u0435\u043B\u0441\u043A\u043E\u0433\u043E\xBB.\r\n[6]
    \u0412 \u043A\u043D\u0438\u0433\u0435 115 \u041C\u0435\u0442\u0440\u0438\u043A\u0438
    \u0412\u041A\u041B: \xAB\u0431\u0435\u043B\u0441\u043A\u043E\u0433\xBB.\r\n[7]
    \u042D\u0442\u043E\u0442 \u0430\u0431\u0437\u0430\u0446 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u043A\u043D\u0438\u0433\u0435 115 \u041C\u0435\u0442\u0440\u0438\u043A\u0438
    \u0412\u041A\u041B, \u0432 \u043A\u043D\u0438\u0433\u0435 83 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.\n\n\n"
