  m_text: "\r1. \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n2. \u0423\u043B. \u0417\u0430\u043C\u043A\u043E\u0432\u0430\u044F\r\n3.
    \u041C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437 \u0440. \u0412\u0438\u0442\u044C\u0431\u0443\r\n4.
    \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440
    \u0438 \u0430\u0440\u0445\u0438\u0435\u0440\u0435\u0439\u0441\u043A\u0438\u0439
    \u0434\u043E\u043C\r\n5. \u0411\u0430\u0448\u043D\u044F \xAB\u0414\u0443\u0445\u043E\u0432\u0441\u043A\u043E\u0439
    \u043A\u0440\u0443\u0433\u043B\u0438\u043A\xBB (\u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442)\r\n6.
    \u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0414\u0443\u0445\u0430\r\n7.
    \u0420\u0430\u0442\u0443\u0448\u0430\r\n8. \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    (\u0420\u044B\u043D\u043A\u043E\u0432\u0430\u044F) \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n9.
    \u0423\u0441\u043F\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440
    \u0438 \u0414\u0443\u0445\u043E\u0432\u043D\u0430\u044F \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0438\u044F\r\n10.
    \u0423\u043B\u0438\u0446\u0430 \u0421\u043C\u043E\u043B\u0435\u043D\u0441\u043A\u0430\u044F
    (\u0441\u043E\u0432\u0440. \u0443\u043B. \u041B\u0435\u043D\u0438\u043D\u0430)\r\n11.
    \u0411\u043E\u0433\u043E\u044F\u0432\u043B\u0435\u043D\u0441\u043A\u0430\u044F
    (\u0421\u0438\u043C\u0435\u043E\u043D\u043E\u0432\u0441\u043A\u0430\u044F) \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n12.
    \u0421\u043E\u0431\u043E\u0440\u043D\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u044C
    (\u0441\u043E\u0432\u0440. \u043F\u043B. \u0421\u0432\u043E\u0431\u043E\u0434\u044B)
    \r\n13. \u0414\u0432\u043E\u0440\u0435\u0446 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430\r\n14.
    \u0421\u043F\u0430\u0441\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n15.
    \u041A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0410\u043D\u0442\u043E\u043D\u0438\u044F\r\n16.
    \u0414\u043E\u043C\u0430 \u0432\u0438\u0446\u0435-\u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
    \u0438 \u043A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442\u0430 \r\n(\u0441
    1883 \u0433. \u0437\u0434\u0430\u043D\u0438\u0435 \u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0433\u043E
    \u0441\u0443\u0434\u0430)\r\n17. \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439
    \u0430\u0440\u0445\u0438\u0432 \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u0430\u043A\u0442\u043E\u0432
    \r\n(\u0431\u044B\u0432\u0448\u0438\u0439 \u0424\u0430\u0440\u043D\u044B\u0439
    \u043A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B)\r\n18.
    \u0414\u043E\u043C \u0434\u0432\u043E\u0440\u044F\u043D\u0441\u043A\u043E\u0433\u043E
    \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F\r\n19. \u0420\u043E\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043D\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n20. \u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u0430\u044F
    (\u0417\u0430\u0440\u0443\u0447\u0435\u0432\u0441\u043A\u0430\u044F) \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n21. 
    \u0421\u0432\u044F\u0442\u043E-\u041F\u043E\u043A\u0440\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n22. \u041C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437
    \u0417\u0430\u043F. \u0414\u0432\u0438\u043D\u0443\r\n23. \u041B\u044E\u0442\u0435\u0440\u0430\u043D\u0441\u043A\u0430\u044F
    \u043A\u0438\u0440\u0445\u0430\r\n24. \u0421\u0432.-\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430\u044F
    (\u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D\u043D\u0430\u044F) \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n25.
    \u0418\u043B\u044C\u0438\u043D\u0441\u043A\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C  
    \r\n26. \u041F\u0435\u0442\u0440\u043E-\u041F\u0430\u0432\u043B\u043E\u0432\u0441\u043A\u0430\u044F
    \u0446\u0435\u0440\u043A\u043E\u0432\u044C\r\n27. \u041F\u0440\u043E\u0432\u0438\u0430\u043D\u0442\u0441\u043A\u0438\u0439
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D (\u0441\u043E\u043B\u044F\u043D\u044B\u0435
    \u0441\u043A\u043B\u0430\u0434\u044B, \u043B\u0430\u0431\u0430\u0437\u044B)\r\n28.
    \u0416\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
    \u0432\u043E\u043A\u0437\u0430\u043B\r\n29. \u0425\u043E\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u0441\u0438\u043D\u0430\u0433\u043E\u0433\u0430\r\n30. \u0416\u0435\u043D\u0441\u043A\u0430\u044F
    \u041C\u0430\u0440\u0438\u0438\u043D\u0441\u043A\u0430\u044F \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F\r\n31.
    \u041C\u0443\u0436\u0441\u043A\u0430\u044F \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u0441\u043A\u0430\u044F
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F\r\n32. \u0417\u0434\u0430\u043D\u0438\u044F
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0443\u043B. \u0417\u0430\u0434\u0443\u043D\u0430\u0432\u0441\u043A\u043E\u0439
    (\u0441\u043E\u0432\u0440. \u043F\u0440-\u0442\u0430 \u0424\u0440\u0443\u043D\u0437\u0435)\r\n33.
    \u0414\u043E\u043C \u043A\u0443\u043F\u0446\u043E\u0432 \u0412\u0438\u0442\u0442\u0435\u043D\u0431\u0435\u0440\u0433\u043E\u0432
    (\u0441 1900-\u0445 \u0433\u0433. \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435\r\n\u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0433\u043E
    \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0431\u0430\u043D\u043A\u0430)\r\n34.
    \u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0442\u0435\u0430\u0442\u0440\r\n35.
    \u0422\u044E\u0440\u0435\u043C\u043D\u044B\u0439 \u0437\u0430\u043C\u043E\u043A\r\n36.
    \u0426\u0435\u0440\u043A\u043E\u0432\u044C \u0421\u0432. \u0422\u0440\u043E\u0438\u0446\u044B
    (\xAB\u0427\u0435\u0440\u043D\u0430\u044F \u0422\u0440\u043E\u0438\u0446\u0430\xBB)\r\n37.
    \u041F\u0438\u0432\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u0432\u043E\u0434\r\n38.
    \u041A\u043E\u0441\u0442\u0435\u043B \u0421\u0432. \u0412\u0430\u0440\u0432\u0430\u0440\u044B"
  m_isRightToLeft: 0
