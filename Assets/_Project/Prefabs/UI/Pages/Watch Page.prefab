--- !u!114 &6248278081339471878
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4741169398311372536}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\t\u041F\u0435\u0440\u0432\u043E\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
    \u043E \u0447\u0430\u0441\u0430\u0445 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u0432\u043E\u0437\u043B\u0435 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u0440\u0430\u0442\u0443\u0448\u0438 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
    \u0432 \xAB\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    1641 \u0433\u043E\u0434\u0430\xBB. \u0412 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0438
    \u0441\u043A\u0430\u0437\u0430\u043D\u043E: \xAB\u0412 \u0441\u0430\u043C\u043E\u043C
    \u0433\u043E\u0440\u043E\u0434\u0435 \u0433\u043E\u0441\u0442\u0438\u043D\u044B\u0439
    \u0434\u0432\u043E\u0440 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435, \u043F\u0440\u043E\u0442\u0438\u0432
    \u0446\u0435\u0440\u043A\u0432\u0438 (\u0412\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u0441\u043A\u043E\u0439)
    \u0441\u0442\u043E\u044F\u0449\u0438\u0439. \u0412 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432\u0435\u0434\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0432\u043E\u0440\u043E\u0442\u0430,
    \u0430 \u043D\u0430 \u0432\u0435\u0440\u0445\u0443 \u044D\u0442\u0438\u0445 \u0432\u043E\u0440\u043E\u0442
    \u2013 \u043C\u0435\u0437\u043E\u043D\u0438\u043D, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0447\u0430\u0441\u044B \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0447\u0430\u0441\u043E\u0432\u044B\u043C
    \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u043E\u043C\xBB.\r\n\t\u0417\u0434\u0430\u043D\u0438\u0435
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0440\u0430\u0442\u0443\u0448\u0438
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435 (\u0441\u043E\u0432\u0440.
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u043E\u0439
    \u043A\u0440\u0430\u0435\u0432\u0435\u0434\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u0443\u0437\u0435\u0439) \u0431\u044B\u043B\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E
    \u0432 1597 \u0433\u043E\u0434\u0443 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0433\u043E\u0440\u043E\u0434\u043E\u043C \u041C\u0430\u0433\u0434\u0435\u0431\u0443\u0440\u0433\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0430\u0432\u0430. \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F
    \u0440\u0430\u0442\u0443\u0448\u0430 \u0432\u043D\u0430\u0447\u0430\u043B\u0435
    \u0431\u044B\u043B\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0439.
    \u0414\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C,
    \u0431\u044B\u043B\u0438 \u043B\u0438 \u0447\u0430\u0441\u044B \u043D\u0430 \u0440\u0430\u0442\u0443\u0448\u0435
    \u0432 XVII \u0432\u0435\u043A\u0435, \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C. \u0412\u043F\u0435\u0440\u0432\u044B\u0435
    \u0440\u0430\u0442\u0443\u0448\u0430 \u0431\u044B\u043B\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430
    \u043D\u0430 \xAB\u0427\u0435\u0440\u0442\u0435\u0436\u0435 \u0433\u043E\u0440\u043E\u0434\u0430
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430 1664 \u0433\u043E\u0434\u0430\xBB.
    \u0417\u0434\u0430\u043D\u0438\u0435 \u0440\u0430\u0442\u0443\u0448\u0438 \u0431\u044B\u043B\u043E
    \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u043C \u0441 \u0447\u0435\u0442\u044B\u0440\u0435\u0445\u0441\u043A\u0430\u0442\u043D\u043E\u0439
    \u043A\u0440\u044B\u0448\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043B\u0430\u0441\u044C \u0431\u0430\u0448\u043D\u0435\u0439.
    \u0427\u0430\u0441\u044B \u043D\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
    \u0440\u0430\u0442\u0443\u0448\u0435 \u043D\u0430 \xAB\u0427\u0435\u0440\u0442\u0435\u0436\u0435\xBB
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044B \u043D\u0435 \u0431\u044B\u043B\u0438."
