--- !u!114 &8577027715659184078
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4625243414347200740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "     \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435 \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    - \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E-\u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435
    \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043A\u043D\u044F\u0436\u0435\u0441\u0442\u0432\u0430
    \u041B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0441 \u0446\u0435\u043D\u0442\u0440\u043E\u043C
    \u0432 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0435, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0435\u043D\u0438\u044F
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439 \u0437\u0435\u043C\u043B\u0438
    (\u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0441 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u0438\u0438).
    \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u043E\xBB \u0431\u044B\u043B\u043E
    \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043E \u0437\u0430 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0439
    \u0437\u0435\u043C\u043B\u0451\u0439 \u0432 1511 \u0433., \u0430 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u0442\u0430\u0442\u0443\u0441 \u0437\u0435\u043C\u043B\u0438 \u0443\u043F\u0440\u0430\u0437\u0434\u043D\u0451\u043D
    \u0412\u0442\u043E\u0440\u044B\u043C \u0421\u0442\u0430\u0442\u0443\u0442\u043E\u043C
    \u0412\u041A\u041B \u0442\u043E\u043B\u044C\u043A\u043E \u0432 1566 \u0433.  
    \u0413\u043B\u0430\u0432\u043E\u0439 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430, \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u043E\u043C
    \u043A\u043E\u0440\u043E\u043B\u044F \u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0438 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043A\u043D\u044F\u0437\u044F
    \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0431\u044B\u043B
    \u0432\u043E\u0435\u0432\u043E\u0434\u0430. \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0438\u0435
    \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0438 \u043D\u0430\u0447\u0430\u043B\u0438
    \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0432\u043E\u0435\u0432\u043E\u0434\u0430\u043C\u0438
    \u0435\u0449\u0451 \u0432 1503 \u0433., \u043F\u043E\u0447\u0442\u0438 \u0437\u0430
    \u043F\u043E\u043B\u0432\u0435\u043A\u0430 \u0434\u043E \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E,
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0442\u0443\u0441\u0430
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0412\u0438\u0442\u0435\u0431\u0449\u0438\u043D\u044B
    \u043A\u0430\u043A \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430.   \u0412 1508\u20131566
    \u0433\u0433. \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E
    \u0438\u0437 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E, \u0415\u0437\u0435\u0440\u0438\u0449\u0435\u043D\u0441\u043A\u043E\u0435,
    \u0423\u0441\u0432\u044F\u0442\u0441\u043A\u043E\u0435 \u0438 \u041E\u0440\u0448\u0430\u043D\u0441\u043A\u043E\u0435
    \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u0447\u0435\u0441\u0442\u0432,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0443\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0414\u0440\u0443\u0446\u043A\u043E\u0433\u043E \u043A\u043D\u044F\u0436\u0435\u0441\u0442\u0432\u0430,
    \u0432\u043A\u043B\u044E\u0447\u0430\u043B\u043E \u0432 \u0441\u0435\u0431\u044F
    \u0433\u043E\u0440\u043E\u0434\u0430: \u0412\u0438\u0442\u0435\u0431\u0441\u043A,
    \u041E\u0440\u0448\u0443, \u041C\u043E\u0433\u0438\u043B\u0451\u0432, \u0414\u0440\u0443\u0446\u043A,
    \u0411\u043E\u0440\u0438\u0441\u043E\u0432, \u041D\u0435\u0432\u0435\u043B\u044C,
    \u0412\u0435\u043B\u0438\u0436, \u0428\u043A\u043B\u043E\u0432, \u041A\u043E\u043F\u044B\u0441\u044C,
    \u0427\u0430\u0443\u0441\u044B, \u0427\u0435\u0440\u0438\u043A\u043E\u0432, \u0411\u044B\u0445\u043E\u0432.
    \u0412 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u0440\u0435\u0444\u043E\u0440\u043C\u044B 1565\u20131566 \u0433\u0433. \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F
    \u0412\u041A\u041B \u0431\u044B\u043B\u0430 \u0437\u0430\u043D\u043E\u0432\u043E
    \u043F\u043E\u0434\u0435\u043B\u0435\u043D\u0430 \u043D\u0430 \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u0438 \u043F\u043E\u0432\u0435\u0442\u044B. \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u043E
    \u0438\u0437 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0438
    \u041E\u0440\u0448\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u0432\u0435\u0442\u043E\u0432.
    \u041F\u043E \u0438\u0442\u043E\u0433\u0430\u043C \u041B\u0438\u0432\u043E\u043D\u0441\u043A\u043E\u0439
    \u0432\u043E\u0439\u043D\u044B (1558\u20131583) \u043A \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u043C\u0443
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0443 \u0431\u044B\u043B\u0430
    \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0430 \u0412\u0435\u043B\u0438\u0436\u0441\u043A\u0430\u044F
    \u0432\u043E\u043B\u043E\u0441\u0442\u044C.   \u0412 1772 \u0433. \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0412\u0438\u0442\u0435\u0431\u0441\u043A
    \u0438 \u041E\u0440\u0448\u0443, \u0432\u043E\u0448\u043B\u0430 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u043E\u0439
    II \u041F\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0439 \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u0439
    \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439 \u0438\u043C\u043F\u0435\u0440\u0438\u0438.
    \u0414\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043E\u0435\u0432\u043E\u0434\u044B
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B\u0430\u0441\u044C \u0434\u043E
    1794 \u0433. \u0426\u0435\u043D\u0442\u0440\u043E\u043C \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430,
    \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435
    \u0412\u041A\u041B, \u0441\u0442\u0430\u043B\u0430 \u0427\u0435\u0440\u0435\u044F.
    \u0412 1793 \u0433. \u0437\u0430\u043F\u0430\u0434\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u0442\u0430\u043A\u0436\u0435 \u043E\u0442\u043E\u0448\u043B\u0430 \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438 \u0438 \u0431\u044B\u043B\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430
    \u0432 \u041F\u043E\u043B\u043E\u0446\u043A\u043E\u0435 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E.  
    \u0413\u0435\u0440\u0431 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    \u0441\u043E\u0431\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u043D\u044B\u0439
    \u0449\u0438\u0442 \u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C
    \u043D\u0430 \u043A\u0440\u0430\u0441\u043D\u043E\u043C \u043F\u043E\u043B\u0435
    \u0440\u044B\u0446\u0430\u0440\u044F \u0432 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
    \u043B\u0430\u0442\u0430\u0445 \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C
    \u0449\u0438\u0442\u043E\u043C, \u0437\u0430\u043D\u043E\u0441\u044F\u0449\u0435\u0433\u043E
    \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439
    \u043C\u0435\u0447 \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u044D\u0444\u0435\u0441\u043E\u043C
    \u0438 \u0441\u043A\u0430\u0447\u0443\u0449\u0435\u0433\u043E \u043D\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u043C
    \u043A\u043E\u043D\u0435 \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0441\u0431\u0440\u0443\u0435\u0439
    \u0438 \u0441\u0435\u0434\u043B\u043E\u043C. \u041D\u0430 \u0449\u0438\u0442\u0435
    \u0440\u044B\u0446\u0430\u0440\u044F \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D
    \u0448\u0435\u0441\u0442\u0438\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
    \u043A\u0440\u0435\u0441\u0442. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0438\u0441\u0442\u043E\u0440\u0438\u043A\u0443 \u0410. \u0421\u0430\u043F\u0443\u043D\u043E\u0432\u0443,
    \u0432 \u0442\u0430\u043A\u043E\u043C \u0432\u0438\u0434\u0435 \u0433\u0435\u0440\u0431
    \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0433\u043E \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0441 1500 \u0433. (\xAB\u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430\u044F
    \u0441\u0442\u0430\u0440\u0438\u043D\u0430\xBB \u0442. 1, 1883 \u0433.).   \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u043E\u0435
    \u0432\u043E\u0435\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0438\u043C\u0435\u043B\u043E
    \u0445\u043E\u0440\u0443\u0433\u0432\u044C \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430 \u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C
    \xAB\u041F\u043E\u0433\u043E\u043D\u0438\xBB \u043D\u0430 \u0431\u0435\u043B\u043E\u043C
    \u043F\u043E\u043B\u0435.   \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0438\u043C\u0432\u043E\u043B\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u043E\u0433\u043E \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0430
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u043D\u0430 \u0412\u0438\u0442\u0435\u0431\u0449\u0438\u043D\u0435
    \u0441\u043E 2-\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B XIII \u0432. 
    \u0410 \u0434\u0432\u0443\u043C\u044F \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438
    \u0440\u0430\u043D\u0435\u0435 \u0437\u0434\u0435\u0441\u044C \u0441\u0442\u0430\u043B
    \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0434\u0440\u0435\u0432\u043D\u0438\u0439
    \u0445\u0440\u0438\u0441\u0442\u0438\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u0438\u043C\u0432\u043E\u043B
    \u2013 \u0448\u0435\u0441\u0442\u0438\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
    \u043A\u0440\u0435\u0441\u0442 \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439
    \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0438\u043D\u043E\u0439,
    \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u044B
    \u043D\u0430 \u0434\u043E\u043B\u043E\u043C\u0438\u0442\u043E\u0432\u0443\u044E
    \u043F\u043B\u0438\u0442\u0443 \u0432 \u0411\u043B\u0430\u0433\u043E\u0432\u0435\u0449\u0435\u043D\u0441\u043A\u043E\u0439
    \u0446\u0435\u0440\u043A\u0432\u0438 \u0412\u0438\u0442\u0435\u0431\u0441\u043A\u0430
    \u0441 XII \u0432. \r\n"
  m_isRightToLeft: 0
